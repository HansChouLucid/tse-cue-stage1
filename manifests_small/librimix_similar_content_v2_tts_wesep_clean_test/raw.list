TS__1320-1320-122617-0008__VOICE__1221.wav"}, "sir_db": 0.0}
{"key": "1320-122617-0008_1221-135767-0021__T2__SCV2TTS__1221-1221-135767-0021__VOICE__1320", "condition": "similar_content_v2_tts", "spk": ["1221", "1320"], "mix": {"default": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/mix_clean/1320-122617-0008_1221-135767-0021__T2__SCV2TTS__1221-1221-135767-0021__VOICE__1320.wav"]}, "src": {"1221": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/s1/1320-122617-0008_1221-135767-0021__T2__SCV2TTS__1221-1221-135767-0021__VOICE__1320.wav"], "1320": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/s2/1320-122617-0008_1221-135767-0021__T2__SCV2TTS__1221-1221-135767-0021__VOICE__1320.wav"]}, "target_text": "PEARL ACCORDINGLY RAN TO THE BOW WINDOW AT THE FURTHER END OF THE HALL AND LOOKED ALONG THE VISTA OF A GARDEN WALK CARPETED WITH CLOSELY SHAVEN GRASS AND BORDERED WITH SOME RUDE AND IMMATURE ATTEMPT AT SHRUBBERY", "source_meta": {"key": "1320-122617-0008_1221-135767-0021__T2__SCV2TTS__1221-1221-135767-0021__VOICE__1320", "mixture_id": "1320-122617-0008_1221-135767-0021", "target_source": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/1221/135767/1221-135767-0021.flac", "target_spk": "1221", "target_utt": "1221-135767-0021", "target_text": "PEARL ACCORDINGLY RAN TO THE BOW WINDOW AT THE FURTHER END OF THE HALL AND LOOKED ALONG THE VISTA OF A GARDEN WALK CARPETED WITH CLOSELY SHAVEN GRASS AND BORDERED WITH SOME RUDE AND IMMATURE ATTEMPT AT SHRUBBERY", "original_interferer_source": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/1320/122617/1320-122617-0008.flac", "interferer_spk": "1320", "interferer_utt": "1320-122617-0008", "prompt_audio": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/1320/122612/1320-122612-0000.flac", "prompt_utt": "1320-122612-0000", "prompt_text": "SINCE THE PERIOD OF OUR TALE THE ACTIVE SPIRIT OF THE COUNTRY HAS SURROUNDED IT WITH A BELT OF RICH AND THRIVING SETTLEMENTS THOUGH NONE BUT THE HUNTER OR THE SAVAGE IS EVER KNOWN EVEN NOW TO PENETRATE ITS WILD RECESSES", "synthetic_interferer": "/data/tse_cue_project/manifests/librimix_similar_content_v2_tts/clean/test/synthetic_interferer/1320-122617-0008_1221-135767-0021__T2__SCV2TTS__1221-1221-135767-0021__VOICE__1320.wav"}, "sir_db": 0.0}

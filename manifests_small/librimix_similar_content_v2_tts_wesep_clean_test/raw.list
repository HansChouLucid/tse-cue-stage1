{"key": "3729-6852-0007_8555-284447-0021__T1__SCV2TTS__3729-3729-6852-0007__VOICE__8555", "condition": "similar_content_v2_tts", "spk": ["3729", "8555"], "mix": {"default": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/mix_clean/3729-6852-0007_8555-284447-0021__T1__SCV2TTS__3729-3729-6852-0007__VOICE__8555.wav"]}, "src": {"3729": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/s1/3729-6852-0007_8555-284447-0021__T1__SCV2TTS__3729-3729-6852-0007__VOICE__8555.wav"], "8555": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/s2/3729-6852-0007_8555-284447-0021__T1__SCV2TTS__3729-3729-6852-0007__VOICE__8555.wav"]}, "target_text": "TWO YEARS BEFORE HER DEATH I SAW HER PERFORM THE CHARACTER OF MARIANNE IN THE COMEDY OF MARIVAUX AND IN SPITE OF HER AGE AND DECLINING HEALTH THE ILLUSION WAS COMPLETE", "source_meta": {"key": "3729-6852-0007_8555-284447-0021__T1__SCV2TTS__3729-3729-6852-0007__VOICE__8555", "mixture_id": "3729-6852-0007_8555-284447-0021", "target_source": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/3729/6852/3729-6852-0007.flac", "target_spk": "3729", "target_utt": "3729-6852-0007", "target_text": "TWO YEARS BEFORE HER DEATH I SAW HER PERFORM THE CHARACTER OF MARIANNE IN THE COMEDY OF MARIVAUX AND IN SPITE OF HER AGE AND DECLINING HEALTH THE ILLUSION WAS COMPLETE", "original_interferer_source": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/8555/284447/8555-284447-0021.flac", "interferer_spk": "8555", "interferer_utt": "8555-284447-0021", "prompt_audio": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/8555/284447/8555-284447-0000.flac", "prompt_utt": "8555-284447-0000", "prompt_text": "THEN HE RUSHED DOWN STAIRS INTO THE COURTYARD SHOUTING LOUDLY FOR HIS SOLDIERS AND THREATENING TO PATCH EVERYBODY IN HIS DOMINIONS IF THE SAILORMAN WAS NOT RECAPTURED", "synthetic_interferer": "/data/tse_cue_project/manifests/librimix_similar_content_v2_tts/clean/test/synthetic_interferer/3729-6852-0007_8555-284447-0021__T1__SCV2TTS__3729-3729-6852-0007__VOICE__8555.wav"}, "sir_db": 0.0}

{"key": "237-134500-0002_1995-1836-0008__T2__SCV2TTS__1995-1995-1836-0008__VOICE__237", "condition": "similar_content_v2_tts", "spk": ["1995", "237"], "mix": {"default": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/mix_clean/237-134500-0002_1995-1836-0008__T2__SCV2TTS__1995-1995-1836-0008__VOICE__237.wav"]}, "src": {"1995": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/s1/237-134500-0002_1995-1836-0008__T2__SCV2TTS__1995-1995-1836-0008__VOICE__237.wav"], "237": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/s2/237-134500-0002_1995-1836-0008__T2__SCV2TTS__1995-1995-1836-0008__VOICE__237.wav"]}, "target_text": "I BELIEVE IN THE TRAINING OF PEOPLE TO THEIR HIGHEST CAPACITY THE ENGLISHMAN HERE HEARTILY SECONDED HIM", "source_meta": {"key": "237-134500-0002_1995-1836-0008__T2__SCV2TTS__1995-1995-1836-0008__VOICE__237", "mixture_id": "237-134500-0002_1995-1836-0008", "target_source": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/1995/1836/1995-1836-0008.flac", "target_spk": "1995", "target_utt": "1995-1836-0008", "target_text": "I BELIEVE IN THE TRAINING OF PEOPLE TO THEIR HIGHEST CAPACITY THE ENGLISHMAN HERE HEARTILY SECONDED HIM", "original_interferer_source": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/237/134500/237-134500-0002.flac", "interferer_spk": "237", "interferer_utt": "237-134500-0002", "prompt_audio": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/237/126133/237-126133-0000.flac", "prompt_utt": "237-126133-0000", "prompt_text": "HERE SHE WOULD STAY COMFORTED AND SOOTHED AMONG THE LOVELY PLANTS AND RICH EXOTICS REJOICING THE HEART OF OLD TURNER THE GARDENER WHO SINCE POLLY'S FIRST RAPTUROUS ENTRANCE HAD TAKEN HER INTO HIS GOOD GRACES FOR ALL TIME", "synthetic_interferer": "/data/tse_cue_project/manifests/librimix_similar_content_v2_tts/clean/test/synthetic_interferer/237-134500-0002_1995-1836-0008__T2__SCV2TTS__1995-1995-1836-0008__VOICE__237.wav"}, "sir_db": 0.0}

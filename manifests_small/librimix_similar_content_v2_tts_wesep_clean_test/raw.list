ata/tse_cue_project/manifests/librimix_similar_content_v2_tts/clean/test/synthetic_interferer/1284-134647-0006_8455-210777-0067__T1__SCV2TTS__1284-1284-134647-0006__VOICE__8455.wav"}, "sir_db": 0.0}

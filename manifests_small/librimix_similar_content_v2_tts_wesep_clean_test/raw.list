": "/data/tse_cue_project/manifests/librimix_similar_content_v2_tts/clean/test/synthetic_interferer/2094-142345-0043_1580-141084-0040__T2__SCV2TTS__1580-1580-141084-0040__VOICE__2094.wav"}, "sir_db": 0.0}

ON FALLS LIKE MORNING DEW", "synthetic_interferer": "/data/tse_cue_project/manifests/librimix_similar_content_v2_tts/clean/test/synthetic_interferer/5639-40744-0040_908-31957-0024__T1__SCV2TTS__5639-5639-40744-0040__VOICE__908.wav"}, "sir_db": 0.0}

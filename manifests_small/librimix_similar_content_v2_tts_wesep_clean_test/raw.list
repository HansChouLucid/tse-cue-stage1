 TO THE DESIGNERS AND ORNAMENT WORKERS OF THE COURT", "synthetic_interferer": "/data/tse_cue_project/manifests/librimix_similar_content_v2_tts/clean/test/synthetic_interferer/1089-134686-0013_7127-75946-0007__T1__SCV2TTS__1089-1089-134686-0013__VOICE__7127.wav"}, "sir_db": 0.0}

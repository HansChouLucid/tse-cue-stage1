{"key": "8455-210777-0016_2830-3980-0030__T1__SCV2TTS__8455-8455-210777-0016__VOICE__2830", "condition": "similar_content_v2_tts", "spk": ["8455", "2830"], "mix": {"default": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/mix_clean/8455-210777-0016_2830-3980-0030__T1__SCV2TTS__8455-8455-210777-0016__VOICE__2830.wav"]}, "src": {"8455": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/s1/8455-210777-0016_2830-3980-0030__T1__SCV2TTS__8455-8455-210777-0016__VOICE__2830.wav"], "2830": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/s2/8455-210777-0016_2830-3980-0030__T1__SCV2TTS__8455-8455-210777-0016__VOICE__2830.wav"]}, "target_text": "THIS I FELT WAS PAID TO ME AS BEING PRESIDENT OF THE REPUBLIC AND I ENDEAVOURED TO BEHAVE MYSELF WITH SUCH MINGLED HUMILITY AND DIGNITY AS MIGHT BEFIT THE OCCASION BUT I COULD NOT BUT FEEL THAT SOMETHING WAS WANTING TO THE SIMPLICITY OF MY ORDINARY LIFE", "source_meta": {"key": "8455-210777-0016_2830-3980-0030__T1__SCV2TTS__8455-8455-210777-0016__VOICE__2830", "mixture_id": "8455-210777-0016_2830-3980-0030", "target_source": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/8455/210777/8455-210777-0016.flac", "target_spk": "8455", "target_utt": "8455-210777-0016", "target_text": "THIS I FELT WAS PAID TO ME AS BEING PRESIDENT OF THE REPUBLIC AND I ENDEAVOURED TO BEHAVE MYSELF WITH SUCH MINGLED HUMILITY AND DIGNITY AS MIGHT BEFIT THE OCCASION BUT I COULD NOT BUT FEEL THAT SOMETHING WAS WANTING TO THE SIMPLICITY OF MY ORDINARY LIFE", "original_interferer_source": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/2830/3980/2830-3980-0030.flac", "interferer_spk": "2830", "interferer_utt": "2830-3980-0030", "prompt_audio": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/2830/3979/2830-3979-0000.flac", "prompt_utt": "2830-3979-0000", "prompt_text": "WE WANT YOU TO HELP US
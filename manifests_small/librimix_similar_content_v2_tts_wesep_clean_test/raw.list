{"key": "4446-2271-0000_2830-3980-0029__T2__SCV2TTS__2830-2830-3980-0029__VOICE__4446", "condition": "similar_content_v2_tts", "spk": ["2830", "4446"], "mix": {"default": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/mix_clean/4446-2271-0000_2830-3980-0029__T2__SCV2TTS__2830-2830-3980-0029__VOICE__4446.wav"]}, "src": {"2830": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/s1/4446-2271-0000_2830-3980-0029__T2__SCV2TTS__2830-2830-3980-0029__VOICE__4446.wav"], "4446": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/s2/4446-2271-0000_2830-3980-0029__T2__SCV2TTS__2830-2830-3980-0029__VOICE__4446.wav"]}, "target_text": "ALTHOUGH THE BRETHREN WITH ME ARE NOT APOSTLES LIKE MYSELF YET THEY ARE ALL OF ONE MIND WITH ME THINK WRITE AND TEACH AS I DO", "source_meta": {"key": "4446-2271-0000_2830-3980-0029__T2__SCV2TTS__2830-2830-3980-0029__VOICE__4446", "mixture_id": "4446-2271-0000_2830-3980-0029", "target_source": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/2830/3980/2830-3980-0029.flac", "target_spk": "2830", "target_utt": "2830-3980-0029", "target_text": "ALTHOUGH THE BRETHREN WITH ME ARE NOT APOSTLES LIKE MYSELF YET THEY ARE ALL OF ONE MIND WITH ME THINK WRITE AND TEACH AS I DO", "original_interferer_source": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/4446/2271/4446-2271-0000.flac", "interferer_spk": "4446", "interferer_utt": "4446-2271-0000", "prompt_audio": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/4446/2271/4446-2271-0001.flac", "prompt_utt": "4446-2271-0001", "prompt_text": "HE HAD PRECONCEIVED IDEAS ABOUT EVERYTHING AND HIS IDEA ABOUT AMERICANS WAS THAT THEY SHOULD BE ENGINEERS OR MECHANICS", "synthetic_interferer": "/data/tse_cue_project/manifests/librimix_similar_content_v2_tts/clean/test/synthetic_interferer/4446-2271-0000_2830-3980-0029__T2__SCV2TTS__2830-2830-3980-0029__VOICE__4446.wav"}, "sir_db": 0.0}
{"key": "1580-141084-0029_61-70968-0039__T1__SCV2TTS__1580-1580-141084-0029__VOICE__61", "condition": "similar_content_v2_tts", "spk": ["1580", "61"], "mix": {"default": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/mix_clean/1580-141084-0029_61-70968-0039__T1__SCV2TTS__1580-1580-141084-0029__VOICE__61.wav"]}, "src": {"1580": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/s1/1580-141084-0029_61-70968-0039__T1__SCV2TTS__1580-1580-141084-0029__VOICE__61.wav"], "61": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/s2/1580-141084-0029_61-70968-0039__T1__SCV2TTS__1580-1580-141084-0029__VOICE__61.wav"]}, "target_text": "HIS TROUBLED BLUE EYES GLANCED AT EACH OF US AND FINALLY RESTED WITH AN EXPRESSION OF BLANK DISMAY UPON BANNISTER IN THE FARTHER CORNER", "source_meta": {"key": "1580-141084-0029_61-70968-0039__T1__SCV2TTS__1580-1580-141084-0029__VOICE__61", "mixture_id": "1580-141084-0029_61-70968-0039", "target_source": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/1580/141084/1580-141084-0029.flac", "target_spk": "1580", "target_utt": "1580-141084-0029", "target_text": "HIS TROUBLED BLUE EYES GLANCED AT EACH OF US AND FINALLY RESTED WITH AN EXPRESSION OF BLANK DISMAY UPON BANNISTER IN THE FARTHER CORNER", "original_interferer_source": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/61/70968/61-70968-0039.flac", "interferer_spk": "61", "interferer_utt": "61-70968-0039", "prompt_audio": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/61/70968/61-70968-0000.flac", "prompt_utt": "61-70968-0000", "prompt_text": "HE BEGAN A CONFUSED COMPLAINT AGAINST THE WIZARD WHO HAD VANISHED BEHIND THE CURTAIN ON THE LEFT", "synthetic_interferer": "/data/tse_cue_project/manifests/librimix_similar_content_v2_tts/clean/test/synthetic_interferer/1580-141084-0029_61-70968-0039__T1__SCV2TTS__1580-1580-141084-0029__VOICE__61.wav"}, "sir_db": 0.0}

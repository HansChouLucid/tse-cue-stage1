{"key": "1320-122617-0020_61-70970-0019__T2__SCV2TTS__61-61-70970-0019__VOICE__1320", "condition": "similar_content_v2_tts", "spk": ["61", "1320"], "mix": {"default": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/mix_clean/1320-122617-0020_61-70970-0019__T2__SCV2TTS__61-61-70970-0019__VOICE__1320.wav"]}, "src": {"61": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/s1/1320-122617-0020_61-70970-0019__T2__SCV2TTS__61-61-70970-0019__VOICE__1320.wav"], "1320": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/s2/1320-122617-0020_61-70970-0019__T2__SCV2TTS__61-61-70970-0019__VOICE__1320.wav"]}, "target_text": "AT LAST ALL WAS QUIET AND BLACK IN THE COURTYARD OF GAMEWELL", "source_meta": {"key": "1320-122617-0020_61-70970-0019__T2__SCV2TTS__61-61-70970-0019__VOICE__1320", "mixture_id": "1320-122617-0020_61-70970-0019", "target_source": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/61/70970/61-70970-0019.flac", "target_spk": "61", "target_utt": "61-70970-0019", "target_text": "AT LAST ALL WAS QUIET AND BLACK IN THE COURTYARD OF GAMEWELL", "original_interferer_source": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/1320/122617/1320-122617-0020.flac", "interferer_spk": "1320", "interferer_utt": "1320-122617-0020", "prompt_audio": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/1320/122612/1320-122612-0000.flac", "prompt_utt": "1320-122612-0000", "prompt_text": "SINCE THE PERIOD OF OUR TALE THE ACTIVE SPIRIT OF THE COUNTRY HAS SURROUNDED IT WITH A BELT OF RICH AND THRIVING SETTLEMENTS THOUGH NONE BUT THE HUNTER OR THE SAVAGE IS EVER KNOWN EVEN NOW TO PENETRATE ITS WILD RECESSES", "synthetic_interferer": "/data/tse_cue_project/manifests/librimix_similar_content_v2_tts/clean/test/synthetic_interferer/1320-122617-0020_61-70970-0019__T2__SCV2TTS__61-61-70970-0019__VOICE__1320.wav"}, "sir_db": 0.0}
{"key": "8555-284447-0021_121-127105-0000__T1__SCV2TTS__8555-8555-284447-0021__VOICE__121", "condition": "similar_content_v2_tts", "spk": ["8555", "121"], "mix": {"default": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/mix_clean/8555-284447-0021_121-127105-0000__T1__SCV2TTS__8555-8555-284447-0021__VOICE__121.wav"]}, "src": {"8555": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/s1/8555-284447-0021_121-127105-0000__T1__SCV2TTS__8555-8555-284447-0021__VOICE__121.wav"], "121": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/s2/8555-284447-0021_121-127105-0000__T1__SCV2TTS__8555-8555-284447-0021__VOICE__121.wav"]}, "target_text": "THEN THEY SPED IN GREAT HASTE FOR THE DOOR AND THE GOAT GAVE A FINAL BUTT THAT SENT THE ROW OF ROYAL LADIES ALL DIVING INTO THE CORRIDOR IN ANOTHER TANGLE WHEREUPON THEY SHRIEKED IN A MANNER THAT TERRIFIED EVERYONE WITHIN SOUND OF THEIR VOICES", "source_meta": {"key": "8555-284447-0021_121-127105-0000__T1__SCV2TTS__8555-8555-284447-0021__VOICE__121", "mixture_id": "8555-284447-0021_121-127105-0000", "target_source": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/8555/284447/8555-284447-0021.flac", "target_spk": "8555", "target_utt": "8555-284447-0021", "target_text": "THEN THEY SPED IN GREAT HASTE FOR THE DOOR AND THE GOAT GAVE A FINAL BUTT THAT SENT THE ROW OF ROYAL LADIES ALL DIVING INTO THE CORRIDOR IN ANOTHER TANGLE WHEREUPON THEY SHRIEKED IN A MANNER THAT TERRIFIED EVERYONE WITHIN SOUND OF THEIR VOICES", "original_interferer_source": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/121/127105/121-127105-0000.flac", "interferer_spk": "121", "interferer_utt": "121-127105-0000", "prompt_audio": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/121/121726/121-121726-0000.flac", "prompt_utt": "121-121726-0000", "prompt_text": "ALSO A POPULAR CONTRIVANCE WHEREBY LOVE MAKING MAY BE SUSPENDED BUT NOT STOPPED DURING THE PICNIC SEASON", "synthetic_interferer": "/data/tse_cue_project/manifests/librimix_similar_content_v2_tts/clean/test/synthetic_interferer/8555-284447-0021_121-127105-0000__T1__SCV2TTS__8555-8555-284447-0021__VOICE__121.wav"}, "sir_db": 0.0}

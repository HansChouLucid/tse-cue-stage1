{"key": "3575-170457-0005_6829-68769-0006__T1__SCV2TTS__3575-3575-170457-0005__VOICE__6829", "condition": "similar_content_v2_tts", "spk": ["3575", "6829"], "mix": {"default": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/mix_clean/3575-170457-0005_6829-68769-0006__T1__SCV2TTS__3575-3575-170457-0005__VOICE__6829.wav"]}, "src": {"3575": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/s1/3575-170457-0005_6829-68769-0006__T1__SCV2TTS__3575-3575-170457-0005__VOICE__6829.wav"], "6829": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/s2/3575-170457-0005_6829-68769-0006__T1__SCV2TTS__3575-3575-170457-0005__VOICE__6829.wav"]}, "target_text": "SHE A TORY AND CLERGYMAN'S DAUGHTER WAS ALWAYS IN A MINORITY OF ONE IN OUR HOUSE OF VIOLENT DISSENT AND RADICALISM", "source_meta": {"key": "3575-170457-0005_6829-68769-0006__T1__SCV2TTS__3575-3575-170457-0005__VOICE__6829", "mixture_id": "3575-170457-0005_6829-68769-0006", "target_source": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/3575/170457/3575-170457-0005.flac", "target_spk": "3575", "target_utt": "3575-170457-0005", "target_text": "SHE A TORY AND CLERGYMAN'S DAUGHTER WAS ALWAYS IN A MINORITY OF ONE IN OUR HOUSE OF VIOLENT DISSENT AND RADICALISM", "original_interferer_source": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/6829/68769/6829-68769-0006.flac", "interferer_spk": "6829", "interferer_utt": "6829-68769-0006", "prompt_audio": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/6829/68769/6829-68769-0000.flac", "prompt_utt": "6829-68769-0000", "prompt_text": "KENNETH AND BETH REFRAINED FROM TELLING THE OTHER GIRLS OR UNCLE JOHN OF OLD WILL ROGERS'S VISIT BUT THEY GOT MISTER WATSON IN THE LIBRARY AND QUESTIONED HIM CLOSELY ABOUT THE PENALTY FOR FORGING A CHECK", "synthetic_interferer": "/data/tse_cue_project/manifests/librimix_similar_content_v2_tts/clean/test/synthetic_interferer/3575-170457-0005_6829-68769-0006__T1__SCV2TTS__3575-3575-170457-0005__VOICE__6829.wav"}, "sir_db": 0.0}

-2961-961-0014__VOICE__1995.wav"}, "sir_db": 0.0}
{"key": "8224-274381-0013_1284-1180-0026__T1__SCV2TTS__8224-8224-274381-0013__VOICE__1284", "condition": "similar_content_v2_tts", "spk": ["8224", "1284"], "mix": {"default": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/mix_clean/8224-274381-0013_1284-1180-0026__T1__SCV2TTS__8224-8224-274381-0013__VOICE__1284.wav"]}, "src": {"8224": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/s1/8224-274381-0013_1284-1180-0026__T1__SCV2TTS__8224-8224-274381-0013__VOICE__1284.wav"], "1284": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/s2/8224-274381-0013_1284-1180-0026__T1__SCV2TTS__8224-8224-274381-0013__VOICE__1284.wav"]}, "target_text": "FROM THE SAME MEN NEW REGIMENTS AND NEW COMPANIES WERE FORMED DIFFERENT OFFICERS APPOINTED AND THE WHOLE MILITARY FORCE PUT INTO SUCH HANDS AS THE INDEPENDENTS COULD RELY ON", "source_meta": {"key": "8224-274381-0013_1284-1180-0026__T1__SCV2TTS__8224-8224-274381-0013__VOICE__1284", "mixture_id": "8224-274381-0013_1284-1180-0026", "target_source": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/8224/274381/8224-274381-0013.flac", "target_spk": "8224", "target_utt": "8224-274381-0013", "target_text": "FROM THE SAME MEN NEW REGIMENTS AND NEW COMPANIES WERE FORMED DIFFERENT OFFICERS APPOINTED AND THE WHOLE MILITARY FORCE PUT INTO SUCH HANDS AS THE INDEPENDENTS COULD RELY ON", "original_interferer_source": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/1284/1180/1284-1180-0026.flac", "interferer_spk": "1284", "interferer_utt": "1284-1180-0026", "prompt_audio": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/1284/1180/1284-1180-0000.flac", "prompt_utt": "1284-1180-0000", "prompt_text": "HE WORE BLUE SILK STOCKINGS BLUE KNEE PANTS WITH GOLD BUCKLES A BLUE RUFFLED WAIST AND A JACKET OF BRIGHT BLUE BRAIDED WITH GOLD", "synthetic_interferer": "/data/tse_cue_project/manifests/librimix_similar_content_v2_tts/clean/test/synthetic_interferer/8224-274381-0013_1284-1180-0026__T1__SCV2TTS__8224-8224-274381-0013__VOICE__1284.wav"}, "sir_db": 0.0}

ject/manifests/librimix_similar_content_v2_tts/clean/test/synthetic_interferer/1995-1837-0021_4970-29095-0026__T2__SCV2TTS__4970-4970-29095-0026__VOICE__1995.wav"}, "sir_db": 0.0}

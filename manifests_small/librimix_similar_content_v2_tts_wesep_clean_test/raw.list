{"key": "61-70970-0028_908-31957-0009__T1__SCV2TTS__61-61-70970-0028__VOICE__908", "condition": "similar_content_v2_tts", "spk": ["61", "908"], "mix": {"default": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/mix_clean/61-70970-0028_908-31957-0009__T1__SCV2TTS__61-61-70970-0028__VOICE__908.wav"]}, "src": {"61": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/s1/61-70970-0028_908-31957-0009__T1__SCV2TTS__61-61-70970-0028__VOICE__908.wav"], "908": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/s2/61-70970-0028_908-31957-0009__T1__SCV2TTS__61-61-70970-0028__VOICE__908.wav"]}, "target_text": "STUTELEY WAS BY HIS SIDE IN A FLASH AND THEN THEY BOTH BEGAN FEELING ABOUT THEM TO ASCERTAIN THE SHAPE AND CHARACTER OF THIS VAULT", "source_meta": {"key": "61-70970-0028_908-31957-0009__T1__SCV2TTS__61-61-70970-0028__VOICE__908", "mixture_id": "61-70970-0028_908-31957-0009", "target_source": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/61/70970/61-70970-0028.flac", "target_spk": "61", "target_utt": "61-70970-0028", "target_text": "STUTELEY WAS BY HIS SIDE IN A FLASH AND THEN THEY BOTH BEGAN FEELING ABOUT THEM TO ASCERTAIN THE SHAPE AND CHARACTER OF THIS VAULT", "original_interferer_source": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/908/31957/908-31957-0009.flac", "interferer_spk": "908", "interferer_utt": "908-31957-0009", "prompt_audio": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/908/157963/908-157963-0000.flac", "prompt_utt": "908-157963-0000", "prompt_text": "TO FADE AWAY LIKE MORNING BEAUTY FROM HER MORTAL DAY DOWN BY THE RIVER OF ADONA HER SOFT VOICE IS HEARD AND THUS HER GENTLE LAMENTATION FALLS LIKE MORNING DEW", "synthetic_interferer": "/data/tse_cue_project/manifests/librimix_similar_content_v2_tts/clean/test/synthetic_interferer/61-70970-0028_908-31957-0009__T1__SCV2TTS__61-61-
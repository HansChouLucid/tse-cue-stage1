{"key": "1320-122617-0011_7127-75947-0003__T1__SCV2TTS__1320-1320-122617-0011__VOICE__7127", "condition": "similar_content_v2_tts", "spk": ["1320", "7127"], "mix": {"default": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/mix_clean/1320-122617-0011_7127-75947-0003__T1__SCV2TTS__1320-1320-122617-0011__VOICE__7127.wav"]}, "src": {"1320": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/s1/1320-122617-0011_7127-75947-0003__T1__SCV2TTS__1320-1320-122617-0011__VOICE__7127.wav"], "7127": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/s2/1320-122617-0011_7127-75947-0003__T1__SCV2TTS__1320-1320-122617-0011__VOICE__7127.wav"]}, "target_text": "THE LODGE IN WHICH UNCAS WAS CONFINED WAS IN THE VERY CENTER OF THE VILLAGE AND IN A SITUATION PERHAPS MORE DIFFICULT THAN ANY OTHER TO APPROACH OR LEAVE WITHOUT OBSERVATION", "source_meta": {"key": "1320-122617-0011_7127-75947-0003__T1__SCV2TTS__1320-1320-122617-0011__VOICE__7127", "mixture_id": "1320-122617-0011_7127-75947-0003", "target_source": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/1320/122617/1320-122617-0011.flac", "target_spk": "1320", "target_utt": "1320-122617-0011", "target_text": "THE LODGE IN WHICH UNCAS WAS CONFINED WAS IN THE VERY CENTER OF THE VILLAGE AND IN A SITUATION PERHAPS MORE DIFFICULT THAN ANY OTHER TO APPROACH OR LEAVE WITHOUT OBSERVATION", "original_interferer_source": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/7127/75947/7127-75947-0003.flac", "interferer_spk": "7127", "interferer_utt": "7127-75947-0003", "prompt_audio": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/7127/75946/7127-75946-0000.flac", "prompt_utt": "7127-75946-0000", "prompt_text": "AT THE CONCLUSION OF THE BANQUET WHICH WAS SERVED AT FIVE O'CLOCK THE KING ENTERED HIS CABINET WHERE HIS TAILORS WERE AWAITING HIM FOR THE PURPOSE OF TRYING ON THE CELEBRATED COSTUME REPRESENTING SPRING WHICH WAS THE RESULT OF SO MUCH IMAGINATION AND HAD COST SO MANY EFFORTS OF THOUGHT TO THE DESIGNERS AND ORNAMENT WORKERS OF THE COURT", "synthetic_interferer": "/data/tse_cue_project/manifests/librimix_similar_content_v2_tts/clean/test/synthetic_interferer/1320-122617-0011_7127-75947-0003__T1__SCV2TTS__1320-1320-122617-0011__VOICE__7127.wav"}, "sir_db": 0.0}

{"key": "672-122797-0073_7127-75946-0006__T1__SCV2TTS__672-672-122797-0073__VOICE__7127", "condition": "similar_content_v2_tts", "spk": ["672", "7127"], "mix": {"default": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/mix_clean/672-122797-0073_7127-75946-0006__T1__SCV2TTS__672-672-122797-0073__VOICE__7127.wav"]}, "src": {"672": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/s1/672-122797-0073_7127-75946-0006__T1__SCV2TTS__672-672-122797-0073__VOICE__7127.wav"], "7127": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/s2/672-122797-0073_7127-75946-0006__T1__SCV2TTS__672-672-122797-0073__VOICE__7127.wav"]}, "target_text": "THE WOOD FLAMED UP SPLENDIDLY UNDER THE LARGE BREWING COPPER AND IT SIGHED SO DEEPLY", "source_meta": {"key": "672-122797-0073_7127-75946-0006__T1__SCV2TTS__672-672-122797-0073__VOICE__7127", "mixture_id": "672-122797-0073_7127-75946-0006", "target_source": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/672/122797/672-122797-0073.flac", "target_spk": "672", "target_utt": "672-122797-0073", "target_text": "THE WOOD FLAMED UP SPLENDIDLY UNDER THE LARGE BREWING COPPER AND IT SIGHED SO DEEPLY", "original_interferer_source": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/7127/75946/7127-75946-0006.flac", "interferer_spk": "7127", "interferer_utt": "7127-75946-0006", "prompt_audio": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/7127/75946/7127-75946-0000.flac", "prompt_utt": "7127-75946-0000", "prompt_text": "AT THE CONCLUSION OF THE BANQUET WHICH WAS SERVED AT FIVE O'CLOCK THE KING ENTERED HIS CABINET WHERE HIS TAILORS WERE AWAITING HIM FOR THE PURPOSE OF TRYING ON THE CELEBRATED COSTUME REPRESENTING SPRING WHICH WAS THE RESULT OF SO MUCH IMAGINATION AND HAD COST SO MANY EFFORTS OF THOUGHT TO THE DESIGNERS AND ORNAMENT WORKERS OF THE COURT", "synthetic_interferer": "/data/tse_cue_project/manifests/librimix_similar_content_v2_tts/clean/test/synthetic_interferer/672-122797-0073_7127-75946-0006__T1__SCV2TTS__672-672-122797-0073__VOICE__7127.wav"}, "sir_db": 0.0}

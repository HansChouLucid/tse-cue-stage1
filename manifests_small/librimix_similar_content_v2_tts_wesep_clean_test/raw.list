_cue_project/manifests/librimix_similar_content_v2_tts/clean/test/synthetic_interferer/1320-122617-0040_8224-274381-0007__T2__SCV2TTS__8224-8224-274381-0007__VOICE__1320.wav"}, "sir_db": 0.0}

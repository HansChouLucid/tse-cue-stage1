{"key": "7176-92135-0031_4446-2273-0021__T2__SCV2TTS__4446-4446-2273-0021__VOICE__7176", "condition": "similar_content_v2_tts", "spk": ["4446", "7176"], "mix": {"default": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/mix_clean/7176-92135-0031_4446-2273-0021__T2__SCV2TTS__4446-4446-2273-0021__VOICE__7176.wav"]}, "src": {"4446": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/s1/7176-92135-0031_4446-2273-0021__T2__SCV2TTS__4446-4446-2273-0021__VOICE__7176.wav"], "7176": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/s2/7176-92135-0031_4446-2273-0021__T2__SCV2TTS__4446-4446-2273-0021__VOICE__7176.wav"]}, "target_text": "WHAT SHE WANTED FROM US WAS NEITHER OUR FLOWERS NOR OUR FRANCS BUT JUST OUR YOUTH", "source_meta": {"key": "7176-92135-0031_4446-2273-0021__T2__SCV2TTS__4446-4446-2273-0021__VOICE__7176", "mixture_id": "7176-92135-0031_4446-2273-0021", "target_source": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/4446/2273/4446-2273-0021.flac", "target_spk": "4446", "target_utt": "4446-2273-0021", "target_text": "WHAT SHE WANTED FROM US WAS NEITHER OUR FLOWERS NOR OUR FRANCS BUT JUST OUR YOUTH", "original_interferer_source": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/7176/92135/7176-92135-0031.flac", "interferer_spk": "7176", "interferer_utt": "7176-92135-0031", "prompt_audio": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/7176/88083/7176-88083-0000.flac", "prompt_utt": "7176-88083-0000", "prompt_text": "ALL ABOUT HIM WAS A TUMULT OF BRIGHT AND BROKEN COLOR SCATTERED IN BROAD SPLASHES", "synthetic_interferer": "/data/tse_cue_project/manifests/librimix_similar_content_v2_tts/clean/test/synthetic_interferer/7176-92135-0031_4446-2273-0021__T2__SCV2TTS__4446-4446-2273-0021__VOICE__7176.wav"}, "sir_db": 0.0}
{"key": "4077-13751-0011_7729-102255-0021__T1__SCV2TTS__4077-4077-13751-0011__VOICE__7729", "condition": "similar_content_v2_tts", "spk": ["4077", "7729"], "mix": {"default": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/mix_clean/4077-13751-0011_7729-102255-0021__T1__SCV2TTS__4077-4077-13751-0011__VOICE__7729.wav"]}, "src": {"4077": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/s1/4077-13751-0011_7729-102255-0021__T1__SCV2TTS__4077-4077-13751-0011__VOICE__7729.wav"], "7729": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/s2/4077-13751-0011_7729-102255-0021__T1__SCV2TTS__4077-4077-13751-0011__VOICE__7729.wav"]}, "target_text": "SOON THOUSANDS OF CONVERTS HAD RENTED OR PURCHASED HOMES IN MISSOURI INDEPENDENCE JACKSON COUNTY BEING THEIR CENTER BUT FROM THE FIRST THEY WERE UNPOPULAR AMONG THE MISSOURIANS", "source_meta": {"key": "4077-13751-0011_7729-102255-0021__T1__SCV2TTS__4077-4077-13751-0011__VOICE__7729", "mixture_id": "4077-13751-0011_7729-102255-0021", "target_source": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/4077/13751/4077-13751-0011.flac", "target_spk": "4077", "target_utt": "4077-13751-0011", "target_text": "SOON THOUSANDS OF CONVERTS HAD RENTED OR PURCHASED HOMES IN MISSOURI INDEPENDENCE JACKSON COUNTY BEING THEIR CENTER BUT FROM THE FIRST THEY WERE UNPOPULAR AMONG THE MISSOURIANS", "original_interferer_source": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/7729/102255/7729-102255-0021.flac", "interferer_spk": "7729", "interferer_utt": "7729-102255-0021", "prompt_audio": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/7729/102255/7729-102255-0000.flac", "prompt_utt": "7729-102255-0000", "prompt_text": "THE BOGUS LEGISLATURE NUMBERED THIRTY SIX MEMBERS", "synthetic_interferer": "/data/tse_cue_project/manifests/librimix_similar_content_v2_tts/clean/test/synthetic_interferer/4077-13751-0011_7729-102255-0021__T1__SCV2TTS__4077-4077-13751-0011__VOICE__7729.wav"}, "sir_db": 0.0}

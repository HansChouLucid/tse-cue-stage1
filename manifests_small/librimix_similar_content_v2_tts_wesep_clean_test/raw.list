-961-0019__T1__SCV2TTS__8224-8224-274384-0007__VOICE__2961.wav"}, "sir_db": 0.0}
{"key": "8224-274384-0007_2961-961-0019__T2__SCV2TTS__2961-2961-961-0019__VOICE__8224", "condition": "similar_content_v2_tts", "spk": ["2961", "8224"], "mix": {"default": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/mix_clean/8224-274384-0007_2961-961-0019__T2__SCV2TTS__2961-2961-961-0019__VOICE__8224.wav"]}, "src": {"2961": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/s1/8224-274384-0007_2961-961-0019__T2__SCV2TTS__2961-2961-961-0019__VOICE__8224.wav"], "8224": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/s2/8224-274384-0007_2961-961-0019__T2__SCV2TTS__2961-2961-961-0019__VOICE__8224.wav"]}, "target_text": "FOR AT THE PERIL OF HER OWN EXISTENCE AND WHEN THE OTHER HELLENES HAD DESERTED HER SHE REPELLED THE INVADER AND OF HER OWN ACCORD GAVE LIBERTY TO ALL THE NATIONS WITHIN THE PILLARS", "source_meta": {"key": "8224-274384-0007_2961-961-0019__T2__SCV2TTS__2961-2961-961-0019__VOICE__8224", "mixture_id": "8224-274384-0007_2961-961-0019", "target_source": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/2961/961/2961-961-0019.flac", "target_spk": "2961", "target_utt": "2961-961-0019", "target_text": "FOR AT THE PERIL OF HER OWN EXISTENCE AND WHEN THE OTHER HELLENES HAD DESERTED HER SHE REPELLED THE INVADER AND OF HER OWN ACCORD GAVE LIBERTY TO ALL THE NATIONS WITHIN THE PILLARS", "original_interferer_source": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/8224/274384/8224-274384-0007.flac", "interferer_spk": "8224", "interferer_utt": "8224-274384-0007", "prompt_audio": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/8224/274381/8224-274381-0000.flac", "prompt_utt": "8224-274381-0000", "prompt_text": "THOUGH THROWN INTO PRISON FOR THIS ENTERPRISE AND DETAINED SOME TIME HE WAS NOT DISCOURAGED BUT STILL CONTINUED BY HIS COUNTENANCE AND PROTECTION TO INFUSE SPIRIT INTO THE DISTRESSED ROYALISTS", "synthetic_interferer": "/data/tse_cue_project/manifests/librimix_similar_content_v2_tts/clean/test/synthetic_interferer/8224-274384-0007_2961-961-0019__T2__SCV2TTS__2961-2961-961-0019__VOICE__8224.wav"}, "sir_db": 0.0}

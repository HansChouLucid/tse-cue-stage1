{"key": "8455-210777-0031_6829-68769-0030__T1__SCV2TTS__8455-8455-210777-0031__VOICE__6829", "condition": "similar_content_v2_tts", "spk": ["8455", "6829"], "mix": {"default": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/mix_clean/8455-210777-0031_6829-68769-0030__T1__SCV2TTS__8455-8455-210777-0031__VOICE__6829.wav"]}, "src": {"8455": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/s1/8455-210777-0031_6829-68769-0030__T1__SCV2TTS__8455-8455-210777-0031__VOICE__6829.wav"], "6829": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/s2/8455-210777-0031_6829-68769-0030__T1__SCV2TTS__8455-8455-210777-0031__VOICE__6829.wav"]}, "target_text": "YOU HAVE RECEIVED US WITH ALL THAT COURTESY AND HOSPITALITY FOR WHICH YOUR CHARACTER IN ENGLAND STANDS SO HIGH", "source_meta": {"key": "8455-210777-0031_6829-68769-0030__T1__SCV2TTS__8455-8455-210777-0031__VOICE__6829", "mixture_id": "8455-210777-0031_6829-68769-0030", "target_source": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/8455/210777/8455-210777-0031.flac", "target_spk": "8455", "target_utt": "8455-210777-0031", "target_text": "YOU HAVE RECEIVED US WITH ALL THAT COURTESY AND HOSPITALITY FOR WHICH YOUR CHARACTER IN ENGLAND STANDS SO HIGH", "original_interferer_source": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/6829/68769/6829-68769-0030.flac", "interferer_spk": "6829", "interferer_utt": "6829-68769-0030", "prompt_audio": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/6829/68769/6829-68769-0000.flac", "prompt_utt": "6829-68769-0000", "prompt_text": "KENNETH AND BETH REFRAINED FROM TELLING THE OTHER GIRLS OR UNCLE JOHN OF OLD WILL ROGERS'S VISIT BUT THEY GOT MISTER WATSON IN THE LIBRARY AND QUESTIONED HIM CLOSELY ABOUT THE PENALTY FOR FORGING A CHECK", "synthetic_interferer": "/data/tse_cue_project/manifests/librimix_similar_content_v2_tts/clean/test/synthetic_interferer/8455-210777-0031_6829-68769-0030__T1__SCV2TTS__8455-8455-210777-0031__VOICE__6829.wav"}, "sir_db": 0.0}

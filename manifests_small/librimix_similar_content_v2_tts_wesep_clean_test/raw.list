N WAS NOT RECAPTURED", "synthetic_interferer": "/data/tse_cue_project/manifests/librimix_similar_content_v2_tts/clean/test/synthetic_interferer/8555-292519-0011_7127-75947-0038__T2__SCV2TTS__7127-7127-75947-0038__VOICE__8555.wav"}, "sir_db": 0.0}
{"key": "2094-142345-0058_8455-210777-0004__T1__SCV2TTS__2094-2094-142345-0058__VOICE__8455", "condition": "similar_content_v2_tts", "spk": ["2094", "8455"], "mix": {"default": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/mix_clean/2094-142345-0058_8455-210777-0004__T1__SCV2TTS__2094-2094-142345-0058__VOICE__8455.wav"]}, "src": {"2094": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/s1/2094-142345-0058_8455-210777-0004__T1__SCV2TTS__2094-2094-142345-0058__VOICE__8455.wav"], "8455": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/s2/2094-142345-0058_8455-210777-0004__T1__SCV2TTS__2094-2094-142345-0058__VOICE__8455.wav"]}, "target_text": "BY THE BY I'VE NEVER SEEN YOUR DAIRY I MUST SEE YOUR DAIRY MISSUS POYSER", "source_meta": {"key": "2094-142345-0058_8455-210777-0004__T1__SCV2TTS__2094-2094-142345-0058__VOICE__8455", "mixture_id": "2094-142345-0058_8455-210777-0004", "target_source": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/2094/142345/2094-142345-0058.flac", "target_spk": "2094", "target_utt": "2094-142345-0058", "target_text": "BY THE BY I'VE NEVER SEEN YOUR DAIRY I MUST SEE YOUR DAIRY MISSUS POYSER", "original_interferer_source": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/8455/210777/8455-210777-0004.flac", "interferer_spk": "8455", "interferer_utt": "8455-210777-0004", "prompt_audio": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/8455/210777/8455-210777-0000.flac", "prompt_utt": "8455-210777-0000", "prompt_text": "I REMAINED THERE ALONE FOR MANY HOURS BUT I MUST ACKNOWLEDGE THAT BEFORE I LEFT THE CHAMBERS I HAD GRADUALLY BROUGHT MYSELF TO LOOK AT THE MATTER IN ANOTHER LIGHT", "synthetic_interferer": "/data/tse_cue_project/manifests/librimix_similar_content_v2_tts/clean/test/synthetic_interferer/2094-142345-0058_8455-210777-0004__T1__SCV2TTS__2094-2094-142345-0058__VOICE__8455.wav"}, "sir_db": 0.0}
{"key": "2094-142345-0058_8455-210777-0004__T2__SCV2TTS__8455-8455-210777-0004__VOICE__2094", "condition": "similar_content_v2_tts", "spk": ["8455", "2094"], "mix": {"default": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/mix_clean/2094-142345-0058_8455-210777-0004__T2__SCV2TTS__8455-8455-210777-0004__VOICE__2094.wav"]}, "src": {"8455": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/s1/2094-142345-0058_8455-210777-0004__T2__SCV2TTS__8455-8455-210777-0004__VOICE__2094.wav"], "2094": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/s2/2094-142345-0058_8455-210777-0004__T2__SCV2TTS__8455-8455-210777-0004__VOICE__2094.wav"]}, "target_text": "I HAVE COME TO YOUR SHORES MISTER PRESIDENT WITH THE PURPOSE OF SEEING HOW THINGS ARE PROGRESSING IN THIS DISTANT QUARTER OF THE WORLD", "source_meta": {"key": "2094-142345-0058_8455-210777-0004__T2__SCV2TTS__8455-8455-210777-0004__VOICE__2094", "mixture_id": "2094-142345-0058_8455-210777-0004", "target_source": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/8455/210777/8455-210777-0004.flac", "target_spk": "8455", "target_utt": "8455-210777-0004", "target_text": "I HAVE COME TO YOUR SHORES MISTER PRESIDENT WITH THE PURPOSE OF SEEING HOW THINGS ARE PROGRESSING IN THIS DISTANT QUARTER OF THE WORLD", "original_interferer_source": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/2094/142345/2094-142345-0058.flac", "interferer_spk": "2094", "interferer_utt": "2094-142345-0058", "prompt_audio": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/2094/142345/2094-142345-0000.flac", "prompt_utt": "2094-142345-0000", "prompt_text": "IT IS A VERY FINE OLD PLACE OF RED BRICK SOFTENED BY A PALE POWDERY LICHEN WHICH HAS DISPERSED ITSELF WITH HAPPY IRREGULARITY SO AS TO BRING THE RED BRICK INTO TERMS OF FRIENDLY COMPANIONSHIP WITH THE LIMESTONE ORNAMENTS SURROUNDING THE THREE GABLES THE WINDOWS AND THE DOOR PLACE", "synthetic_interferer": "/data/tse_cue_project/manifests/librimix_similar_content_v2_tts/clean/test/synthetic_interferer/2094-142345-0058_8455-210777-0004__T2__SCV2TTS__8455-8455-210777-0004__VOICE__2094.wav"}, "sir_db": 0.0}

{"key": "2830-3980-0056_2961-961-0012__T1__SCV2TTS__2830-2830-3980-0056__VOICE__2961", "condition": "similar_content_v2_tts", "spk": ["2830", "2961"], "mix": {"default": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/mix_clean/2830-3980-0056_2961-961-0012__T1__SCV2TTS__2830-2830-3980-0056__VOICE__2961.wav"]}, "src": {"2830": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/s1/2830-3980-0056_2961-961-0012__T1__SCV2TTS__2830-2830-3980-0056__VOICE__2961.wav"], "2961": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/s2/2830-3980-0056_2961-961-0012__T1__SCV2TTS__2830-2830-3980-0056__VOICE__2961.wav"]}, "target_text": "OTHERWISE PAUL SHOULD HAVE WRITTEN GRACE FROM GOD THE FATHER AND PEACE FROM OUR LORD JESUS CHRIST", "source_meta": {"key": "2830-3980-0056_2961-961-0012__T1__SCV2TTS__2830-2830-3980-0056__VOICE__2961", "mixture_id": "2830-3980-0056_2961-961-0012", "target_source": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/2830/3980/2830-3980-0056.flac", "target_spk": "2830", "target_utt": "2830-3980-0056", "target_text": "OTHERWISE PAUL SHOULD HAVE WRITTEN GRACE FROM GOD THE FATHER AND PEACE FROM OUR LORD JESUS CHRIST", "original_interferer_source": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/2961/961/2961-961-0012.flac", "interferer_spk": "2961", "interferer_utt": "2961-961-0012", "prompt_audio": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/2961/960/2961-960-0000.flac", "prompt_utt": "2961-960-0000", "prompt_text": "HE PASSES ABRUPTLY FROM PERSONS TO IDEAS AND NUMBERS AND FROM IDEAS AND NUMBERS TO PERSONS FROM THE HEAVENS TO MAN FROM ASTRONOMY TO PHYSIOLOGY HE CONFUSES OR RATHER DOES NOT DISTINGUISH SUBJECT AND OBJECT FIRST AND FINAL CAUSES AND IS DREAMING OF GEOMETRICAL FIGURES LOST IN A FLUX OF SENSE", "synthetic_interferer": "/data/tse_cue_project/manifests/librimix_similar_content_v2_tts/clean/test/synthetic_interferer/2830-3980-0056_2961-961-0012__T1__SCV2TTS__2830-2830-3980-0056__VOICE__2961.wav"}, "sir_db": 0.0}
{"key": "2830-3980-0056_2961-961-0012__T2__SCV2TTS__2961-2961-961-0012__VOICE__2830", "condition": "similar_content_v2_tts", "spk": ["2961", "2830"], "mix": {"default": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/mix_clean/2830-3980-0056_2961-961-0012__T2__SCV2TTS__2961-2961-961-0012__VOICE__2830.wav"]}, "src": {"2961": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/s1/2830-3980-0056_2961-961-0012__T2__SCV2TTS__2961-2961-961-0012__VOICE__2830.wav"], "2830": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/s2/2830-3980-0056_2961-961-0012__T2__SCV2TTS__2961-2961-961-0012__VOICE__2830.wav"]}, "target_text": "FOR IN THE TIMES BEFORE THE GREAT FLOOD ATHENS WAS THE GREATEST AND BEST OF CITIES AND DID THE NOBLEST DEEDS AND HAD THE BEST CONSTITUTION OF ANY UNDER THE FACE OF HEAVEN", "source_meta": {"key": "2830-3980-0056_2961-961-0012__T2__SCV2TTS__2961-2961-961-0012__VOICE__2830", "mixture_id": "2830-3980-0056_2961-961-0012", "target_source": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/2961/961/2961-961-0012.flac", "target_spk": "2961", "target_utt": "2961-961-0012", "target_text": "FOR IN THE TIMES BEFORE THE GREAT FLOOD ATHENS WAS THE GREATEST AND BEST OF CITIES AND DID THE NOBLEST DEEDS AND HAD THE BEST CONSTITUTION OF ANY UNDER THE FACE OF HEAVEN", "original_interferer_source": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/2830/3980/2830-3980-0056.flac", "interferer_spk": "2830", "interferer_utt": "2830-3980-0056", "prompt_audio": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/2830/3979/2830-3979-0000.flac", "prompt_utt": "2830-3979-0000", "prompt_text": "WE WANT YOU TO HELP US PUBLISH SOME LEADING WORK OF LUTHER'S FOR THE GENERAL AMERICAN MARKET WILL YOU DO IT", "synthetic_interferer": "/data/tse_cue_project/manifests/librimix_similar_content_v2_tts/clean/test/synthetic_interferer/2830-3980-0056_2961-961-0012__T2__SCV2TTS__2961-2961-961-0012__VOICE__2830.wav"}, "sir_db": 0.0}
{"key": "908-31957-0009_2094-142345-0024__T1__SCV2TTS__908-908-31957-0009__VOICE__2094", "condition": "similar_content_v2_tts", "spk": ["908", "2094"], "mix": {"default": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/mix_clean/908-31957-0009_2094-142345-0024__T1__SCV2TTS__908-908-31957-0009__VOICE__2094.wav"]}, "src": {"908": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/s1/908-31957-0009_2094-142345-0024__T1__SCV2TTS__908-908-31957-0009__VOICE__2094.wav"], "2094": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/s2/908-31957-0009_2094-142345-0024__T1__SCV2TTS__908-908-31957-0009__VOICE__2094.wav"]}, "target_text": "AND THOUGH I HAVE GROWN SERENE AND STRONG SINCE THEN I THINK THAT GOD HAS WILLED A STILL RENEWABLE FEAR", "source_meta": {"key": "908-31957-0009_2094-142345-0024__T1__SCV2TTS__908-908-31957-0009__VOICE__2094", "mixture_id": "908-31957-0009_2094-142345-0024", "target_source": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/908/31957/908-31957-0009.flac", "target_spk": "908", "target_utt": "908-31957-0009", "target_text": "AND THOUGH I HAVE GROWN SERENE AND STRONG SINCE THEN I THINK THAT GOD HAS WILLED A STILL RENEWABLE FEAR", "original_interferer_source": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/2094/142345/2094-142345-0024.flac", "interferer_spk": "2094", "interferer_utt": "2094-142345-0024", "prompt_audio": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/2094/142345/2094-142345-0000.flac", "prompt_utt": "2094-142345-0000", "prompt_text": "IT IS A VERY FINE OLD PLACE OF RED BRICK SOFTENED BY A PALE POWDERY LICHEN WHICH HAS DISPERSED ITSELF WITH HAPPY IRREGULARITY SO AS TO BRING THE RED BRICK INTO TERMS OF FRIENDLY COMPANIONSHIP WITH THE LIMESTONE ORNAMENTS SURROUNDING THE THREE GABLES THE WINDOWS AND THE DOOR PLACE", "synthetic_interferer": "/data/tse_cue_project/manifests/librimix_similar_content_v2_tts/clean/test/synthetic_interferer/908-31957-0009_2094-142345-0024__T1__SCV2TTS__908-908-31957-0009__VOICE__2094.wav"}, "sir_db": 0.0}

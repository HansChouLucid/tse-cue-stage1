D BEHIND THE CURTAIN ON THE LEFT", "synthetic_interferer": "/data/tse_cue_project/manifests/librimix_similar_content_v2_tts/clean/test/synthetic_interferer/61-70968-0022_1221-135767-0011__T2__SCV2TTS__1221-1221-135767-0011__VOICE__61.wav"}, "sir_db": 0.0}

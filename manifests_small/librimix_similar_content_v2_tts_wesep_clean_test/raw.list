{"key": "2094-142345-0028_8455-210777-0038__T2__SCV2TTS__8455-8455-210777-0038__VOICE__2094", "condition": "similar_content_v2_tts", "spk": ["8455", "2094"], "mix": {"default": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/mix_clean/2094-142345-0028_8455-210777-0038__T2__SCV2TTS__8455-8455-210777-0038__VOICE__2094.wav"]}, "src": {"8455": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/s1/2094-142345-0028_8455-210777-0038__T2__SCV2TTS__8455-8455-210777-0038__VOICE__2094.wav"], "2094": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/s2/2094-142345-0028_8455-210777-0038__T2__SCV2TTS__8455-8455-210777-0038__VOICE__2094.wav"]}, "target_text": "THEREFORE I FEEL MYSELF QUITE ABLE AS PRESIDENT OF THIS REPUBLIC TO RECEIVE YOU WITH A COURTESY DUE TO THE SERVANTS OF A FRIENDLY ALLY", "source_meta": {"key": "2094-142345-0028_8455-210777-0038__T2__SCV2TTS__8455-8455-210777-0038__VOICE__2094", "mixture_id": "2094-142345-0028_8455-210777-0038", "target_source": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/8455/210777/8455-210777-0038.flac", "target_spk": "8455", "target_utt": "8455-210777-0038", "target_text": "THEREFORE I FEEL MYSELF QUITE ABLE AS PRESIDENT OF THIS REPUBLIC TO RECEIVE YOU WITH A COURTESY DUE TO THE SERVANTS OF A FRIENDLY ALLY", "original_interferer_source": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/2094/142345/2094-142345-0028.flac", "interferer_spk": "2094", "interferer_utt": "2094-142345-0028", "prompt_audio": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/2094/142345/2094-142345-0000.flac", "prompt_utt": "2094-142345-0000", "prompt_text": "IT IS A VERY FINE OLD PLACE OF RED BRICK SOFTENED BY A PALE POWDERY LICHEN WHICH HAS DISPERSED ITSELF WITH HAPPY IRREGULARITY SO AS TO BRING THE RED BRICK INTO TERMS OF FRIENDLY COMPANIONSHIP WITH THE LIMESTONE ORNAMENTS SURROUNDING THE THREE GABLES THE WINDOWS AND THE DOOR PLACE", "synthetic_interferer": "/data/tse_cue_project/manifests/librimix_similar_content_v2_tts/clean/test/synthetic_interferer/2094-142345-0028_8455-210777-0038__T2__SCV2TTS__8455-8455-210777-0038__VOICE__2094.wav"}, "sir_db": 0.0}

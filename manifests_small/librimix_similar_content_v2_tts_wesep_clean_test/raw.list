T RECAPTURED", "synthetic_interferer": "/data/tse_cue_project/manifests/librimix_similar_content_v2_tts/clean/test/synthetic_interferer/8555-284449-0018_8455-210777-0057__T2__SCV2TTS__8455-8455-210777-0057__VOICE__8555.wav"}, "sir_db": 0.0}

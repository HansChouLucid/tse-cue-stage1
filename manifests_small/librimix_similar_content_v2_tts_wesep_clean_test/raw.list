er": "/data/tse_cue_project/manifests/librimix_similar_content_v2_tts/clean/test/synthetic_interferer/908-31957-0022_1221-135766-0007__T1__SCV2TTS__908-908-31957-0022__VOICE__1221.wav"}, "sir_db": 0.0}

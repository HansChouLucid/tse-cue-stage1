E LITTLE FIR TREE", "synthetic_interferer": "/data/tse_cue_project/manifests/librimix_similar_content_v2_tts/clean/test/synthetic_interferer/7176-88083-0013_672-122797-0058__T1__SCV2TTS__7176-7176-88083-0013__VOICE__672.wav"}, "sir_db": 0.0}

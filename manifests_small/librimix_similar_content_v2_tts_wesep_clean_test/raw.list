RNAMENTS SURROUNDING THE THREE GABLES THE WINDOWS AND THE DOOR PLACE", "synthetic_interferer": "/data/tse_cue_project/manifests/librimix_similar_content_v2_tts/clean/test/synthetic_interferer/8455-210777-0019_2094-142345-0059__T1__SCV2TTS__8455-8455-210777-0019__VOICE__2094.wav"}, "sir_db": 0.0}

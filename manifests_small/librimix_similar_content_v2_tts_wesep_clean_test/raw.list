{"key": "7729-102255-0015_7127-75946-0012__T1__SCV2TTS__7729-7729-102255-0015__VOICE__7127", "condition": "similar_content_v2_tts", "spk": ["7729", "7127"], "mix": {"default": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/mix_clean/7729-102255-0015_7127-75946-0012__T1__SCV2TTS__7729-7729-102255-0015__VOICE__7127.wav"]}, "src": {"7729": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/s1/7729-102255-0015_7127-75946-0012__T1__SCV2TTS__7729-7729-102255-0015__VOICE__7127.wav"], "7127": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/s2/7729-102255-0015_7127-75946-0012__T1__SCV2TTS__7729-7729-102255-0015__VOICE__7127.wav"]}, "target_text": "ONE OF HIS MILITIA GENERALS SUGGESTED THAT THE GOVERNOR SHOULD REQUIRE THE OUTLAWS AT LAWRENCE AND ELSEWHERE TO SURRENDER THE SHARPS RIFLES ANOTHER WROTE ASKING HIM TO CALL OUT THE GOVERNMENT TROOPS AT FORT LEAVENWORTH", "source_meta": {"key": "7729-102255-0015_7127-75946-0012__T1__SCV2TTS__7729-7729-102255-0015__VOICE__7127", "mixture_id": "7729-102255-0015_7127-75946-0012", "target_source": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/7729/102255/7729-102255-0015.flac", "target_spk": "7729", "target_utt": "7729-102255-0015", "target_text": "ONE OF HIS MILITIA GENERALS SUGGESTED THAT THE GOVERNOR SHOULD REQUIRE THE OUTLAWS AT LAWRENCE AND ELSEWHERE TO SURRENDER THE SHARPS RIFLES ANOTHER WROTE ASKING HIM TO CALL OUT THE GOVERNMENT TROOPS AT FORT LEAVENWORTH", "original_interferer_source": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/7127/75946/7127-75946-0012.flac", "interferer_spk": "7127", "interferer_utt": "7127-75946-0012", "prompt_audio": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/7127/75946/7127-75946-0000.flac", "prompt_utt": "7127-75946-0000", "prompt_text": "AT THE CONCLUSION OF THE BANQUET WHICH WAS SERVED AT FIVE O'CLOCK THE KING ENTERED HIS CABINET WHERE HIS TAILORS WERE AWAITING HIM FOR THE PURPOSE OF TRYING ON THE CELEBRATED COSTUME REPRESENTING SPRING WHICH WAS THE RESULT OF SO MUCH IMAGINATION AND HAD COST SO MANY EFFORTS OF THOUGHT TO THE DESIGNERS AND ORNAMENT WORKERS OF THE COURT", "synthetic_interferer": "/data/tse_cue_project/manifests/librimix_similar_content_v2_tts/clean/test/synthetic_interferer/7729-102255-0015_7127-75946-0012__T1__SCV2TTS__7729-7729-102255-0015__VOICE__7127.wav"}, "sir_db": 0.0}

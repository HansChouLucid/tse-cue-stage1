ata/tse_cue_project/manifests/librimix_similar_content_v2_tts/clean/test/synthetic_interferer/8224-274384-0013_5639-40744-0012__T2__SCV2TTS__5639-5639-40744-0012__VOICE__8224.wav"}, "sir_db": 0.0}

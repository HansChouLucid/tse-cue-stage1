{"key": "8455-210777-0064_6829-68769-0048__T1__SCV2TTS__8455-8455-210777-0064__VOICE__6829", "condition": "similar_content_v2_tts", "spk": ["8455", "6829"], "mix": {"default": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/mix_clean/8455-210777-0064_6829-68769-0048__T1__SCV2TTS__8455-8455-210777-0064__VOICE__6829.wav"]}, "src": {"8455": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/s1/8455-210777-0064_6829-68769-0048__T1__SCV2TTS__8455-8455-210777-0064__VOICE__6829.wav"], "6829": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/s2/8455-210777-0064_6829-68769-0048__T1__SCV2TTS__8455-8455-210777-0064__VOICE__6829.wav"]}, "target_text": "AND I HAVE NO ONE READY TO WHOM I CAN GIVE UP THE ARCHIVES OF THE GOVERNMENT", "source_meta": {"key": "8455-210777-0064_6829-68769-0048__T1__SCV2TTS__8455-8455-210777-0064__VOICE__6829", "mixture_id": "8455-210777-0064_6829-68769-0048", "target_source": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/8455/210777/8455-210777-0064.flac", "target_spk": "8455", "target_utt": "8455-210777-0064", "target_text": "AND I HAVE NO ONE READY TO WHOM I CAN GIVE UP THE ARCHIVES OF THE GOVERNMENT", "original_interferer_source": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/6829/68769/6829-68769-0048.flac", "interferer_spk": "6829", "interferer_utt": "6829-68769-0048", "prompt_audio": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/6829/68769/6829-68769-0000.flac", "prompt_utt": "6829-68769-0000", "prompt_text": "KENNETH AND BETH REFRAINED FROM TELLING THE OTHER GIRLS OR UNCLE JOHN OF OLD WILL ROGERS'S VISIT BUT THEY GOT MISTER WATSON IN THE LIBRARY AND QUESTIONED HIM CLOSELY ABOUT THE PENALTY FOR FORGING A CHECK", "synthetic_interferer": "/data/tse_cue_project/manifests/librimix_similar_content_v2_tts/clean/test/synthetic_interferer/8455-210777-0064_6829-68769-0048__T1__SCV2TTS__8455-8455-210777-0064__VOICE__6829.wav"}, "sir_db": 0.0}
{"key": "8455-210777-0064_6829-68769-0048__T2__SCV2TTS__6829-6829-68769-0048__VOICE__8455", "condition": "similar_content_v2_tts", "spk": ["6829", "8455"], "mix": {"default": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/mix_clean/8455-210777-0064_6829-68769-0048__T2__SCV2TTS__6829-6829-68769-0048__VOICE__8455.wav"]}, "src": {"6829": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/s1/8455-210777-0064_6829-68769-0048__T2__SCV2TTS__6829-6829-68769-0048__VOICE__8455.wav"], "8455": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/s2/8455-210777-0064_6829-68769-0048__T2__SCV2TTS__6829-6829-68769-0048__VOICE__8455.wav"]}, "target_text": "GIVE ME A CHECK FOR A HUNDRED AND FIFTY AND I'LL TURN OVER TO YOU THE FORGED CHECK AND QUASH FURTHER PROCEEDINGS", "source_meta": {"key": "8455-210777-0064_6829-68769-0048__T2__SCV2TTS__6829-6829-68769-0048__VOICE__8455", "mixture_id": "8455-210777-0064_6829-68769-0048", "target_source": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/6829/68769/6829-68769-0048.flac", "target_spk": "6829", "target_utt": "6829-68769-0048", "target_text": "GIVE ME A CHECK FOR A HUNDRED AND FIFTY AND I'LL TURN OVER TO YOU THE FORGED CHECK AND QUASH FURTHER PROCEEDINGS", "original_interferer_source": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/8455/210777/8455-210777-0064.flac", "interferer_spk": "8455", "interferer_utt": "8455-210777-0064", "prompt_audio": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/8455/210777/8455-210777-0000.flac", "prompt_utt": "8455-210777-0000", "prompt_text": "I REMAINED THERE ALONE FOR MANY HOURS BUT I MUST ACKNOWLEDGE THAT BEFORE I LEFT THE CHAMBERS I HAD GRADUALLY BROUGHT MYSELF TO LOOK AT THE MATTER IN ANOTHER LIGHT", "synthetic_interferer": "/data/tse_cue_project/manifests/librimix_similar_content_v2_tts/clean/test/synthetic_interferer/8455-210777-0064_6829-68769-0048__T2__SCV2TTS__6829-6829-68769-0048__VOICE__8455.wav"}, "sir_db": 0.0}

{"key": "1580-141084-0011_7127-75946-0013__T1__SCV2TTS__1580-1580-141084-0011__VOICE__7127", "condition": "similar_content_v2_tts", "spk": ["1580", "7127"], "mix": {"default": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/mix_clean/1580-141084-0011_7127-75946-0013__T1__SCV2TTS__1580-1580-141084-0011__VOICE__7127.wav"]}, "src": {"1580": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/s1/1580-141084-0011_7127-75946-0013__T1__SCV2TTS__1580-1580-141084-0011__VOICE__7127.wav"], "7127": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/s2/1580-141084-0011_7127-75946-0013__T1__SCV2TTS__1580-1580-141084-0011__VOICE__7127.wav"]}, "target_text": "WHEN WE WERE OUT IN THE DARKNESS OF THE QUADRANGLE WE AGAIN LOOKED UP AT THE WINDOWS", "source_meta": {"key": "1580-141084-0011_7127-75946-0013__T1__SCV2TTS__1580-1580-141084-0011__VOICE__7127", "mixture_id": "1580-141084-0011_7127-75946-0013", "target_source": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/1580/141084/1580-141084-0011.flac", "target_spk": "1580", "target_utt": "1580-141084-0011", "target_text": "WHEN WE WERE OUT IN THE DARKNESS OF THE QUADRANGLE WE AGAIN LOOKED UP AT THE WINDOWS", "original_interferer_source": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/7127/75946/7127-75946-0013.flac", "interferer_spk": "7127", "interferer_utt": "7127-75946-0013", "prompt_audio": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/7127/75946/7127-75946-0000.flac", "prompt_utt": "7127-75946-0000", "prompt_text": "AT THE CONCLUSION OF THE BANQUET WHICH WAS SERVED AT FIVE O'CLOCK THE KING ENTERED HIS CABINET WHERE HIS TAILORS WERE AWAITING HIM FOR THE PURPOSE OF TRYING ON THE CELEBRATED COSTUME REPRESENTING SPRING WHICH WAS THE RESULT OF SO MUCH IMAGINATION AND HAD COST SO MANY EFFORTS OF THOUGHT TO THE DESIGNERS AND ORNAMENT WORKERS OF THE COURT", "synthetic_interferer": "/data/tse_cue_project/manifests/librimix_similar_content_v2_tts/clean/test/synthetic_interferer/1580-141084-0011_7127-75946-0013__T1__SCV2TTS__1580-1580-141084-0011__VOICE__7127.wav"}, "sir_db": 0.0}

ata/tse_cue_project/manifests/librimix_similar_content_v2_tts/clean/test/synthetic_interferer/237-134500-0024_1320-122617-0024__T2__SCV2TTS__1320-1320-122617-0024__VOICE__237.wav"}, "sir_db": 0.0}
{"key": "4992-41806-0008_6829-68771-0024__T1__SCV2TTS__4992-4992-41806-0008__VOICE__6829", "condition": "similar_content_v2_tts", "spk": ["4992", "6829"], "mix": {"default": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/mix_clean/4992-41806-0008_6829-68771-0024__T1__SCV2TTS__4992-4992-41806-0008__VOICE__6829.wav"]}, "src": {"4992": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/s1/4992-41806-0008_6829-68771-0024__T1__SCV2TTS__4992-4992-41806-0008__VOICE__6829.wav"], "6829": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/s2/4992-41806-0008_6829-68771-0024__T1__SCV2TTS__4992-4992-41806-0008__VOICE__6829.wav"]}, "target_text": "OLIVE HAS ANOTHER LOVELY GIFT FOR THE YELLOW HOUSE SAID MOTHER CAREY RISING AND TO CARRY OUT THE NEXT PART OF THE PROGRAMME WE SHALL HAVE TO GO IN PROCESSION UPSTAIRS TO MY BEDROOM", "source_meta": {"key": "4992-41806-0008_6829-68771-0024__T1__SCV2TTS__4992-4992-41806-0008__VOICE__6829", "mixture_id": "4992-41806-0008_6829-68771-0024", "target_source": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/4992/41806/4992-41806-0008.flac", "target_spk": "4992", "target_utt": "4992-41806-0008", "target_text": "OLIVE HAS ANOTHER LOVELY GIFT FOR THE YELLOW HOUSE SAID MOTHER CAREY RISING AND TO CARRY OUT THE NEXT PART OF THE PROGRAMME WE SHALL HAVE TO GO IN PROCESSION UPSTAIRS TO MY BEDROOM", "original_interferer_source": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/6829/68771/6829-68771-0024.flac", "interferer_spk": "6829", "interferer_utt": "6829-68771-0024", "prompt_audio": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/6829/68769/6829-68769-0000.flac", "prompt_utt": "6829-68769-0000", "prompt_text": "KENNETH AND BETH REFRAINED FROM TELLING THE OTHER GIRLS OR UNCLE JOHN OF OLD WILL ROGERS'S VISIT BUT THEY GOT MISTER WATSON IN THE LIBRARY AND QUESTIONED HIM CLOSELY ABOUT THE PENALTY FOR FORGING A CHECK", "synthetic_interferer": "/data/tse_cue_project/manifests/librimix_similar_content_v2_tts/clean/test/synthetic_interferer/4992-41806-0008_6829-68771-0024__T1__SCV2TTS__4992-4992-41806-0008__VOICE__6829.wav"}, "sir_db": 0.0}

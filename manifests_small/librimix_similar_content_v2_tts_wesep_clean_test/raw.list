/manifests/librimix_similar_content_v2_tts/clean/test/synthetic_interferer/2300-131720-0018_1188-133604-0018__T2__SCV2TTS__1188-1188-133604-0018__VOICE__2300.wav"}, "sir_db": 0.0}

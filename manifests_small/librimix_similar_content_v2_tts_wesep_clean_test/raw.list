ITH GOLD", "synthetic_interferer": "/data/tse_cue_project/manifests/librimix_similar_content_v2_tts/clean/test/synthetic_interferer/8555-284447-0017_1284-1180-0005__T1__SCV2TTS__8555-8555-284447-0017__VOICE__1284.wav"}, "sir_db": 0.0}

, "synthetic_interferer": "/data/tse_cue_project/manifests/librimix_similar_content_v2_tts/clean/test/synthetic_interferer/5683-32866-0027_5639-40744-0000__T2__SCV2TTS__5639-5639-40744-0000__VOICE__5683.wav"}, "sir_db": 0.0}

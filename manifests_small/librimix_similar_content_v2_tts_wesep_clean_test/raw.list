{"key": "3570-5696-0007_5639-40744-0024__T1__SCV2TTS__3570-3570-5696-0007__VOICE__5639", "condition": "similar_content_v2_tts", "spk": ["3570", "5639"], "mix": {"default": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/mix_clean/3570-5696-0007_5639-40744-0024__T1__SCV2TTS__3570-3570-5696-0007__VOICE__5639.wav"]}, "src": {"3570": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/s1/3570-5696-0007_5639-40744-0024__T1__SCV2TTS__3570-3570-5696-0007__VOICE__5639.wav"], "5639": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/s2/3570-5696-0007_5639-40744-0024__T1__SCV2TTS__3570-3570-5696-0007__VOICE__5639.wav"]}, "target_text": "THE USE OF THE WORD WASTE AS A TECHNICAL TERM THEREFORE IMPLIES NO DEPRECATION OF THE MOTIVES OR OF THE ENDS SOUGHT BY THE CONSUMER UNDER THIS CANON OF CONSPICUOUS WASTE", "source_meta": {"key": "3570-5696-0007_5639-40744-0024__T1__SCV2TTS__3570-3570-5696-0007__VOICE__5639", "mixture_id": "3570-5696-0007_5639-40744-0024", "target_source": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/3570/5696/3570-5696-0007.flac", "target_spk": "3570", "target_utt": "3570-5696-0007", "target_text": "THE USE OF THE WORD WASTE AS A TECHNICAL TERM THEREFORE IMPLIES NO DEPRECATION OF THE MOTIVES OR OF THE ENDS SOUGHT BY THE CONSUMER UNDER THIS CANON OF CONSPICUOUS WASTE", "original_interferer_source": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/5639/40744/5639-40744-0024.flac", "interferer_spk": "5639", "interferer_utt": "5639-40744-0024", "prompt_audio": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/5639/40744/5639-40744-0000.flac", "prompt_utt": "5639-40744-0000", "prompt_text": "ELEVEN O'CLOCK HAD STRUCK IT WAS A FINE CLEAR NIGHT THEY WERE THE ONLY PERSONS ON THE ROAD AND THEY SAUNTERED LEISURELY ALONG TO AVOID PAYING THE PRICE OF FATIGUE FOR THE RECREATION PROVIDED FOR THE TOLEDANS IN THEIR VALLEY OR ON THE BANKS OF THEIR RIVER", "synthetic_interferer": "/data/tse_cue_project/manifests/librimix_similar_content_v2_tts/clean/test/synthetic_interferer/3570-5696-0007_5639-40744-0024__T1__SCV2TTS__3570-3570-5696-0007__VOICE__5639.wav"}, "sir_db": 0.0}

{"key": "1995-1837-0027_1089-134686-0017__T2__SCV2TTS__1089-1089-134686-0017__VOICE__1995", "condition": "similar_content_v2_tts", "spk": ["1089", "1995"], "mix": {"default": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/mix_clean/1995-1837-0027_1089-134686-0017__T2__SCV2TTS__1089-1089-134686-0017__VOICE__1995.wav"]}, "src": {"1089": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/s1/1995-1837-0027_1089-134686-0017__T2__SCV2TTS__1089-1089-134686-0017__VOICE__1995.wav"], "1995": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/s2/1995-1837-0027_1089-134686-0017__T2__SCV2TTS__1089-1089-134686-0017__VOICE__1995.wav"]}, "target_text": "STEPHEN LEANING BACK AND DRAWING IDLY ON HIS SCRIBBLER LISTENED TO THE TALK ABOUT HIM WHICH HERON CHECKED FROM TIME TO TIME BY SAYING", "source_meta": {"key": "1995-1837-0027_1089-134686-0017__T2__SCV2TTS__1089-1089-134686-0017__VOICE__1995", "mixture_id": "1995-1837-0027_1089-134686-0017", "target_source": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/1089/134686/1089-134686-0017.flac", "target_spk": "1089", "target_utt": "1089-134686-0017", "target_text": "STEPHEN LEANING BACK AND DRAWING IDLY ON HIS SCRIBBLER LISTENED TO THE TALK ABOUT HIM WHICH HERON CHECKED FROM TIME TO TIME BY SAYING", "original_interferer_source": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/1995/1837/1995-1837-0027.flac", "interferer_spk": "1995", "interferer_utt": "1995-1837-0027", "prompt_audio": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/1995/1826/1995-1826-0000.flac", "prompt_utt": "1995-1826-0000", "prompt_text": "IN THE DEBATE BETWEEN THE SENIOR SOCIETIES HER DEFENCE OF THE FIFTEENTH AMENDMENT HAD BEEN NOT ONLY A NOTABLE BIT OF REASONING BUT DELIVERED WITH REAL ENTHUSIASM", "synthetic_interferer": "/data/tse_cue_project/manifests/librimix_similar_content_v2_tts/clean/test/synthetic_interferer/1995-1837-0027_1089-134686-0017__T2__SCV2TTS__1089-1089-134686-0017__VOICE__1995.wav"}, "sir_db": 0.0}

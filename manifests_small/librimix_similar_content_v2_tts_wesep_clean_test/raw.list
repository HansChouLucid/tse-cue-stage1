rer": "/data/tse_cue_project/manifests/librimix_similar_content_v2_tts/clean/test/synthetic_interferer/61-70970-0024_2961-961-0018__T1__SCV2TTS__61-61-70970-0024__VOICE__2961.wav"}, "sir_db": 0.0}

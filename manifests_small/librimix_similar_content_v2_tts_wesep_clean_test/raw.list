": 0.0}
{"key": "8230-279154-0026_672-122797-0020__T2__SCV2TTS__672-672-122797-0020__VOICE__8230", "condition": "similar_content_v2_tts", "spk": ["672", "8230"], "mix": {"default": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/mix_clean/8230-279154-0026_672-122797-0020__T2__SCV2TTS__672-672-122797-0020__VOICE__8230.wav"]}, "src": {"672": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/s1/8230-279154-0026_672-122797-0020__T2__SCV2TTS__672-672-122797-0020__VOICE__8230.wav"], "8230": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/s2/8230-279154-0026_672-122797-0020__T2__SCV2TTS__672-672-122797-0020__VOICE__8230.wav"]}, "target_text": "BUT THE TREE DID NOT REJOICE AT ALL HE GREW AND GREW AND WAS GREEN BOTH WINTER AND SUMMER", "source_meta": {"key": "8230-279154-0026_672-122797-0020__T2__SCV2TTS__672-672-122797-0020__VOICE__8230", "mixture_id": "8230-279154-0026_672-122797-0020", "target_source": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/672/122797/672-122797-0020.flac", "target_spk": "672", "target_utt": "672-122797-0020", "target_text": "BUT THE TREE DID NOT REJOICE AT ALL HE GREW AND GREW AND WAS GREEN BOTH WINTER AND SUMMER", "original_interferer_source": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/8230/279154/8230-279154-0026.flac", "interferer_spk": "8230", "interferer_utt": "8230-279154-0026", "prompt_audio": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/8230/279154/8230-279154-0000.flac", "prompt_utt": "8230-279154-0000", "prompt_text": "THE ANALYSIS OF KNOWLEDGE WILL OCCUPY US UNTIL THE END OF THE THIRTEENTH LECTURE AND IS THE MOST DIFFICULT PART OF OUR WHOLE ENTERPRISE", "synthetic_interferer": "/data/tse_cue_project/manifests/librimix_similar_content_v2_tts/clean/test/synthetic_interferer/8230-279154-0026_672-122797-0020__T2__SCV2TTS__672-672-122797-0020__VOICE__8230.wav"}, "sir_db": 0.0}
{"key": "5142-36377-0005_1221-135767-0022__T1__SCV2TTS__5142-5142-36377-0005__VOICE__1221", "condition": "similar_content_v2_tts", "spk": ["5142", "1221"], "mix": {"default": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/mix_clean/5142-36377-0005_1221-135767-0022__T1__SCV2TTS__5142-5142-36377-0005__VOICE__1221.wav"]}, "src": {"5142": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/s1/5142-36377-0005_1221-135767-0022__T1__SCV2TTS__5142-5142-36377-0005__VOICE__1221.wav"], "1221": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/s2/5142-36377-0005_1221-135767-0022__T1__SCV2TTS__5142-5142-36377-0005__VOICE__1221.wav"]}, "target_text": "THE DOOR OPENED AGAIN WHILE I WAS STILL STUDYING THE TWO BROTHERS WITHOUT I HONESTLY CONFESS BEING VERY FAVORABLY IMPRESSED BY EITHER OF THEM", "source_meta": {"key": "5142-36377-0005_1221-135767-0022__T1__SCV2TTS__5142-5142-36377-0005__VOICE__1221", "mixture_id": "5142-36377-0005_1221-135767-0022", "target_source": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/5142/36377/5142-36377-0005.flac", "target_spk": "5142", "target_utt": "5142-36377-0005", "target_text": "THE DOOR OPENED AGAIN WHILE I WAS STILL STUDYING THE TWO BROTHERS WITHOUT I HONESTLY CONFESS BEING VERY FAVORABLY IMPRESSED BY EITHER OF THEM", "original_interferer_source": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/1221/135767/1221-135767-0022.flac", "interferer_spk": "1221", "interferer_utt": "1221-135767-0022", "prompt_audio": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/1221/135766/1221-135766-0000.flac", "prompt_utt": "1221-135766-0000", "prompt_text": "HOW STRANGE IT SEEMED TO THE SAD WOMAN AS SHE WATCHED THE GROWTH AND THE BEAUTY THAT BECAME EVERY DAY MORE BRILLIANT AND THE INTELLIGENCE THAT THREW ITS QUIVERING SUNSHINE OVER THE TINY FEATURES OF THIS CHILD", "synthetic_interferer": "/data/tse_cue_project/manifests/librimix_similar_content_v2_tts/clean/test/synthetic_interferer/5142-36377-0005_1221-135767-0022__T1__SCV2TTS__5142-5142-36377-0005__VOICE__1221.wav"}, "sir_db": 0.0}
{"key": "5142-36377-0005_1221-135767-0022__T2__SCV2TTS__1221-1221-135767-0022__VOICE__5142", "condition": "similar_content_v2_tts", "spk": ["1221", "5142"], "mix": {"default": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/mix_clean/5142-36377-0005_1221-135767-0022__T2__SCV2TTS__1221-1221-135767-0022__VOICE__5142.wav"]}, "src": {"1221": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/s1/5142-36377-0005_1221-135767-0022__T2__SCV2TTS__1221-1221-135767-0022__VOICE__5142.wav"], "5142": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/s2/5142-36377-0005_1221-135767-0022__T2__SCV2TTS__1221-1221-135767-0022__VOICE__5142.wav"]}, "target_text": "BUT THE PROPRIETOR APPEARED ALREADY TO HAVE RELINQUISHED AS HOPELESS THE EFFORT TO PERPETUATE ON THIS SIDE OF THE ATLANTIC IN A HARD SOIL AND AMID THE CLOSE STRUGGLE FOR SUBSISTENCE THE NATIVE ENGLISH TASTE FOR ORNAMENTAL GARDENING", "source_meta": {"key": "5142-36377-0005_1221-135767-0022__T2__SCV2TTS__1221-1221-135767-0022__VOICE__5142", "mixture_id": "5142-36377-0005_1221-135767-0022", "target_source": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/1221/135767/1221-135767-0022.flac", "target_spk": "1221", "target_utt": "1221-135767-0022", "target_text": "BUT THE PROPRIETOR APPEARED ALREADY TO HAVE RELINQUISHED AS HOPELESS THE EFFORT TO PERPETUATE ON THIS SIDE OF THE ATLANTIC IN A HARD SOIL AND AMID THE CLOSE STRUGGLE FOR SUBSISTENCE THE NATIVE ENGLISH TASTE FOR ORNAMENTAL GARDENING", "original_interferer_source": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/5142/36377/5142-36377-0005.flac", "interferer_spk": "5142", "interferer_utt": "5142-36377-0005", "prompt_audio": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/5142/33396/5142-33396-0000.flac", "prompt_utt": "5142-33396-0000", "prompt_text": "AT ANOTHER TIME HARALD ASKED", "synthetic_interferer": "/data/tse_cue_project/manifests/librimix_similar_content_v2_tts/clean/test/synthetic_interferer/5142-36377-0005_1221-135767-0022__T2__SCV2TTS__1221-1221-135767-0022__VOICE__5142.wav"}, "sir_db": 0.0}

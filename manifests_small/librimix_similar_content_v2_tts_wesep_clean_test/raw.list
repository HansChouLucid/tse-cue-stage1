E DISTRESSED ROYALISTS", "synthetic_interferer": "/data/tse_cue_project/manifests/librimix_similar_content_v2_tts/clean/test/synthetic_interferer/8224-274384-0005_5639-40744-0021__T2__SCV2TTS__5639-5639-40744-0021__VOICE__8224.wav"}, "sir_db": 0.0}
{"key": "8555-284447-0006_908-31957-0021__T1__SCV2TTS__8555-8555-284447-0006__VOICE__908", "condition": "similar_content_v2_tts", "spk": ["8555", "908"], "mix": {"default": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/mix_clean/8555-284447-0006_908-31957-0021__T1__SCV2TTS__8555-8555-284447-0006__VOICE__908.wav"]}, "src": {"8555": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/s1/8555-284447-0006_908-31957-0021__T1__SCV2TTS__8555-8555-284447-0006__VOICE__908.wav"], "908": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/s2/8555-284447-0006_908-31957-0021__T1__SCV2TTS__8555-8555-284447-0006__VOICE__908.wav"]}, "target_text": "IN ONE PLACE AT THE HEAD OF THE ROOM WAS A RAISED PLATFORM FOR THE ROYAL FAMILY WITH ELEGANT THRONE CHAIRS FOR THE KING AND QUEEN AND SIX SMALLER BUT RICHLY UPHOLSTERED CHAIRS FOR THE SNUBNOSED PRINCESSES", "source_meta": {"key": "8555-284447-0006_908-31957-0021__T1__SCV2TTS__8555-8555-284447-0006__VOICE__908", "mixture_id": "8555-284447-0006_908-31957-0021", "target_source": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/8555/284447/8555-284447-0006.flac", "target_spk": "8555", "target_utt": "8555-284447-0006", "target_text": "IN ONE PLACE AT THE HEAD OF THE ROOM WAS A RAISED PLATFORM FOR THE ROYAL FAMILY WITH ELEGANT THRONE CHAIRS FOR THE KING AND QUEEN AND SIX SMALLER BUT RICHLY UPHOLSTERED CHAIRS FOR THE SNUBNOSED PRINCESSES", "original_interferer_source": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/908/31957/908-31957-0021.flac", "interferer_spk": "908", "interferer_utt": "908-31957-0021", "prompt_audio": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/908/157963/908-157963-0000.flac", "prompt_utt": "908-157963-0000", "prompt_text": "TO FADE AWAY LIKE MORNING BEAUTY FROM HER MORTAL DAY DOWN BY THE RIVER OF ADONA HER SOFT VOICE IS HEARD AND THUS HER GENTLE LAMENTATION FALLS LIKE MORNING DEW", "synthetic_interferer": "/data/tse_cue_project/manifests/librimix_similar_content_v2_tts/clean/test/synthetic_interferer/8555-284447-0006_908-31957-0021__T1__SCV2TTS__8555-8555-284447-0006__VOICE__908.wav"}, "sir_db": 0.0}

a/tse_cue_project/manifests/librimix_similar_content_v2_tts/clean/test/synthetic_interferer/1320-122612-0010_3570-5695-0003__T1__SCV2TTS__1320-1320-122612-0010__VOICE__3570.wav"}, "sir_db": 0.0}

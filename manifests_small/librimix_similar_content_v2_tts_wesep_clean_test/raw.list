{"key": "2830-3980-0048_8555-292519-0007__T1__SCV2TTS__2830-2830-3980-0048__VOICE__8555", "condition": "similar_content_v2_tts", "spk": ["2830", "8555"], "mix": {"default": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/mix_clean/2830-3980-0048_8555-292519-0007__T1__SCV2TTS__2830-2830-3980-0048__VOICE__8555.wav"]}, "src": {"2830": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/s1/2830-3980-0048_8555-292519-0007__T1__SCV2TTS__2830-2830-3980-0048__VOICE__8555.wav"], "8555": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/s2/2830-3980-0048_8555-292519-0007__T1__SCV2TTS__2830-2830-3980-0048__VOICE__8555.wav"]}, "target_text": "HE CAME DOWN TO EARTH LIVED AMONG MEN SUFFERED WAS CRUCIFIED AND THEN HE DIED STANDING CLEARLY BEFORE US SO THAT OUR HEARTS AND EYES MAY FASTEN UPON HIM", "source_meta": {"key": "2830-3980-0048_8555-292519-0007__T1__SCV2TTS__2830-2830-3980-0048__VOICE__8555", "mixture_id": "2830-3980-0048_8555-292519-0007", "target_source": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/2830/3980/2830-3980-0048.flac", "target_spk": "2830", "target_utt": "2830-3980-0048", "target_text": "HE CAME DOWN TO EARTH LIVED AMONG MEN SUFFERED WAS CRUCIFIED AND THEN HE DIED STANDING CLEARLY BEFORE US SO THAT OUR HEARTS AND EYES MAY FASTEN UPON HIM", "original_interferer_source": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/8555/292519/8555-292519-0007.flac", "interferer_spk": "8555", "interferer_utt": "8555-292519-0007", "prompt_audio": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/8555/284447/8555-284447-0000.flac", "prompt_utt": "8555-284447-0000", "prompt_text": "THEN HE RUSHED DOWN STAIRS INTO THE COURTYARD SHOUTING LOUDLY FOR HIS SOLDIERS AND THREATENING TO PATCH EVERYBODY IN HIS DOMINIONS IF THE SAILORMAN WAS NOT RECAPTURED", "synthetic_interferer": "/data/tse_cue_project/manifests/librimix_similar_content_v2_tts/clean/test/synthetic_interferer/2830-3980-0048_8555-292519-0007__T1__SCV2TTS__2830-2830-3980-0048__VOICE__8555.wav"}, "sir_db": 0.0}

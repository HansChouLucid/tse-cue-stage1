CULAR PLACE OR GIVE A CLUE AS TO THE PEOPLE CONCERNED", "synthetic_interferer": "/data/tse_cue_project/manifests/librimix_similar_content_v2_tts/clean/test/synthetic_interferer/2094-142345-0011_1580-141083-0001__T1__SCV2TTS__2094-2094-142345-0011__VOICE__1580.wav"}, "sir_db": 0.0}

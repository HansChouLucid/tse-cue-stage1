ata/tse_cue_project/manifests/librimix_similar_content_v2_tts/clean/test/synthetic_interferer/3570-5694-0015_6829-68771-0010__T2__SCV2TTS__6829-6829-68771-0010__VOICE__3570.wav"}, "sir_db": 0.0}

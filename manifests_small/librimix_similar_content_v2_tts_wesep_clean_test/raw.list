{"key": "260-123288-0002_2094-142345-0045__T1__SCV2TTS__260-260-123288-0002__VOICE__2094", "condition": "similar_content_v2_tts", "spk": ["260", "2094"], "mix": {"default": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/mix_clean/260-123288-0002_2094-142345-0045__T1__SCV2TTS__260-260-123288-0002__VOICE__2094.wav"]}, "src": {"260": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/s1/260-123288-0002_2094-142345-0045__T1__SCV2TTS__260-260-123288-0002__VOICE__2094.wav"], "2094": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/s2/260-123288-0002_2094-142345-0045__T1__SCV2TTS__260-260-123288-0002__VOICE__2094.wav"]}, "target_text": "THE ATMOSPHERE IS CHARGED WITH VAPOURS PERVADED WITH THE ELECTRICITY GENERATED BY THE EVAPORATION OF SALINE WATERS", "source_meta": {"key": "260-123288-0002_2094-142345-0045__T1__SCV2TTS__260-260-123288-0002__VOICE__2094", "mixture_id": "260-123288-0002_2094-142345-0045", "target_source": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/260/123288/260-123288-0002.flac", "target_spk": "260", "target_utt": "260-123288-0002", "target_text": "THE ATMOSPHERE IS CHARGED WITH VAPOURS PERVADED WITH THE ELECTRICITY GENERATED BY THE EVAPORATION OF SALINE WATERS", "original_interferer_source": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/2094/142345/2094-142345-0045.flac", "interferer_spk": "2094", "interferer_utt": "2094-142345-0045", "prompt_audio": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/2094/142345/2094-142345-0000.flac", "prompt_utt": "2094-142345-0000", "prompt_text": "IT IS A VERY FINE OLD PLACE OF RED BRICK SOFTENED BY A PALE POWDERY LICHEN WHICH HAS DISPERSED ITSELF WITH HAPPY IRREGULARITY SO AS TO BRING THE RED BRICK INTO TERMS OF FRIENDLY COMPANIONSHIP WITH THE LIMESTONE ORNAMENTS SURROUNDING THE THREE GABLES THE WINDOWS AND THE DOOR PLACE", "synthetic_interferer": "/data/tse_cue_project/manifests/librimix_similar_content_v2_tts/clean/test/synthetic_interferer/260-123288-0002_2094-142345-0045__T1__SCV2TTS__260-260-123288-0002__VOICE__2094.wav"}, "sir_db": 0.0}

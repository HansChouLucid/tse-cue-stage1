{"key": "1221-135766-0013_1284-1181-0013__T2__SCV2TTS__1284-1284-1181-0013__VOICE__1221", "condition": "similar_content_v2_tts", "spk": ["1284", "1221"], "mix": {"default": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/mix_clean/1221-135766-0013_1284-1181-0013__T2__SCV2TTS__1284-1284-1181-0013__VOICE__1221.wav"]}, "src": {"1284": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/s1/1221-135766-0013_1284-1181-0013__T2__SCV2TTS__1284-1284-1181-0013__VOICE__1221.wav"], "1221": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/s2/1221-135766-0013_1284-1181-0013__T2__SCV2TTS__1284-1284-1181-0013__VOICE__1221.wav"]}, "target_text": "OJO BECAME A BIT UNEASY AT THIS FOR HE HAD ALREADY PUT QUITE A LOT OF THE CLEVERNESS POWDER IN THE DISH BUT HE DARED NOT INTERFERE AND SO HE COMFORTED HIMSELF WITH THE THOUGHT THAT ONE CANNOT HAVE TOO MUCH CLEVERNESS", "source_meta": {"key": "1221-135766-0013_1284-1181-0013__T2__SCV2TTS__1284-1284-1181-0013__VOICE__1221", "mixture_id": "1221-135766-0013_1284-1181-0013", "target_source": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/1284/1181/1284-1181-0013.flac", "target_spk": "1284", "target_utt": "1284-1181-0013", "target_text": "OJO BECAME A BIT UNEASY AT THIS FOR HE HAD ALREADY PUT QUITE A LOT OF THE CLEVERNESS POWDER IN THE DISH BUT HE DARED NOT INTERFERE AND SO HE COMFORTED HIMSELF WITH THE THOUGHT THAT ONE CANNOT HAVE TOO MUCH CLEVERNESS", "original_interferer_source": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/1221/135766/1221-135766-0013.flac", "interferer_spk": "1221", "interferer_utt": "1221-135766-0013", "prompt_audio": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/1221/135766/1221-135766-0000.flac", "prompt_utt": "1221-135766-0000", "prompt_text": "HOW STRANGE IT SEEMED TO THE SAD WOMAN AS SHE WATCHED THE GROWTH AND THE BEAUTY THAT BECAME EVERY DA
{"key": "1995-1837-0001_672-122797-0001__T2__SCV2TTS__672-672-122797-0001__VOICE__1995", "condition": "similar_content_v2_tts", "spk": ["672", "1995"], "mix": {"default": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/mix_clean/1995-1837-0001_672-122797-0001__T2__SCV2TTS__672-672-122797-0001__VOICE__1995.wav"]}, "src": {"672": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/s1/1995-1837-0001_672-122797-0001__T2__SCV2TTS__672-672-122797-0001__VOICE__1995.wav"], "1995": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/s2/1995-1837-0001_672-122797-0001__T2__SCV2TTS__672-672-122797-0001__VOICE__1995.wav"]}, "target_text": "THE PLACE HE HAD WAS A VERY GOOD ONE THE SUN SHONE ON HIM AS TO FRESH AIR THERE WAS ENOUGH OF THAT AND ROUND HIM GREW MANY LARGE SIZED COMRADES PINES AS WELL AS FIRS", "source_meta": {"key": "1995-1837-0001_672-122797-0001__T2__SCV2TTS__672-672-122797-0001__VOICE__1995", "mixture_id": "1995-1837-0001_672-122797-0001", "target_source": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/672/122797/672-122797-0001.flac", "target_spk": "672", "target_utt": "672-122797-0001", "target_text": "THE PLACE HE HAD WAS A VERY GOOD ONE THE SUN SHONE ON HIM AS TO FRESH AIR THERE WAS ENOUGH OF THAT AND ROUND HIM GREW MANY LARGE SIZED COMRADES PINES AS WELL AS FIRS", "original_interferer_source": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/1995/1837/1995-1837-0001.flac", "interferer_spk": "1995", "interferer_utt": "1995-1837-0001", "prompt_audio": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/1995/1826/1995-1826-0000.flac", "prompt_utt": "1995-1826-0000", "prompt_text": "IN THE DEBATE BETWEEN THE SENIOR SOCIETIES HER DEFENCE OF THE FIFTEENTH AMENDMENT HAD BEEN NOT ONLY A NOTABLE BIT OF REASONING BUT DELIVERED WITH REAL ENTHUSIASM", "synthetic_interferer": "/data/tse_cue_project/manifests/librimix_similar_content_v2_tts/clean/test/synthetic_interferer/1995-1837-0001_672-122797-0001__T2__SCV2TTS__672-672-122797-0001__VOICE__1995.wav"}, "sir_db": 0.0}

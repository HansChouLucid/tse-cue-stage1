ELIVERED WITH REAL ENTHUSIASM", "synthetic_interferer": "/data/tse_cue_project/manifests/librimix_similar_content_v2_tts/clean/test/synthetic_interferer/1995-1826-0017_5639-40744-0001__T2__SCV2TTS__5639-5639-40744-0001__VOICE__1995.wav"}, "sir_db": 0.0}

cue_project/manifests/librimix_similar_content_v2_tts/clean/test/synthetic_interferer/237-134500-0003_1188-133604-0041__T2__SCV2TTS__1188-1188-133604-0041__VOICE__237.wav"}, "sir_db": 0.0}

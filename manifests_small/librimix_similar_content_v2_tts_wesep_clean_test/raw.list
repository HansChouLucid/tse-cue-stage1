{"key": "2094-142345-0012_4446-2275-0026__T2__SCV2TTS__4446-4446-2275-0026__VOICE__2094", "condition": "similar_content_v2_tts", "spk": ["4446", "2094"], "mix": {"default": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/mix_clean/2094-142345-0012_4446-2275-0026__T2__SCV2TTS__4446-4446-2275-0026__VOICE__2094.wav"]}, "src": {"4446": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/s1/2094-142345-0012_4446-2275-0026__T2__SCV2TTS__4446-4446-2275-0026__VOICE__2094.wav"], "2094": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/s2/2094-142345-0012_4446-2275-0026__T2__SCV2TTS__4446-4446-2275-0026__VOICE__2094.wav"]}, "target_text": "SHE CLOSED HER EYES AND TOOK A DEEP BREATH AS IF TO DRAW IN AGAIN THE FRAGRANCE OF THOSE DAYS", "source_meta": {"key": "2094-142345-0012_4446-2275-0026__T2__SCV2TTS__4446-4446-2275-0026__VOICE__2094", "mixture_id": "2094-142345-0012_4446-2275-0026", "target_source": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/4446/2275/4446-2275-0026.flac", "target_spk": "4446", "target_utt": "4446-2275-0026", "target_text": "SHE CLOSED HER EYES AND TOOK A DEEP BREATH AS IF TO DRAW IN AGAIN THE FRAGRANCE OF THOSE DAYS", "original_interferer_source": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/2094/142345/2094-142345-0012.flac", "interferer_spk": "2094", "interferer_utt": "2094-142345-0012", "prompt_audio": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/2094/142345/2094-142345-0000.flac", "prompt_utt": "2094-142345-0000", "prompt_text": "IT IS A VERY FINE OLD PLACE OF RED BRICK SOFTENED BY A PALE POWDERY LICHEN WHICH HAS DISPERSED ITSELF WITH HAPPY IRREGULARITY SO AS TO BRING THE RED BRICK INTO TERMS OF FRIENDLY COMPANIONSHIP WITH THE LIMESTONE ORNAMENTS SURROUNDING THE THREE GABLES THE WINDOWS AND THE DOOR PLACE", "synthetic_interferer": "/data/tse_cue_project/manifests/librimix_similar_content_v2_tts/clean/test/synthetic_interferer/2094-142345-0012_4446-2275-0026__T2__SCV2TTS__4446-4446-2275-0026__VOICE__2094.wav"}, "sir_db": 0.0}
{"key": "6930-81414-0000_1320-122612-0012__T1__SCV2TTS__6930-6930-81414-0000__VOICE__1320", "condition": "similar_content_v2_tts", "spk": ["6930", "1320"], "mix": {"default": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/mix_clean/6930-81414-0000_1320-122612-0012__T1__SCV2TTS__6930-6930-81414-0000__VOICE__1320.wav"]}, "src": {"6930": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/s1/6930-81414-0000_1320-122612-0012__T1__SCV2TTS__6930-6930-81414-0000__VOICE__1320.wav"], "1320": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/s2/6930-81414-0000_1320-122612-0012__T1__SCV2TTS__6930-6930-81414-0000__VOICE__1320.wav"]}, "target_text": "NO WORDS WERE SPOKEN NO LANGUAGE WAS UTTERED SAVE THAT OF WAILING AND HISSING AND THAT SOMEHOW WAS INDISTINCT AS IF IT EXISTED IN FANCY AND NOT IN REALITY", "source_meta": {"key": "6930-81414-0000_1320-122612-0012__T1__SCV2TTS__6930-6930-81414-0000__VOICE__1320", "mixture_id": "6930-81414-0000_1320-122612-0012", "target_source": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/6930/81414/6930-81414-0000.flac", "target_spk": "6930", "target_utt": "6930-81414-0000", "target_text": "NO WORDS WERE SPOKEN NO LANGUAGE WAS UTTERED SAVE THAT OF WAILING AND HISSING AND THAT SOMEHOW WAS INDISTINCT AS IF IT EXISTED IN FANCY AND NOT IN REALITY", "original_interferer_source": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/1320/122612/1320-122612-0012.flac", "interferer_spk": "1320", "interferer_utt": "1320-122612-0012", "prompt_audio": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/1320/122612/1320-122612-0000.flac", "prompt_utt": "1320-122612-0000", "prompt_text": "SINCE THE PERIOD OF OUR TALE THE ACTIVE SPIRIT OF THE COUNTRY HAS SURROUNDED IT WITH A BELT OF RICH AND THRIVING SETTLEMENTS THOUGH NONE BUT THE HUNTER OR THE SAVAGE IS EVER KNOWN EVEN NOW TO PENETRATE ITS WILD RECESSES", "synthetic_interferer": "/data/tse_cue_project/manifests/librimix_similar_content_v2_tts/clean/test/synthetic_interferer/6930-81414-0000_1320-122612-0012__T1__SCV2TTS__6930-6930-81414-0000__VOICE__1320.wav"}, "sir_db": 0.0}
{"key": "6930-81414-0000_1320-122612-0012__T2__SCV2TTS__1320-1320-122612-0012__VOICE__6930", "condition": "similar_content_v2_tts", "spk": ["1320", "6930"], "mix": {"default": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/mix_clean/6930-81414-0000_1320-122612-0012__T2__SCV2TTS__1320-1320-122612-0012__VOICE__6930.wav"]}, "src": {"1320": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/s1/6930-81414-0000_1320-122612-0012__T2__SCV2TTS__1320-1320-122612-0012__VOICE__6930.wav"], "6930": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/s2/6930-81414-0000_1320-122612-0012__T2__SCV2TTS__1320-1320-122612-0012__VOICE__6930.wav"]}, "target_text": "EXTINGUISHED BRANDS WERE LYING AROUND A SPRING THE OFFALS OF A DEER WERE SCATTERED ABOUT THE PLACE AND THE TREES BORE EVIDENT MARKS OF HAVING BEEN BROWSED BY THE HORSES", "source_meta": {"key": "6930-81414-0000_1320-122612-0012__T2__SCV2TTS__1320-1320-122612-0012__VOICE__6930", "mixture_id": "6930-81414-0000_1320-122612-0012", "target_source": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/1320/122612/1320-122612-0012.flac", "target_spk": "1320", "target_utt": "1320-122612-0012", "target_text": "EXTINGUISHED BRANDS WERE LYING AROUND A SPRING THE OFFALS OF A DEER WERE SCATTERED ABOUT THE PLACE AND THE TREES BORE EVIDENT MARKS OF HAVING BEEN BROWSED BY THE HORSES", "original_interferer_source": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/6930/81414/6930-81414-0000.flac", "interferer_spk": "6930", "interferer_utt": "6930-81414-0000", "prompt_audio": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/6930/75918/6930-75918-0000.flac", "prompt_utt": "6930-75918-0000", "prompt_text": "CONCORD RETURNED TO ITS PLACE AMIDST THE TENTS", "synthetic_interferer": "/data/tse_cue_project/manifests/librimix_similar_content_v2_tts/clean/test/synthetic_interferer/6930-81414-0000_1320-122612-0012__T2__SCV2TTS__1320-1320-122612-0012__VOICE__6930.wav"}, "sir_db": 0.0}

an/4992/23283/4992-23283-0000.flac", "prompt_utt": "4992-23283-0000", "prompt_text": "BUT THE MORE FORGETFULNESS HAD THEN PREVAILED THE MORE POWERFUL WAS THE FORCE OF REMEMBRANCE WHEN SHE AWOKE", "synthetic_interferer": "/data/tse_cue_project/manifests/librimix_similar_content_v2_tts/clean/test/synthetic_interferer/4992-41806-0009_3570-5696-0001__T2__SCV2TTS__3570-3570-5696-0001__VOICE__4992.wav"}, "sir_db": 0.0}

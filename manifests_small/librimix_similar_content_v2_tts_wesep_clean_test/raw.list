project/manifests/librimix_similar_content_v2_tts/clean/test/synthetic_interferer/3570-5695-0011_8455-210777-0058__T1__SCV2TTS__3570-3570-5695-0011__VOICE__8455.wav"}, "sir_db": 0.0}

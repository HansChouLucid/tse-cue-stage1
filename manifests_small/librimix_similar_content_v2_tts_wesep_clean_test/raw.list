c_interferer": "/data/tse_cue_project/manifests/librimix_similar_content_v2_tts/clean/test/synthetic_interferer/237-126133-0024_8555-284449-0003__T2__SCV2TTS__8555-8555-284449-0003__VOICE__237.wav"}, "sir_db": 0.0}

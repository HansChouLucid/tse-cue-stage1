{"key": "1580-141083-0046_908-157963-0012__T2__SCV2TTS__908-908-157963-0012__VOICE__1580", "condition": "similar_content_v2_tts", "spk": ["908", "1580"], "mix": {"default": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/mix_clean/1580-141083-0046_908-157963-0012__T2__SCV2TTS__908-908-157963-0012__VOICE__1580.wav"]}, "src": {"908": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/s1/1580-141083-0046_908-157963-0012__T2__SCV2TTS__908-908-157963-0012__VOICE__1580.wav"], "1580": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/s2/1580-141083-0046_908-157963-0012__T2__SCV2TTS__908-908-157963-0012__VOICE__1580.wav"]}, "target_text": "BUT THEL IS LIKE A FAINT CLOUD KINDLED AT THE RISING SUN I VANISH FROM MY PEARLY THRONE AND WHO SHALL FIND MY PLACE", "source_meta": {"key": "1580-141083-0046_908-157963-0012__T2__SCV2TTS__908-908-157963-0012__VOICE__1580", "mixture_id": "1580-141083-0046_908-157963-0012", "target_source": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/908/157963/908-157963-0012.flac", "target_spk": "908", "target_utt": "908-157963-0012", "target_text": "BUT THEL IS LIKE A FAINT CLOUD KINDLED AT THE RISING SUN I VANISH FROM MY PEARLY THRONE AND WHO SHALL FIND MY PLACE", "original_interferer_source": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/1580/141083/1580-141083-0046.flac", "interferer_spk": "1580", "interferer_utt": "1580-141083-0046", "prompt_audio": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/1580/141083/1580-141083-0000.flac", "prompt_utt": "1580-141083-0000", "prompt_text": "I WILL ENDEAVOUR IN MY STATEMENT TO AVOID SUCH TERMS AS WOULD SERVE TO LIMIT THE EVENTS TO ANY PARTICULAR PLACE OR GIVE A CLUE AS TO THE PEOPLE CONCERNED", "synthetic_interferer": "/data/tse_cue_project/manifests/librimix_similar_content_v2_tts/clean/test/synthetic_interferer/1580-141083-0046_908-157963-0012__T2__SCV2TTS__908-908-157963-0012__VOICE__1580.wav"}, "sir_db": 0.0}

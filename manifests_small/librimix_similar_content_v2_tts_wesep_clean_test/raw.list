{"key": "3570-5694-0002_61-70968-0032__T1__SCV2TTS__3570-3570-5694-0002__VOICE__61", "condition": "similar_content_v2_tts", "spk": ["3570", "61"], "mix": {"default": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/mix_clean/3570-5694-0002_61-70968-0032__T1__SCV2TTS__3570-3570-5694-0002__VOICE__61.wav"]}, "src": {"3570": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/s1/3570-5694-0002_61-70968-0032__T1__SCV2TTS__3570-3570-5694-0002__VOICE__61.wav"], "61": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/s2/3570-5694-0002_61-70968-0032__T1__SCV2TTS__3570-3570-5694-0002__VOICE__61.wav"]}, "target_text": "SUCH CONSUMPTION AS FALLS TO THE WOMEN IS MERELY INCIDENTAL TO THEIR WORK IT IS A MEANS TO THEIR CONTINUED LABOUR AND NOT A CONSUMPTION DIRECTED TO THEIR OWN COMFORT AND FULNESS OF LIFE", "source_meta": {"key": "3570-5694-0002_61-70968-0032__T1__SCV2TTS__3570-3570-5694-0002__VOICE__61", "mixture_id": "3570-5694-0002_61-70968-0032", "target_source": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/3570/5694/3570-5694-0002.flac", "target_spk": "3570", "target_utt": "3570-5694-0002", "target_text": "SUCH CONSUMPTION AS FALLS TO THE WOMEN IS MERELY INCIDENTAL TO THEIR WORK IT IS A MEANS TO THEIR CONTINUED LABOUR AND NOT A CONSUMPTION DIRECTED TO THEIR OWN COMFORT AND FULNESS OF LIFE", "original_interferer_source": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/61/70968/61-70968-0032.flac", "interferer_spk": "61", "interferer_utt": "61-70968-0032", "prompt_audio": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/61/70968/61-70968-0000.flac", "prompt_utt": "61-70968-0000", "prompt_text": "HE BEGAN A CONFUSED COMPLAINT AGAINST THE WIZARD WHO HAD VANISHED BEHIND THE CURTAIN ON THE LEFT", "synthetic_interferer": "/data/tse_cue_project/manifests/librimix_similar_content_v2_tts/clean/test/synthetic_interferer/3570-5694-0002_61-70968-0032__T1__SCV2TTS__3570-3570-5694-0002__VOICE__61.wav"}, "sir_db": 0.0}
{"key": "3570-5694-0002_61-70968-0032__T2__SCV2TTS__61-61-70968-0032__VOICE__3570", "condition": "similar_content_v2_tts", "spk": ["61", "3570"], "mix": {"default": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/mix_clean/3570-5694-0002_61-70968-0032__T2__SCV2TTS__61-61-70968-0032__VOICE__3570.wav"]}, "src": {"61": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/s1/3570-5694-0002_61-70968-0032__T2__SCV2TTS__61-61-70968-0032__VOICE__3570.wav"], "3570": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/s2/3570-5694-0002_61-70968-0032__T2__SCV2TTS__61-61-70968-0032__VOICE__3570.wav"]}, "target_text": "HE FELT FOR AND FOUND THE WIZARD'S BLACK CLOTH THE SQUIRE WAS QUITE OUT OF BREATH", "source_meta": {"key": "3570-5694-0002_61-70968-0032__T2__SCV2TTS__61-61-70968-0032__VOICE__3570", "mixture_id": "3570-5694-0002_61-70968-0032", "target_source": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/61/70968/61-70968-0032.flac", "target_spk": "61", "target_utt": "61-70968-0032", "target_text": "HE FELT FOR AND FOUND THE WIZARD'S BLACK CLOTH THE SQUIRE WAS QUITE OUT OF BREATH", "original_interferer_source": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/3570/5694/3570-5694-0002.flac", "interferer_spk": "3570", "interferer_utt": "3570-5694-0002", "prompt_audio": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/3570/5694/3570-5694-0000.flac", "prompt_utt": "3570-5694-0000", "prompt_text": "BUT ALREADY AT A POINT IN ECONOMIC EVOLUTION FAR ANTEDATING THE EMERGENCE OF THE LADY SPECIALISED CONSUMPTION OF GOODS AS AN EVIDENCE OF PECUNIARY STRENGTH HAD BEGUN TO WORK OUT IN A MORE OR LESS ELABORATE SYSTEM", "synthetic_interferer": "/data/tse_cue_project/manifests/librimix_similar_content_v2_tts/clean/test/synthetic_interferer/3570-5694-0002_61-70968-0032__T2__SCV2TTS__61-61-70968-0032__VOICE__3570.wav"}, "sir_db": 0.0}

e_cue_project/manifests/librimix_similar_content_v2_tts/clean/test/synthetic_interferer/3570-5694-0008_237-126133-0023__T1__SCV2TTS__3570-3570-5694-0008__VOICE__237.wav"}, "sir_db": 0.0}

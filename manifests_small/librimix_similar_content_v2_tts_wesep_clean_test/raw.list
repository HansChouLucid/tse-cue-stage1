{"key": "8455-210777-0058_1188-133604-0039__T2__SCV2TTS__1188-1188-133604-0039__VOICE__8455", "condition": "similar_content_v2_tts", "spk": ["1188", "8455"], "mix": {"default": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/mix_clean/8455-210777-0058_1188-133604-0039__T2__SCV2TTS__1188-1188-133604-0039__VOICE__8455.wav"]}, "src": {"1188": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/s1/8455-210777-0058_1188-133604-0039__T2__SCV2TTS__1188-1188-133604-0039__VOICE__8455.wav"], "8455": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/s2/8455-210777-0058_1188-133604-0039__T2__SCV2TTS__1188-1188-133604-0039__VOICE__8455.wav"]}, "target_text": "IT HAS NO BEAUTY WHATSOEVER NO SPECIALTY OF PICTURESQUENESS AND ALL ITS LINES ARE CRAMPED AND POOR", "source_meta": {"key": "8455-210777-0058_1188-133604-0039__T2__SCV2TTS__1188-1188-133604-0039__VOICE__8455", "mixture_id": "8455-210777-0058_1188-133604-0039", "target_source": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/1188/133604/1188-133604-0039.flac", "target_spk": "1188", "target_utt": "1188-133604-0039", "target_text": "IT HAS NO BEAUTY WHATSOEVER NO SPECIALTY OF PICTURESQUENESS AND ALL ITS LINES ARE CRAMPED AND POOR", "original_interferer_source": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/8455/210777/8455-210777-0058.flac", "interferer_spk": "8455", "interferer_utt": "8455-210777-0058", "prompt_audio": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/8455/210777/8455-210777-0000.flac", "prompt_utt": "8455-210777-0000", "prompt_text": "I REMAINED THERE ALONE FOR MANY HOURS BUT I MUST ACKNOWLEDGE THAT BEFORE I LEFT THE CHAMBERS I HAD GRADUALLY BROUGHT MYSELF TO LOOK AT THE MATTER IN ANOTHER LIGHT", "synthetic_interferer": "/data/tse_cue_project/manifests/librimix_similar_content_v2_tts/clean/test/synthetic_interferer/8455-210777-0058_1188-133604-0039__T2__SCV2TTS__1188-1188-133604-0039__VOICE__8455.wav"}, "sir_db": 0.0}

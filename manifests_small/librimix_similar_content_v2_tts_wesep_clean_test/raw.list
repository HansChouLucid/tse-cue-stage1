{"key": "4992-41797-0002_1089-134691-0002__T2__SCV2TTS__1089-1089-134691-0002__VOICE__4992", "condition": "similar_content_v2_tts", "spk": ["1089", "4992"], "mix": {"default": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/mix_clean/4992-41797-0002_1089-134691-0002__T2__SCV2TTS__1089-1089-134691-0002__VOICE__4992.wav"]}, "src": {"1089": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/s1/4992-41797-0002_1089-134691-0002__T2__SCV2TTS__1089-1089-134691-0002__VOICE__4992.wav"], "4992": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/s2/4992-41797-0002_1089-134691-0002__T2__SCV2TTS__1089-1089-134691-0002__VOICE__4992.wav"]}, "target_text": "HE SET OFF ABRUPTLY FOR THE BULL WALKING RAPIDLY LEST HIS FATHER'S SHRILL WHISTLE MIGHT CALL HIM BACK AND IN A FEW MOMENTS HE HAD ROUNDED THE CURVE AT THE POLICE BARRACK AND WAS SAFE", "source_meta": {"key": "4992-41797-0002_1089-134691-0002__T2__SCV2TTS__1089-1089-134691-0002__VOICE__4992", "mixture_id": "4992-41797-0002_1089-134691-0002", "target_source": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/1089/134691/1089-134691-0002.flac", "target_spk": "1089", "target_utt": "1089-134691-0002", "target_text": "HE SET OFF ABRUPTLY FOR THE BULL WALKING RAPIDLY LEST HIS FATHER'S SHRILL WHISTLE MIGHT CALL HIM BACK AND IN A FEW MOMENTS HE HAD ROUNDED THE CURVE AT THE POLICE BARRACK AND WAS SAFE", "original_interferer_source": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/4992/41797/4992-41797-0002.flac", "interferer_spk": "4992", "interferer_utt": "4992-41797-0002", "prompt_audio": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/4992/23283/4992-23283-0000.flac", "prompt_utt": "4992-23283-0000", "prompt_text": "BUT THE MORE FORGETFULNESS HAD THEN PREVAILED THE MORE POWERFUL WAS THE FORCE OF REMEMBRANCE WHEN SHE AWOKE", "synthetic_interferer": "/data/tse_cue_pro
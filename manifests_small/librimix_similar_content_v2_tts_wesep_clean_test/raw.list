{"key": "61-70970-0031_1320-122617-0000__T1__SCV2TTS__61-61-70970-0031__VOICE__1320", "condition": "similar_content_v2_tts", "spk": ["61", "1320"], "mix": {"default": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/mix_clean/61-70970-0031_1320-122617-0000__T1__SCV2TTS__61-61-70970-0031__VOICE__1320.wav"]}, "src": {"61": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/s1/61-70970-0031_1320-122617-0000__T1__SCV2TTS__61-61-70970-0031__VOICE__1320.wav"], "1320": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/s2/61-70970-0031_1320-122617-0000__T1__SCV2TTS__61-61-70970-0031__VOICE__1320.wav"]}, "target_text": "CRIED HE WAVING THE LANTHORN BEFORE HIM TO MAKE SURE THAT THESE WERE NO GHOSTS IN FRONT OF HIM", "source_meta": {"key": "61-70970-0031_1320-122617-0000__T1__SCV2TTS__61-61-70970-0031__VOICE__1320", "mixture_id": "61-70970-0031_1320-122617-0000", "target_source": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/61/70970/61-70970-0031.flac", "target_spk": "61", "target_utt": "61-70970-0031", "target_text": "CRIED HE WAVING THE LANTHORN BEFORE HIM TO MAKE SURE THAT THESE WERE NO GHOSTS IN FRONT OF HIM", "original_interferer_source": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/1320/122617/1320-122617-0000.flac", "interferer_spk": "1320", "interferer_utt": "1320-122617-0000", "prompt_audio": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/1320/122612/1320-122612-0000.flac", "prompt_utt": "1320-122612-0000", "prompt_text": "SINCE THE PERIOD OF OUR TALE THE ACTIVE SPIRIT OF THE COUNTRY HAS SURROUNDED IT WITH A BELT OF RICH AND THRIVING SETTLEMENTS THOUGH NONE BUT THE HUNTER OR THE SAVAGE IS EVER KNOWN EVEN NOW TO PENETRATE ITS WILD RECESSES", "synthetic_interferer": "/data/tse_cue_project/manifests/librimix_similar_content_v2_tts/clean/test/synthetic_interferer/61-70970-0031_1320-122617-0000__T1__SCV2TTS__61-61-70970-0031__VOICE__1320.wav"}, "sir_db": 0.0}

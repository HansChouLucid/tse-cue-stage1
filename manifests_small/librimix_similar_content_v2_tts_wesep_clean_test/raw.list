RGING A CHECK", "synthetic_interferer": "/data/tse_cue_project/manifests/librimix_similar_content_v2_tts/clean/test/synthetic_interferer/2830-3980-0007_6829-68769-0014__T1__SCV2TTS__2830-2830-3980-0007__VOICE__6829.wav"}, "sir_db": 0.0}

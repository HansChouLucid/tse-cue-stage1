{"key": "1089-134691-0020_908-31957-0004__T2__SCV2TTS__908-908-31957-0004__VOICE__1089", "condition": "similar_content_v2_tts", "spk": ["908", "1089"], "mix": {"default": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/mix_clean/1089-134691-0020_908-31957-0004__T2__SCV2TTS__908-908-31957-0004__VOICE__1089.wav"]}, "src": {"908": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/s1/1089-134691-0020_908-31957-0004__T2__SCV2TTS__908-908-31957-0004__VOICE__1089.wav"], "1089": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/s2/1089-134691-0020_908-31957-0004__T2__SCV2TTS__908-908-31957-0004__VOICE__1089.wav"]}, "target_text": "SHALL I NEVER MISS HOME TALK AND BLESSING AND THE COMMON KISS THAT COMES TO EACH IN TURN NOR COUNT IT STRANGE WHEN I LOOK UP TO DROP ON A NEW RANGE OF WALLS AND FLOORS ANOTHER HOME THAN THIS", "source_meta": {"key": "1089-134691-0020_908-31957-0004__T2__SCV2TTS__908-908-31957-0004__VOICE__1089", "mixture_id": "1089-134691-0020_908-31957-0004", "target_source": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/908/31957/908-31957-0004.flac", "target_spk": "908", "target_utt": "908-31957-0004", "target_text": "SHALL I NEVER MISS HOME TALK AND BLESSING AND THE COMMON KISS THAT COMES TO EACH IN TURN NOR COUNT IT STRANGE WHEN I LOOK UP TO DROP ON A NEW RANGE OF WALLS AND FLOORS ANOTHER HOME THAN THIS", "original_interferer_source": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/1089/134691/1089-134691-0020.flac", "interferer_spk": "1089", "interferer_utt": "1089-134691-0020", "prompt_audio": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/1089/134686/1089-134686-0000.flac", "prompt_utt": "1089-134686-0000", "prompt_text": "HE HOPED THERE WOULD BE STEW FOR DINNER TURNIPS AND CARROTS AND BRUISED POTATOES AND FAT MUTTON PIECES TO BE LADLED OUT IN THICK PEPPERED FLOUR FATTENED SAUCE", "synthetic_interferer": "/data/tse_cue_project/manifests/librimix_similar_content_v2_tts/clean/test/synthetic_interferer/1089-134691-0020_908-31957-0004__T2__SCV2TTS__908-908-31957-0004__VOICE__1089.wav"}, "sir_db": 0.0}

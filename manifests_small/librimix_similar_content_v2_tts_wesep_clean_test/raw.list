project/manifests/librimix_similar_content_v2_tts/clean/test/synthetic_interferer/3729-6852-0023_8224-274381-0015__T1__SCV2TTS__3729-3729-6852-0023__VOICE__8224.wav"}, "sir_db": 0.0}
{"key": "3729-6852-0023_8224-274381-0015__T2__SCV2TTS__8224-8224-274381-0015__VOICE__3729", "condition": "similar_content_v2_tts", "spk": ["8224", "3729"], "mix": {"default": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/mix_clean/3729-6852-0023_8224-274381-0015__T2__SCV2TTS__8224-8224-274381-0015__VOICE__3729.wav"]}, "src": {"8224": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/s1/3729-6852-0023_8224-274381-0015__T2__SCV2TTS__8224-8224-274381-0015__VOICE__3729.wav"], "3729": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/s2/3729-6852-0023_8224-274381-0015__T2__SCV2TTS__8224-8224-274381-0015__VOICE__3729.wav"]}, "target_text": "THOUGH THE DISCIPLINE OF THE FORMER PARLIAMENTARY ARMY WAS NOT CONTEMPTIBLE A MORE EXACT PLAN WAS INTRODUCED AND RIGOROUSLY EXECUTED BY THESE NEW COMMANDERS", "source_meta": {"key": "3729-6852-0023_8224-274381-0015__T2__SCV2TTS__8224-8224-274381-0015__VOICE__3729", "mixture_id": "3729-6852-0023_8224-274381-0015", "target_source": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/8224/274381/8224-274381-0015.flac", "target_spk": "8224", "target_utt": "8224-274381-0015", "target_text": "THOUGH THE DISCIPLINE OF THE FORMER PARLIAMENTARY ARMY WAS NOT CONTEMPTIBLE A MORE EXACT PLAN WAS INTRODUCED AND RIGOROUSLY EXECUTED BY THESE NEW COMMANDERS", "original_interferer_source": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/3729/6852/3729-6852-0023.flac", "interferer_spk": "3729", "interferer_utt": "3729-6852-0023", "prompt_audio": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/3729/6852/3729-6852-0000.flac", "prompt_utt": "3729-6852-0000", "prompt_text": "TO CELEBRATE THE ARRIVAL OF HER SON SILVIA GAVE A SPLENDID SUPPER TO WHICH SHE HAD INVITED ALL HER RELATIVES AND IT WAS A GOOD OPPORTUNITY FOR ME TO MAKE THEIR ACQUAINTANCE", "synthetic_interferer": "/data/tse_cue_project/manifests/librimix_similar_content_v2_tts/clean/test/synthetic_interferer/3729-6852-0023_8224-274381-0015__T2__SCV2TTS__8224-8224-274381-0015__VOICE__3729.wav"}, "sir_db": 0.0}

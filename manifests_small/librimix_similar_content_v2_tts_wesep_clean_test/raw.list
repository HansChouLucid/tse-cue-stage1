{"key": "1089-134691-0002_8455-210777-0005__T1__SCV2TTS__1089-1089-134691-0002__VOICE__8455", "condition": "similar_content_v2_tts", "spk": ["1089", "8455"], "mix": {"default": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/mix_clean/1089-134691-0002_8455-210777-0005__T1__SCV2TTS__1089-1089-134691-0002__VOICE__8455.wav"]}, "src": {"1089": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/s1/1089-134691-0002_8455-210777-0005__T1__SCV2TTS__1089-1089-134691-0002__VOICE__8455.wav"], "8455": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/s2/1089-134691-0002_8455-210777-0005__T1__SCV2TTS__1089-1089-134691-0002__VOICE__8455.wav"]}, "target_text": "HE SET OFF ABRUPTLY FOR THE BULL WALKING RAPIDLY LEST HIS FATHER'S SHRILL WHISTLE MIGHT CALL HIM BACK AND IN A FEW MOMENTS HE HAD ROUNDED THE CURVE AT THE POLICE BARRACK AND WAS SAFE", "source_meta": {"key": "1089-134691-0002_8455-210777-0005__T1__SCV2TTS__1089-1089-134691-0002__VOICE__8455", "mixture_id": "1089-134691-0002_8455-210777-0005", "target_source": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/1089/134691/1089-134691-0002.flac", "target_spk": "1089", "target_utt": "1089-134691-0002", "target_text": "HE SET OFF ABRUPTLY FOR THE BULL WALKING RAPIDLY LEST HIS FATHER'S SHRILL WHISTLE MIGHT CALL HIM BACK AND IN A FEW MOMENTS HE HAD ROUNDED THE CURVE AT THE POLICE BARRACK AND WAS SAFE", "original_interferer_source": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/8455/210777/8455-210777-0005.flac", "interferer_spk": "8455", "interferer_utt": "8455-210777-0005", "prompt_audio": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/8455/210777/8455-210777-0000.flac", "prompt_utt": "8455-210777-0000", "prompt_text": "I REMAINED THERE ALONE FOR MANY HOURS BUT I MUST ACKNOWLEDGE THAT BEFORE I LEFT THE CHAMBERS I HAD GRADUALLY BROUGHT MYSELF TO LOOK AT THE MATTER IN ANOTHER LIGHT", "synthetic_interferer": "/data/tse_cue_project/manifests/librimix_similar_content_v2_tts/clean/test/synthetic_interferer/1089-134691-0002_8455-210777-0005__T1__SCV2TTS__1089-1089-134691-0002__VOICE__8455.wav"}, "sir_db": 0.0}

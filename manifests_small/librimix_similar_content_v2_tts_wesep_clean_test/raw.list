{"key": "4077-13751-0014_1320-122612-0009__T1__SCV2TTS__4077-4077-13751-0014__VOICE__1320", "condition": "similar_content_v2_tts", "spk": ["4077", "1320"], "mix": {"default": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/mix_clean/4077-13751-0014_1320-122612-0009__T1__SCV2TTS__4077-4077-13751-0014__VOICE__1320.wav"]}, "src": {"4077": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/s1/4077-13751-0014_1320-122612-0009__T1__SCV2TTS__4077-4077-13751-0014__VOICE__1320.wav"], "1320": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/s2/4077-13751-0014_1320-122612-0009__T1__SCV2TTS__4077-4077-13751-0014__VOICE__1320.wav"]}, "target_text": "MAKING THEIR WAY ACROSS THE RIVER MOST OF THE REFUGEES FOUND SHELTER AMONG THE MORE HOSPITABLE PEOPLE OF CLAY COUNTY AND AFTERWARD ESTABLISHED THEMSELVES IN CALDWELL COUNTY THEREIN FOUNDING THE CITY OF FAR WEST", "source_meta": {"key": "4077-13751-0014_1320-122612-0009__T1__SCV2TTS__4077-4077-13751-0014__VOICE__1320", "mixture_id": "4077-13751-0014_1320-122612-0009", "target_source": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/4077/13751/4077-13751-0014.flac", "target_spk": "4077", "target_utt": "4077-13751-0014", "target_text": "MAKING THEIR WAY ACROSS THE RIVER MOST OF THE REFUGEES FOUND SHELTER AMONG THE MORE HOSPITABLE PEOPLE OF CLAY COUNTY AND AFTERWARD ESTABLISHED THEMSELVES IN CALDWELL COUNTY THEREIN FOUNDING THE CITY OF FAR WEST", "original_interferer_source": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/1320/122612/1320-122612-0009.flac", "interferer_spk": "1320", "interferer_utt": "1320-122612-0009", "prompt_audio": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/1320/122612/1320-122612-0000.flac", "prompt_utt": "1320-122612-0000", "prompt_text": "SINCE THE PERIOD OF OUR TALE THE ACTIVE SPIRIT OF THE COUNTRY HAS SURROUNDED IT WITH A BELT OF RICH AND THRIVING SETTLEMENTS THOUGH NONE BUT THE HUNTER OR THE SAVAGE IS EVER KNOWN EVEN NOW TO PENETRATE ITS WILD RECESSES", "synthetic_interferer": "/data/tse_cue_project/manifests/librimix_similar_content_v2_tts/clean/test/synthetic_interferer/4077-13751-0014_1320-122612-0009__T1__SCV2TTS__4077-4077-13751-0014__VOICE__1320.wav"}, "sir_db": 0.0}

{"key": "7021-79740-0010_8455-210777-0051__T1__SCV2TTS__7021-7021-79740-0010__VOICE__8455", "condition": "similar_content_v2_tts", "spk": ["7021", "8455"], "mix": {"default": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/mix_clean/7021-79740-0010_8455-210777-0051__T1__SCV2TTS__7021-7021-79740-0010__VOICE__8455.wav"]}, "src": {"7021": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/s1/7021-79740-0010_8455-210777-0051__T1__SCV2TTS__7021-7021-79740-0010__VOICE__8455.wav"], "8455": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/s2/7021-79740-0010_8455-210777-0051__T1__SCV2TTS__7021-7021-79740-0010__VOICE__8455.wav"]}, "target_text": "DELIA CAME TO THE PARLOR AND WITH AN AIR OF GREAT MYSTERY BECKONED THE CHILDREN ASIDE AND SAID TO THEM IN A WHISPER LEAVE ANDELLA AND ROSALIE HERE AND DON'T SAY A WORD TO THEM", "source_meta": {"key": "7021-79740-0010_8455-210777-0051__T1__SCV2TTS__7021-7021-79740-0010__VOICE__8455", "mixture_id": "7021-79740-0010_8455-210777-0051", "target_source": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/7021/79740/7021-79740-0010.flac", "target_spk": "7021", "target_utt": "7021-79740-0010", "target_text": "DELIA CAME TO THE PARLOR AND WITH AN AIR OF GREAT MYSTERY BECKONED THE CHILDREN ASIDE AND SAID TO THEM IN A WHISPER LEAVE ANDELLA AND ROSALIE HERE AND DON'T SAY A WORD TO THEM", "original_interferer_source": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/8455/210777/8455-210777-0051.flac", "interferer_spk": "8455", "interferer_utt": "8455-210777-0051", "prompt_audio": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/8455/210777/8455-210777-0000.flac", "prompt_utt": "8455-210777-0000", "prompt_text": "I REMAINED THERE ALONE FOR MANY HOURS BUT I MUST ACKNOWLEDGE THAT BEFORE I LEFT THE CHAMBERS I HAD GRADUALLY BROUGHT MYSELF TO LOOK AT THE MATTER IN ANOTHER LIGHT", "synthetic_interferer": "/data/tse_cue_project/manifests/librimix_similar_content_v2_tts/clean/test/synthetic_interferer/7021-79740-0010_8455-210777-0051__T1__SCV2TTS__7021-7021-79740-0010__VOICE__8455.wav"}, "sir_db": 0.0}

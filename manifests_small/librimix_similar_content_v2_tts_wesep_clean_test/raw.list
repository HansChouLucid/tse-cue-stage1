terferer": "/data/tse_cue_project/manifests/librimix_similar_content_v2_tts/clean/test/synthetic_interferer/237-126133-0019_5639-40744-0024__T2__SCV2TTS__5639-5639-40744-0024__VOICE__237.wav"}, "sir_db": 0.0}

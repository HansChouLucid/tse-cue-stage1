{"key": "2094-142345-0059_8555-292519-0006__T2__SCV2TTS__8555-8555-292519-0006__VOICE__2094", "condition": "similar_content_v2_tts", "spk": ["8555", "2094"], "mix": {"default": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/mix_clean/2094-142345-0059_8555-292519-0006__T2__SCV2TTS__8555-8555-292519-0006__VOICE__2094.wav"]}, "src": {"8555": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/s1/2094-142345-0059_8555-292519-0006__T2__SCV2TTS__8555-8555-292519-0006__VOICE__2094.wav"], "2094": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/s2/2094-142345-0059_8555-292519-0006__T2__SCV2TTS__8555-8555-292519-0006__VOICE__2094.wav"]}, "target_text": "THE PLEASANT GRAVEYARD OF MY SOUL WITH SENTIMENTAL CYPRESS TREES AND FLOWERS IS FILLED THAT I MAY STROLL IN MEDITATION AT MY EASE", "source_meta": {"key": "2094-142345-0059_8555-292519-0006__T2__SCV2TTS__8555-8555-292519-0006__VOICE__2094", "mixture_id": "2094-142345-0059_8555-292519-0006", "target_source": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/8555/292519/8555-292519-0006.flac", "target_spk": "8555", "target_utt": "8555-292519-0006", "target_text": "THE PLEASANT GRAVEYARD OF MY SOUL WITH SENTIMENTAL CYPRESS TREES AND FLOWERS IS FILLED THAT I MAY STROLL IN MEDITATION AT MY EASE", "original_interferer_source": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/2094/142345/2094-142345-0059.flac", "interferer_spk": "2094", "interferer_utt": "2094-142345-0059", "prompt_audio": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/2094/142345/2094-142345-0000.flac", "prompt_utt": "2094-142345-0000", "prompt_text": "IT IS A VERY FINE OLD PLACE OF RED BRICK SOFTENED BY A PALE POWDERY LICHEN WHICH HAS DISPERSED ITSELF WITH HAPPY IRREGULARITY SO AS TO BRING THE RED BRICK INTO TERMS OF FRIENDLY COMPANIONSHIP WITH THE LIMESTONE ORNAMENTS SURROUNDING THE THREE GABLES THE WINDOWS AND THE DOOR PLACE", "synthetic_interferer": "/data/tse_cue_project/manifests/librimix_similar_content_v2_tts/clean/test/synthetic_interferer/2094-142345-0059_8555-292519-0006__T2__SCV2TTS__8555-8555-292519-0006__VOICE__2094.wav"}, "sir_db": 0.0}
{"key": "8555-284449-0018_8455-210777-0057__T1__SCV2TTS__8555-8555-284449-0018__VOICE__8455", "condition": "similar_content_v2_tts", "spk": ["8555", "8455"], "mix": {"default": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/mix_clean/8555-284449-0018_8455-210777-0057__T1__SCV2TTS__8555-8555-284449-0018__VOICE__8455.wav"]}, "src": {"8555": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/s1/8555-284449-0018_8455-210777-0057__T1__SCV2TTS__8555-8555-284449-0018__VOICE__8455.wav"], "8455": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/s2/8555-284449-0018_8455-210777-0057__T1__SCV2TTS__8555-8555-284449-0018__VOICE__8455.wav"]}, "target_text": "SO GHIP GHISIZZLE ORDERED THE CAPTAIN TO TAKE A FILE OF SOLDIERS AND ESCORT THE RAVING BEAUTIES TO THEIR NEW HOME", "source_meta": {"key": "8555-284449-0018_8455-210777-0057__T1__SCV2TTS__8555-8555-284449-0018__VOICE__8455", "mixture_id": "8555-284449-0018_8455-210777-0057", "target_source": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/8555/284449/8555-284449-0018.flac", "target_spk": "8555", "target_utt": "8555-284449-0018", "target_text": "SO GHIP GHISIZZLE ORDERED THE CAPTAIN TO TAKE A FILE OF SOLDIERS AND ESCORT THE RAVING BEAUTIES TO THEIR NEW HOME", "original_interferer_source": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/8455/210777/8455-210777-0057.flac", "interferer_spk": "8455", "interferer_utt": "8455-210777-0057", "prompt_audio": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/8455/210777/8455-210777-0000.flac", "prompt_utt": "8455-210777-0000", "prompt_text": "I REMAINED THERE ALONE FOR MANY HOURS BUT I MUST ACKNOWLEDGE THAT BEFORE I LEFT THE CHAMBERS I HAD GRADUALLY BROUGHT MYSELF TO LOOK AT THE MATTER IN ANOTHER LIGHT", "synthetic_interferer": "/data/tse_cue_project/manifests/librimix_similar_content_v2_tts/clean/test/synthetic_int
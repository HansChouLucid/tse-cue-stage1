{"key": "8455-210777-0044_5639-40744-0024__T1__SCV2TTS__8455-8455-210777-0044__VOICE__5639", "condition": "similar_content_v2_tts", "spk": ["8455", "5639"], "mix": {"default": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/mix_clean/8455-210777-0044_5639-40744-0024__T1__SCV2TTS__8455-8455-210777-0044__VOICE__5639.wav"]}, "src": {"8455": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/s1/8455-210777-0044_5639-40744-0024__T1__SCV2TTS__8455-8455-210777-0044__VOICE__5639.wav"], "5639": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/s2/8455-210777-0044_5639-40744-0024__T1__SCV2TTS__8455-8455-210777-0044__VOICE__5639.wav"]}, "target_text": "I WAS TO BE TAKEN AWAY AND CARRIED TO ENGLAND OR ELSEWHERE OR DROWNED UPON THE VOYAGE IT MATTERED NOT WHICH", "source_meta": {"key": "8455-210777-0044_5639-40744-0024__T1__SCV2TTS__8455-8455-210777-0044__VOICE__5639", "mixture_id": "8455-210777-0044_5639-40744-0024", "target_source": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/8455/210777/8455-210777-0044.flac", "target_spk": "8455", "target_utt": "8455-210777-0044", "target_text": "I WAS TO BE TAKEN AWAY AND CARRIED TO ENGLAND OR ELSEWHERE OR DROWNED UPON THE VOYAGE IT MATTERED NOT WHICH", "original_interferer_source": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/5639/40744/5639-40744-0024.flac", "interferer_spk": "5639", "interferer_utt": "5639-40744-0024", "prompt_audio": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/5639/40744/5639-40744-0000.flac", "prompt_utt": "5639-40744-0000", "prompt_text": "ELEVEN O'CLOCK HAD STRUCK IT WAS A FINE CLEAR NIGHT THEY WERE THE ONLY PERSONS ON THE ROAD AND THEY SAUNTERED LEISURELY ALONG TO AVOID PAYING THE PRICE OF FATIGUE FOR THE RECREATION PROVIDED FOR THE TOLEDANS IN THEIR VALLEY OR ON THE BANKS OF THEIR RIVER", "synthetic_interferer": "/data/tse_cue_project/manifests/librimix_similar_content_v2_tts/clean/test/synthetic_interferer/8455-210777-0044_5639-40744-0024__T1__SCV2TTS__8455-8455-210777-0044__VOICE__5639.wav"}, "sir_db": 0.0}
{"key": "8455-210777-0044_5639-40744-0024__T2__SCV2TTS__5639-5639-40744-0024__VOICE__8455", "condition": "similar_content_v2_tts", "spk": ["5639", "8455"], "mix": {"default": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/mix_clean/8455-210777-0044_5639-40744-0024__T2__SCV2TTS__5639-5639-40744-0024__VOICE__8455.wav"]}, "src": {"5639": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/s1/8455-210777-0044_5639-40744-0024__T2__SCV2TTS__5639-5639-40744-0024__VOICE__8455.wav"], "8455": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/s2/8455-210777-0044_5639-40744-0024__T2__SCV2TTS__5639-5639-40744-0024__VOICE__8455.wav"]}, "target_text": "ONE DAY WHEN THE BOY WAS SENT BY HIS GRANDFATHER WITH A MESSAGE TO A RELATION HE PASSED ALONG A STREET IN WHICH THERE WAS A GREAT CONCOURSE OF HORSEMEN", "source_meta": {"key": "8455-210777-0044_5639-40744-0024__T2__SCV2TTS__5639-5639-40744-0024__VOICE__8455", "mixture_id": "8455-210777-0044_5639-40744-0024", "target_source": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/5639/40744/5639-40744-0024.flac", "target_spk": "5639", "target_utt": "5639-40744-0024", "target_text": "ONE DAY WHEN THE BOY WAS SENT BY HIS GRANDFATHER WITH A MESSAGE TO A RELATION HE PASSED ALONG A STREET IN WHICH THERE WAS A GREAT CONCOURSE OF HORSEMEN", "original_interferer_source": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/8455/210777/8455-210777-0044.flac", "interferer_spk": "8455", "interferer_utt": "8455-210777-0044", "prompt_audio": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/8455/210777/8455-210777-0000.flac", "prompt_utt": "8455-210777-0000", "prompt_text": "I REMAINED THERE ALONE FOR MANY HOURS BUT I MUST ACKNOWLEDGE THAT BEFORE I LEFT THE CHAMBERS I HAD GRADUALLY BROUGHT MYSELF TO LOOK AT THE MATTER IN ANOTHER LIGHT", "synthetic_interferer": "/data/tse_cue_project/manifests/librimix_similar_content_v2_tts/clean/test/synthetic_interferer/8455-210777-0044_5639-40744-0024__T2__SCV2TTS__5639-5639-40744-0024__VOICE__8455.wav"}, "sir_db": 0.0}

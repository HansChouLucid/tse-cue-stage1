", "synthetic_interferer": "/data/tse_cue_project/manifests/librimix_similar_content_v2_tts/clean/test/synthetic_interferer/1089-134686-0002_7729-102255-0037__T2__SCV2TTS__7729-7729-102255-0037__VOICE__1089.wav"}, "sir_db": 0.0}

{"key": "1284-1181-0014_2094-142345-0001__T1__SCV2TTS__1284-1284-1181-0014__VOICE__2094", "condition": "similar_content_v2_tts", "spk": ["1284", "2094"], "mix": {"default": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/mix_clean/1284-1181-0014_2094-142345-0001__T1__SCV2TTS__1284-1284-1181-0014__VOICE__2094.wav"]}, "src": {"1284": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/s1/1284-1181-0014_2094-142345-0001__T1__SCV2TTS__1284-1284-1181-0014__VOICE__2094.wav"], "2094": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/s2/1284-1181-0014_2094-142345-0001__T1__SCV2TTS__1284-1284-1181-0014__VOICE__2094.wav"]}, "target_text": "HE SELECTED A SMALL GOLD BOTTLE WITH A PEPPER BOX TOP SO THAT THE POWDER MIGHT BE SPRINKLED ON ANY OBJECT THROUGH THE SMALL HOLES", "source_meta": {"key": "1284-1181-0014_2094-142345-0001__T1__SCV2TTS__1284-1284-1181-0014__VOICE__2094", "mixture_id": "1284-1181-0014_2094-142345-0001", "target_source": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/1284/1181/1284-1181-0014.flac", "target_spk": "1284", "target_utt": "1284-1181-0014", "target_text": "HE SELECTED A SMALL GOLD BOTTLE WITH A PEPPER BOX TOP SO THAT THE POWDER MIGHT BE SPRINKLED ON ANY OBJECT THROUGH THE SMALL HOLES", "original_interferer_source": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/2094/142345/2094-142345-0001.flac", "interferer_spk": "2094", "interferer_utt": "2094-142345-0001", "prompt_audio": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/2094/142345/2094-142345-0000.flac", "prompt_utt": "2094-142345-0000", "prompt_text": "IT IS A VERY FINE OLD PLACE OF RED BRICK SOFTENED BY A PALE POWDERY LICHEN WHICH HAS DISPERSED ITSELF WITH HAPPY IRREGULARITY SO AS TO BRING THE RED BRICK INTO TERMS OF FRIENDLY COMPANIONSHIP WITH THE LIMESTONE ORNAMENTS SURROUNDING THE THREE GABLES THE WINDOWS AND THE DOOR PLACE", "synthetic_interferer": "/data/tse_cue_project/manifests/librimix_similar_content_v2_tts/clean/test/synthetic_interferer/1284-1181-0014_2094-142345-0001__T1__SCV2TTS__1284-1284-1181-0014__VOICE__2094.wav"}, "sir_db": 0.0}

{"key": "672-122797-0000_8455-210777-0019__T1__SCV2TTS__672-672-122797-0000__VOICE__8455", "condition": "similar_content_v2_tts", "spk": ["672", "8455"], "mix": {"default": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/mix_clean/672-122797-0000_8455-210777-0019__T1__SCV2TTS__672-672-122797-0000__VOICE__8455.wav"]}, "src": {"672": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/s1/672-122797-0000_8455-210777-0019__T1__SCV2TTS__672-672-122797-0000__VOICE__8455.wav"], "8455": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/s2/672-122797-0000_8455-210777-0019__T1__SCV2TTS__672-672-122797-0000__VOICE__8455.wav"]}, "target_text": "OUT IN THE WOODS STOOD A NICE LITTLE FIR TREE", "source_meta": {"key": "672-122797-0000_8455-210777-0019__T1__SCV2TTS__672-672-122797-0000__VOICE__8455", "mixture_id": "672-122797-0000_8455-210777-0019", "target_source": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/672/122797/672-122797-0000.flac", "target_spk": "672", "target_utt": "672-122797-0000", "target_text": "OUT IN THE WOODS STOOD A NICE LITTLE FIR TREE", "original_interferer_source": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/8455/210777/8455-210777-0019.flac", "interferer_spk": "8455", "interferer_utt": "8455-210777-0019", "prompt_audio": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/8455/210777/8455-210777-0000.flac", "prompt_utt": "8455-210777-0000", "prompt_text": "I REMAINED THERE ALONE FOR MANY HOURS BUT I MUST ACKNOWLEDGE THAT BEFORE I LEFT THE CHAMBERS I HAD GRADUALLY BROUGHT MYSELF TO LOOK AT THE MATTER IN ANOTHER LIGHT", "synthetic_interferer": "/data/tse_cue_project/manifests/librimix_similar_content_v2_tts/clean/test/synthetic_interferer/672-122797-0000_8455-210777-0019__T1__SCV2TTS__672-672-122797-0000__VOICE__8455.wav"}, "sir_db": 0.0}
{"key": "672-122797-0000_8455-210777-0019__T2__SCV2TTS__8455-8455-210777-0019__VOICE__672", "condition": "similar_content_v2_tts", "spk": ["8455", "672"], "mix": {"default": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/mix_clean/672-122797-0000_8455-210777-0019__T2__SCV2TTS__8455-8455-210777-0019__VOICE__672.wav"]}, "src": {"8455": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/s1/672-122797-0000_8455-210777-0019__T2__SCV2TTS__8455-8455-210777-0019__VOICE__672.wav"], "672": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/s2/672-122797-0000_8455-210777-0019__T2__SCV2TTS__8455-8455-210777-0019__VOICE__672.wav"]}, "target_text": "THEN THERE WERE THREE OR FOUR LEADING MEN OF THE COMMUNITY WITH THEIR WIVES WHO WERE FOR THE MOST PART THE FATHERS AND MOTHERS OF THE YOUNG LADIES", "source_meta": {"key": "672-122797-0000_8455-210777-0019__T2__SCV2TTS__8455-8455-210777-0019__VOICE__672", "mixture_id": "672-122797-0000_8455-210777-0019", "target_source": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/8455/210777/8455-210777-0019.flac", "target_spk": "8455", "target_utt": "8455-210777-0019", "target_text": "THEN THERE WERE THREE OR FOUR LEADING MEN OF THE COMMUNITY WITH THEIR WIVES WHO WERE FOR THE MOST PART THE FATHERS AND MOTHERS OF THE YOUNG LADIES", "original_interferer_source": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/672/122797/672-122797-0000.flac", "interferer_spk": "672", "interferer_utt": "672-122797-0000", "prompt_audio": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/672/122797/672-122797-0001.flac", "prompt_utt": "672-122797-0001", "prompt_text": "THE PLACE HE HAD WAS A VERY GOOD ONE THE SUN SHONE ON HIM AS TO FRESH AIR THERE WAS ENOUGH OF THAT AND ROUND HIM GREW MANY LARGE SIZED COMRADES PINES AS WELL AS FIRS", "synthetic_interferer": "/data/tse_cue_project/manifests/librimix_similar_content_v2_tts/clean/test/synthetic_interferer/672-122797-0000_8455-210777-0019__T2__SCV2TTS__8455-8455-210777-0019__VOICE__672.wav"}, "sir_db": 0.0}

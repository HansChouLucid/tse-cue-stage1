{"key": "1995-1837-0016_3575-170457-0038__T2__SCV2TTS__3575-3575-170457-0038__VOICE__1995", "condition": "similar_content_v2_tts", "spk": ["3575", "1995"], "mix": {"default": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/mix_clean/1995-1837-0016_3575-170457-0038__T2__SCV2TTS__3575-3575-170457-0038__VOICE__1995.wav"]}, "src": {"3575": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/s1/1995-1837-0016_3575-170457-0038__T2__SCV2TTS__3575-3575-170457-0038__VOICE__1995.wav"], "1995": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/s2/1995-1837-0016_3575-170457-0038__T2__SCV2TTS__3575-3575-170457-0038__VOICE__1995.wav"]}, "target_text": "AND MEANTIME I KNOW THE GREATNESS OF JEHOVAH I ACKNOWLEDGE THE PERFECTION OF HIS WORD I ADORE THE PURITY OF THE CHRISTIAN FAITH MY THEORY IS RIGHT MY PRACTICE HORRIBLY WRONG", "source_meta": {"key": "1995-1837-0016_3575-170457-0038__T2__SCV2TTS__3575-3575-170457-0038__VOICE__1995", "mixture_id": "1995-1837-0016_3575-170457-0038", "target_source": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/3575/170457/3575-170457-0038.flac", "target_spk": "3575", "target_utt": "3575-170457-0038", "target_text": "AND MEANTIME I KNOW THE GREATNESS OF JEHOVAH I ACKNOWLEDGE THE PERFECTION OF HIS WORD I ADORE THE PURITY OF THE CHRISTIAN FAITH MY THEORY IS RIGHT MY PRACTICE HORRIBLY WRONG", "original_interferer_source": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/1995/1837/1995-1837-0016.flac", "interferer_spk": "1995", "interferer_utt": "1995-1837-0016", "prompt_audio": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/1995/1826/1995-1826-0000.flac", "prompt_utt": "1995-1826-0000", "prompt_text": "IN THE DEBATE BETWEEN THE SENIOR SOCIETIES HER DEFENCE OF THE FIFTEENTH AMENDMENT HAD BEEN NOT ONLY A NOTABLE BIT OF REASONING BUT DELIVERED WITH REAL ENTHUSIASM", "synthetic_interferer": "/data/tse_cue_project/manifests/librimix_similar_content_v2_tts/clean/test/synthetic_interferer/1995-1837-0016_3575-170457-0038__T2__SCV2TTS__3575-3575-170457-0038__VOICE__1995.wav"}, "sir_db": 0.0}

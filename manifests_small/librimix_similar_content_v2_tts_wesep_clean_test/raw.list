{"key": "908-157963-0026_61-70970-0012__T2__SCV2TTS__61-61-70970-0012__VOICE__908", "condition": "similar_content_v2_tts", "spk": ["61", "908"], "mix": {"default": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/mix_clean/908-157963-0026_61-70970-0012__T2__SCV2TTS__61-61-70970-0012__VOICE__908.wav"]}, "src": {"61": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/s1/908-157963-0026_61-70970-0012__T2__SCV2TTS__61-61-70970-0012__VOICE__908.wav"], "908": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/s2/908-157963-0026_61-70970-0012__T2__SCV2TTS__61-61-70970-0012__VOICE__908.wav"]}, "target_text": "YET HE WILL TEACH YOU A FEW TRICKS WHEN MORNING IS COME", "source_meta": {"key": "908-157963-0026_61-70970-0012__T2__SCV2TTS__61-61-70970-0012__VOICE__908", "mixture_id": "908-157963-0026_61-70970-0012", "target_source": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/61/70970/61-70970-0012.flac", "target_spk": "61", "target_utt": "61-70970-0012", "target_text": "YET HE WILL TEACH YOU A FEW TRICKS WHEN MORNING IS COME", "original_interferer_source": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/908/157963/908-157963-0026.flac", "interferer_spk": "908", "interferer_utt": "908-157963-0026", "prompt_audio": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/908/157963/908-157963-0000.flac", "prompt_utt": "908-157963-0000", "prompt_text": "TO FADE AWAY LIKE MORNING BEAUTY FROM HER MORTAL DAY DOWN BY THE RIVER OF ADONA HER SOFT VOICE IS HEARD AND THUS HER GENTLE LAMENTATION FALLS LIKE MORNING DEW", "synthetic_interferer": "/data/tse_cue_project/manifests/librimix_similar_content_v2_tts/clean/test/synthetic_interferer/908-157963-0026_61-70970-0012__T2__SCV2TTS__61-61-70970-0012__VOICE__908.wav"}, "sir_db": 0.0}

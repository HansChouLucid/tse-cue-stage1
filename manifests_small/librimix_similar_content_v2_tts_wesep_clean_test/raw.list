rferer": "/data/tse_cue_project/manifests/librimix_similar_content_v2_tts/clean/test/synthetic_interferer/8224-274384-0013_1995-1826-0000__T2__SCV2TTS__1995-1995-1826-0000__VOICE__8224.wav"}, "sir_db": 0.0}

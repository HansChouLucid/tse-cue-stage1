{"key": "3729-6852-0038_8455-210777-0033__T2__SCV2TTS__8455-8455-210777-0033__VOICE__3729", "condition": "similar_content_v2_tts", "spk": ["8455", "3729"], "mix": {"default": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/mix_clean/3729-6852-0038_8455-210777-0033__T2__SCV2TTS__8455-8455-210777-0033__VOICE__3729.wav"]}, "src": {"8455": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/s1/3729-6852-0038_8455-210777-0033__T2__SCV2TTS__8455-8455-210777-0033__VOICE__3729.wav"], "3729": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/s2/3729-6852-0038_8455-210777-0033__T2__SCV2TTS__8455-8455-210777-0033__VOICE__3729.wav"]}, "target_text": "BUT YOUR POWER IS SO SUPERIOR TO ANY THAT I CAN ADVANCE AS TO MAKE US HERE FEEL THAT THERE IS NO DISGRACE IN YIELDING TO IT", "source_meta": {"key": "3729-6852-0038_8455-210777-0033__T2__SCV2TTS__8455-8455-210777-0033__VOICE__3729", "mixture_id": "3729-6852-0038_8455-210777-0033", "target_source": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/8455/210777/8455-210777-0033.flac", "target_spk": "8455", "target_utt": "8455-210777-0033", "target_text": "BUT YOUR POWER IS SO SUPERIOR TO ANY THAT I CAN ADVANCE AS TO MAKE US HERE FEEL THAT THERE IS NO DISGRACE IN YIELDING TO IT", "original_interferer_source": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/3729/6852/3729-6852-0038.flac", "interferer_spk": "3729", "interferer_utt": "3729-6852-0038", "prompt_audio": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/3729/6852/3729-6852-0000.flac", "prompt_utt": "3729-6852-0000", "prompt_text": "TO CELEBRATE THE ARRIVAL OF HER SON SILVIA GAVE A SPLENDID SUPPER TO WHICH SHE HAD INVITED ALL HER RELATIVES AND IT WAS A GOOD OPPORTUNITY FOR ME TO MAKE THEIR ACQUAINTANCE", "synthetic_interferer": "/data/tse_cue_project/manifests/librimix_similar_content_v2_tts/clean/test/synthetic_interferer/3729-6852-0038_8455-210777-0033__T2__SCV2TTS__8455-8455-210777-0033__VOICE__3729.wav"}, "sir_db": 0.0}

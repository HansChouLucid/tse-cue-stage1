NFUSE SPIRIT INTO THE DISTRESSED ROYALISTS", "synthetic_interferer": "/data/tse_cue_project/manifests/librimix_similar_content_v2_tts/clean/test/synthetic_interferer/5639-40744-0036_8224-274381-0003__T1__SCV2TTS__5639-5639-40744-0036__VOICE__8224.wav"}, "sir_db": 0.0}

 "sir_db": 0.0}
{"key": "1284-1180-0014_1320-122612-0003__T2__SCV2TTS__1320-1320-122612-0003__VOICE__1284", "condition": "similar_content_v2_tts", "spk": ["1320", "1284"], "mix": {"default": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/mix_clean/1284-1180-0014_1320-122612-0003__T2__SCV2TTS__1320-1320-122612-0003__VOICE__1284.wav"]}, "src": {"1320": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/s1/1284-1180-0014_1320-122612-0003__T2__SCV2TTS__1320-1320-122612-0003__VOICE__1284.wav"], "1284": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/s2/1284-1180-0014_1320-122612-0003__T2__SCV2TTS__1320-1320-122612-0003__VOICE__1284.wav"]}, "target_text": "HE OFTEN STOPPED TO EXAMINE THE TREES NOR DID HE CROSS A RIVULET WITHOUT ATTENTIVELY CONSIDERING THE QUANTITY THE VELOCITY AND THE COLOR OF ITS WATERS", "source_meta": {"key": "1284-1180-0014_1320-122612-0003__T2__SCV2TTS__1320-1320-122612-0003__VOICE__1284", "mixture_id": "1284-1180-0014_1320-122612-0003", "target_source": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/1320/122612/1320-122612-0003.flac", "target_spk": "1320", "target_utt": "1320-122612-0003", "target_text": "HE OFTEN STOPPED TO EXAMINE THE TREES NOR DID HE CROSS A RIVULET WITHOUT ATTENTIVELY CONSIDERING THE QUANTITY THE VELOCITY AND THE COLOR OF ITS WATERS", "original_interferer_source": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/1284/1180/1284-1180-0014.flac", "interferer_spk": "1284", "interferer_utt": "1284-1180-0014", "prompt_audio": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/1284/1180/1284-1180-0000.flac", "prompt_utt": "1284-1180-0000", "prompt_text": "HE WORE BLUE SILK STOCKINGS BLUE KNEE PANTS WITH GOLD BUCKLES A BLUE RUFFLED WAIST AND A JACKET OF BRIGHT BLUE BRAIDED WITH GOLD", "synthetic_interferer": "/data/tse_cue_project/manifests/librimix_similar_content_v2_tts/clean/test/synthetic_interferer/1284-1180-0014_1320-122612-0003__T2__SCV2TTS__1320-1320-122612-0003__VOICE__1284.wav"}, "sir_db": 0.0}

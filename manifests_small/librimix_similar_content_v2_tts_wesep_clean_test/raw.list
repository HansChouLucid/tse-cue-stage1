CE__8455.wav"}, "sir_db": 0.0}
{"key": "6829-68769-0049_1320-122617-0001__T1__SCV2TTS__6829-6829-68769-0049__VOICE__1320", "condition": "similar_content_v2_tts", "spk": ["6829", "1320"], "mix": {"default": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/mix_clean/6829-68769-0049_1320-122617-0001__T1__SCV2TTS__6829-6829-68769-0049__VOICE__1320.wav"]}, "src": {"6829": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/s1/6829-68769-0049_1320-122617-0001__T1__SCV2TTS__6829-6829-68769-0049__VOICE__1320.wav"], "1320": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/s2/6829-68769-0049_1320-122617-0001__T1__SCV2TTS__6829-6829-68769-0049__VOICE__1320.wav"]}, "target_text": "HE DETESTED THE GRASPING DISPOSITION THAT WOULD ENDEAVOR TO TAKE ADVANTAGE OF HIS EVIDENT DESIRE TO HELP YOUNG GATES", "source_meta": {"key": "6829-68769-0049_1320-122617-0001__T1__SCV2TTS__6829-6829-68769-0049__VOICE__1320", "mixture_id": "6829-68769-0049_1320-122617-0001", "target_source": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/6829/68769/6829-68769-0049.flac", "target_spk": "6829", "target_utt": "6829-68769-0049", "target_text": "HE DETESTED THE GRASPING DISPOSITION THAT WOULD ENDEAVOR TO TAKE ADVANTAGE OF HIS EVIDENT DESIRE TO HELP YOUNG GATES", "original_interferer_source": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/1320/122617/1320-122617-0001.flac", "interferer_spk": "1320", "interferer_utt": "1320-122617-0001", "prompt_audio": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/1320/122612/1320-122612-0000.flac", "prompt_utt": "1320-122612-0000", "prompt_text": "SINCE THE PERIOD OF OUR TALE THE ACTIVE SPIRIT OF THE COUNTRY HAS SURROUNDED IT WITH A BELT OF RICH AND THRIVING SETTLEMENTS THOUGH NONE BUT THE HUNTER OR THE SAVAGE IS EVER KNOWN EVEN NOW TO PENETRATE ITS WILD RECESSES", "synthetic_interferer": "/data/tse_cue_project/manifests/librimix_similar_content_v2_tts/clean/test/synthetic_interferer/6829-68769-0049_1320-122617-0001__T1__SCV2TTS__6829-6829-68769-0049__VOICE__1320.wav"}, "sir_db": 0.0}
{"key": "6829-68769-0049_1320-122617-0001__T2__SCV2TTS__1320-1320-122617-0001__VOICE__6829", "condition": "similar_content_v2_tts", "spk": ["1320", "6829"], "mix": {"default": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/mix_clean/6829-68769-0049_1320-122617-0001__T2__SCV2TTS__1320-1320-122617-0001__VOICE__6829.wav"]}, "src": {"1320": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/s1/6829-68769-0049_1320-122617-0001__T2__SCV2TTS__1320-1320-122617-0001__VOICE__6829.wav"], "6829": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/s2/6829-68769-0049_1320-122617-0001__T2__SCV2TTS__1320-1320-122617-0001__VOICE__6829.wav"]}, "target_text": "IN HIS RETURN TO THE CAMP HIS ACUTE AND PRACTISED INTELLECTS WERE INTENTLY ENGAGED IN DEVISING MEANS TO COUNTERACT A WATCHFULNESS AND SUSPICION ON THE PART OF HIS ENEMIES THAT HE KNEW WERE IN NO DEGREE INFERIOR TO HIS OWN", "source_meta": {"key": "6829-68769-0049_1320-122617-0001__T2__SCV2TTS__1320-1320-122617-0001__VOICE__6829", "mixture_id": "6829-68769-0049_1320-122617-0001", "target_source": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/1320/122617/1320-122617-0001.flac", "target_spk": "1320", "target_utt": "1320-122617-0001", "target_text": "IN HIS RETURN TO THE CAMP HIS ACUTE AND PRACTISED INTELLECTS WERE INTENTLY ENGAGED IN DEVISING MEANS TO COUNTERACT A WATCHFULNESS AND SUSPICION ON THE PART OF HIS ENEMIES THAT HE KNEW WERE IN NO DEGREE INFERIOR TO HIS OWN", "original_interferer_source": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/6829/68769/6829-68769-0049.flac", "interferer_spk": "6829", "interferer_utt": "6829-68769-0049", "prompt_audio": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/6829/68769/6829-68769-0000.flac", "prompt_utt": "6829-68769-0000", "prompt_text": "KENNETH AND BETH REFRAINED FROM TELLING THE OTHER GIRLS OR UNCLE JOHN OF OLD WILL ROGERS'S VISIT BUT THEY GOT MISTER WATSON IN THE LIBRARY AND QUESTIONED HIM CLOSELY ABOUT THE PENALTY FOR FORGING A CHECK", "synthetic_interferer": "/data/tse_cue_project/manifests/librimix_similar_content_v2_tts/clean/test/synthetic_interferer/6829-68769-0049_1320-122617-0001__T2__SCV2TTS__1320-1320-122617-0001__VOICE__6829.wav"}, "sir_db": 0.0}

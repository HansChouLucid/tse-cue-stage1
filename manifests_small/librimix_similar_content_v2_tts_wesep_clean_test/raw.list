{"key": "1320-122617-0030_8455-210777-0056__T2__SCV2TTS__8455-8455-210777-0056__VOICE__1320", "condition": "similar_content_v2_tts", "spk": ["8455", "1320"], "mix": {"default": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/mix_clean/1320-122617-0030_8455-210777-0056__T2__SCV2TTS__8455-8455-210777-0056__VOICE__1320.wav"]}, "src": {"8455": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/s1/1320-122617-0030_8455-210777-0056__T2__SCV2TTS__8455-8455-210777-0056__VOICE__1320.wav"], "1320": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/s2/1320-122617-0030_8455-210777-0056__T2__SCV2TTS__8455-8455-210777-0056__VOICE__1320.wav"]}, "target_text": "THE PECULIAR CIRCUMSTANCES OF THE COLONY ARE WITHIN YOUR EXCELLENCY'S KNOWLEDGE", "source_meta": {"key": "1320-122617-0030_8455-210777-0056__T2__SCV2TTS__8455-8455-210777-0056__VOICE__1320", "mixture_id": "1320-122617-0030_8455-210777-0056", "target_source": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/8455/210777/8455-210777-0056.flac", "target_spk": "8455", "target_utt": "8455-210777-0056", "target_text": "THE PECULIAR CIRCUMSTANCES OF THE COLONY ARE WITHIN YOUR EXCELLENCY'S KNOWLEDGE", "original_interferer_source": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/1320/122617/1320-122617-0030.flac", "interferer_spk": "1320", "interferer_utt": "1320-122617-0030", "prompt_audio": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/1320/122612/1320-122612-0000.flac", "prompt_utt": "1320-122612-0000", "prompt_text": "SINCE THE PERIOD OF OUR TALE THE ACTIVE SPIRIT OF THE COUNTRY HAS SURROUNDED IT WITH A BELT OF RICH AND THRIVING SETTLEMENTS THOUGH NONE BUT THE HUNTER OR THE SAVAGE IS EVER KNOWN EVEN NOW TO PENETRATE ITS WILD RECESSES", "synthetic_interferer": "/data/tse_cue_project/manifests/librimix_similar_content_v2_tts/clean/test/synthetic_interferer/1320-122617-0030_8455-210777-0056__T2__SCV2TTS__8455-8455-210777-0056__VOICE__1320.wav"}, "sir_db": 0.0}

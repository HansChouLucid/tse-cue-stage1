ST IN A FLUX OF SENSE", "synthetic_interferer": "/data/tse_cue_project/manifests/librimix_similar_content_v2_tts/clean/test/synthetic_interferer/2961-960-0020_237-134493-0005__T2__SCV2TTS__237-237-134493-0005__VOICE__2961.wav"}, "sir_db": 0.0}

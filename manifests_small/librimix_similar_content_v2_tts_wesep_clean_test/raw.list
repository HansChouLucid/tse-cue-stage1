{"key": "1580-141084-0011_1284-1181-0003__T2__SCV2TTS__1284-1284-1181-0003__VOICE__1580", "condition": "similar_content_v2_tts", "spk": ["1284", "1580"], "mix": {"default": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/mix_clean/1580-141084-0011_1284-1181-0003__T2__SCV2TTS__1284-1284-1181-0003__VOICE__1580.wav"]}, "src": {"1284": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/s1/1580-141084-0011_1284-1181-0003__T2__SCV2TTS__1284-1284-1181-0003__VOICE__1580.wav"], "1580": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/s2/1580-141084-0011_1284-1181-0003__T2__SCV2TTS__1284-1284-1181-0003__VOICE__1580.wav"]}, "target_text": "THE HAIR WAS OF BROWN YARN AND HUNG DOWN ON HER NECK IN SEVERAL NEAT BRAIDS", "source_meta": {"key": "1580-141084-0011_1284-1181-0003__T2__SCV2TTS__1284-1284-1181-0003__VOICE__1580", "mixture_id": "1580-141084-0011_1284-1181-0003", "target_source": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/1284/1181/1284-1181-0003.flac", "target_spk": "1284", "target_utt": "1284-1181-0003", "target_text": "THE HAIR WAS OF BROWN YARN AND HUNG DOWN ON HER NECK IN SEVERAL NEAT BRAIDS", "original_interferer_source": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/1580/141084/1580-141084-0011.flac", "interferer_spk": "1580", "interferer_utt": "1580-141084-0011", "prompt_audio": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/1580/141083/1580-141083-0000.flac", "prompt_utt": "1580-141083-0000", "prompt_text": "I WILL ENDEAVOUR IN MY STATEMENT TO AVOID SUCH TERMS AS WOULD SERVE TO LIMIT THE EVENTS TO ANY PARTICULAR PLACE OR GIVE A CLUE AS TO THE PEOPLE CONCERNED", "synthetic_interferer": "/data/tse_cue_project/manifests/librimix_similar_content_v2_tts/clean/test/synthetic_interferer/1580-141084-0011_1284-1181-0003__T2__SCV2TTS__1284-1284-1181-0003__VOICE__1580.wav"}, "sir_db": 0.0}
{"key": "8455-210777-0053_3575-170457-0033__T1__SCV2TTS__8455-8455-210777-0053__VOICE__3575", "condition": "similar_content_v2_tts", "spk": ["8455", "3575"], "mix": {"default": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/mix_clean/8455-210777-0053_3575-170457-0033__T1__SCV2TTS__8455-8455-210777-0053__VOICE__3575.wav"]}, "src": {"8455": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/s1/8455-210777-0053_3575-170457-0033__T1__SCV2TTS__8455-8455-210777-0053__VOICE__3575.wav"], "3575": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/s2/8455-210777-0053_3575-170457-0033__T1__SCV2TTS__8455-8455-210777-0053__VOICE__3575.wav"]}, "target_text": "WERE I TO COMPLY WITH YOUR ORDERS WITHOUT EXPRESSING MY OWN OPINION I SHOULD SEEM TO HAVE DONE SO WILLINGLY HEREAFTER", "source_meta": {"key": "8455-210777-0053_3575-170457-0033__T1__SCV2TTS__8455-8455-210777-0053__VOICE__3575", "mixture_id": "8455-210777-0053_3575-170457-0033", "target_source": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/8455/210777/8455-210777-0053.flac", "target_spk": "8455", "target_utt": "8455-210777-0053", "target_text": "WERE I TO COMPLY WITH YOUR ORDERS WITHOUT EXPRESSING MY OWN OPINION I SHOULD SEEM TO HAVE DONE SO WILLINGLY HEREAFTER", "original_interferer_source": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/3575/170457/3575-170457-0033.flac", "interferer_spk": "3575", "interferer_utt": "3575-170457-0033", "prompt_audio": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/3575/170457/3575-170457-0000.flac", "prompt_utt": "3575-170457-0000", "prompt_text": "AND OFTEN HAS MY MOTHER SAID WHILE ON HER LAP I LAID MY HEAD SHE FEARED FOR TIME I WAS NOT MADE BUT FOR ETERNITY", "synthetic_interferer": "/data/tse_cue_project/manifests/librimix_similar_content_v2_tts/clean/test/synthetic_interferer/8455-210777-0053_3575-170457-0033__T1__SCV2TTS__8455-8455-210777-0053__VOICE__3575.wav"}, "sir_db": 0.0}
{"key": "8455-210777-0053_3575-170457-0033__T2__SCV2TTS__3575-3575-170457-0033__VOICE__8455", "condition": "similar_content_v2_tts", "spk": ["3575", "8455"], "mix": {"default": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/mix_clean/8455-210777-0053_3575-170457-0033__T2__SCV2TTS__3575-3575-170457-0033__VOICE__8455.wav"]}, "src": {"3575": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/s1/8455-210777-0053_3575-170457-0033__T2__SCV2TTS__3575-3575-170457-0033__VOICE__8455.wav"], "8455": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/s2/8455-210777-0053_3575-170457-0033__T2__SCV2TTS__3575-3575-170457-0033__VOICE__8455.wav"]}, "target_text": "SATURDAY AFTER SATURDAY COMES ROUND AND I CAN HAVE NO HOPE OF HEARING YOUR KNOCK AT THE DOOR AND THEN BEING TOLD THAT MISS E IS COME OH DEAR", "source_meta": {"key": "8455-210777-0053_3575-170457-0033__T2__SCV2TTS__3575-3575-170457-0033__VOICE__8455", "mixture_id": "8455-210777-0053_3575-170457-0033", "target_source": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/3575/170457/3575-170457-0033.flac", "target_spk": "3575", "target_utt": "3575-170457-0033", "target_text": "SATURDAY AFTER SATURDAY COMES ROUND AND I CAN HAVE NO HOPE OF HEARING YOUR KNOCK AT THE DOOR AND THEN BEING TOLD THAT MISS E IS COME OH DEAR", "original_interferer_source": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/8455/210777/8455-210777-0053.flac", "interferer_spk": "8455", "interferer_utt": "8455-210777-0053", "prompt_audio": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/8455/210777/8455-210777-0000.flac", "prompt_utt": "8455-210777-0000", "prompt_text": "I REMAINED THERE ALONE FOR MANY HOURS BUT I MUST ACKNOWLEDGE THAT BEFORE I LEFT THE CHAMBERS I HAD GRADUALLY BROUGHT MYSELF TO LOOK AT THE MATTER IN ANOTHER LIGHT", "synthetic_interferer": "/data/tse_cue_project/manifests/librimix_similar_content_v2_tts/clean/test/synthetic_interferer/8455-210777-0053_3575-170457-0033__T2__SCV2TTS__3575-3575-170457-0033__VOICE__8455.wav"}, "sir_db": 0.0}
{"key": "1284-1180-0017_2094-142345-0001__T1__SCV2TTS__1284-1284-1180-0017__VOICE__2094", "condition": "similar_content_v2_tts", "spk": ["1284", "2094"], "mix": {"default": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/mix_clean/1284-1180-0017_2094-142345-0001__T1__SCV2TTS__1284-1284-1180-0017__VOICE__2094.wav"]}, "src": {"1284": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/s1/1284-1180-0017_2094-142345-0001__T1__SCV2TTS__1284-1284-1180-0017__VOICE__2094.wav"], "2094": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/s2/1284-1180-0017_2094-142345-0001__T1__SCV2TTS__1284-1284-1180-0017__VOICE__2094.wav"]}, "target_text": "AT ONE END STOOD A GREAT FIREPLACE IN WHICH A BLUE LOG WAS BLAZING WITH A BLUE FLAME AND OVER THE FIRE HUNG FOUR KETTLES IN A ROW ALL BUBBLING AND STEAMING AT A GREAT RATE", "source_meta": {"key": "1284-1180-0017_2094-142345-0001__T1__SCV2TTS__1284-1284-1180-0017__VOICE__2094", "mixture_id": "1284-1180-0017_2094-142345-0001", "target_source": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/1284/1180/1284-1180-0017.flac", "target_spk": "1284", "target_utt": "1284-1180-0017", "target_text": "AT ONE END STOOD A GREAT FIREPLACE IN WHICH A BLUE LOG WAS BLAZING WITH A BLUE FLAME AND OVER THE FIRE HUNG FOUR KETTLES IN A ROW ALL BUBBLING AND STEAMING AT A GREAT RATE", "original_interferer_source": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/2094/142345/2094-142345-0001.flac", "interferer_spk": "2094", "interferer_utt": "2094-142345-0001", "prompt_audio": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/2094/142345/2094-142345-0000.flac", "prompt_utt": "2094-142345-0000", "prompt_text": "IT IS A VERY FINE OLD PLACE OF RED BRICK SOFTENED BY A PALE POWDERY LICHEN WHICH HAS DISPERSED ITSELF WITH HAPPY IRREGULARITY SO AS TO BRING THE RED BRICK INTO TERMS OF FRIENDLY COMPANIONSHIP WITH THE LIMESTONE ORNAMENTS SURROUNDING THE THREE GABLES THE WINDOWS AND THE DOOR PLACE", "synthetic_interferer": "/data/tse_cue_project/manifests/librimix_similar_content_v2_tts/clean/test/synthetic_interferer/1284-1180-0017_2094-142345-0001__T1__SCV2TTS__1284-1284-1180-0017__VOICE__2094.wav"}, "sir_db": 0.0}

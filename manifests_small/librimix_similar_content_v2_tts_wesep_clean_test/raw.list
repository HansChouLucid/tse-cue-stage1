ANCE WHEREBY LOVE MAKING MAY BE SUSPENDED BUT NOT STOPPED DURING THE PICNIC SEASON", "synthetic_interferer": "/data/tse_cue_project/manifests/librimix_similar_content_v2_tts/clean/test/synthetic_interferer/8455-210777-0022_121-127105-0011__T1__SCV2TTS__8455-8455-210777-0022__VOICE__121.wav"}, "sir_db": 0.0}

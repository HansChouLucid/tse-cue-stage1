{"key": "61-70970-0028_908-31957-0009__T2__SCV2TTS__908-908-31957-0009__VOICE__61", "condition": "similar_content_v2_tts", "spk": ["908", "61"], "mix": {"default": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/mix_clean/61-70970-0028_908-31957-0009__T2__SCV2TTS__908-908-31957-0009__VOICE__61.wav"]}, "src": {"908": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/s1/61-70970-0028_908-31957-0009__T2__SCV2TTS__908-908-31957-0009__VOICE__61.wav"], "61": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/s2/61-70970-0028_908-31957-0009__T2__SCV2TTS__908-908-31957-0009__VOICE__61.wav"]}, "target_text": "AND THOUGH I HAVE GROWN SERENE AND STRONG SINCE THEN I THINK THAT GOD HAS WILLED A STILL RENEWABLE FEAR", "source_meta": {"key": "61-70970-0028_908-31957-0009__T2__SCV2TTS__908-908-31957-0009__VOICE__61", "mixture_id": "61-70970-0028_908-31957-0009", "target_source": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/908/31957/908-31957-0009.flac", "target_spk": "908", "target_utt": "908-31957-0009", "target_text": "AND THOUGH I HAVE GROWN SERENE AND STRONG SINCE THEN I THINK THAT GOD HAS WILLED A STILL RENEWABLE FEAR", "original_interferer_source": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/61/70970/61-70970-0028.flac", "interferer_spk": "61", "interferer_utt": "61-70970-0028", "prompt_audio": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/61/70968/61-70968-0000.flac", "prompt_utt": "61-70968-0000", "prompt_text": "HE BEGAN A CONFUSED COMPLAINT AGAINST THE WIZARD WHO HAD VANISHED BEHIND THE CURTAIN ON THE LEFT", "synthetic_interferer": "/data/tse_cue_project/manifests/librimix_similar_content_v2_tts/clean/test/synthetic_interferer/61-70970-0028_908-31957-0009__T2__SCV2TTS__908-908-31957-0009__VOICE__61.wav"}, "sir_db": 0.0}

{"key": "3575-170457-0033_5683-32879-0012__T2__SCV2TTS__5683-5683-32879-0012__VOICE__3575", "condition": "similar_content_v2_tts", "spk": ["5683", "3575"], "mix": {"default": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/mix_clean/3575-170457-0033_5683-32879-0012__T2__SCV2TTS__5683-5683-32879-0012__VOICE__3575.wav"]}, "src": {"5683": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/s1/3575-170457-0033_5683-32879-0012__T2__SCV2TTS__5683-5683-32879-0012__VOICE__3575.wav"], "3575": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/s2/3575-170457-0033_5683-32879-0012__T2__SCV2TTS__5683-5683-32879-0012__VOICE__3575.wav"]}, "target_text": "THANK YOU RACHEL MY COUSIN RACHEL MY ONLY FRIEND", "source_meta": {"key": "3575-170457-0033_5683-32879-0012__T2__SCV2TTS__5683-5683-32879-0012__VOICE__3575", "mixture_id": "3575-170457-0033_5683-32879-0012", "target_source": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/5683/32879/5683-32879-0012.flac", "target_spk": "5683", "target_utt": "5683-32879-0012", "target_text": "THANK YOU RACHEL MY COUSIN RACHEL MY ONLY FRIEND", "original_interferer_source": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/3575/170457/3575-170457-0033.flac", "interferer_spk": "3575", "interferer_utt": "3575-170457-0033", "prompt_audio": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/3575/170457/3575-170457-0000.flac", "prompt_utt": "3575-170457-0000", "prompt_text": "AND OFTEN HAS MY MOTHER SAID WHILE ON HER LAP I LAID MY HEAD SHE FEARED FOR TIME I WAS NOT MADE BUT FOR ETERNITY", "synthetic_interferer": "/data/tse_cue_project/manifests/librimix_similar_content_v2_tts/clean/test/synthetic_interferer/3575-170457-0033_5683-32879-0012__T2__SCV2TTS__5683-5683-32879-0012__VOICE__3575.wav"}, "sir_db": 0.0}
{"key": "5142-33396-0034_8455-210777-0059__T1__SCV2TTS__5142-5142-33396-0034__VOICE__8455", "condition": "similar_content_v2_tts", "spk": ["5142", "8455"], "mix": {"default": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/mix_clean/5142-33396-0034_8455-210777-0059__T1__SCV2TTS__5142-5142-33396-0034__VOICE__8455.wav"]}, "src": {"5142": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/s1/5142-33396-0034_8455-210777-0059__T1__SCV2TTS__5142-5142-33396-0034__VOICE__8455.wav"], "8455": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/s2/5142-33396-0034_8455-210777-0059__T1__SCV2TTS__5142-5142-33396-0034__VOICE__8455.wav"]}, "target_text": "THEN I DRANK HALF OF THE HORNFUL AND SENT THE REST ACROSS THE FIRE TO THE FARMER HE TOOK IT AND SMILED SAYING", "source_meta": {"key": "5142-33396-0034_8455-210777-0059__T1__SCV2TTS__5142-5142-33396-0034__VOICE__8455", "mixture_id": "5142-33396-0034_8455-210777-0059", "target_source": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/5142/33396/5142-33396-0034.flac", "target_spk": "5142", "target_utt": "5142-33396-0034", "target_text": "THEN I DRANK HALF OF THE HORNFUL AND SENT THE REST ACROSS THE FIRE TO THE FARMER HE TOOK IT AND SMILED SAYING", "original_interferer_source": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/8455/210777/8455-210777-0059.flac", "interferer_spk": "8455", "interferer_utt": "8455-210777-0059", "prompt_audio": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/8455/210777/8455-210777-0000.flac", "prompt_utt": "8455-210777-0000", "prompt_text": "I REMAINED THERE ALONE FOR MANY HOURS BUT I MUST ACKNOWLEDGE THAT BEFORE I LEFT THE CHAMBERS I HAD GRADUALLY BROUGHT MYSELF TO LOOK AT THE MATTER IN ANOTHER LIGHT", "synthetic_interferer": "/data/tse_cue_project/manifests/librimix_similar_content_v2_tts/clean/test/synthetic_interferer/5142-33396-0034_8455-210777-0059__T1__SCV2TTS__5142-5142-33396-0034__VOICE__8455.wav"}, "sir_db": 0.0}

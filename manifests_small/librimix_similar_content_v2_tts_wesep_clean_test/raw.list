{"key": "5142-36377-0001_1221-135767-0007__T1__SCV2TTS__5142-5142-36377-0001__VOICE__1221", "condition": "similar_content_v2_tts", "spk": ["5142", "1221"], "mix": {"default": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/mix_clean/5142-36377-0001_1221-135767-0007__T1__SCV2TTS__5142-5142-36377-0001__VOICE__1221.wav"]}, "src": {"5142": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/s1/5142-36377-0001_1221-135767-0007__T1__SCV2TTS__5142-5142-36377-0001__VOICE__1221.wav"], "1221": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/s2/5142-36377-0001_1221-135767-0007__T1__SCV2TTS__5142-5142-36377-0001__VOICE__1221.wav"]}, "target_text": "IN FIVE MINUTES I WAS IN A NEW WORLD AND MY MELANCHOLY ROOM WAS FULL OF THE LIVELIEST FRENCH COMPANY", "source_meta": {"key": "5142-36377-0001_1221-135767-0007__T1__SCV2TTS__5142-5142-36377-0001__VOICE__1221", "mixture_id": "5142-36377-0001_1221-135767-0007", "target_source": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/5142/36377/5142-36377-0001.flac", "target_spk": "5142", "target_utt": "5142-36377-0001", "target_text": "IN FIVE MINUTES I WAS IN A NEW WORLD AND MY MELANCHOLY ROOM WAS FULL OF THE LIVELIEST FRENCH COMPANY", "original_interferer_source": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/1221/135767/1221-135767-0007.flac", "interferer_spk": "1221", "interferer_utt": "1221-135767-0007", "prompt_audio": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/1221/135766/1221-135766-0000.flac", "prompt_utt": "1221-135766-0000", "prompt_text": "HOW STRANGE IT SEEMED TO THE SAD WOMAN AS SHE WATCHED THE GROWTH AND THE BEAUTY THAT BECAME EVERY DAY MORE BRILLIANT AND THE INTELLIGENCE THAT THREW ITS QUIVERING SUNSHINE OVER THE TINY FEATURES OF THIS CHILD", "synthetic_interferer": "/data/tse_cue_project/manifests/librimix_similar_content_v2_tts/clean/test/synthetic_interferer/5142-36377-0001_1221-135767-0007__T1__SCV2TTS__5142-5142-36377-0001__VOICE__1221.wav"}, "sir_db": 0.0}

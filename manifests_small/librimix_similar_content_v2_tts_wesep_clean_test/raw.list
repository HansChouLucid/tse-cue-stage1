{"key": "61-70970-0029_1221-135767-0007__T1__SCV2TTS__61-61-70970-0029__VOICE__1221", "condition": "similar_content_v2_tts", "spk": ["61", "1221"], "mix": {"default": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/mix_clean/61-70970-0029_1221-135767-0007__T1__SCV2TTS__61-61-70970-0029__VOICE__1221.wav"]}, "src": {"61": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/s1/61-70970-0029_1221-135767-0007__T1__SCV2TTS__61-61-70970-0029__VOICE__1221.wav"], "1221": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/s2/61-70970-0029_1221-135767-0007__T1__SCV2TTS__61-61-70970-0029__VOICE__1221.wav"]}, "target_text": "FROM THE BLACKNESS BEHIND THE LIGHT THEY HEARD A VOICE WARRENTON'S", "source_meta": {"key": "61-70970-0029_1221-135767-0007__T1__SCV2TTS__61-61-70970-0029__VOICE__1221", "mixture_id": "61-70970-0029_1221-135767-0007", "target_source": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/61/70970/61-70970-0029.flac", "target_spk": "61", "target_utt": "61-70970-0029", "target_text": "FROM THE BLACKNESS BEHIND THE LIGHT THEY HEARD A VOICE WARRENTON'S", "original_interferer_source": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/1221/135767/1221-135767-0007.flac", "interferer_spk": "1221", "interferer_utt": "1221-135767-0007", "prompt_audio": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/1221/135766/1221-135766-0000.flac", "prompt_utt": "1221-135766-0000", "prompt_text": "HOW STRANGE IT SEEMED TO THE SAD WOMAN AS SHE WATCHED THE GROWTH AND THE BEAUTY THAT BECAME EVERY DAY MORE BRILLIANT AND THE INTELLIGENCE THAT THREW ITS QUIVERING SUNSHINE OVER THE TINY FEATURES OF THIS CHILD", "synthetic_interferer": "/data/tse_cue_project/manifests/librimix_similar_content_v2_tts/clean/test/synthetic_interferer/61-70970-0029_1221-135767-0007__T1__SCV2TTS__61-61-70970-0029__VOICE__1221.wav"}, "sir_db": 0.0}
{"key": "61-70970-0029_1221-135767-0007__T2__SCV2TTS__1221-1221-135767-0007__VOICE__61", "condition": "similar_content_v2_tts", "spk": ["1221", "61"], "mix": {"default": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/mix_clean/61-70970-0029_1221-135767-0007__T2__SCV2TTS__1221-1221-135767-0007__VOICE__61.wav"]}, "src": {"1221": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/s1/61-70970-0029_1221-135767-0007__T2__SCV2TTS__1221-1221-135767-0007__VOICE__61.wav"], "61": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/s2/61-70970-0029_1221-135767-0007__T2__SCV2TTS__1221-1221-135767-0007__VOICE__61.wav"]}, "target_text": "BUT IN TRUTH PEARL WAS THE ONE AS WELL AS THE OTHER AND ONLY IN CONSEQUENCE OF THAT IDENTITY HAD HESTER CONTRIVED SO PERFECTLY TO REPRESENT THE SCARLET LETTER IN HER APPEARANCE", "source_meta": {"key": "61-70970-0029_1221-135767-0007__T2__SCV2TTS__1221-1221-135767-0007__VOICE__61", "mixture_id": "61-70970-0029_1221-135767-0007", "target_source": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/1221/135767/1221-135767-0007.flac", "target_spk": "1221", "target_utt": "1221-135767-0007", "target_text": "BUT IN TRUTH PEARL WAS THE ONE AS WELL AS THE OTHER AND ONLY IN CONSEQUENCE OF THAT IDENTITY HAD HESTER CONTRIVED SO PERFECTLY TO REPRESENT THE SCARLET LETTER IN HER APPEARANCE", "original_interferer_source": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/61/70970/61-70970-0029.flac", "interferer_spk": "61", "interferer_utt": "61-70970-0029", "prompt_audio": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/61/70968/61-70968-0000.flac", "prompt_utt": "61-70968-0000", "prompt_text": "HE BEGAN A CONFUSED COMPLAINT AGAINST THE WIZARD WHO HAD VANISHED BEHIND THE CURTAIN ON THE LEFT", "synthetic_interferer": "/data/tse_cue_project/manifests/librimix_similar_content_v2_tts/clean/test/synthetic_interferer/61-70970-0029_1221-135767-0007__T2__SCV2TTS__1221-1221-135767-0007__VOICE__61.wav"}, "sir_db": 0.0}

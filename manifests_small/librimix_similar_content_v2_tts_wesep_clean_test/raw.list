O THE DESIGNERS AND ORNAMENT WORKERS OF THE COURT", "synthetic_interferer": "/data/tse_cue_project/manifests/librimix_similar_content_v2_tts/clean/test/synthetic_interferer/7127-75947-0016_7176-92135-0017__T2__SCV2TTS__7176-7176-92135-0017__VOICE__7127.wav"}, "sir_db": 0.0}

project/manifests/librimix_similar_content_v2_tts/clean/test/synthetic_interferer/5142-36586-0004_8230-279154-0040__T2__SCV2TTS__8230-8230-279154-0040__VOICE__5142.wav"}, "sir_db": 0.0}
{"key": "61-70970-0015_7127-75946-0018__T1__SCV2TTS__61-61-70970-0015__VOICE__7127", "condition": "similar_content_v2_tts", "spk": ["61", "7127"], "mix": {"default": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/mix_clean/61-70970-0015_7127-75946-0018__T1__SCV2TTS__61-61-70970-0015__VOICE__7127.wav"]}, "src": {"61": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/s1/61-70970-0015_7127-75946-0018__T1__SCV2TTS__61-61-70970-0015__VOICE__7127.wav"], "7127": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/s2/61-70970-0015_7127-75946-0018__T1__SCV2TTS__61-61-70970-0015__VOICE__7127.wav"]}, "target_text": "WILL CRIED HE SOFTLY AND STUTELEY WHO HAD CHOSEN HIS COUCH ACROSS THE DOOR OF HIS YOUNG MASTER'S CHAMBER SPRANG UP AT ONCE IN ANSWER", "source_meta": {"key": "61-70970-0015_7127-75946-0018__T1__SCV2TTS__61-61-70970-0015__VOICE__7127", "mixture_id": "61-70970-0015_7127-75946-0018", "target_source": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/61/70970/61-70970-0015.flac", "target_spk": "61", "target_utt": "61-70970-0015", "target_text": "WILL CRIED HE SOFTLY AND STUTELEY WHO HAD CHOSEN HIS COUCH ACROSS THE DOOR OF HIS YOUNG MASTER'S CHAMBER SPRANG UP AT ONCE IN ANSWER", "original_interferer_source": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/7127/75946/7127-75946-0018.flac", "interferer_spk": "7127", "interferer_utt": "7127-75946-0018", "prompt_audio": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/7127/75946/7127-75946-0000.flac", "prompt_utt": "7127-75946-0000", "prompt_text": "AT THE CONCLUSION OF THE BANQUET WHICH WAS SERVED AT FIVE O'CLOCK THE KING ENTERED HIS CABINET WHERE HIS TAILORS WERE AWAITING HIM FOR THE PURPOSE OF TRYING ON THE CELEBRATED COSTUME REPRESENTING SPRING WHICH WAS THE RESULT OF SO MUCH IMAGINATION AND HAD COST SO MANY EFFORTS OF THOUGHT TO THE DESIGNERS AND ORNAMENT WORKERS OF THE COURT", "synthetic_interferer": "/data/tse_cue_project/manifests/librimix_similar_content_v2_tts/clean/test/synthetic_interferer/61-70970-0015_7127-75946-0018__T1__SCV2TTS__61-61-70970-0015__VOICE__7127.wav"}, "sir_db": 0.0}

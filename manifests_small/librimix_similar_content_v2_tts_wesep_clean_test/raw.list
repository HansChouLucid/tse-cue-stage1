1089-134686-0026__T1__SCV2TTS__7127-7127-75947-0024__VOICE__1089.wav"}, "sir_db": 0.0}
{"key": "7127-75947-0024_1089-134686-0026__T2__SCV2TTS__1089-1089-134686-0026__VOICE__7127", "condition": "similar_content_v2_tts", "spk": ["1089", "7127"], "mix": {"default": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/mix_clean/7127-75947-0024_1089-134686-0026__T2__SCV2TTS__1089-1089-134686-0026__VOICE__7127.wav"]}, "src": {"1089": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/s1/7127-75947-0024_1089-134686-0026__T2__SCV2TTS__1089-1089-134686-0026__VOICE__7127.wav"], "7127": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/s2/7127-75947-0024_1089-134686-0026__T2__SCV2TTS__1089-1089-134686-0026__VOICE__7127.wav"]}, "target_text": "THE RECTOR DID NOT ASK FOR A CATECHISM TO HEAR THE LESSON FROM", "source_meta": {"key": "7127-75947-0024_1089-134686-0026__T2__SCV2TTS__1089-1089-134686-0026__VOICE__7127", "mixture_id": "7127-75947-0024_1089-134686-0026", "target_source": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/1089/134686/1089-134686-0026.flac", "target_spk": "1089", "target_utt": "1089-134686-0026", "target_text": "THE RECTOR DID NOT ASK FOR A CATECHISM TO HEAR THE LESSON FROM", "original_interferer_source": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/7127/75947/7127-75947-0024.flac", "interferer_spk": "7127", "interferer_utt": "7127-75947-0024", "prompt_audio": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/7127/75946/7127-75946-0000.flac", "prompt_utt": "7127-75946-0000", "prompt_text": "AT THE CONCLUSION OF THE BANQUET WHICH WAS SERVED AT FIVE O'CLOCK THE KING ENTERED HIS CABINET WHERE HIS TAILORS WERE AWAITING HIM FOR THE PURPOSE OF TRYING ON THE CELEBRATED COSTUME REPRESENTING SPRING WHICH WAS THE RESULT OF SO MUCH IMAGINATION AND HAD COST SO MANY EFFORTS OF THOUGHT TO THE DESIGNERS AND ORNAMENT WORKERS OF THE COURT", "synthetic_interferer": "/data/tse_cue_project/manifests/librimix_similar_content_v2_tts/clean/test/synthetic_interferer/7127-75947-0024_1089-134686-0026__T2__SCV2TTS__1089-1089-134686-0026__VOICE__7127.wav"}, "sir_db": 0.0}
{"key": "4992-23283-0015_8455-210777-0013__T1__SCV2TTS__4992-4992-23283-0015__VOICE__8455", "condition": "similar_content_v2_tts", "spk": ["4992", "8455"], "mix": {"default": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/mix_clean/4992-23283-0015_8455-210777-0013__T1__SCV2TTS__4992-4992-23283-0015__VOICE__8455.wav"]}, "src": {"4992": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/s1/4992-23283-0015_8455-210777-0013__T1__SCV2TTS__4992-4992-23283-0015__VOICE__8455.wav"], "8455": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/s2/4992-23283-0015_8455-210777-0013__T1__SCV2TTS__4992-4992-23283-0015__VOICE__8455.wav"]}, "target_text": "IS SHE NOT AFRAID THAT I WILL THWART HER INCLINATIONS", "source_meta": {"key": "4992-23283-0015_8455-210777-0013__T1__SCV2TTS__4992-4992-23283-0015__VOICE__8455", "mixture_id": "4992-23283-0015_8455-210777-0013", "target_source": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/4992/23283/4992-23283-0015.flac", "target_spk": "4992", "target_utt": "4992-23283-0015", "target_text": "IS SHE NOT AFRAID THAT I WILL THWART HER INCLINATIONS", "original_interferer_source": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/8455/210777/8455-210777-0013.flac", "interferer_spk": "8455", "interferer_utt": "8455-210777-0013", "prompt_audio": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/8455/210777/8455-210777-0000.flac", "prompt_utt": "8455-210777-0000", "prompt_text": "I REMAINED THERE ALONE FOR MANY HOURS BUT I MUST ACKNOWLEDGE THAT BEFORE I LEFT THE CHAMBERS I HAD GRADUALLY BROUGHT MYSELF TO LOOK AT THE MATTER IN ANOTHER LIGHT", "synthetic_interferer": "/data/tse_cue_project/manifests/librimix_similar_content_v2_tts/clean/test/synthetic_interferer/4992-23283-0015_8455-210777-0013__T1__SCV2TTS__4992-4992-23283-0015__VOICE__8455.wav"}, "sir_db": 0.0}
{"key": "4992-23283-0015_8455-210777-0013__T2__SCV2TTS__8455-8455-210777-0013__VOICE__4992", "condition": "similar_content_v2_tts", "spk": ["8455", "4992"], "mix": {"default": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/mix_clean/4992-23283-0015_8455-210777-0013__T2__SCV2TTS__8455-8455-210777-0013__VOICE__4992.wav"]}, "src": {"8455": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/s1/4992-23283-0015_8455-210777-0013__T2__SCV2TTS__8455-8455-210777-0013__VOICE__4992.wav"], "4992": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/s2/4992-23283-0015_8455-210777-0013__T2__SCV2TTS__8455-8455-210777-0013__VOICE__4992.wav"]}, "target_text": "JACK HAD BEEN STANDING IN THE FAR CORNER OF THE ROOM TALKING TO EVA AND WAS NOW REDUCED TO SILENCE BY HIS PRAISES", "source_meta": {"key": "4992-23283-0015_8455-210777-0013__T2__SCV2TTS__8455-8455-210777-0013__VOICE__4992", "mixture_id": "4992-23283-0015_8455-210777-0013", "target_source": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/8455/210777/8455-210777-0013.flac", "target_spk": "8455", "target_utt": "8455-210777-0013", "target_text": "JACK HAD BEEN STANDING IN THE FAR CORNER OF THE ROOM TALKING TO EVA AND WAS NOW REDUCED TO SILENCE BY HIS PRAISES", "original_interferer_source": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/4992/23283/4992-23283-0015.flac", "interferer_spk": "4992", "interferer_utt": "4992-23283-0015", "prompt_audio": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/4992/23283/4992-23283-0000.flac", "prompt_utt": "4992-23283-0000", "prompt_text": "BUT THE MORE FORGETFULNESS HAD THEN PREVAILED THE MORE POWERFUL WAS THE FORCE OF REMEMBRANCE WHEN SHE AWOKE", "synthetic_interferer": "/data/tse_cue_project/manifests/librimix_similar_content_v2_tts/clean/test/synthetic_interferer/4992-23283-0015_8455-210777-0013__T2__SCV2TTS__8455-8455-210777-0013__VOICE__4992.wav"}, "sir_db": 0.0}

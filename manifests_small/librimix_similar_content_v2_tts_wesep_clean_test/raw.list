{"key": "8455-210777-0040_7127-75946-0028__T1__SCV2TTS__8455-8455-210777-0040__VOICE__7127", "condition": "similar_content_v2_tts", "spk": ["8455", "7127"], "mix": {"default": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/mix_clean/8455-210777-0040_7127-75946-0028__T1__SCV2TTS__8455-8455-210777-0040__VOICE__7127.wav"]}, "src": {"8455": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/s1/8455-210777-0040_7127-75946-0028__T1__SCV2TTS__8455-8455-210777-0040__VOICE__7127.wav"], "7127": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/s2/8455-210777-0040_7127-75946-0028__T1__SCV2TTS__8455-8455-210777-0040__VOICE__7127.wav"]}, "target_text": "THEN SAID SIR FERDINANDO THERE IS NOTHING FOR IT BUT THAT HE MUST TAKE YOU WITH HIM", "source_meta": {"key": "8455-210777-0040_7127-75946-0028__T1__SCV2TTS__8455-8455-210777-0040__VOICE__7127", "mixture_id": "8455-210777-0040_7127-75946-0028", "target_source": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/8455/210777/8455-210777-0040.flac", "target_spk": "8455", "target_utt": "8455-210777-0040", "target_text": "THEN SAID SIR FERDINANDO THERE IS NOTHING FOR IT BUT THAT HE MUST TAKE YOU WITH HIM", "original_interferer_source": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/7127/75946/7127-75946-0028.flac", "interferer_spk": "7127", "interferer_utt": "7127-75946-0028", "prompt_audio": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/7127/75946/7127-75946-0000.flac", "prompt_utt": "7127-75946-0000", "prompt_text": "AT THE CONCLUSION OF THE BANQUET WHICH WAS SERVED AT FIVE O'CLOCK THE KING ENTERED HIS CABINET WHERE HIS TAILORS WERE AWAITING HIM FOR THE PURPOSE OF TRYING ON THE CELEBRATED COSTUME REPRESENTING SPRING WHICH WAS THE RESULT OF SO MUCH IMAGINATION AND HAD COST SO MANY EFFORTS OF THOUGHT TO THE DESIGNERS AND ORNAMENT WORKERS OF THE COURT", "synthetic_interferer": "/data/tse_cue_project/manifests/librimix_similar_content_v2_tts/clean/test/synthetic_interferer/8455-210777-0040_7127-75946-0028__T1__SCV2TTS__8455-8455-210777-0040__VOICE__7127.wav"}, "sir_db": 0.0}
{"key": "8455-210777-0040_7127-75946-0028__T2__SCV2TTS__7127-7127-75946-0028__VOICE__8455", "condition": "similar_content_v2_tts", "spk": ["7127", "8455"], "mix": {"default": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/mix_clean/8455-210777-0040_7127-75946-0028__T2__SCV2TTS__7127-7127-75946-0028__VOICE__8455.wav"]}, "src": {"7127": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/s1/8455-210777-0040_7127-75946-0028__T2__SCV2TTS__7127-7127-75946-0028__VOICE__8455.wav"], "8455": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/s2/8455-210777-0040_7127-75946-0028__T2__SCV2TTS__7127-7127-75946-0028__VOICE__8455.wav"]}, "target_text": "BY DEGREES ALL HIS HAPPINESS ALL HIS BRILLIANCY SUBSIDED INTO REGRET AND UNEASINESS SO THAT HIS LIMBS LOST THEIR POWER HIS ARMS HUNG HEAVILY BY HIS SIDES AND HIS HEAD DROOPED AS THOUGH HE WAS STUPEFIED", "source_meta": {"key": "8455-210777-0040_7127-75946-0028__T2__SCV2TTS__7127-7127-75946-0028__VOICE__8455", "mixture_id": "8455-210777-0040_7127-75946-0028", "target_source": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/7127/75946/7127-75946-0028.flac", "target_spk": "7127", "target_utt": "7127-75946-0028", "target_text": "BY DEGREES ALL HIS HAPPINESS ALL HIS BRILLIANCY SUBSIDED INTO REGRET AND UNEASINESS SO THAT HIS LIMBS LOST THEIR POWER HIS ARMS HUNG HEAVILY BY HIS SIDES AND HIS HEAD DROOPED AS THOUGH HE WAS STUPEFIED", "original_interferer_source": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/8455/210777/8455-210777-0040.flac", "interferer_spk": "8455", "interferer_utt": "8455-210777-0040", "prompt_audio": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/8455/210777/8455-210777-0000.flac", "prompt_utt": "8455-210777-0000", "prompt_text": "I REMAINED THERE ALONE FOR MANY HOURS BUT I MUST ACKNOWLEDGE THAT BEFORE I LEFT THE CHAMBERS I HAD GRADUALLY BROUGHT MYSELF TO LOOK AT THE MATTER IN ANOTHER LIGHT", "synthetic_interferer": "/data/tse_cue_project/manifests/librimix_similar_content_v2_tts/clean/test/synthetic_interferer/8455-210777-0040_7127-75946-0028__T2__SCV2TTS__7127-7127-75946-0028__VOICE__8455.wav"}, "sir_db": 0.0}

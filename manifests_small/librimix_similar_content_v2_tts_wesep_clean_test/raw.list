ERNITY", "synthetic_interferer": "/data/tse_cue_project/manifests/librimix_similar_content_v2_tts/clean/test/synthetic_interferer/3575-170457-0011_121-127105-0027__T2__SCV2TTS__121-121-127105-0027__VOICE__3575.wav"}, "sir_db": 0.0}

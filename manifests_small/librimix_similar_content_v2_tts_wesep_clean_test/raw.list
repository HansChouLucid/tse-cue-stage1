{"key": "5639-40744-0020_7021-85628-0001__T1__SCV2TTS__5639-5639-40744-0020__VOICE__7021", "condition": "similar_content_v2_tts", "spk": ["5639", "7021"], "mix": {"default": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/mix_clean/5639-40744-0020_7021-85628-0001__T1__SCV2TTS__5639-5639-40744-0020__VOICE__7021.wav"]}, "src": {"5639": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/s1/5639-40744-0020_7021-85628-0001__T1__SCV2TTS__5639-5639-40744-0020__VOICE__7021.wav"], "7021": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/s2/5639-40744-0020_7021-85628-0001__T1__SCV2TTS__5639-5639-40744-0020__VOICE__7021.wav"]}, "target_text": "THUS DID THIS HUMANE AND RIGHT MINDED FATHER COMFORT HIS UNHAPPY DAUGHTER AND HER MOTHER EMBRACING HER AGAIN DID ALL SHE COULD TO SOOTHE HER FEELINGS", "source_meta": {"key": "5639-40744-0020_7021-85628-0001__T1__SCV2TTS__5639-5639-40744-0020__VOICE__7021", "mixture_id": "5639-40744-0020_7021-85628-0001", "target_source": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/5639/40744/5639-40744-0020.flac", "target_spk": "5639", "target_utt": "5639-40744-0020", "target_text": "THUS DID THIS HUMANE AND RIGHT MINDED FATHER COMFORT HIS UNHAPPY DAUGHTER AND HER MOTHER EMBRACING HER AGAIN DID ALL SHE COULD TO SOOTHE HER FEELINGS", "original_interferer_source": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/7021/85628/7021-85628-0001.flac", "interferer_spk": "7021", "interferer_utt": "7021-85628-0001", "prompt_audio": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/7021/79730/7021-79730-0000.flac", "prompt_utt": "7021-79730-0000", "prompt_text": "THE THREE MODES OF MANAGEMENT", "synthetic_interferer": "/data/tse_cue_project/manifests/librimix_similar_content_v2_tts/clean/test/synthetic_interferer/5639-40744-0020_7021-85628-0001__T1__SCV2TTS__5639-5639-40744-0020__VOICE__7021.wav"}, "sir_db": 0.0}
{"key": "5639-40744-0020_7021-85628-0001__T2__SCV2TTS__7021-7021-85628-0001__VOICE__5639", "condition": "similar_content_v2_tts", "spk": ["7021", "5639"], "mix": {"default": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/mix_clean/5639-40744-0020_7021-85628-0001__T2__SCV2TTS__7021-7021-85628-0001__VOICE__5639.wav"]}, "src": {"7021": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/s1/5639-40744-0020_7021-85628-0001__T2__SCV2TTS__7021-7021-85628-0001__VOICE__5639.wav"], "5639": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/s2/5639-40744-0020_7021-85628-0001__T2__SCV2TTS__7021-7021-85628-0001__VOICE__5639.wav"]}, "target_text": "HE MADE A BOW SO DEEP THAT HIS BACK CAME NEAR BREAKING AND HE WAS DUMBFOUNDED I CAN TELL YOU WHEN HE SAW IT WAS NOBODY BUT ANDERS", "source_meta": {"key": "5639-40744-0020_7021-85628-0001__T2__SCV2TTS__7021-7021-85628-0001__VOICE__5639", "mixture_id": "5639-40744-0020_7021-85628-0001", "target_source": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/7021/85628/7021-85628-0001.flac", "target_spk": "7021", "target_utt": "7021-85628-0001", "target_text": "HE MADE A BOW SO DEEP THAT HIS BACK CAME NEAR BREAKING AND HE WAS DUMBFOUNDED I CAN TELL YOU WHEN HE SAW IT WAS NOBODY BUT ANDERS", "original_interferer_source": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/5639/40744/5639-40744-0020.flac", "interferer_spk": "5639", "interferer_utt": "5639-40744-0020", "prompt_audio": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/5639/40744/5639-40744-0000.flac", "prompt_utt": "5639-40744-0000", "prompt_text": "ELEVEN O'CLOCK HAD STRUCK IT WAS A FINE CLEAR NIGHT THEY WERE THE ONLY PERSONS ON THE ROAD AND THEY SAUNTERED LEISURELY ALONG TO AVOID PAYING THE PRICE OF FATIGUE FOR THE RECREATION PROVIDED FOR THE TOLEDANS IN THEIR VALLEY OR ON THE BANKS OF THEIR RIVER", "synthetic_interferer": "/data/tse_cue_project/manifests/librimix_similar_content_v2_tts/clean/test/synthetic_interferer/5639-40744-0020_7021-85628-0001__T2__SCV2TTS__7021-7021-85628-0001__VOICE__5639.wav"}, "sir_db": 0.0}

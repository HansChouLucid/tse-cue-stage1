{"key": "61-70968-0034_672-122797-0070__T2__SCV2TTS__672-672-122797-0070__VOICE__61", "condition": "similar_content_v2_tts", "spk": ["672", "61"], "mix": {"default": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/mix_clean/61-70968-0034_672-122797-0070__T2__SCV2TTS__672-672-122797-0070__VOICE__61.wav"]}, "src": {"672": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/s1/61-70968-0034_672-122797-0070__T2__SCV2TTS__672-672-122797-0070__VOICE__61.wav"], "61": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/s2/61-70968-0034_672-122797-0070__T2__SCV2TTS__672-672-122797-0070__VOICE__61.wav"]}, "target_text": "THE GOLDEN STAR OF TINSEL WAS STILL ON THE TOP OF THE TREE AND GLITTERED IN THE SUNSHINE", "source_meta": {"key": "61-70968-0034_672-122797-0070__T2__SCV2TTS__672-672-122797-0070__VOICE__61", "mixture_id": "61-70968-0034_672-122797-0070", "target_source": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/672/122797/672-122797-0070.flac", "target_spk": "672", "target_utt": "672-122797-0070", "target_text": "THE GOLDEN STAR OF TINSEL WAS STILL ON THE TOP OF THE TREE AND GLITTERED IN THE SUNSHINE", "original_interferer_source": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/61/70968/61-70968-0034.flac", "interferer_spk": "61", "interferer_utt": "61-70968-0034", "prompt_audio": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/61/70968/61-70968-0000.flac", "prompt_utt": "61-70968-0000", "prompt_text": "HE BEGAN A CONFUSED COMPLAINT AGAINST THE WIZARD WHO HAD VANISHED BEHIND THE CURTAIN ON THE LEFT", "synthetic_interferer": "/data/tse_cue_project/manifests/librimix_similar_content_v2_tts/clean/test/synthetic_interferer/61-70968-0034_672-122797-0070__T2__SCV2TTS__672-672-122797-0070__VOICE__61.wav"}, "sir_db": 0.0}

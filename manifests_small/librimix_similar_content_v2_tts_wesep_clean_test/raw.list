D", "synthetic_interferer": "/data/tse_cue_project/manifests/librimix_similar_content_v2_tts/clean/test/synthetic_interferer/1580-141083-0030_1995-1837-0014__T2__SCV2TTS__1995-1995-1837-0014__VOICE__1580.wav"}, "sir_db": 0.0}

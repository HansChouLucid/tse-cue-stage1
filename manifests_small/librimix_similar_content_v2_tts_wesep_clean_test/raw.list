{"key": "6829-68769-0012_8463-294828-0001__T2__SCV2TTS__8463-8463-294828-0001__VOICE__6829", "condition": "similar_content_v2_tts", "spk": ["8463", "6829"], "mix": {"default": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/mix_clean/6829-68769-0012_8463-294828-0001__T2__SCV2TTS__8463-8463-294828-0001__VOICE__6829.wav"]}, "src": {"8463": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/s1/6829-68769-0012_8463-294828-0001__T2__SCV2TTS__8463-8463-294828-0001__VOICE__6829.wav"], "6829": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/s2/6829-68769-0012_8463-294828-0001__T2__SCV2TTS__8463-8463-294828-0001__VOICE__6829.wav"]}, "target_text": "THREE SECONDS BEFORE THE ARRIVAL OF J B HOBSON'S LETTER I NO MORE DREAMED OF CHASING THE UNICORN THAN OF TRYING FOR THE NORTHWEST PASSAGE", "source_meta": {"key": "6829-68769-0012_8463-294828-0001__T2__SCV2TTS__8463-8463-294828-0001__VOICE__6829", "mixture_id": "6829-68769-0012_8463-294828-0001", "target_source": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/8463/294828/8463-294828-0001.flac", "target_spk": "8463", "target_utt": "8463-294828-0001", "target_text": "THREE SECONDS BEFORE THE ARRIVAL OF J B HOBSON'S LETTER I NO MORE DREAMED OF CHASING THE UNICORN THAN OF TRYING FOR THE NORTHWEST PASSAGE", "original_interferer_source": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/6829/68769/6829-68769-0012.flac", "interferer_spk": "6829", "interferer_utt": "6829-68769-0012", "prompt_audio": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/6829/68769/6829-68769-0000.flac", "prompt_utt": "6829-68769-0000", "prompt_text": "KENNETH AND BETH REFRAINED FROM TELLING THE OTHER GIRLS OR UNCLE JOHN OF OLD WILL ROGERS'S VISIT BUT THEY GOT MISTER WATSON IN THE LIBRARY AND QUESTIONED HIM CLOSELY ABOUT THE PENALTY FOR FORGING A CHECK", "synthetic_interferer": "/data/tse_cue_project/manifests/librimix_similar_content_v2_tts/clean/test/synthetic_interferer/6829-68769-0012_8463-294828-0001__T2__SCV2TTS__8463-8463-294828-0001__VOICE__6829.wav"}, "sir_db": 0.0}
{"key": "4992-41806-0007_7176-88083-0013__T1__SCV2TTS__4992-4992-41806-0007__VOICE__7176", "condition": "similar_content_v2_tts", "spk": ["4992", "7176"], "mix": {"default": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/mix_clean/4992-41806-0007_7176-88083-0013__T1__SCV2TTS__4992-4992-41806-0007__VOICE__7176.wav"]}, "src": {"4992": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/s1/4992-41806-0007_7176-88083-0013__T1__SCV2TTS__4992-4992-41806-0007__VOICE__7176.wav"], "7176": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/s2/4992-41806-0007_7176-88083-0013__T1__SCV2TTS__4992-4992-41806-0007__VOICE__7176.wav"]}, "target_text": "OLIVE HAD PAINTED THE MOTTO ON A LONG NARROW PANEL OF CANVAS AND GIVING IT TO MISTER POPHAM STOOD BY THE FIRESIDE WHILE HE DEFTLY FITTED IT INTO THE PLACE PREPARED FOR IT", "source_meta": {"key": "4992-41806-0007_7176-88083-0013__T1__SCV2TTS__4992-4992-41806-0007__VOICE__7176", "mixture_id": "4992-41806-0007_7176-88083-0013", "target_source": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/4992/41806/4992-41806-0007.flac", "target_spk": "4992", "target_utt": "4992-41806-0007", "target_text": "OLIVE HAD PAINTED THE MOTTO ON A LONG NARROW PANEL OF CANVAS AND GIVING IT TO MISTER POPHAM STOOD BY THE FIRESIDE WHILE HE DEFTLY FITTED IT INTO THE PLACE PREPARED FOR IT", "original_interferer_source": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/7176/88083/7176-88083-0013.flac", "interferer_spk": "7176", "interferer_utt": "7176-88083-0013", "prompt_audio": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/7176/88083/7176-88083-0000.flac", "prompt_utt": "7176-88083-0000", "prompt_text": "ALL ABOUT HIM WAS A TUMULT OF BRIGHT AND BROKEN COLOR SCATTERED IN BROAD SPLASHES", "synthetic_interferer": "/data/tse_cue_project/manifests/librimix_similar_content_v2_tts/clean/test/synthetic_interferer/4992-41806-0007_7176-88083-0013__T1__SCV2TTS__4992-4992-41806-0007__VOICE__7176.wav"}, "sir_db": 0.0}
{"key": "4992-41806-0007_7176-88083-0013__T2__SCV2TTS__7176-7176-88083-0013__VOICE__4992", "condition": "similar_content_v2_tts", "spk": ["7176", "4992"], "mix": {"default": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/mix_clean/4992-41806-0007_7176-88083-0013__T2__SCV2TTS__7176-7176-88083-0013__VOICE__4992.wav"]}, "src": {"7176": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/s1/4992-41806-0007_7176-88083-0013__T2__SCV2TTS__7176-7176-88083-0013__VOICE__4992.wav"], "4992": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/s2/4992-41806-0007_7176-88083-0013__T2__SCV2TTS__7176-7176-88083-0013__VOICE__4992.wav"]}, "target_text": "LIKE HIS UNFORTUNATE LITTLE COUSIN THE TEAL HE TOO HAD FELT THE FEAR OF DEATH SMITTEN INTO HIS HEART AND WAS HEADING DESPERATELY FOR THE REFUGE OF SOME DARK OVERHANGING BANK DEEP FRINGED WITH WEEDS WHERE THE DREADFUL EYE OF THE HAWK SHOULD NOT DISCERN HIM", "source_meta": {"key": "4992-41806-0007_7176-88083-0013__T2__SCV2TTS__7176-7176-88083-0013__VOICE__4992", "mixture_id": "4992-41806-0007_7176-88083-0013", "target_source": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/7176/88083/7176-88083-0013.flac", "target_spk": "7176", "target_utt": "7176-88083-0013", "target_text": "LIKE HIS UNFORTUNATE LITTLE COUSIN THE TEAL HE TOO HAD FELT THE FEAR OF DEATH SMITTEN INTO HIS HEART AND WAS HEADING DESPERATELY FOR THE REFUGE OF SOME DARK OVERHANGING BANK DEEP FRINGED WITH WEEDS WHERE THE DREADFUL EYE OF THE HAWK SHOULD NOT DISCERN HIM", "original_interferer_source": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/4992/41806/4992-41806-0007.flac", "interferer_spk": "4992", "interferer_utt": "4992-41806-0007", "prompt_audio": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/4992/23283/4992-23283-0000.flac", "prompt_utt": "4992-23283-0000", "prompt_text": "BUT THE MORE FORGETFULNESS HAD THEN PREVAILED THE MORE POWERFUL WAS THE FORCE OF REMEMBRANCE WHEN SHE AWOKE", "synthetic_interferer": "/data/tse_cue_project/manifests/librimix_similar_content_v2_tts/clean/test/synthetic_interferer/4992-41806-0007_7176-88083-0013__T2__SCV2TTS__7176-7176-88083-0013__VOICE__4992.wav"}, "sir_db": 0.0}

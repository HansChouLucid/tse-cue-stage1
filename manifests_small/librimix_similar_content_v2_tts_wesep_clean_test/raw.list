IONSHIP WITH THE LIMESTONE ORNAMENTS SURROUNDING THE THREE GABLES THE WINDOWS AND THE DOOR PLACE", "synthetic_interferer": "/data/tse_cue_project/manifests/librimix_similar_content_v2_tts/clean/test/synthetic_interferer/2094-142345-0054_1995-1836-0005__T2__SCV2TTS__1995-1995-1836-0005__VOICE__2094.wav"}, "sir_db": 0.0}

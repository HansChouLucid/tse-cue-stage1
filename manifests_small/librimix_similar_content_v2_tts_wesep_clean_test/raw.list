ATE SYSTEM", "synthetic_interferer": "/data/tse_cue_project/manifests/librimix_similar_content_v2_tts/clean/test/synthetic_interferer/3570-5696-0009_7729-102255-0016__T2__SCV2TTS__7729-7729-102255-0016__VOICE__3570.wav"}, "sir_db": 0.0}

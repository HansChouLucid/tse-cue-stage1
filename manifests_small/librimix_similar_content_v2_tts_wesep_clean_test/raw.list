{"key": "4446-2275-0002_8455-210777-0045__T2__SCV2TTS__8455-8455-210777-0045__VOICE__4446", "condition": "similar_content_v2_tts", "spk": ["8455", "4446"], "mix": {"default": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/mix_clean/4446-2275-0002_8455-210777-0045__T2__SCV2TTS__8455-8455-210777-0045__VOICE__4446.wav"]}, "src": {"8455": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/s1/4446-2275-0002_8455-210777-0045__T2__SCV2TTS__8455-8455-210777-0045__VOICE__4446.wav"], "4446": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/s2/4446-2275-0002_8455-210777-0045__T2__SCV2TTS__8455-8455-210777-0045__VOICE__4446.wav"]}, "target_text": "THEN THE REPUBLIC OF BRITANNULA WAS TO BE DECLARED AS NON EXISTENT AND THE BRITISH FLAG WAS TO BE EXALTED AND A BRITISH GOVERNOR INSTALLED IN THE EXECUTIVE CHAMBERS", "source_meta": {"key": "4446-2275-0002_8455-210777-0045__T2__SCV2TTS__8455-8455-210777-0045__VOICE__4446", "mixture_id": "4446-2275-0002_8455-210777-0045", "target_source": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/8455/210777/8455-210777-0045.flac", "target_spk": "8455", "target_utt": "8455-210777-0045", "target_text": "THEN THE REPUBLIC OF BRITANNULA WAS TO BE DECLARED AS NON EXISTENT AND THE BRITISH FLAG WAS TO BE EXALTED AND A BRITISH GOVERNOR INSTALLED IN THE EXECUTIVE CHAMBERS", "original_interferer_source": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/4446/2275/4446-2275-0002.flac", "interferer_spk": "4446", "interferer_utt": "4446-2275-0002", "prompt_audio": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/4446/2271/4446-2271-0000.flac", "prompt_utt": "4446-2271-0000", "prompt_text": "MAINHALL LIKED ALEXANDER BECAUSE HE WAS AN ENGINEER", "synthetic_interferer": "/data/tse_cue_project/manifests/librimix_similar_content_v2_tts/clean/test/synthetic_interferer/4446-2275-0002_8455-21077
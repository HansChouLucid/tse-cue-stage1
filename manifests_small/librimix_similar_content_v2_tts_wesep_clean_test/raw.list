{"key": "1995-1826-0015_1320-122617-0037__T2__SCV2TTS__1320-1320-122617-0037__VOICE__1995", "condition": "similar_content_v2_tts", "spk": ["1320", "1995"], "mix": {"default": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/mix_clean/1995-1826-0015_1320-122617-0037__T2__SCV2TTS__1320-1320-122617-0037__VOICE__1995.wav"]}, "src": {"1320": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/s1/1995-1826-0015_1320-122617-0037__T2__SCV2TTS__1320-1320-122617-0037__VOICE__1995.wav"], "1995": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/s2/1995-1826-0015_1320-122617-0037__T2__SCV2TTS__1320-1320-122617-0037__VOICE__1995.wav"]}, "target_text": "THE DELAWARE DOG HE SAID LEANING FORWARD AND PEERING THROUGH THE DIM LIGHT TO CATCH THE EXPRESSION OF THE OTHER'S FEATURES IS HE AFRAID", "source_meta": {"key": "1995-1826-0015_1320-122617-0037__T2__SCV2TTS__1320-1320-122617-0037__VOICE__1995", "mixture_id": "1995-1826-0015_1320-122617-0037", "target_source": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/1320/122617/1320-122617-0037.flac", "target_spk": "1320", "target_utt": "1320-122617-0037", "target_text": "THE DELAWARE DOG HE SAID LEANING FORWARD AND PEERING THROUGH THE DIM LIGHT TO CATCH THE EXPRESSION OF THE OTHER'S FEATURES IS HE AFRAID", "original_interferer_source": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/1995/1826/1995-1826-0015.flac", "interferer_spk": "1995", "interferer_utt": "1995-1826-0015", "prompt_audio": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/1995/1826/1995-1826-0000.flac", "prompt_utt": "1995-1826-0000", "prompt_text": "IN THE DEBATE BETWEEN THE SENIOR SOCIETIES HER DEFENCE OF THE FIFTEENTH AMENDMENT HAD BEEN NOT ONLY A NOTABLE BIT OF REASONING BUT DELIVERED WITH REAL ENTHUSIASM", "synthetic_interferer": "/data/tse_cue_project/manifests/librimix_similar_content_v2_tts/clean/test/synthetic_interferer/1995-1826-0015_1320-122617-0037__T2__SCV2TTS__1320-1320-122617-0037__VOICE__1995.wav"}, "sir_db": 0.0}
{"key": "5142-33396-0044_8455-210777-0070__T1__SCV2TTS__5142-5142-33396-0044__VOICE__8455", "condition": "similar_content_v2_tts", "spk": ["5142", "8455"], "mix": {"default": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/mix_clean/5142-33396-0044_8455-210777-0070__T1__SCV2TTS__5142-5142-33396-0044__VOICE__8455.wav"]}, "src": {"5142": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/s1/5142-33396-0044_8455-210777-0070__T1__SCV2TTS__5142-5142-33396-0044__VOICE__8455.wav"], "8455": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/s2/5142-33396-0044_8455-210777-0070__T1__SCV2TTS__5142-5142-33396-0044__VOICE__8455.wav"]}, "target_text": "I AM STIFF WITH LONG SITTING HE SAID I ITCH FOR A FIGHT I TURNED TO THE FARMER", "source_meta": {"key": "5142-33396-0044_8455-210777-0070__T1__SCV2TTS__5142-5142-33396-0044__VOICE__8455", "mixture_id": "5142-33396-0044_8455-210777-0070", "target_source": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/5142/33396/5142-33396-0044.flac", "target_spk": "5142", "target_utt": "5142-33396-0044", "target_text": "I AM STIFF WITH LONG SITTING HE SAID I ITCH FOR A FIGHT I TURNED TO THE FARMER", "original_interferer_source": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/8455/210777/8455-210777-0070.flac", "interferer_spk": "8455", "interferer_utt": "8455-210777-0070", "prompt_audio": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/8455/210777/8455-210777-0000.flac", "prompt_utt": "8455-210777-0000", "prompt_text": "I REMAINED THERE ALONE FOR MANY HOURS BUT I MUST ACKNOWLEDGE THAT BEFORE I LEFT THE CHAMBERS I HAD GRADUALLY BROUGHT MYSELF TO LOOK AT THE MATTER IN ANOTHER LIGHT", "synthetic_interferer": "/data/tse_cue_project/manifests/librimix_similar_content_v2_tts/clean/test/synthetic_interferer/5142-33396-0044_8455-210777-0070__T1__SCV2TTS__5142-5142-33396-0044__VOICE__8455.wav"}, "sir_db": 0.0}

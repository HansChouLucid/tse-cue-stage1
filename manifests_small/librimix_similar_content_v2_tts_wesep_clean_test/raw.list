e_project/manifests/librimix_similar_content_v2_tts/clean/test/synthetic_interferer/1089-134691-0023_1580-141083-0000__T2__SCV2TTS__1580-1580-141083-0000__VOICE__1089.wav"}, "sir_db": 0.0}

ECK", "synthetic_interferer": "/data/tse_cue_project/manifests/librimix_similar_content_v2_tts/clean/test/synthetic_interferer/6829-68769-0003_8463-294825-0006__T2__SCV2TTS__8463-8463-294825-0006__VOICE__6829.wav"}, "sir_db": 0.0}

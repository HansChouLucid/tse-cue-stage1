{"key": "1320-122612-0010_2094-142345-0048__T1__SCV2TTS__1320-1320-122612-0010__VOICE__2094", "condition": "similar_content_v2_tts", "spk": ["1320", "2094"], "mix": {"default": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/mix_clean/1320-122612-0010_2094-142345-0048__T1__SCV2TTS__1320-1320-122612-0010__VOICE__2094.wav"]}, "src": {"1320": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/s1/1320-122612-0010_2094-142345-0048__T1__SCV2TTS__1320-1320-122612-0010__VOICE__2094.wav"], "2094": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/s2/1320-122612-0010_2094-142345-0048__T1__SCV2TTS__1320-1320-122612-0010__VOICE__2094.wav"]}, "target_text": "SEE SAID UNCAS POINTING NORTH AND SOUTH AT THE EVIDENT MARKS OF THE BROAD TRAIL ON EITHER SIDE OF HIM THE DARK HAIR HAS GONE TOWARD THE FOREST", "source_meta": {"key": "1320-122612-0010_2094-142345-0048__T1__SCV2TTS__1320-1320-122612-0010__VOICE__2094", "mixture_id": "1320-122612-0010_2094-142345-0048", "target_source": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/1320/122612/1320-122612-0010.flac", "target_spk": "1320", "target_utt": "1320-122612-0010", "target_text": "SEE SAID UNCAS POINTING NORTH AND SOUTH AT THE EVIDENT MARKS OF THE BROAD TRAIL ON EITHER SIDE OF HIM THE DARK HAIR HAS GONE TOWARD THE FOREST", "original_interferer_source": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/2094/142345/2094-142345-0048.flac", "interferer_spk": "2094", "interferer_utt": "2094-142345-0048", "prompt_audio": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/2094/142345/2094-142345-0000.flac", "prompt_utt": "2094-142345-0000", "prompt_text": "IT IS A VERY FINE OLD PLACE OF RED BRICK SOFTENED BY A PALE POWDERY LICHEN WHICH HAS DISPERSED ITSELF WITH HAPPY IRREGULARITY SO AS TO BRING THE RED BRICK INTO TERMS OF FRIENDLY COMPANIONSHIP WITH THE LIMESTONE ORNAMENTS SURROUNDING THE THREE GABLES THE WINDOWS AND THE DOOR PLACE", "synthetic_interferer": "/data/tse_cue_project/manifests/librimix_similar_content_v2_tts/clean/test/synthetic_interferer/1320-122612-0010_2094-142345-0048__T1__SCV2TTS__1320-1320-122612-0010__VOICE__2094.wav"}, "sir_db": 0.0}

{"key": "8455-210777-0000_61-70968-0011__T2__SCV2TTS__61-61-70968-0011__VOICE__8455", "condition": "similar_content_v2_tts", "spk": ["61", "8455"], "mix": {"default": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/mix_clean/8455-210777-0000_61-70968-0011__T2__SCV2TTS__61-61-70968-0011__VOICE__8455.wav"]}, "src": {"61": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/s1/8455-210777-0000_61-70968-0011__T2__SCV2TTS__61-61-70968-0011__VOICE__8455.wav"], "8455": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/s2/8455-210777-0000_61-70968-0011__T2__SCV2TTS__61-61-70968-0011__VOICE__8455.wav"]}, "target_text": "HE GAVE WAY TO THE OTHERS VERY READILY AND RETREATED UNPERCEIVED BY THE SQUIRE AND MISTRESS FITZOOTH TO THE REAR OF THE TENT", "source_meta": {"key": "8455-210777-0000_61-70968-0011__T2__SCV2TTS__61-61-70968-0011__VOICE__8455", "mixture_id": "8455-210777-0000_61-70968-0011", "target_source": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/61/70968/61-70968-0011.flac", "target_spk": "61", "target_utt": "61-70968-0011", "target_text": "HE GAVE WAY TO THE OTHERS VERY READILY AND RETREATED UNPERCEIVED BY THE SQUIRE AND MISTRESS FITZOOTH TO THE REAR OF THE TENT", "original_interferer_source": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/8455/210777/8455-210777-0000.flac", "interferer_spk": "8455", "interferer_utt": "8455-210777-0000", "prompt_audio": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/8455/210777/8455-210777-0001.flac", "prompt_utt": "8455-210777-0001", "prompt_text": "HAD EVA CRASWELLER NOT BEEN GOOD LOOKING HAD JACK BEEN STILL AT COLLEGE HAD SIR KENNINGTON OVAL REMAINED IN ENGLAND HAD MISTER BUNNIT AND THE BAR KEEPER NOT SUCCEEDED IN STOPPING MY CARRIAGE ON THE HILL SHOULD I HAVE SUCCEEDED IN ARRANGING FOR THE FINAL DEPARTURE OF MY OLD FRIEND", "synthetic_interferer": "/data/tse_cue_project/manifests/librimix_similar_content_v2_tts/clean/test/synthetic_interferer/8455-210777-0000_61-70968-0011__T2__SCV2TTS__61-61-70968-0011__VOICE__8455.wav"}, "sir_db": 0.0}

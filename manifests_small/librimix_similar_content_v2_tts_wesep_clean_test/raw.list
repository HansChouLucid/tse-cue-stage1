erer": "/data/tse_cue_project/manifests/librimix_similar_content_v2_tts/clean/test/synthetic_interferer/237-134500-0015_1089-134691-0004__T1__SCV2TTS__237-237-134500-0015__VOICE__1089.wav"}, "sir_db": 0.0}

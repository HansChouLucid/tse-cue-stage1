 OF THE COURT", "synthetic_interferer": "/data/tse_cue_project/manifests/librimix_similar_content_v2_tts/clean/test/synthetic_interferer/7127-75946-0003_3729-6852-0022__T2__SCV2TTS__3729-3729-6852-0022__VOICE__7127.wav"}, "sir_db": 0.0}

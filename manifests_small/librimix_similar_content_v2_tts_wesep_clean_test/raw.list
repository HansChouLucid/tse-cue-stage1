-4077-13751-0001__VOICE__1995.wav"}, "sir_db": 0.0}
{"key": "1221-135767-0001_7127-75947-0008__T1__SCV2TTS__1221-1221-135767-0001__VOICE__7127", "condition": "similar_content_v2_tts", "spk": ["1221", "7127"], "mix": {"default": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/mix_clean/1221-135767-0001_7127-75947-0008__T1__SCV2TTS__1221-1221-135767-0001__VOICE__7127.wav"]}, "src": {"1221": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/s1/1221-135767-0001_7127-75947-0008__T1__SCV2TTS__1221-1221-135767-0001__VOICE__7127.wav"], "7127": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/s2/1221-135767-0001_7127-75947-0008__T1__SCV2TTS__1221-1221-135767-0001__VOICE__7127.wav"]}, "target_text": "ANOTHER AND FAR MORE IMPORTANT REASON THAN THE DELIVERY OF A PAIR OF EMBROIDERED GLOVES IMPELLED HESTER AT THIS TIME TO SEEK AN INTERVIEW WITH A PERSONAGE OF SO MUCH POWER AND ACTIVITY IN THE AFFAIRS OF THE SETTLEMENT", "source_meta": {"key": "1221-135767-0001_7127-75947-0008__T1__SCV2TTS__1221-1221-135767-0001__VOICE__7127", "mixture_id": "1221-135767-0001_7127-75947-0008", "target_source": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/1221/135767/1221-135767-0001.flac", "target_spk": "1221", "target_utt": "1221-135767-0001", "target_text": "ANOTHER AND FAR MORE IMPORTANT REASON THAN THE DELIVERY OF A PAIR OF EMBROIDERED GLOVES IMPELLED HESTER AT THIS TIME TO SEEK AN INTERVIEW WITH A PERSONAGE OF SO MUCH POWER AND ACTIVITY IN THE AFFAIRS OF THE SETTLEMENT", "original_interferer_source": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/7127/75947/7127-75947-0008.flac", "interferer_spk": "7127", "interferer_utt": "7127-75947-0008", "prompt_audio": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/7127/75946/7127-75946-0000.flac", "prompt_utt": "7127-75946-0000", "prompt_text": "AT THE CONCLUSION OF THE BANQUET WHICH WAS SERVED AT FIVE O'CLOCK THE KING ENTERED HIS CABINET WHERE HIS TAILORS WERE AWAITING HIM FOR THE PURPOSE OF TRYING ON THE CELEBRATED COSTUME REPRESENTING SPRING WHICH WAS THE RESULT OF SO MUCH IMAGINATION AND HAD COST SO MANY EFFORTS OF THOUGHT TO THE DESIGNERS AND ORNAMENT WORKERS OF THE COURT", "synthetic_interferer": "/data/tse_cue_project/manifests/librimix_similar_content_v2_tts/clean/test/synthetic_interferer/1221-135767-0001_7127-75947-0008__T1__SCV2TTS__1221-1221-135767-0001__VOICE__7127.wav"}, "sir_db": 0.0}

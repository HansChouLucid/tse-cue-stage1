{"key": "8455-210777-0041_5683-32879-0019__T2__SCV2TTS__5683-5683-32879-0019__VOICE__8455", "condition": "similar_content_v2_tts", "spk": ["5683", "8455"], "mix": {"default": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/mix_clean/8455-210777-0041_5683-32879-0019__T2__SCV2TTS__5683-5683-32879-0019__VOICE__8455.wav"]}, "src": {"5683": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/s1/8455-210777-0041_5683-32879-0019__T2__SCV2TTS__5683-5683-32879-0019__VOICE__8455.wav"], "8455": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/s2/8455-210777-0041_5683-32879-0019__T2__SCV2TTS__5683-5683-32879-0019__VOICE__8455.wav"]}, "target_text": "I HAVE VERY FEW TO LOVE ME NOW AND I THOUGHT YOU MIGHT LOVE ME AS I HAVE BEGUN TO LOVE YOU", "source_meta": {"key": "8455-210777-0041_5683-32879-0019__T2__SCV2TTS__5683-5683-32879-0019__VOICE__8455", "mixture_id": "8455-210777-0041_5683-32879-0019", "target_source": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/5683/32879/5683-32879-0019.flac", "target_spk": "5683", "target_utt": "5683-32879-0019", "target_text": "I HAVE VERY FEW TO LOVE ME NOW AND I THOUGHT YOU MIGHT LOVE ME AS I HAVE BEGUN TO LOVE YOU", "original_interferer_source": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/8455/210777/8455-210777-0041.flac", "interferer_spk": "8455", "interferer_utt": "8455-210777-0041", "prompt_audio": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/8455/210777/8455-210777-0000.flac", "prompt_utt": "8455-210777-0000", "prompt_text": "I REMAINED THERE ALONE FOR MANY HOURS BUT I MUST ACKNOWLEDGE THAT BEFORE I LEFT THE CHAMBERS I HAD GRADUALLY BROUGHT MYSELF TO LOOK AT THE MATTER IN ANOTHER LIGHT", "synthetic_interferer": "/data/tse_cue_project/manifests/librimix_similar_content_v2_tts/clean/test/synthetic_interferer/8455-210777-0041_5683-32879-0019__T2__SCV2TTS__5683-5683-32879-0019__VOICE__8455.wav"}, "sir_db": 0.0}
{"key": "3570-5695-0015_1580-141084-0000__T1__SCV2TTS__3570-3570-5695-0015__VOICE__1580", "condition": "similar_content_v2_tts", "spk": ["3570", "1580"], "mix": {"default": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/mix_clean/3570-5695-0015_1580-141084-0000__T1__SCV2TTS__3570-3570-5695-0015__VOICE__1580.wav"]}, "src": {"3570": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/s1/3570-5695-0015_1580-141084-0000__T1__SCV2TTS__3570-3570-5695-0015__VOICE__1580.wav"], "1580": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/s2/3570-5695-0015_1580-141084-0000__T1__SCV2TTS__3570-3570-5695-0015__VOICE__1580.wav"]}, "target_text": "THE RESULT IS A GREAT MOBILITY OF THE LABOR EMPLOYED IN PRINTING PERHAPS GREATER THAN IN ANY OTHER EQUALLY WELL DEFINED AND CONSIDERABLE BODY OF WORKMEN", "source_meta": {"key": "3570-5695-0015_1580-141084-0000__T1__SCV2TTS__3570-3570-5695-0015__VOICE__1580", "mixture_id": "3570-5695-0015_1580-141084-0000", "target_source": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/3570/5695/3570-5695-0015.flac", "target_spk": "3570", "target_utt": "3570-5695-0015", "target_text": "THE RESULT IS A GREAT MOBILITY OF THE LABOR EMPLOYED IN PRINTING PERHAPS GREATER THAN IN ANY OTHER EQUALLY WELL DEFINED AND CONSIDERABLE BODY OF WORKMEN", "original_interferer_source": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/1580/141084/1580-141084-0000.flac", "interferer_spk": "1580", "interferer_utt": "1580-141084-0000", "prompt_audio": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/1580/141083/1580-141083-0000.flac", "prompt_utt": "1580-141083-0000", "prompt_text": "I WILL ENDEAVOUR IN MY STATEMENT TO AVOID SUCH TERMS AS WOULD SERVE TO LIMIT THE EVENTS TO ANY PARTICULAR PLACE OR GIVE A CLUE AS TO THE PEOPLE CONCERNED", "synthetic_interferer": "/data/tse_cue_project/manifests/librimix_similar_content_v2_tts/clean/test/synthetic_interferer/3570-5695-0015_1580-141084-0000__T1__SCV2TTS__3570-3570-5695-0015__VOICE__1580.wav"}, "sir_db": 0.0}
{"key": "3570-5695-0015_1580-141084-0000__T2__SCV2TTS__1580-1580-141084-0000__VOICE__3570", "condition": "similar_content_v2_tts", "spk": ["1580", "3570"], "mix": {"default": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/mix_clean/3570-5695-0015_1580-141084-0000__T2__SCV2TTS__1580-1580-141084-0000__VOICE__3570.wav"]}, "src": {"1580": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/s1/3570-5695-0015_1580-141084-0000__T2__SCV2TTS__1580-1580-141084-0000__VOICE__3570.wav"], "3570": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/s2/3570-5695-0015_1580-141084-0000__T2__SCV2TTS__1580-1580-141084-0000__VOICE__3570.wav"]}, "target_text": "IT WAS THE INDIAN WHOSE DARK SILHOUETTE APPEARED SUDDENLY UPON HIS BLIND", "source_meta": {"key": "3570-5695-0015_1580-141084-0000__T2__SCV2TTS__1580-1580-141084-0000__VOICE__3570", "mixture_id": "3570-5695-0015_1580-141084-0000", "target_source": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/1580/141084/1580-141084-0000.flac", "target_spk": "1580", "target_utt": "1580-141084-0000", "target_text": "IT WAS THE INDIAN WHOSE DARK SILHOUETTE APPEARED SUDDENLY UPON HIS BLIND", "original_interferer_source": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/3570/5695/3570-5695-0015.flac", "interferer_spk": "3570", "interferer_utt": "3570-5695-0015", "prompt_audio": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/3570/5694/3570-5694-0000.flac", "prompt_utt": "3570-5694-0000", "prompt_text": "BUT ALREADY AT A POINT IN ECONOMIC EVOLUTION FAR ANTEDATING THE EMERGENCE OF THE LADY SPECIALISED CONSUMPTION OF GOODS AS AN EVIDENCE OF PECUNIARY STRENGTH HAD BEGUN TO WORK OUT IN A MORE OR LESS ELABORATE SYSTEM", "synthetic_interferer": "/data/tse_cue_project/manifests/librimix_similar_content_v2_tts/clean/test/synthetic_interferer/3570-5695-0015_1580-141084-0000__T2__SCV2TTS__1580-1580-141084-0000__VOICE__3570.wav"}, "sir_db": 0.0}

{"key": "1089-134686-0031_61-70968-0026__T2__SCV2TTS__61-61-70968-0026__VOICE__1089", "condition": "similar_content_v2_tts", "spk": ["61", "1089"], "mix": {"default": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/mix_clean/1089-134686-0031_61-70968-0026__T2__SCV2TTS__61-61-70968-0026__VOICE__1089.wav"]}, "src": {"61": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/s1/1089-134686-0031_61-70968-0026__T2__SCV2TTS__61-61-70968-0026__VOICE__1089.wav"], "1089": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/s2/1089-134686-0031_61-70968-0026__T2__SCV2TTS__61-61-70968-0026__VOICE__1089.wav"]}, "target_text": "THE STROLLERS TOOK THEIR PART IN IT WITH HEARTY ZEST NOW THAT THEY HAD SOME CHANCE OF BEATING OFF THEIR FOES", "source_meta": {"key": "1089-134686-0031_61-70968-0026__T2__SCV2TTS__61-61-70968-0026__VOICE__1089", "mixture_id": "1089-134686-0031_61-70968-0026", "target_source": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/61/70968/61-70968-0026.flac", "target_spk": "61", "target_utt": "61-70968-0026", "target_text": "THE STROLLERS TOOK THEIR PART IN IT WITH HEARTY ZEST NOW THAT THEY HAD SOME CHANCE OF BEATING OFF THEIR FOES", "original_interferer_source": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/1089/134686/1089-134686-0031.flac", "interferer_spk": "1089", "interferer_utt": "1089-134686-0031", "prompt_audio": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/1089/134686/1089-134686-0000.flac", "prompt_utt": "1089-134686-0000", "prompt_text": "HE HOPED THERE WOULD BE STEW FOR DINNER TURNIPS AND CARROTS AND BRUISED POTATOES AND FAT MUTTON PIECES TO BE LADLED OUT IN THICK PEPPERED FLOUR FATTENED SAUCE", "synthetic_interferer": "/data/tse_cue_project/manifests/librimix_similar_content_v2_tts/clean/test/synthetic_interferer/1089-134686-0031_61-70968-0026__T2__SCV2TTS__61-61-70968-0026__VOICE__1089.wav"}, "sir_db": 0.0}
{"key": "1284-1180-0005_6829-68771-0000__T1__SCV2TTS__1284-1284-1180-0005__VOICE__6829", "condition": "similar_content_v2_tts", "spk": ["1284", "6829"], "mix": {"default": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/mix_clean/1284-1180-0005_6829-68771-0000__T1__SCV2TTS__1284-1284-1180-0005__VOICE__6829.wav"]}, "src": {"1284": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/s1/1284-1180-0005_6829-68771-0000__T1__SCV2TTS__1284-1284-1180-0005__VOICE__6829.wav"], "6829": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/s2/1284-1180-0005_6829-68771-0000__T1__SCV2TTS__1284-1284-1180-0005__VOICE__6829.wav"]}, "target_text": "NO ONE WOULD DISTURB THEIR LITTLE HOUSE EVEN IF ANYONE CAME SO FAR INTO THE THICK FOREST WHILE THEY WERE GONE", "source_meta": {"key": "1284-1180-0005_6829-68771-0000__T1__SCV2TTS__1284-1284-1180-0005__VOICE__6829", "mixture_id": "1284-1180-0005_6829-68771-0000", "target_source": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/1284/1180/1284-1180-0005.flac", "target_spk": "1284", "target_utt": "1284-1180-0005", "target_text": "NO ONE WOULD DISTURB THEIR LITTLE HOUSE EVEN IF ANYONE CAME SO FAR INTO THE THICK FOREST WHILE THEY WERE GONE", "original_interferer_source": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/6829/68771/6829-68771-0000.flac", "interferer_spk": "6829", "interferer_utt": "6829-68771-0000", "prompt_audio": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/6829/68769/6829-68769-0000.flac", "prompt_utt": "6829-68769-0000", "prompt_text": "KENNETH AND BETH REFRAINED FROM TELLING THE OTHER GIRLS OR UNCLE JOHN OF OLD WILL ROGERS'S VISIT BUT THEY GOT MISTER WATSON IN THE LIBRARY AND QUESTIONED HIM CLOSELY ABOUT THE PENALTY FOR FORGING A CHECK", "synthetic_interferer": "/data/tse_cue_project/manifests/librimix_similar_content_v2_tts/clean/test/synthetic_interferer/1284-1180-0005_6829-68771-0000__T1__SCV2TTS__1284-1284-1180-0005__VOICE__6829.wav"}, "sir_db": 0.0}

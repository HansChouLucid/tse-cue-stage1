{"key": "8455-210777-0034_8555-284449-0004__T2__SCV2TTS__8555-8555-284449-0004__VOICE__8455", "condition": "similar_content_v2_tts", "spk": ["8555", "8455"], "mix": {"default": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/mix_clean/8455-210777-0034_8555-284449-0004__T2__SCV2TTS__8555-8555-284449-0004__VOICE__8455.wav"]}, "src": {"8555": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/s1/8455-210777-0034_8555-284449-0004__T2__SCV2TTS__8555-8555-284449-0004__VOICE__8455.wav"], "8455": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/s2/8455-210777-0034_8555-284449-0004__T2__SCV2TTS__8555-8555-284449-0004__VOICE__8455.wav"]}, "target_text": "SINCE LAST THURSDAY I GHIP GHISIZZLE HAVE BEEN THE LAWFUL BOOLOOROO OF THE BLUE COUNTRY BUT NOW THAT YOU ARE CONQUERED BY QUEEN TROT I SUPPOSE I AM CONQUERED TOO AND YOU HAVE NO BOOLOOROO AT ALL", "source_meta": {"key": "8455-210777-0034_8555-284449-0004__T2__SCV2TTS__8555-8555-284449-0004__VOICE__8455", "mixture_id": "8455-210777-0034_8555-284449-0004", "target_source": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/8555/284449/8555-284449-0004.flac", "target_spk": "8555", "target_utt": "8555-284449-0004", "target_text": "SINCE LAST THURSDAY I GHIP GHISIZZLE HAVE BEEN THE LAWFUL BOOLOOROO OF THE BLUE COUNTRY BUT NOW THAT YOU ARE CONQUERED BY QUEEN TROT I SUPPOSE I AM CONQUERED TOO AND YOU HAVE NO BOOLOOROO AT ALL", "original_interferer_source": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/8455/210777/8455-210777-0034.flac", "interferer_spk": "8455", "interferer_utt": "8455-210777-0034", "prompt_audio": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/8455/210777/8455-210777-0000.flac", "prompt_utt": "8455-210777-0000", "prompt_text": "I REMAINED THERE ALONE FOR MANY HOURS BUT I MUST ACKNOWLEDGE THAT BEFORE I LEFT THE CHAMBERS I HAD GRADUALLY BROUGHT
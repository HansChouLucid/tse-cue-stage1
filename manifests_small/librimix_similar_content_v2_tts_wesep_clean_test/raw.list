e_cue_project/manifests/librimix_similar_content_v2_tts/clean/test/synthetic_interferer/237-126133-0024_8555-284449-0003__T1__SCV2TTS__237-237-126133-0024__VOICE__8555.wav"}, "sir_db": 0.0}

N A FLUX OF SENSE", "synthetic_interferer": "/data/tse_cue_project/manifests/librimix_similar_content_v2_tts/clean/test/synthetic_interferer/2961-961-0010_4992-41797-0015__T2__SCV2TTS__4992-4992-41797-0015__VOICE__2961.wav"}, "sir_db": 0.0}

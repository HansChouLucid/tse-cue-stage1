OD GRACES FOR ALL TIME", "synthetic_interferer": "/data/tse_cue_project/manifests/librimix_similar_content_v2_tts/clean/test/synthetic_interferer/237-134500-0014_260-123288-0005__T2__SCV2TTS__260-260-123288-0005__VOICE__237.wav"}, "sir_db": 0.0}

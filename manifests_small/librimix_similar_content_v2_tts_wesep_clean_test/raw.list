4-0010_2961-961-0018__T1__SCV2TTS__5639-5639-40744-0010__VOICE__2961.wav"}, "sir_db": 0.0}
{"key": "5639-40744-0010_2961-961-0018__T2__SCV2TTS__2961-2961-961-0018__VOICE__5639", "condition": "similar_content_v2_tts", "spk": ["2961", "5639"], "mix": {"default": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/mix_clean/5639-40744-0010_2961-961-0018__T2__SCV2TTS__2961-2961-961-0018__VOICE__5639.wav"]}, "src": {"2961": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/s1/5639-40744-0010_2961-961-0018__T2__SCV2TTS__2961-2961-961-0018__VOICE__5639.wav"], "5639": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/s2/5639-40744-0010_2961-961-0018__T2__SCV2TTS__2961-2961-961-0018__VOICE__5639.wav"]}, "target_text": "THE MOST FAMOUS OF THEM ALL WAS THE OVERTHROW OF THE ISLAND OF ATLANTIS", "source_meta": {"key": "5639-40744-0010_2961-961-0018__T2__SCV2TTS__2961-2961-961-0018__VOICE__5639", "mixture_id": "5639-40744-0010_2961-961-0018", "target_source": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/2961/961/2961-961-0018.flac", "target_spk": "2961", "target_utt": "2961-961-0018", "target_text": "THE MOST FAMOUS OF THEM ALL WAS THE OVERTHROW OF THE ISLAND OF ATLANTIS", "original_interferer_source": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/5639/40744/5639-40744-0010.flac", "interferer_spk": "5639", "interferer_utt": "5639-40744-0010", "prompt_audio": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/5639/40744/5639-40744-0000.flac", "prompt_utt": "5639-40744-0000", "prompt_text": "ELEVEN O'CLOCK HAD STRUCK IT WAS A FINE CLEAR NIGHT THEY WERE THE ONLY PERSONS ON THE ROAD AND THEY SAUNTERED LEISURELY ALONG TO AVOID PAYING THE PRICE OF FATIGUE FOR THE RECREATION PROVIDED FOR THE TOLEDANS IN THEIR VALLEY OR ON THE BANKS OF THEIR RIVER", "synthetic_interferer": "/data/tse_cue_project/manifests/librimix_similar_content_v2_tts/clean/test/synthetic_interferer/5639-40744-0010_2961-961-0018__T2__SCV
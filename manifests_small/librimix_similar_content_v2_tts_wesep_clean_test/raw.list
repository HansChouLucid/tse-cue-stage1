{"key": "3575-170457-0005_7127-75947-0024__T1__SCV2TTS__3575-3575-170457-0005__VOICE__7127", "condition": "similar_content_v2_tts", "spk": ["3575", "7127"], "mix": {"default": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/mix_clean/3575-170457-0005_7127-75947-0024__T1__SCV2TTS__3575-3575-170457-0005__VOICE__7127.wav"]}, "src": {"3575": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/s1/3575-170457-0005_7127-75947-0024__T1__SCV2TTS__3575-3575-170457-0005__VOICE__7127.wav"], "7127": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/s2/3575-170457-0005_7127-75947-0024__T1__SCV2TTS__3575-3575-170457-0005__VOICE__7127.wav"]}, "target_text": "SHE A TORY AND CLERGYMAN'S DAUGHTER WAS ALWAYS IN A MINORITY OF ONE IN OUR HOUSE OF VIOLENT DISSENT AND RADICALISM", "source_meta": {"key": "3575-170457-0005_7127-75947-0024__T1__SCV2TTS__3575-3575-170457-0005__VOICE__7127", "mixture_id": "3575-170457-0005_7127-75947-0024", "target_source": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/3575/170457/3575-170457-0005.flac", "target_spk": "3575", "target_utt": "3575-170457-0005", "target_text": "SHE A TORY AND CLERGYMAN'S DAUGHTER WAS ALWAYS IN A MINORITY OF ONE IN OUR HOUSE OF VIOLENT DISSENT AND RADICALISM", "original_interferer_source": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/7127/75947/7127-75947-0024.flac", "interferer_spk": "7127", "interferer_utt": "7127-75947-0024", "prompt_audio": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/7127/75946/7127-75946-0000.flac", "prompt_utt": "7127-75946-0000", "prompt_text": "AT THE CONCLUSION OF THE BANQUET WHICH WAS SERVED AT FIVE O'CLOCK THE KING ENTERED HIS CABINET WHERE HIS TAILORS WERE AWAITING HIM FOR THE PURPOSE OF TRYING ON THE CELEBRATED COSTUME REPRESENTING SPRING WHICH WAS THE RESULT OF SO MUCH IMAGINATION AND HAD COST SO MANY EFFORTS OF THOUGHT TO THE DESIGNERS AND ORNAMENT WORKERS OF THE COURT", "synthetic_interferer": "/data/tse_cue_project/manifests/librimix_similar_content_v2_tts/clean/test/synthetic_interferer/3575-170457-0005_7127-75947-0024__T1__SCV2TTS__3575-3575-170457-0005__VOICE__7127.wav"}, "sir_db": 0.0}
{"key": "3575-170457-0005_7127-75947-0024__T2__SCV2TTS__7127-7127-75947-0024__VOICE__3575", "condition": "similar_content_v2_tts", "spk": ["7127", "3575"], "mix": {"default": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/mix_clean/3575-170457-0005_7127-75947-0024__T2__SCV2TTS__7127-7127-75947-0024__VOICE__3575.wav"]}, "src": {"7127": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/s1/3575-170457-0005_7127-75947-0024__T2__SCV2TTS__7127-7127-75947-0024__VOICE__3575.wav"], "3575": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/s2/3575-170457-0005_7127-75947-0024__T2__SCV2TTS__7127-7127-75947-0024__VOICE__3575.wav"]}, "target_text": "LOOK YONDER DO YOU NOT SEE THE MOON SLOWLY RISING SILVERING THE TOPMOST BRANCHES OF THE CHESTNUTS AND THE OAKS", "source_meta": {"key": "3575-170457-0005_7127-75947-0024__T2__SCV2TTS__7127-7127-75947-0024__VOICE__3575", "mixture_id": "3575-170457-0005_7127-75947-0024", "target_source": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/7127/75947/7127-75947-0024.flac", "target_spk": "7127", "target_utt": "7127-75947-0024", "target_text": "LOOK YONDER DO YOU NOT SEE THE MOON SLOWLY RISING SILVERING THE TOPMOST BRANCHES OF THE CHESTNUTS AND THE OAKS", "original_interferer_source": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/3575/170457/3575-170457-0005.flac", "interferer_spk": "3575", "interferer_utt": "3575-170457-0005", "prompt_audio": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/3575/170457/3575-170457-0000.flac", "prompt_utt": "3575-170457-0000", "prompt_text": "AND OFTEN HAS MY MOTHER SAID WHILE ON HER LAP I LAID MY HEAD SHE FEARED FOR TIME I WAS NOT MADE BUT FOR ETERNITY", "synthetic_interferer": "/data/tse_cue_project/manifests/librimix_similar_content_v2_tts/clean/test/synthetic_interferer/3575-170457-0005_7127-75947-0024__T2__SCV2TTS__7127-7127-75947-0024__VOICE__3575.wav"}, "sir_db": 0.0}

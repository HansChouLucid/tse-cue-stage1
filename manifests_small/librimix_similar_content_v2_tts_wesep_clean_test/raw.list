{"key": "6829-68771-0022_3570-5694-0000__T2__SCV2TTS__3570-3570-5694-0000__VOICE__6829", "condition": "similar_content_v2_tts", "spk": ["3570", "6829"], "mix": {"default": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/mix_clean/6829-68771-0022_3570-5694-0000__T2__SCV2TTS__3570-3570-5694-0000__VOICE__6829.wav"]}, "src": {"3570": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/s1/6829-68771-0022_3570-5694-0000__T2__SCV2TTS__3570-3570-5694-0000__VOICE__6829.wav"], "6829": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/s2/6829-68771-0022_3570-5694-0000__T2__SCV2TTS__3570-3570-5694-0000__VOICE__6829.wav"]}, "target_text": "BUT ALREADY AT A POINT IN ECONOMIC EVOLUTION FAR ANTEDATING THE EMERGENCE OF THE LADY SPECIALISED CONSUMPTION OF GOODS AS AN EVIDENCE OF PECUNIARY STRENGTH HAD BEGUN TO WORK OUT IN A MORE OR LESS ELABORATE SYSTEM", "source_meta": {"key": "6829-68771-0022_3570-5694-0000__T2__SCV2TTS__3570-3570-5694-0000__VOICE__6829", "mixture_id": "6829-68771-0022_3570-5694-0000", "target_source": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/3570/5694/3570-5694-0000.flac", "target_spk": "3570", "target_utt": "3570-5694-0000", "target_text": "BUT ALREADY AT A POINT IN ECONOMIC EVOLUTION FAR ANTEDATING THE EMERGENCE OF THE LADY SPECIALISED CONSUMPTION OF GOODS AS AN EVIDENCE OF PECUNIARY STRENGTH HAD BEGUN TO WORK OUT IN A MORE OR LESS ELABORATE SYSTEM", "original_interferer_source": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/6829/68771/6829-68771-0022.flac", "interferer_spk": "6829", "interferer_utt": "6829-68771-0022", "prompt_audio": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/6829/68769/6829-68769-0000.flac", "prompt_utt": "6829-68769-0000", "prompt_text": "KENNETH AND BETH REFRAINED FROM TELLING THE OTHER GIRLS OR UNCLE JOHN OF OLD WILL ROGERS'S VISIT BUT THEY GOT MISTER WATSON IN THE LIBRARY AND QUESTIONED HIM CLOSELY ABOUT THE PENALTY FOR FORGING A CHECK", "synthetic_interferer": "/data/tse_cue_project/manifests/librimix_similar_content_v2_tts/clean/test/synthetic_interferer/6829-68771-0022_3570-5694-0000__T2__SCV2TTS__3570-3570-5694-0000__VOICE__6829.wav"}, "sir_db": 0.0}
{"key": "2961-961-0010_7127-75946-0007__T1__SCV2TTS__2961-2961-961-0010__VOICE__7127", "condition": "similar_content_v2_tts", "spk": ["2961", "7127"], "mix": {"default": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/mix_clean/2961-961-0010_7127-75946-0007__T1__SCV2TTS__2961-2961-961-0010__VOICE__7127.wav"]}, "src": {"2961": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/s1/2961-961-0010_7127-75946-0007__T1__SCV2TTS__2961-2961-961-0010__VOICE__7127.wav"], "7127": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/s2/2961-961-0010_7127-75946-0007__T1__SCV2TTS__2961-2961-961-0010__VOICE__7127.wav"]}, "target_text": "BUT IN EGYPT THE TRADITIONS OF OUR OWN AND OTHER LANDS ARE BY US REGISTERED FOR EVER IN OUR TEMPLES", "source_meta": {"key": "2961-961-0010_7127-75946-0007__T1__SCV2TTS__2961-2961-961-0010__VOICE__7127", "mixture_id": "2961-961-0010_7127-75946-0007", "target_source": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/2961/961/2961-961-0010.flac", "target_spk": "2961", "target_utt": "2961-961-0010", "target_text": "BUT IN EGYPT THE TRADITIONS OF OUR OWN AND OTHER LANDS ARE BY US REGISTERED FOR EVER IN OUR TEMPLES", "original_interferer_source": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/7127/75946/7127-75946-0007.flac", "interferer_spk": "7127", "interferer_utt": "7127-75946-0007", "prompt_audio": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/7127/75946/7127-75946-0000.flac", "prompt_utt": "7127-75946-0000", "prompt_text": "AT THE CONCLUSION OF THE BANQUET WHICH WAS SERVED AT FIVE O'CLOCK THE KING ENTERED HIS CABINET WHERE HIS TAILORS WERE AWAITING HIM FOR THE PURPOSE OF TRYING ON THE CELEBRATED COSTUME REPRESENTING SPRING WHICH WAS THE RESULT OF SO MUCH IMAGINATION AND HAD COST SO MANY EFFORTS OF THOUGHT TO THE DESIGNERS AND ORNAMENT WORKERS OF THE COURT", "synthetic_interferer": "/data/tse_cue_project/manifests/librimix_similar_content_v2_tts/clean/test/synthetic_interferer/2961-961-0010_7127-75946-0007__T1__SCV2TTS__2961-2961-961-0010__VOICE__7127.wav"}, "sir_db": 0.0}

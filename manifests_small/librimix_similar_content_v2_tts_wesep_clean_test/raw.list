{"key": "8455-210777-0060_8463-287645-0006__T2__SCV2TTS__8463-8463-287645-0006__VOICE__8455", "condition": "similar_content_v2_tts", "spk": ["8463", "8455"], "mix": {"default": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/mix_clean/8455-210777-0060_8463-287645-0006__T2__SCV2TTS__8463-8463-287645-0006__VOICE__8455.wav"]}, "src": {"8463": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/s1/8455-210777-0060_8463-287645-0006__T2__SCV2TTS__8463-8463-287645-0006__VOICE__8455.wav"], "8455": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/s2/8455-210777-0060_8463-287645-0006__T2__SCV2TTS__8463-8463-287645-0006__VOICE__8455.wav"]}, "target_text": "THE DOCTOR WHO ATTENDED THE INJURED CREATURE IN THIS CASE WAS SIMPLY TOLD THAT SHE SLIPPED AND FELL DOWN STAIRS AS SHE WAS COMING DOWN", "source_meta": {"key": "8455-210777-0060_8463-287645-0006__T2__SCV2TTS__8463-8463-287645-0006__VOICE__8455", "mixture_id": "8455-210777-0060_8463-287645-0006", "target_source": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/8463/287645/8463-287645-0006.flac", "target_spk": "8463", "target_utt": "8463-287645-0006", "target_text": "THE DOCTOR WHO ATTENDED THE INJURED CREATURE IN THIS CASE WAS SIMPLY TOLD THAT SHE SLIPPED AND FELL DOWN STAIRS AS SHE WAS COMING DOWN", "original_interferer_source": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/8455/210777/8455-210777-0060.flac", "interferer_spk": "8455", "interferer_utt": "8455-210777-0060", "prompt_audio": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/8455/210777/8455-210777-0000.flac", "prompt_utt": "8455-210777-0000", "prompt_text": "I REMAINED THERE ALONE FOR MANY HOURS BUT I MUST ACKNOWLEDGE THAT BEFORE I LEFT THE CHAMBERS I HAD GRADUALLY BROUGHT MYSELF TO LOOK AT THE MATTER IN ANOTHER LIGHT", "synthetic_interferer": "/data/tse_cue_project/manifests/librimix_similar_content_v2_tts/clean/test/synthetic_interferer/8455-210777-0060_8463-287645-0006__T2__SCV2TTS__8463-8463-287645-0006__VOICE__8455.wav"}, "sir_db": 0.0}
{"key": "61-70970-0023_908-31957-0009__T1__SCV2TTS__61-61-70970-0023__VOICE__908", "condition": "similar_content_v2_tts", "spk": ["61", "908"], "mix": {"default": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/mix_clean/61-70970-0023_908-31957-0009__T1__SCV2TTS__61-61-70970-0023__VOICE__908.wav"]}, "src": {"61": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/s1/61-70970-0023_908-31957-0009__T1__SCV2TTS__61-61-70970-0023__VOICE__908.wav"], "908": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/s2/61-70970-0023_908-31957-0009__T1__SCV2TTS__61-61-70970-0023__VOICE__908.wav"]}, "target_text": "BE NOT SO FOOLISH FRIEND SAID FITZOOTH CROSSLY", "source_meta": {"key": "61-70970-0023_908-31957-0009__T1__SCV2TTS__61-61-70970-0023__VOICE__908", "mixture_id": "61-70970-0023_908-31957-0009", "target_source": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/61/70970/61-70970-0023.flac", "target_spk": "61", "target_utt": "61-70970-0023", "target_text": "BE NOT SO FOOLISH FRIEND SAID FITZOOTH CROSSLY", "original_interferer_source": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/908/31957/908-31957-0009.flac", "interferer_spk": "908", "interferer_utt": "908-31957-0009", "prompt_audio": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/908/157963/908-157963-0000.flac", "prompt_utt": "908-157963-0000", "prompt_text": "TO FADE AWAY LIKE MORNING BEAUTY FROM HER MORTAL DAY DOWN BY THE RIVER OF ADONA HER SOFT VOICE IS HEARD AND THUS HER GENTLE LAMENTATION FALLS LIKE MORNING DEW", "synthetic_interferer": "/data/tse_cue_project/manifests/librimix_similar_content_v2_tts/clean/test/synthetic_interferer/61-70970-0023_908-31957-0009__T1__SCV2TTS__61-61-70970-0023__VOICE__908.wav"}, "sir_db": 0.0}
{"key": "61-70970-0023_908-31957-0009__T2__SCV2TTS__908-908-31957-0009__VOICE__61", "condition": "similar_content_v2_tts", "spk": ["908", "61"], "mix": {"default": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/mix_clean/61-70970-0023_908-31957-0009__T2__SCV2TTS__908-908-31957-0009__VOICE__61.wav"]}, "src": {"908": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/s1/61-70970-0023_908-31957-0009__T2__SCV2TTS__908-908-31957-0009__VOICE__61.wav"], "61": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/s2/61-70970-0023_908-31957-0009__T2__SCV2TTS__908-908-31957-0009__VOICE__61.wav"]}, "target_text": "AND THOUGH I HAVE GROWN SERENE AND STRONG SINCE THEN I THINK THAT GOD HAS WILLED A STILL RENEWABLE FEAR", "source_meta": {"key": "61-70970-0023_908-31957-0009__T2__SCV2TTS__908-908-31957-0009__VOICE__61", "mixture_id": "61-70970-0023_908-31957-0009", "target_source": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/908/31957/908-31957-0009.flac", "target_spk": "908", "target_utt": "908-31957-0009", "target_text": "AND THOUGH I HAVE GROWN SERENE AND STRONG SINCE THEN I THINK THAT GOD HAS WILLED A STILL RENEWABLE FEAR", "original_interferer_source": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/61/70970/61-70970-0023.flac", "interferer_spk": "61", "interferer_utt": "61-70970-0023", "prompt_audio": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/61/70968/61-70968-0000.flac", "prompt_utt": "61-70968-0000", "prompt_text": "HE BEGAN A CONFUSED COMPLAINT AGAINST THE WIZARD WHO HAD VANISHED BEHIND THE CURTAIN ON THE LEFT", "synthetic_interferer": "/data/tse_cue_project/manifests/librimix_similar_content_v2_tts/clean/test/synthetic_interferer/61-70970-0023_908-31957-0009__T2__SCV2TTS__908-908-31957-0009__VOICE__61.wav"}, "sir_db": 0.0}

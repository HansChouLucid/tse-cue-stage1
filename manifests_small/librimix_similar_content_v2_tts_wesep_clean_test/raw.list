se_cue_project/manifests/librimix_similar_content_v2_tts/clean/test/synthetic_interferer/237-126133-0015_1320-122612-0008__T1__SCV2TTS__237-237-126133-0015__VOICE__1320.wav"}, "sir_db": 0.0}

ATE ITS WILD RECESSES", "synthetic_interferer": "/data/tse_cue_project/manifests/librimix_similar_content_v2_tts/clean/test/synthetic_interferer/7127-75946-0016_1320-122617-0026__T1__SCV2TTS__7127-7127-75946-0016__VOICE__1320.wav"}, "sir_db": 0.0}

{"key": "1580-141084-0048_237-134500-0037__T1__SCV2TTS__1580-1580-141084-0048__VOICE__237", "condition": "similar_content_v2_tts", "spk": ["1580", "237"], "mix": {"default": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/mix_clean/1580-141084-0048_237-134500-0037__T1__SCV2TTS__1580-1580-141084-0048__VOICE__237.wav"]}, "src": {"1580": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/s1/1580-141084-0048_237-134500-0037__T1__SCV2TTS__1580-1580-141084-0048__VOICE__237.wav"], "237": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/s2/1580-141084-0048_237-134500-0037__T1__SCV2TTS__1580-1580-141084-0048__VOICE__237.wav"]}, "target_text": "IT WILL BE CLEAR TO YOU FROM WHAT I HAVE SAID THAT ONLY YOU COULD HAVE LET THIS YOUNG MAN OUT SINCE YOU WERE LEFT IN THE ROOM AND MUST HAVE LOCKED THE DOOR WHEN YOU WENT OUT", "source_meta": {"key": "1580-141084-0048_237-134500-0037__T1__SCV2TTS__1580-1580-141084-0048__VOICE__237", "mixture_id": "1580-141084-0048_237-134500-0037", "target_source": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/1580/141084/1580-141084-0048.flac", "target_spk": "1580", "target_utt": "1580-141084-0048", "target_text": "IT WILL BE CLEAR TO YOU FROM WHAT I HAVE SAID THAT ONLY YOU COULD HAVE LET THIS YOUNG MAN OUT SINCE YOU WERE LEFT IN THE ROOM AND MUST HAVE LOCKED THE DOOR WHEN YOU WENT OUT", "original_interferer_source": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/237/134500/237-134500-0037.flac", "interferer_spk": "237", "interferer_utt": "237-134500-0037", "prompt_audio": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/237/126133/237-126133-0000.flac", "prompt_utt": "237-126133-0000", "prompt_text": "HERE SHE WOULD STAY COMFORTED AND SOOTHED AMONG THE LOVELY PLANTS AND RICH EXOTICS REJOICING THE HEART OF OLD TURNER THE GARDENER WHO SINCE POLLY'S FIRST RAPTUROUS ENTRANCE HAD TAKEN HER INTO HIS GOOD GRACES FOR ALL TIME", "synthetic_interferer": "/data/tse_cue_project/manifests/librimix_similar_content_v2_tts/clean/test/synthetic_interferer/1580-141084-0048_237-134500-0037__T1__SCV2TTS__1580-1580-141084-0048__VOICE__237.wav"}, "sir_db": 0.0}
{"key": "1580-141084-0048_237-134500-0037__T2__SCV2TTS__237-237-134500-0037__VOICE__1580", "condition": "similar_content_v2_tts", "spk": ["237", "1580"], "mix": {"default": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/mix_clean/1580-141084-0048_237-134500-0037__T2__SCV2TTS__237-237-134500-0037__VOICE__1580.wav"]}, "src": {"237": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/s1/1580-141084-0048_237-134500-0037__T2__SCV2TTS__237-237-134500-0037__VOICE__1580.wav"], "1580": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/s2/1580-141084-0048_237-134500-0037__T2__SCV2TTS__237-237-134500-0037__VOICE__1580.wav"]}, "target_text": "BUT EMIL IF I UNDERSTAND THEN ALL OUR GOOD TIMES ARE OVER WE CAN NEVER DO NICE THINGS TOGETHER ANY MORE", "source_meta": {"key": "1580-141084-0048_237-134500-0037__T2__SCV2TTS__237-237-134500-0037__VOICE__1580", "mixture_id": "1580-141084-0048_237-134500-0037", "target_source": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/237/134500/237-134500-0037.flac", "target_spk": "237", "target_utt": "237-134500-0037", "target_text": "BUT EMIL IF I UNDERSTAND THEN ALL OUR GOOD TIMES ARE OVER WE CAN NEVER DO NICE THINGS TOGETHER ANY MORE", "original_interferer_source": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/1580/141084/1580-141084-0048.flac", "interferer_spk": "1580", "interferer_utt": "1580-141084-0048", "prompt_audio": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/1580/141083/1580-141083-0000.flac", "prompt_utt": "1580-141083-0000", "prompt_text": "I WILL ENDEAVOUR IN MY STATEMENT TO AVOID SUCH TERMS AS WOULD SERVE TO LIMIT THE EVENTS TO ANY PARTICULAR PLACE OR GIVE A CLUE AS TO THE PEOPLE CONCERNED", "synthetic_interferer": "/data/tse_cue_project/manifests/librimix_similar_content_v2_tts/clean/test/synthetic_interferer/1580-141084-0048_237-134500-0037__T2__SCV2T
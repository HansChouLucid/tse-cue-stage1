{"key": "5142-36377-0022_1089-134686-0006__T1__SCV2TTS__5142-5142-36377-0022__VOICE__1089", "condition": "similar_content_v2_tts", "spk": ["5142", "1089"], "mix": {"default": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/mix_clean/5142-36377-0022_1089-134686-0006__T1__SCV2TTS__5142-5142-36377-0022__VOICE__1089.wav"]}, "src": {"5142": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/s1/5142-36377-0022_1089-134686-0006__T1__SCV2TTS__5142-5142-36377-0022__VOICE__1089.wav"], "1089": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/s2/5142-36377-0022_1089-134686-0006__T1__SCV2TTS__5142-5142-36377-0022__VOICE__1089.wav"]}, "target_text": "I WISH YOU GOOD NIGHT SHE LAID HER BONY HANDS ON THE BACK OF MISTER MEADOWCROFT'S INVALID CHAIR CUT HIM SHORT IN HIS FAREWELL SALUTATION TO ME AND WHEELED HIM OUT TO HIS BED AS IF SHE WERE WHEELING HIM OUT TO HIS GRAVE", "source_meta": {"key": "5142-36377-0022_1089-134686-0006__T1__SCV2TTS__5142-5142-36377-0022__VOICE__1089", "mixture_id": "5142-36377-0022_1089-134686-0006", "target_source": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/5142/36377/5142-36377-0022.flac", "target_spk": "5142", "target_utt": "5142-36377-0022", "target_text": "I WISH YOU GOOD NIGHT SHE LAID HER BONY HANDS ON THE BACK OF MISTER MEADOWCROFT'S INVALID CHAIR CUT HIM SHORT IN HIS FAREWELL SALUTATION TO ME AND WHEELED HIM OUT TO HIS BED AS IF SHE WERE WHEELING HIM OUT TO HIS GRAVE", "original_interferer_source": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/1089/134686/1089-134686-0006.flac", "interferer_spk": "1089", "interferer_utt": "1089-134686-0006", "prompt_audio": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/1089/134686/1089-134686-0000.flac", "prompt_utt": "1089-134686-0000", "prompt_text": "HE HOPED THERE WOULD BE STEW FOR DINNER TURNIPS AND CARROTS AND BRUISED POTATOES AND FAT MUTTON PIECES TO BE LADLED OUT IN THICK PEPPERED FLOUR FATTENED SAUCE", "synthetic_interferer": "/data/tse_cue_project/manifests/librimix_similar_content_v2_tts/clean/test/synthetic_interferer/5142-36377-0022_1089-134686-0006__T1__SCV2TTS__5142-5142-36377-0022__VOICE__1089.wav"}, "sir_db": 0.0}

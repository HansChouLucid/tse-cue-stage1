{"key": "6829-68769-0026_1284-1180-0030__T2__SCV2TTS__1284-1284-1180-0030__VOICE__6829", "condition": "similar_content_v2_tts", "spk": ["1284", "6829"], "mix": {"default": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/mix_clean/6829-68769-0026_1284-1180-0030__T2__SCV2TTS__1284-1284-1180-0030__VOICE__6829.wav"]}, "src": {"1284": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/s1/6829-68769-0026_1284-1180-0030__T2__SCV2TTS__1284-1284-1180-0030__VOICE__6829.wav"], "6829": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/s2/6829-68769-0026_1284-1180-0030__T2__SCV2TTS__1284-1284-1180-0030__VOICE__6829.wav"]}, "target_text": "WHEN I FOUND IT I SAID TO MYSELF THAT IT WOULD DO NICELY FOR MY SERVANT GIRL FOR WHEN SHE WAS BROUGHT TO LIFE SHE WOULD NOT BE PROUD NOR HAUGHTY AS THE GLASS CAT IS FOR SUCH A DREADFUL MIXTURE OF COLORS WOULD DISCOURAGE HER FROM TRYING TO BE AS DIGNIFIED AS THE BLUE MUNCHKINS ARE", "source_meta": {"key": "6829-68769-0026_1284-1180-0030__T2__SCV2TTS__1284-1284-1180-0030__VOICE__6829", "mixture_id": "6829-68769-0026_1284-1180-0030", "target_source": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/1284/1180/1284-1180-0030.flac", "target_spk": "1284", "target_utt": "1284-1180-0030", "target_text": "WHEN I FOUND IT I SAID TO MYSELF THAT IT WOULD DO NICELY FOR MY SERVANT GIRL FOR WHEN SHE WAS BROUGHT TO LIFE SHE WOULD NOT BE PROUD NOR HAUGHTY AS THE GLASS CAT IS FOR SUCH A DREADFUL MIXTURE OF COLORS WOULD DISCOURAGE HER FROM TRYING TO BE AS DIGNIFIED AS THE BLUE MUNCHKINS ARE", "original_interferer_source": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/6829/68769/6829-68769-0026.flac", "interferer_spk": "6829", "interferer_utt": "6829-68769-0026", "prompt_audio": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/6829/68769/6829-68769-0000.flac", "prompt_utt": "6829-68769-0000", "prompt_text": "KENNETH AND BETH REFRAINED FROM TELLING THE OTHER GIRLS OR UNCLE JOHN OF OLD WILL ROGERS'S VISIT BUT THEY GOT MISTER WATSON IN THE LIBRARY AND QUESTIONED HIM CLOSELY ABOUT THE PENALTY FOR FORGING A CHECK", "synthetic_interferer": "/data/tse_cue_project/manifests/librimix_similar_content_v2_tts/clean/test/synthetic_interferer/6829-68769-0026_1284-1180-0030__T2__SCV2TTS__1284-1284-1180-0030__VOICE__6829.wav"}, "sir_db": 0.0}

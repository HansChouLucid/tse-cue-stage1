/7176-92135-0017_1580-141083-0006__T1__SCV2TTS__7176-7176-92135-0017__VOICE__1580.wav"}, "sir_db": 0.0}
{"key": "7176-92135-0017_1580-141083-0006__T2__SCV2TTS__1580-1580-141083-0006__VOICE__7176", "condition": "similar_content_v2_tts", "spk": ["1580", "7176"], "mix": {"default": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/mix_clean/7176-92135-0017_1580-141083-0006__T2__SCV2TTS__1580-1580-141083-0006__VOICE__7176.wav"]}, "src": {"1580": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/s1/7176-92135-0017_1580-141083-0006__T2__SCV2TTS__1580-1580-141083-0006__VOICE__7176.wav"], "7176": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/s2/7176-92135-0017_1580-141083-0006__T2__SCV2TTS__1580-1580-141083-0006__VOICE__7176.wav"]}, "target_text": "THE ONLY DUPLICATE WHICH EXISTED SO FAR AS I KNEW WAS THAT WHICH BELONGED TO MY SERVANT BANNISTER A MAN WHO HAS LOOKED AFTER MY ROOM FOR TEN YEARS AND WHOSE HONESTY IS ABSOLUTELY ABOVE SUSPICION", "source_meta": {"key": "7176-92135-0017_1580-141083-0006__T2__SCV2TTS__1580-1580-141083-0006__VOICE__7176", "mixture_id": "7176-92135-0017_1580-141083-0006", "target_source": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/1580/141083/1580-141083-0006.flac", "target_spk": "1580", "target_utt": "1580-141083-0006", "target_text": "THE ONLY DUPLICATE WHICH EXISTED SO FAR AS I KNEW WAS THAT WHICH BELONGED TO MY SERVANT BANNISTER A MAN WHO HAS LOOKED AFTER MY ROOM FOR TEN YEARS AND WHOSE HONESTY IS ABSOLUTELY ABOVE SUSPICION", "original_interferer_source": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/7176/92135/7176-92135-0017.flac", "interferer_spk": "7176", "interferer_utt": "7176-92135-0017", "prompt_audio": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/7176/88083/7176-88083-0000.flac", "prompt_utt": "7176-88083-0000", "prompt_text": "ALL ABOUT HIM WAS A TUMULT OF BRIGHT AND BROKEN COLOR SCATTERED IN BROAD SPLASHES", "synthetic_interferer": "/data/tse_cue_project/manifests/librimix_similar_content_v2_tts/clean/test/synthetic_interferer/7176-92135-0017_1580-141083-0006__T2__SCV2TTS__1580-1580-141083-0006__VOICE__7176.wav"}, "sir_db": 0.0}
{"key": "8555-284447-0006_1320-122617-0024__T1__SCV2TTS__8555-8555-284447-0006__VOICE__1320", "condition": "similar_content_v2_tts", "spk": ["8555", "1320"], "mix": {"default": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/mix_clean/8555-284447-0006_1320-122617-0024__T1__SCV2TTS__8555-8555-284447-0006__VOICE__1320.wav"]}, "src": {"8555": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/s1/8555-284447-0006_1320-122617-0024__T1__SCV2TTS__8555-8555-284447-0006__VOICE__1320.wav"], "1320": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/s2/8555-284447-0006_1320-122617-0024__T1__SCV2TTS__8555-8555-284447-0006__VOICE__1320.wav"]}, "target_text": "IN ONE PLACE AT THE HEAD OF THE ROOM WAS A RAISED PLATFORM FOR THE ROYAL FAMILY WITH ELEGANT THRONE CHAIRS FOR THE KING AND QUEEN AND SIX SMALLER BUT RICHLY UPHOLSTERED CHAIRS FOR THE SNUBNOSED PRINCESSES", "source_meta": {"key": "8555-284447-0006_1320-122617-0024__T1__SCV2TTS__8555-8555-284447-0006__VOICE__1320", "mixture_id": "8555-284447-0006_1320-122617-0024", "target_source": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/8555/284447/8555-284447-0006.flac", "target_spk": "8555", "target_utt": "8555-284447-0006", "target_text": "IN ONE PLACE AT THE HEAD OF THE ROOM WAS A RAISED PLATFORM FOR THE ROYAL FAMILY WITH ELEGANT THRONE CHAIRS FOR THE KING AND QUEEN AND SIX SMALLER BUT RICHLY UPHOLSTERED CHAIRS FOR THE SNUBNOSED PRINCESSES", "original_interferer_source": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/1320/122617/1320-122617-0024.flac", "interferer_spk": "1320", "interferer_utt": "1320-122617-0024", "prompt_audio": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/1320/122612/1320-122612-0000.flac", "prompt_utt": "1320-122612-0000", "prompt_text": "SINCE THE PERIOD OF OUR TALE THE ACTIVE SPIRIT OF THE COUNTRY HAS SURROUNDED IT WITH A BELT OF RICH AND THRIVING SETTLEMENTS THOUGH NONE BUT THE HUNTER OR THE SAVAGE IS EVER KNOWN EVEN NOW TO PENETRATE ITS WILD RECESSES", "synthetic_interferer": "/data/tse_cue_project/manifests/librimix_similar_content_v2_tts/clean/test/synthetic_interferer/8555-284447-0006_1320-122617-0024__T1__SCV2TTS__8555-8555-284447-0006__VOICE__1320.wav"}, "sir_db": 0.0}
{"key": "8555-284447-0006_1320-122617-0024__T2__SCV2TTS__1320-1320-122617-0024__VOICE__8555", "condition": "similar_content_v2_tts", "spk": ["1320", "8555"], "mix": {"default": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/mix_clean/8555-284447-0006_1320-122617-0024__T2__SCV2TTS__1320-1320-122617-0024__VOICE__8555.wav"]}, "src": {"1320": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/s1/8555-284447-0006_1320-122617-0024__T2__SCV2TTS__1320-1320-122617-0024__VOICE__8555.wav"], "8555": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/s2/8555-284447-0006_1320-122617-0024__T2__SCV2TTS__1320-1320-122617-0024__VOICE__8555.wav"]}, "target_text": "BUT HAWKEYE WHO WAS TOO MUCH OCCUPIED WITH HIS OWN THOUGHTS TO NOTE THE MOVEMENT CONTINUED SPEAKING MORE TO HIMSELF THAN TO HIS COMPANION", "source_meta": {"key": "8555-284447-0006_1320-122617-0024__T2__SCV2TTS__1320-1320-122617-0024__VOICE__8555", "mixture_id": "8555-284447-0006_1320-122617-0024", "target_source": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/1320/122617/1320-122617-0024.flac", "target_spk": "1320", "target_utt": "1320-122617-0024", "target_text": "BUT HAWKEYE WHO WAS TOO MUCH OCCUPIED WITH HIS OWN THOUGHTS TO NOTE THE MOVEMENT CONTINUED SPEAKING MORE TO HIMSELF THAN TO HIS COMPANION", "original_interferer_source": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/8555/284447/8555-284447-0006.flac", "interferer_spk": "8555", "interferer_utt": "8555-284447-0006", "prompt_audio": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/8555/284447/8555-284447-0000.flac", "prompt_utt": "8555-284447-0000", "prompt_text": "THEN HE RUSHED DOWN STAIRS INTO THE COURTYARD SHOUTING LOUDLY FOR HIS SOLDIERS AND THREATENING TO PATCH EVERYBODY IN HIS DOMINIONS IF THE SAILORMAN WAS NOT RECAPTURED", "synthetic_interferer": "/data/tse_cue_project/manifests/librimix_similar_content_v2_tts/clean/test/synthetic_interferer/8555-284447-0006_1320-122617-0024__T2__SCV2TTS__1320-1320-122617-0024__VOICE__8555.wav"}, "sir_db": 0.0}

LACE", "synthetic_interferer": "/data/tse_cue_project/manifests/librimix_similar_content_v2_tts/clean/test/synthetic_interferer/1995-1836-0006_2094-142345-0036__T1__SCV2TTS__1995-1995-1836-0006__VOICE__2094.wav"}, "sir_db": 0.0}

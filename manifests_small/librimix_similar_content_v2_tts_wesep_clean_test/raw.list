R IN ANOTHER LIGHT", "synthetic_interferer": "/data/tse_cue_project/manifests/librimix_similar_content_v2_tts/clean/test/synthetic_interferer/8455-210777-0008_8555-292519-0000__T2__SCV2TTS__8555-8555-292519-0000__VOICE__8455.wav"}, "sir_db": 0.0}

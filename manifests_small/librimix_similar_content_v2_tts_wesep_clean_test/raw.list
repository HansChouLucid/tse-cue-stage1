{"key": "1995-1826-0025_7021-85628-0007__T2__SCV2TTS__7021-7021-85628-0007__VOICE__1995", "condition": "similar_content_v2_tts", "spk": ["7021", "1995"], "mix": {"default": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/mix_clean/1995-1826-0025_7021-85628-0007__T2__SCV2TTS__7021-7021-85628-0007__VOICE__1995.wav"]}, "src": {"7021": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/s1/1995-1826-0025_7021-85628-0007__T2__SCV2TTS__7021-7021-85628-0007__VOICE__1995.wav"], "1995": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/s2/1995-1826-0025_7021-85628-0007__T2__SCV2TTS__7021-7021-85628-0007__VOICE__1995.wav"]}, "target_text": "AND SHE TOOK ANDERS HAND AND WALKED WITH HIM UP THE BROAD MARBLE STAIRS WHERE SOLDIERS WERE POSTED AT EVERY THIRD STEP AND THROUGH THE MAGNIFICENT HALLS WHERE COURTIERS IN SILK AND VELVET STOOD BOWING WHEREVER HE WENT", "source_meta": {"key": "1995-1826-0025_7021-85628-0007__T2__SCV2TTS__7021-7021-85628-0007__VOICE__1995", "mixture_id": "1995-1826-0025_7021-85628-0007", "target_source": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/7021/85628/7021-85628-0007.flac", "target_spk": "7021", "target_utt": "7021-85628-0007", "target_text": "AND SHE TOOK ANDERS HAND AND WALKED WITH HIM UP THE BROAD MARBLE STAIRS WHERE SOLDIERS WERE POSTED AT EVERY THIRD STEP AND THROUGH THE MAGNIFICENT HALLS WHERE COURTIERS IN SILK AND VELVET STOOD BOWING WHEREVER HE WENT", "original_interferer_source": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/1995/1826/1995-1826-0025.flac", "interferer_spk": "1995", "interferer_utt": "1995-1826-0025", "prompt_audio": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/1995/1826/1995-1826-0000.flac", "prompt_utt": "1995-1826-0000", "prompt_text": "IN THE DEBATE BETWEEN THE SENIOR SOCIETIES HER DEFENCE OF THE FIFTEENTH AMENDMENT HAD BEEN NOT ONLY A NOTABLE BIT OF REASONING BUT DELIVERED WITH REAL ENTHUSIASM", "synthetic_interferer": "/data/tse_cue_project/manifests/librimix_similar_content_v2_tts/clean/test/synthetic_interferer/1995-1826-0025_7021-85628-0007__T2__SCV2TTS__7021-7021-85628-0007__VOICE__1995.wav"}, "sir_db": 0.0}
{"key": "1221-135766-0006_7176-92135-0040__T1__SCV2TTS__1221-1221-135766-0006__VOICE__7176", "condition": "similar_content_v2_tts", "spk": ["1221", "7176"], "mix": {"default": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/mix_clean/1221-135766-0006_7176-92135-0040__T1__SCV2TTS__1221-1221-135766-0006__VOICE__7176.wav"]}, "src": {"1221": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/s1/1221-135766-0006_7176-92135-0040__T1__SCV2TTS__1221-1221-135766-0006__VOICE__7176.wav"], "7176": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/s2/1221-135766-0006_7176-92135-0040__T1__SCV2TTS__1221-1221-135766-0006__VOICE__7176.wav"]}, "target_text": "THEY WERE NOW ILLUMINATED BY THE MORNING RADIANCE OF A YOUNG CHILD'S DISPOSITION BUT LATER IN THE DAY OF EARTHLY EXISTENCE MIGHT BE PROLIFIC OF THE STORM AND WHIRLWIND", "source_meta": {"key": "1221-135766-0006_7176-92135-0040__T1__SCV2TTS__1221-1221-135766-0006__VOICE__7176", "mixture_id": "1221-135766-0006_7176-92135-0040", "target_source": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/1221/135766/1221-135766-0006.flac", "target_spk": "1221", "target_utt": "1221-135766-0006", "target_text": "THEY WERE NOW ILLUMINATED BY THE MORNING RADIANCE OF A YOUNG CHILD'S DISPOSITION BUT LATER IN THE DAY OF EARTHLY EXISTENCE MIGHT BE PROLIFIC OF THE STORM AND WHIRLWIND", "original_interferer_source": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/7176/92135/7176-92135-0040.flac", "interferer_spk": "7176", "interferer_utt": "7176-92135-0040", "prompt_audio": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/7176/88083/7176-88083-0000.flac", "prompt_utt": "7176-88083-0000", "prompt_text": "ALL ABOUT HIM WAS A TUMULT OF BRIGHT AND BROKEN COLOR SCATTERED IN BROAD SPLASHES", "synthetic_interferer": "/data/tse_cue_project/manifests/librimix_similar_content_v2_tts/clean/test/synthetic_interferer/1221-135766-0006_7176-92135-0040__T1__SCV2TTS__1221-1221-135766-0006__VOICE__7176.wav"}, "sir_db": 0.0}

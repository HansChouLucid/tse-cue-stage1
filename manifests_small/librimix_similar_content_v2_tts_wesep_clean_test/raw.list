{"key": "3729-6852-0001_4077-13751-0008__T1__SCV2TTS__3729-3729-6852-0001__VOICE__4077", "condition": "similar_content_v2_tts", "spk": ["3729", "4077"], "mix": {"default": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/mix_clean/3729-6852-0001_4077-13751-0008__T1__SCV2TTS__3729-3729-6852-0001__VOICE__4077.wav"]}, "src": {"3729": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/s1/3729-6852-0001_4077-13751-0008__T1__SCV2TTS__3729-3729-6852-0001__VOICE__4077.wav"], "4077": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/s2/3729-6852-0001_4077-13751-0008__T1__SCV2TTS__3729-3729-6852-0001__VOICE__4077.wav"]}, "target_text": "WITHOUT SAYING IT POSITIVELY SHE MADE ME UNDERSTAND THAT BEING HERSELF AN ILLUSTRIOUS MEMBER OF THE REPUBLIC OF LETTERS SHE WAS WELL AWARE THAT SHE WAS SPEAKING TO AN INSECT", "source_meta": {"key": "3729-6852-0001_4077-13751-0008__T1__SCV2TTS__3729-3729-6852-0001__VOICE__4077", "mixture_id": "3729-6852-0001_4077-13751-0008", "target_source": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/3729/6852/3729-6852-0001.flac", "target_spk": "3729", "target_utt": "3729-6852-0001", "target_text": "WITHOUT SAYING IT POSITIVELY SHE MADE ME UNDERSTAND THAT BEING HERSELF AN ILLUSTRIOUS MEMBER OF THE REPUBLIC OF LETTERS SHE WAS WELL AWARE THAT SHE WAS SPEAKING TO AN INSECT", "original_interferer_source": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/4077/13751/4077-13751-0008.flac", "interferer_spk": "4077", "interferer_utt": "4077-13751-0008", "prompt_audio": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/4077/13751/4077-13751-0000.flac", "prompt_utt": "4077-13751-0000", "prompt_text": "ON THE SIXTH OF APRIL EIGHTEEN THIRTY THE CHURCH OF JESUS CHRIST OF LATTER DAY SAINTS WAS FORMALLY ORGANIZED AND THUS TOOK ON A LEGAL EXISTENCE", "synthetic_interferer": "/data/tse_cue_project/manifests/librimix_similar_content_v2_tts/clean/test/synthetic_interferer/3729-6852-0001_4077-13751-0008__T1__SCV2TTS__3729-3729-6852-0001__VOICE__4077.wav"}, "sir_db": 0.0}
{"key": "3729-6852-0001_4077-13751-0008__T2__SCV2TTS__4077-4077-13751-0008__VOICE__3729", "condition": "similar_content_v2_tts", "spk": ["4077", "3729"], "mix": {"default": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/mix_clean/3729-6852-0001_4077-13751-0008__T2__SCV2TTS__4077-4077-13751-0008__VOICE__3729.wav"]}, "src": {"4077": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/s1/3729-6852-0001_4077-13751-0008__T2__SCV2TTS__4077-4077-13751-0008__VOICE__3729.wav"], "3729": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/s2/3729-6852-0001_4077-13751-0008__T2__SCV2TTS__4077-4077-13751-0008__VOICE__3729.wav"]}, "target_text": "IT IS NOTABLE THAT THE INDIAN TRIBES HAVE GENERALLY REGARDED THE RELIGION OF THE LATTER DAY SAINTS WITH FAVOR SEEING IN THE BOOK OF MORMON STRIKING AGREEMENT WITH THEIR OWN TRADITIONS", "source_meta": {"key": "3729-6852-0001_4077-13751-0008__T2__SCV2TTS__4077-4077-13751-0008__VOICE__3729", "mixture_id": "3729-6852-0001_4077-13751-0008", "target_source": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/4077/13751/4077-13751-0008.flac", "target_spk": "4077", "target_utt": "4077-13751-0008", "target_text": "IT IS NOTABLE THAT THE INDIAN TRIBES HAVE GENERALLY REGARDED THE RELIGION OF THE LATTER DAY SAINTS WITH FAVOR SEEING IN THE BOOK OF MORMON STRIKING AGREEMENT WITH THEIR OWN TRADITIONS", "original_interferer_source": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/3729/6852/3729-6852-0001.flac", "interferer_spk": "3729", "interferer_utt": "3729-6852-0001", "prompt_audio": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/3729/6852/3729-6852-0000.flac", "prompt_utt": "3729-6852-0000", "prompt_text": "TO CELEBRATE THE ARRIVAL OF HER SON SILVIA GAVE A SPLENDID SUPPER TO WHICH SHE HAD INVITED ALL HER RELATIVES AND IT WAS A GOOD OPPORTUNITY FOR ME TO MAKE THEIR ACQUAINTANCE", "synthetic_interferer": "/data/tse_cue_project/manifests/librimix_similar_content_v2_tts/clean/test/synthetic_interferer/3729-6852-0001_4077-13751-0008__T2__SCV2TTS__4077-4077-13751-0008__VOICE__3729.wav"}, "sir_db": 0.0}

001__T1__SCV2TTS__2094-2094-142345-0052__VOICE__1089.wav"}, "sir_db": 0.0}
{"key": "2094-142345-0052_1089-134691-0001__T2__SCV2TTS__1089-1089-134691-0001__VOICE__2094", "condition": "similar_content_v2_tts", "spk": ["1089", "2094"], "mix": {"default": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/mix_clean/2094-142345-0052_1089-134691-0001__T2__SCV2TTS__1089-1089-134691-0001__VOICE__2094.wav"]}, "src": {"1089": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/s1/2094-142345-0052_1089-134691-0001__T2__SCV2TTS__1089-1089-134691-0001__VOICE__2094.wav"], "2094": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/s2/2094-142345-0052_1089-134691-0001__T2__SCV2TTS__1089-1089-134691-0001__VOICE__2094.wav"]}, "target_text": "FOR A FULL HOUR HE HAD PACED UP AND DOWN WAITING BUT HE COULD WAIT NO LONGER", "source_meta": {"key": "2094-142345-0052_1089-134691-0001__T2__SCV2TTS__1089-1089-134691-0001__VOICE__2094", "mixture_id": "2094-142345-0052_1089-134691-0001", "target_source": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/1089/134691/1089-134691-0001.flac", "target_spk": "1089", "target_utt": "1089-134691-0001", "target_text": "FOR A FULL HOUR HE HAD PACED UP AND DOWN WAITING BUT HE COULD WAIT NO LONGER", "original_interferer_source": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/2094/142345/2094-142345-0052.flac", "interferer_spk": "2094", "interferer_utt": "2094-142345-0052", "prompt_audio": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/2094/142345/2094-142345-0000.flac", "prompt_utt": "2094-142345-0000", "prompt_text": "IT IS A VERY FINE OLD PLACE OF RED BRICK SOFTENED BY A PALE POWDERY LICHEN WHICH HAS DISPERSED ITSELF WITH HAPPY IRREGULARITY SO AS TO BRING THE RED BRICK INTO TERMS OF FRIENDLY COMPANIONSHIP WITH THE LIMESTONE ORNAMENTS SURROUNDING THE THREE GABLES THE WINDOWS AND THE DOOR PLACE", "synthetic_interferer": "/data/tse_cue_project/manifests/librimix_similar_content_v2_tts/clean/test/synthetic_interferer/2094-142345-0052_1089-134691-0001__T2__SCV2TTS__1089-1089-134691-0001__VOICE__2094.wav"}, "sir_db": 0.0}

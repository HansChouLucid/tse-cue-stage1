S FOR ALL TIME", "synthetic_interferer": "/data/tse_cue_project/manifests/librimix_similar_content_v2_tts/clean/test/synthetic_interferer/5639-40744-0019_237-134500-0022__T1__SCV2TTS__5639-5639-40744-0019__VOICE__237.wav"}, "sir_db": 0.0}
{"key": "5639-40744-0019_237-134500-0022__T2__SCV2TTS__237-237-134500-0022__VOICE__5639", "condition": "similar_content_v2_tts", "spk": ["237", "5639"], "mix": {"default": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/mix_clean/5639-40744-0019_237-134500-0022__T2__SCV2TTS__237-237-134500-0022__VOICE__5639.wav"]}, "src": {"237": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/s1/5639-40744-0019_237-134500-0022__T2__SCV2TTS__237-237-134500-0022__VOICE__5639.wav"], "5639": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/s2/5639-40744-0019_237-134500-0022__T2__SCV2TTS__237-237-134500-0022__VOICE__5639.wav"]}, "target_text": "WHEN SHE USED TO TELL ME ABOUT HIM I ALWAYS WONDERED WHETHER SHE WASN'T A LITTLE IN LOVE WITH HIM", "source_meta": {"key": "5639-40744-0019_237-134500-0022__T2__SCV2TTS__237-237-134500-0022__VOICE__5639", "mixture_id": "5639-40744-0019_237-134500-0022", "target_source": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/237/134500/237-134500-0022.flac", "target_spk": "237", "target_utt": "237-134500-0022", "target_text": "WHEN SHE USED TO TELL ME ABOUT HIM I ALWAYS WONDERED WHETHER SHE WASN'T A LITTLE IN LOVE WITH HIM", "original_interferer_source": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/5639/40744/5639-40744-0019.flac", "interferer_spk": "5639", "interferer_utt": "5639-40744-0019", "prompt_audio": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/5639/40744/5639-40744-0000.flac", "prompt_utt": "5639-40744-0000", "prompt_text": "ELEVEN O'CLOCK HAD STRUCK IT WAS A FINE CLEAR NIGHT THEY WERE THE ONLY PERSONS ON THE ROAD AND THEY SAUNTERED LEISURELY ALONG TO AVOID PAYING THE PRICE OF FATIGUE FOR THE RECREATION PROVIDED FOR THE TOLEDANS IN THEIR VALLEY OR ON THE BANKS OF THEIR RIVER", "synthetic_interferer": "/data/tse_cue_project/manifests/librimix_similar_content_v2_tts/clean/test/synthetic_interferer/5639-40744-0019_237-134500-0022__T2__SCV2TTS__237-237-134500-0022__VOICE__5639.wav"}, "sir_db": 0.0}

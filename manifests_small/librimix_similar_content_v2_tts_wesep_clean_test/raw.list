{"key": "3575-170457-0041_3570-5695-0010__T1__SCV2TTS__3575-3575-170457-0041__VOICE__3570", "condition": "similar_content_v2_tts", "spk": ["3575", "3570"], "mix": {"default": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/mix_clean/3575-170457-0041_3570-5695-0010__T1__SCV2TTS__3575-3575-170457-0041__VOICE__3570.wav"]}, "src": {"3575": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/s1/3575-170457-0041_3570-5695-0010__T1__SCV2TTS__3575-3575-170457-0041__VOICE__3570.wav"], "3570": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/s2/3575-170457-0041_3570-5695-0010__T1__SCV2TTS__3575-3575-170457-0041__VOICE__3570.wav"]}, "target_text": "SHE WAS GONE OUT INTO THE VILLAGE ON SOME ERRAND WHEN AS SHE WAS DESCENDING THE STEEP STREET HER FOOT SLIPPED ON THE ICE AND SHE FELL IT WAS DARK AND NO ONE SAW HER MISCHANCE TILL AFTER A TIME HER GROANS ATTRACTED THE ATTENTION OF A PASSER BY", "source_meta": {"key": "3575-170457-0041_3570-5695-0010__T1__SCV2TTS__3575-3575-170457-0041__VOICE__3570", "mixture_id": "3575-170457-0041_3570-5695-0010", "target_source": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/3575/170457/3575-170457-0041.flac", "target_spk": "3575", "target_utt": "3575-170457-0041", "target_text": "SHE WAS GONE OUT INTO THE VILLAGE ON SOME ERRAND WHEN AS SHE WAS DESCENDING THE STEEP STREET HER FOOT SLIPPED ON THE ICE AND SHE FELL IT WAS DARK AND NO ONE SAW HER MISCHANCE TILL AFTER A TIME HER GROANS ATTRACTED THE ATTENTION OF A PASSER BY", "original_interferer_source": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/3570/5695/3570-5695-0010.flac", "interferer_spk": "3570", "interferer_utt": "3570-5695-0010", "prompt_audio": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/3570/5694/3570-5694-0000.flac", "prompt_utt": "3570-5694-0000", "prompt_text": "BUT ALREADY AT A POINT IN ECONOMIC EVOLUTION FAR ANTEDATING THE EMERGENCE OF THE LADY SPECIALISED CONSUMPTION OF GOODS AS AN EVIDENCE OF PECUNIARY STRENGTH HAD BEGUN TO WORK OUT IN A MORE OR LESS ELABORATE SYSTEM", "synthetic_interferer": "/data/tse_cue_project/manifests/librimix_similar_content_v2_tts/clean/test/synthetic_interferer/3575-170457-0041_3570-5695-0010__T1__SCV2TTS__3575-3575-170457-0041__VOICE__3570.wav"}, "sir_db": 0.0}

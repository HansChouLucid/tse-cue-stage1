{"key": "6829-68769-0053_1320-122617-0011__T2__SCV2TTS__1320-1320-122617-0011__VOICE__6829", "condition": "similar_content_v2_tts", "spk": ["1320", "6829"], "mix": {"default": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/mix_clean/6829-68769-0053_1320-122617-0011__T2__SCV2TTS__1320-1320-122617-0011__VOICE__6829.wav"]}, "src": {"1320": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/s1/6829-68769-0053_1320-122617-0011__T2__SCV2TTS__1320-1320-122617-0011__VOICE__6829.wav"], "6829": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/s2/6829-68769-0053_1320-122617-0011__T2__SCV2TTS__1320-1320-122617-0011__VOICE__6829.wav"]}, "target_text": "THE LODGE IN WHICH UNCAS WAS CONFINED WAS IN THE VERY CENTER OF THE VILLAGE AND IN A SITUATION PERHAPS MORE DIFFICULT THAN ANY OTHER TO APPROACH OR LEAVE WITHOUT OBSERVATION", "source_meta": {"key": "6829-68769-0053_1320-122617-0011__T2__SCV2TTS__1320-1320-122617-0011__VOICE__6829", "mixture_id": "6829-68769-0053_1320-122617-0011", "target_source": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/1320/122617/1320-122617-0011.flac", "target_spk": "1320", "target_utt": "1320-122617-0011", "target_text": "THE LODGE IN WHICH UNCAS WAS CONFINED WAS IN THE VERY CENTER OF THE VILLAGE AND IN A SITUATION PERHAPS MORE DIFFICULT THAN ANY OTHER TO APPROACH OR LEAVE WITHOUT OBSERVATION", "original_interferer_source": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/6829/68769/6829-68769-0053.flac", "interferer_spk": "6829", "interferer_utt": "6829-68769-0053", "prompt_audio": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/6829/68769/6829-68769-0000.flac", "prompt_utt": "6829-68769-0000", "prompt_text": "KENNETH AND BETH REFRAINED FROM TELLING THE OTHER GIRLS OR UNCLE JOHN OF OLD WILL ROGERS'S VISIT BUT THEY GOT MISTER WATSON IN THE LIBRARY AND QUESTIONED HIM CLOSELY ABOUT THE PENALTY FOR FORGING A CHECK", "synthetic_interferer": "/data/tse_cue_project/manifests/librimix_similar_content_v2_tts/clean/test/synthetic_interferer/6829-68769-0053_1320-122617-0011__T2__SCV2TTS__1320-1320-122617-0011__VOICE__6829.wav"}, "sir_db": 0.0}

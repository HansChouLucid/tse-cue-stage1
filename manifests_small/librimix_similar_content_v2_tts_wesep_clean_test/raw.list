{"key": "61-70968-0020_1089-134691-0012__T2__SCV2TTS__1089-1089-134691-0012__VOICE__61", "condition": "similar_content_v2_tts", "spk": ["1089", "61"], "mix": {"default": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/mix_clean/61-70968-0020_1089-134691-0012__T2__SCV2TTS__1089-1089-134691-0012__VOICE__61.wav"]}, "src": {"1089": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/s1/61-70968-0020_1089-134691-0012__T2__SCV2TTS__1089-1089-134691-0012__VOICE__61.wav"], "61": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/s2/61-70968-0020_1089-134691-0012__T2__SCV2TTS__1089-1089-134691-0012__VOICE__61.wav"]}, "target_text": "IT WAS IDLE FOR HIM TO MOVE HIMSELF TO BE GENEROUS TOWARDS THEM TO TELL HIMSELF THAT IF HE EVER CAME TO THEIR GATES STRIPPED OF HIS PRIDE BEATEN AND IN BEGGAR'S WEEDS THAT THEY WOULD BE GENEROUS TOWARDS HIM LOVING HIM AS THEMSELVES", "source_meta": {"key": "61-70968-0020_1089-134691-0012__T2__SCV2TTS__1089-1089-134691-0012__VOICE__61", "mixture_id": "61-70968-0020_1089-134691-0012", "target_source": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/1089/134691/1089-134691-0012.flac", "target_spk": "1089", "target_utt": "1089-134691-0012", "target_text": "IT WAS IDLE FOR HIM TO MOVE HIMSELF TO BE GENEROUS TOWARDS THEM TO TELL HIMSELF THAT IF HE EVER CAME TO THEIR GATES STRIPPED OF HIS PRIDE BEATEN AND IN BEGGAR'S WEEDS THAT THEY WOULD BE GENEROUS TOWARDS HIM LOVING HIM AS THEMSELVES", "original_interferer_source": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/61/70968/61-70968-0020.flac", "interferer_spk": "61", "interferer_utt": "61-70968-0020", "prompt_audio": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/61/70968/61-70968-0000.flac", "prompt_utt": "61-70968-0000", "prompt_text": "HE BEGAN A CONFUSED COMPLAINT AGAINST THE WIZARD WHO HAD VANISHED BEHIND THE CURTAIN ON THE LEFT", "synthetic_interferer": "/data/tse_cue_project/manifests/librimix_similar_content_v2_tts/clean/test/synthetic_interferer/61-70968-0020_1089-134691-0012__T2__SCV2TTS__1089-1089-134691-0012__VOICE__61.wav"}, "sir_db": 0.0}
{"key": "3575-170457-0056_1320-122617-0024__T1__SCV2TTS__3575-3575-170457-0056__VOICE__1320", "condition": "similar_content_v2_tts", "spk": ["3575", "1320"], "mix": {"default": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/mix_clean/3575-170457-0056_1320-122617-0024__T1__SCV2TTS__3575-3575-170457-0056__VOICE__1320.wav"]}, "src": {"3575": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/s1/3575-170457-0056_1320-122617-0024__T1__SCV2TTS__3575-3575-170457-0056__VOICE__1320.wav"], "1320": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/s2/3575-170457-0056_1320-122617-0024__T1__SCV2TTS__3575-3575-170457-0056__VOICE__1320.wav"]}, "target_text": "I DOUBT WHETHER BRANWELL WAS MAINTAINING HIMSELF AT THIS TIME", "source_meta": {"key": "3575-170457-0056_1320-122617-0024__T1__SCV2TTS__3575-3575-170457-0056__VOICE__1320", "mixture_id": "3575-170457-0056_1320-122617-0024", "target_source": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/3575/170457/3575-170457-0056.flac", "target_spk": "3575", "target_utt": "3575-170457-0056", "target_text": "I DOUBT WHETHER BRANWELL WAS MAINTAINING HIMSELF AT THIS TIME", "original_interferer_source": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/1320/122617/1320-122617-0024.flac", "interferer_spk": "1320", "interferer_utt": "1320-122617-0024", "prompt_audio": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/1320/122612/1320-122612-0000.flac", "prompt_utt": "1320-122612-0000", "prompt_text": "SINCE THE PERIOD OF OUR TALE THE ACTIVE SPIRIT OF THE COUNTRY HAS SURROUNDED IT WITH A BELT OF RICH AND THRIVING SETTLEMENTS THOUGH NONE BUT THE HUNTER OR THE SAVAGE IS EVER KNOWN EVEN NOW TO PENETRATE ITS WILD RECESSES", "synthetic_interferer": "/data/tse_cue_project/manifests/librimix_similar_content_v2_tts/clean/test/synthetic_interferer/3575-170457-0056_1320-122617-0024__T1__SCV2TTS__3575-3575-170457-0056__VOICE__1320.wav"}, "sir_db": 0.0}
{"key": "3575-170457-0056_1320-122617-0024__T2__SCV2TTS__1320-1320-122617-0024__VOICE__3575", "condition": "similar_content_v2_tts", "spk": ["1320", "3575"], "mix": {"default": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/mix_clean/3575-170457-0056_1320-122617-0024__T2__SCV2TTS__1320-1320-122617-0024__VOICE__3575.wav"]}, "src": {"1320": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/s1/3575-170457-0056_1320-122617-0024__T2__SCV2TTS__1320-1320-122617-0024__VOICE__3575.wav"], "3575": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/s2/3575-170457-0056_1320-122617-0024__T2__SCV2TTS__1320-1320-122617-0024__VOICE__3575.wav"]}, "target_text": "BUT HAWKEYE WHO WAS TOO MUCH OCCUPIED WITH HIS OWN THOUGHTS TO NOTE THE MOVEMENT CONTINUED SPEAKING MORE TO HIMSELF THAN TO HIS COMPANION", "source_meta": {"key": "3575-170457-0056_1320-122617-0024__T2__SCV2TTS__1320-1320-122617-0024__VOICE__3575", "mixture_id": "3575-170457-0056_1320-122617-0024", "target_source": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/1320/122617/1320-122617-0024.flac", "target_spk": "1320", "target_utt": "1320-122617-0024", "target_text": "BUT HAWKEYE WHO WAS TOO MUCH OCCUPIED WITH HIS OWN THOUGHTS TO NOTE THE MOVEMENT CONTINUED SPEAKING MORE TO HIMSELF THAN TO HIS COMPANION", "original_interferer_source": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/3575/170457/3575-170457-0056.flac", "interferer_spk": "3575", "interferer_utt": "3575-170457-0056", "prompt_audio": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/3575/170457/3575-170457-0000.flac", "prompt_utt": "3575-170457-0000", "prompt_text": "AND OFTEN HAS MY MOTHER SAID WHILE ON HER LAP I LAID MY HEAD SHE FEARED FOR TIME I WAS NOT MADE BUT FOR ETERNITY", "synthetic_interferer": "/data/tse_cue_project/manifests/librimix_similar_content_v2_tts/clean/test/synthetic_interferer/3575-170457-0056_1320-122617-0024__T2__SCV2TTS__1320-1320-122617-0024__VOICE__3575.wav"}, "sir_db": 0.0}

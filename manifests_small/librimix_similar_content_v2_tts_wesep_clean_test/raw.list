{"key": "5639-40744-0004_7127-75946-0017__T2__SCV2TTS__7127-7127-75946-0017__VOICE__5639", "condition": "similar_content_v2_tts", "spk": ["7127", "5639"], "mix": {"default": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/mix_clean/5639-40744-0004_7127-75946-0017__T2__SCV2TTS__7127-7127-75946-0017__VOICE__5639.wav"]}, "src": {"7127": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/s1/5639-40744-0004_7127-75946-0017__T2__SCV2TTS__7127-7127-75946-0017__VOICE__5639.wav"], "5639": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/s2/5639-40744-0004_7127-75946-0017__T2__SCV2TTS__7127-7127-75946-0017__VOICE__5639.wav"]}, "target_text": "HIS LEGS THE BEST SHAPED AT COURT WERE DISPLAYED TO GREAT ADVANTAGE IN FLESH COLORED SILKEN HOSE OF SILK SO FINE AND SO TRANSPARENT THAT IT SEEMED ALMOST LIKE FLESH ITSELF", "source_meta": {"key": "5639-40744-0004_7127-75946-0017__T2__SCV2TTS__7127-7127-75946-0017__VOICE__5639", "mixture_id": "5639-40744-0004_7127-75946-0017", "target_source": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/7127/75946/7127-75946-0017.flac", "target_spk": "7127", "target_utt": "7127-75946-0017", "target_text": "HIS LEGS THE BEST SHAPED AT COURT WERE DISPLAYED TO GREAT ADVANTAGE IN FLESH COLORED SILKEN HOSE OF SILK SO FINE AND SO TRANSPARENT THAT IT SEEMED ALMOST LIKE FLESH ITSELF", "original_interferer_source": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/5639/40744/5639-40744-0004.flac", "interferer_spk": "5639", "interferer_utt": "5639-40744-0004", "prompt_audio": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/5639/40744/5639-40744-0000.flac", "prompt_utt": "5639-40744-0000", "prompt_text": "ELEVEN O'CLOCK HAD STRUCK IT WAS A FINE CLEAR NIGHT THEY WERE THE ONLY PERSONS ON THE ROAD AND THEY SAUNTERED LEISURELY ALONG TO AVOID PAYING THE PRICE OF FATIGUE FOR THE RECREATION PROVIDED FOR THE TOLEDANS IN THEIR VALLEY OR ON THE BANKS OF THEIR RIVER", "synthetic_interferer": "/data/tse_cue_project/manifests/librimix_similar_content_v2_tts/clean/test/synthetic_interferer/5639-40744-0004_7127-75946-0017__T2__SCV2TTS__7127-7127-75946-0017__VOICE__5639.wav"}, "sir_db": 0.0}

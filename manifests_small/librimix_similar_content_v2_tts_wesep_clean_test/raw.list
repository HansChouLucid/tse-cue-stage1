{"key": "1221-135766-0003_1320-122617-0009__T1__SCV2TTS__1221-1221-135766-0003__VOICE__1320", "condition": "similar_content_v2_tts", "spk": ["1221", "1320"], "mix": {"default": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/mix_clean/1221-135766-0003_1320-122617-0009__T1__SCV2TTS__1221-1221-135766-0003__VOICE__1320.wav"]}, "src": {"1221": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/s1/1221-135766-0003_1320-122617-0009__T1__SCV2TTS__1221-1221-135766-0003__VOICE__1320.wav"], "1320": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/s2/1221-135766-0003_1320-122617-0009__T1__SCV2TTS__1221-1221-135766-0003__VOICE__1320.wav"]}, "target_text": "THE CHILD HAD A NATIVE GRACE WHICH DOES NOT INVARIABLY CO EXIST WITH FAULTLESS BEAUTY ITS ATTIRE HOWEVER SIMPLE ALWAYS IMPRESSED THE BEHOLDER AS IF IT WERE THE VERY GARB THAT PRECISELY BECAME IT BEST", "source_meta": {"key": "1221-135766-0003_1320-122617-0009__T1__SCV2TTS__1221-1221-135766-0003__VOICE__1320", "mixture_id": "1221-135766-0003_1320-122617-0009", "target_source": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/1221/135766/1221-135766-0003.flac", "target_spk": "1221", "target_utt": "1221-135766-0003", "target_text": "THE CHILD HAD A NATIVE GRACE WHICH DOES NOT INVARIABLY CO EXIST WITH FAULTLESS BEAUTY ITS ATTIRE HOWEVER SIMPLE ALWAYS IMPRESSED THE BEHOLDER AS IF IT WERE THE VERY GARB THAT PRECISELY BECAME IT BEST", "original_interferer_source": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/1320/122617/1320-122617-0009.flac", "interferer_spk": "1320", "interferer_utt": "1320-122617-0009", "prompt_audio": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/1320/122612/1320-122612-0000.flac", "prompt_utt": "1320-122612-0000", "prompt_text": "SINCE THE PERIOD OF OUR TALE THE ACTIVE SPIRIT OF THE COUNTRY HAS SURROUNDED IT WITH A BELT OF RICH AND THRIVING SETTLEMENTS THOUGH NONE BUT THE HUNTER OR THE SAVAGE IS EVER KNOWN EVEN NOW TO PENETRATE ITS WILD RECESSES", "synthetic_interferer": "/data/tse_cue_project/manifests/librimix_similar_content_v2_tts/clean/test/synthetic_interferer/1221-135766-0003_1320-122617-0009__T1__SCV2TTS__1221-1221-135766-0003__VOICE__1320.wav"}, "sir_db": 0.0}
{"key": "1221-135766-0003_1320-122617-0009__T2__SCV2TTS__1320-1320-122617-0009__VOICE__1221", "condition": "similar_content_v2_tts", "spk": ["1320", "1221"], "mix": {"default": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/mix_clean/1221-135766-0003_1320-122617-0009__T2__SCV2TTS__1320-1320-122617-0009__VOICE__1221.wav"]}, "src": {"1320": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/s1/1221-135766-0003_1320-122617-0009__T2__SCV2TTS__1320-1320-122617-0009__VOICE__1221.wav"], "1221": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/s2/1221-135766-0003_1320-122617-0009__T2__SCV2TTS__1320-1320-122617-0009__VOICE__1221.wav"]}, "target_text": "I GREATLY MOURN THAT ONE SO WELL DISPOSED SHOULD DIE IN HIS IGNORANCE AND I HAVE SOUGHT A GOODLY HYMN CAN YOU LEAD ME TO HIM", "source_meta": {"key": "1221-135766-0003_1320-122617-0009__T2__SCV2TTS__1320-1320-122617-0009__VOICE__1221", "mixture_id": "1221-135766-0003_1320-122617-0009", "target_source": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/1320/122617/1320-122617-0009.flac", "target_spk": "1320", "target_utt": "1320-122617-0009", "target_text": "I GREATLY MOURN THAT ONE SO WELL DISPOSED SHOULD DIE IN HIS IGNORANCE AND I HAVE SOUGHT A GOODLY HYMN CAN YOU LEAD ME TO HIM", "original_interferer_source": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/1221/135766/1221-135766-0003.flac", "interferer_spk": "1221", "interferer_utt": "1221-135766-0003", "prompt_audio": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/1221/135766/1221-135766-0000.flac", "prompt_utt": "1221-135766-0000", "prompt_text": "HOW STRANGE IT SEEMED TO THE SAD WOMAN AS SHE WATCHED THE GROWTH AND THE BEAUTY THAT BECAME EVERY DAY MORE BRILLIANT AND THE INTELLIGENCE THAT THREW ITS QUIVERING SUNSHINE OVER THE TINY FEATURES OF THIS CHILD", "synthetic_interferer": "/data/tse_cue_projec
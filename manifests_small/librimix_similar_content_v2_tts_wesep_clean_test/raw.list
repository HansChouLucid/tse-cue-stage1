{"key": "1089-134686-0007_1995-1836-0000__T2__SCV2TTS__1995-1995-1836-0000__VOICE__1089", "condition": "similar_content_v2_tts", "spk": ["1995", "1089"], "mix": {"default": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/mix_clean/1089-134686-0007_1995-1836-0000__T2__SCV2TTS__1995-1995-1836-0000__VOICE__1089.wav"]}, "src": {"1995": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/s1/1089-134686-0007_1995-1836-0000__T2__SCV2TTS__1995-1995-1836-0000__VOICE__1089.wav"], "1089": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/s2/1089-134686-0007_1995-1836-0000__T2__SCV2TTS__1995-1995-1836-0000__VOICE__1089.wav"]}, "target_text": "THE HON CHARLES SMITH MISS SARAH'S BROTHER WAS WALKING SWIFTLY UPTOWN FROM MISTER EASTERLY'S WALL STREET OFFICE AND HIS FACE WAS PALE", "source_meta": {"key": "1089-134686-0007_1995-1836-0000__T2__SCV2TTS__1995-1995-1836-0000__VOICE__1089", "mixture_id": "1089-134686-0007_1995-1836-0000", "target_source": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/1995/1836/1995-1836-0000.flac", "target_spk": "1995", "target_utt": "1995-1836-0000", "target_text": "THE HON CHARLES SMITH MISS SARAH'S BROTHER WAS WALKING SWIFTLY UPTOWN FROM MISTER EASTERLY'S WALL STREET OFFICE AND HIS FACE WAS PALE", "original_interferer_source": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/1089/134686/1089-134686-0007.flac", "interferer_spk": "1089", "interferer_utt": "1089-134686-0007", "prompt_audio": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/1089/134686/1089-134686-0000.flac", "prompt_utt": "1089-134686-0000", "prompt_text": "HE HOPED THERE WOULD BE STEW FOR DINNER TURNIPS AND CARROTS AND BRUISED POTATOES AND FAT MUTTON PIECES TO BE LADLED OUT IN THICK PEPPERED FLOUR FATTENED SAUCE", "synthetic_interferer": "/data/tse_cue_project/manifests/librimix_similar_content_v2_tts/clean/test/synthetic_interferer/1089-134686-0007_1995-1836-0000__T2__SCV2TTS__1995-1995-1836-0000__VOICE__1089.wav"}, "sir_db": 0.0}

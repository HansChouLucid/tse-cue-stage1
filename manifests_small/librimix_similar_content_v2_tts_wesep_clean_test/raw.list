 "sir_db": 0.0}
{"key": "5639-40744-0014_237-134493-0002__T1__SCV2TTS__5639-5639-40744-0014__VOICE__237", "condition": "similar_content_v2_tts", "spk": ["5639", "237"], "mix": {"default": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/mix_clean/5639-40744-0014_237-134493-0002__T1__SCV2TTS__5639-5639-40744-0014__VOICE__237.wav"]}, "src": {"5639": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/s1/5639-40744-0014_237-134493-0002__T1__SCV2TTS__5639-5639-40744-0014__VOICE__237.wav"], "237": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/s2/5639-40744-0014_237-134493-0002__T1__SCV2TTS__5639-5639-40744-0014__VOICE__237.wav"]}, "target_text": "AMONG OTHER THINGS ON WHICH SHE CAST HER EYES WAS A SMALL CRUCIFIX OF SOLID SILVER STANDING ON A CABINET NEAR THE WINDOW", "source_meta": {"key": "5639-40744-0014_237-134493-0002__T1__SCV2TTS__5639-5639-40744-0014__VOICE__237", "mixture_id": "5639-40744-0014_237-134493-0002", "target_source": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/5639/40744/5639-40744-0014.flac", "target_spk": "5639", "target_utt": "5639-40744-0014", "target_text": "AMONG OTHER THINGS ON WHICH SHE CAST HER EYES WAS A SMALL CRUCIFIX OF SOLID SILVER STANDING ON A CABINET NEAR THE WINDOW", "original_interferer_source": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/237/134493/237-134493-0002.flac", "interferer_spk": "237", "interferer_utt": "237-134493-0002", "prompt_audio": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/237/126133/237-126133-0000.flac", "prompt_utt": "237-126133-0000", "prompt_text": "HERE SHE WOULD STAY COMFORTED AND SOOTHED AMONG THE LOVELY PLANTS AND RICH EXOTICS REJOICING THE HEART OF OLD TURNER THE GARDENER WHO SINCE POLLY'S FIRST RAPTUROUS ENTRANCE HAD TAKEN HER INTO HIS GOOD GRACES FOR ALL TIME", "synthetic_interferer": "/data/tse_cue_project/manifests/librimix_similar_content_v2_tts/clean/test/synthetic_interferer/5639-40744-0014_237-134493-0002__T1__SCV2TTS__5639-5639-40744-0014__VOICE__237.wav"}, "sir_db": 0.0}

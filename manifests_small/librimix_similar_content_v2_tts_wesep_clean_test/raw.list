{"key": "7127-75946-0010_5639-40744-0029__T1__SCV2TTS__7127-7127-75946-0010__VOICE__5639", "condition": "similar_content_v2_tts", "spk": ["7127", "5639"], "mix": {"default": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/mix_clean/7127-75946-0010_5639-40744-0029__T1__SCV2TTS__7127-7127-75946-0010__VOICE__5639.wav"]}, "src": {"7127": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/s1/7127-75946-0010_5639-40744-0029__T1__SCV2TTS__7127-7127-75946-0010__VOICE__5639.wav"], "5639": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/s2/7127-75946-0010_5639-40744-0029__T1__SCV2TTS__7127-7127-75946-0010__VOICE__5639.wav"]}, "target_text": "YOUR MAJESTY'S PLAN THEN IN THIS AFFAIR IS", "source_meta": {"key": "7127-75946-0010_5639-40744-0029__T1__SCV2TTS__7127-7127-75946-0010__VOICE__5639", "mixture_id": "7127-75946-0010_5639-40744-0029", "target_source": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/7127/75946/7127-75946-0010.flac", "target_spk": "7127", "target_utt": "7127-75946-0010", "target_text": "YOUR MAJESTY'S PLAN THEN IN THIS AFFAIR IS", "original_interferer_source": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/5639/40744/5639-40744-0029.flac", "interferer_spk": "5639", "interferer_utt": "5639-40744-0029", "prompt_audio": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/5639/40744/5639-40744-0000.flac", "prompt_utt": "5639-40744-0000", "prompt_text": "ELEVEN O'CLOCK HAD STRUCK IT WAS A FINE CLEAR NIGHT THEY WERE THE ONLY PERSONS ON THE ROAD AND THEY SAUNTERED LEISURELY ALONG TO AVOID PAYING THE PRICE OF FATIGUE FOR THE RECREATION PROVIDED FOR THE TOLEDANS IN THEIR VALLEY OR ON THE BANKS OF THEIR RIVER", "synthetic_interferer": "/data/tse_cue_project/manifests/librimix_similar_content_v2_tts/clean/test/synthetic_interferer/7127-75946-0010_5639-40744-0029__T1__SCV2TTS__7127-7127-75946-0010__VOICE__5639.wav"}, "sir_db": 0.0}
{"key": "7127-75946-0010_5639-40744-0029__T2__SCV2TTS__5639-5639-40744-0029__VOICE__7127", "condition": "similar_content_v2_tts", "spk": ["5639", "7127"], "mix": {"default": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/mix_clean/7127-75946-0010_5639-40744-0029__T2__SCV2TTS__5639-5639-40744-0029__VOICE__7127.wav"]}, "src": {"5639": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/s1/7127-75946-0010_5639-40744-0029__T2__SCV2TTS__5639-5639-40744-0029__VOICE__7127.wav"], "7127": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/s2/7127-75946-0010_5639-40744-0029__T2__SCV2TTS__5639-5639-40744-0029__VOICE__7127.wav"]}, "target_text": "THIS TRUTH WHICH I HAVE LEARNED FROM HER LIPS IS CONFIRMED BY HIS FACE IN WHICH WE HAVE BOTH BEHELD THAT OF OUR SON", "source_meta": {"key": "7127-75946-0010_5639-40744-0029__T2__SCV2TTS__5639-5639-40744-0029__VOICE__7127", "mixture_id": "7127-75946-0010_5639-40744-0029", "target_source": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/5639/40744/5639-40744-0029.flac", "target_spk": "5639", "target_utt": "5639-40744-0029", "target_text": "THIS TRUTH WHICH I HAVE LEARNED FROM HER LIPS IS CONFIRMED BY HIS FACE IN WHICH WE HAVE BOTH BEHELD THAT OF OUR SON", "original_interferer_source": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/7127/75946/7127-75946-0010.flac", "interferer_spk": "7127", "interferer_utt": "7127-75946-0010", "prompt_audio": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/7127/75946/7127-75946-0000.flac", "prompt_utt": "7127-75946-0000", "prompt_text": "AT THE CONCLUSION OF THE BANQUET WHICH WAS SERVED AT FIVE O'CLOCK THE KING ENTERED HIS CABINET WHERE HIS TAILORS WERE AWAITING HIM FOR THE PURPOSE OF TRYING ON THE CELEBRATED COSTUME REPRESENTING SPRING WHICH WAS THE RESULT OF SO MUCH IMAGINATION AND HAD COST SO MANY EFFORTS OF THOUGHT TO THE DESIGNERS AND ORNAMENT WORKERS OF THE COURT", "synthetic_interferer": "/data/tse_cue_project/manifests/librimix_similar_content_v2_tts/clean/test/synthetic_interferer/7127-75946-0010_5639-40744-0029__T2__SCV2TTS__5639-5639-40744-0029__VOICE__7127.wav"}, "sir_db": 0.0}
{"key": "8455-210777-0033_1580-141084-0016__T1__SCV2TTS__8455-8455-210777-0033__VOICE__1580", "condition": "similar_content_v2_tts", "spk": ["8455", "1580"], "mix": {"default": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/mix_clean/8455-210777-0033_1580-141084-0016__T1__SCV2TTS__8455-8455-210777-0033__VOICE__1580.wav"]}, "src": {"8455": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/s1/8455-210777-0033_1580-141084-0016__T1__SCV2TTS__8455-8455-210777-0033__VOICE__1580.wav"], "1580": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/s2/8455-210777-0033_1580-141084-0016__T1__SCV2TTS__8455-8455-210777-0033__VOICE__1580.wav"]}, "target_text": "BUT YOUR POWER IS SO SUPERIOR TO ANY THAT I CAN ADVANCE AS TO MAKE US HERE FEEL THAT THERE IS NO DISGRACE IN YIELDING TO IT", "source_meta": {"key": "8455-210777-0033_1580-141084-0016__T1__SCV2TTS__8455-8455-210777-0033__VOICE__1580", "mixture_id": "8455-210777-0033_1580-141084-0016", "target_source": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/8455/210777/8455-210777-0033.flac", "target_spk": "8455", "target_utt": "8455-210777-0033", "target_text": "BUT YOUR POWER IS SO SUPERIOR TO ANY THAT I CAN ADVANCE AS TO MAKE US HERE FEEL THAT THERE IS NO DISGRACE IN YIELDING TO IT", "original_interferer_source": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/1580/141084/1580-141084-0016.flac", "interferer_spk": "1580", "interferer_utt": "1580-141084-0016", "prompt_audio": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/1580/141083/1580-141083-0000.flac", "prompt_utt": "1580-141083-0000", "prompt_text": "I WILL ENDEAVOUR IN MY STATEMENT TO AVOID SUCH TERMS AS WOULD SERVE TO LIMIT THE EVENTS TO ANY PARTICULAR PLACE OR GIVE A CLUE AS TO THE PEOPLE CONCERNED", "synthetic_interferer": "/data/tse_cue_project/manifests/librimix_similar_content_v2_tts/clean/test/sy
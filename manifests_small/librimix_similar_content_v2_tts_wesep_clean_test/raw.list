{"key": "7127-75947-0016_4507-16021-0059__T2__SCV2TTS__4507-4507-16021-0059__VOICE__7127", "condition": "similar_content_v2_tts", "spk": ["4507", "7127"], "mix": {"default": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/mix_clean/7127-75947-0016_4507-16021-0059__T2__SCV2TTS__4507-4507-16021-0059__VOICE__7127.wav"]}, "src": {"4507": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/s1/7127-75947-0016_4507-16021-0059__T2__SCV2TTS__4507-4507-16021-0059__VOICE__7127.wav"], "7127": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/s2/7127-75947-0016_4507-16021-0059__T2__SCV2TTS__4507-4507-16021-0059__VOICE__7127.wav"]}, "target_text": "TO BURN WITHOUT CEASING TO FLY THEREIN LIES THE MARVEL OF GENIUS", "source_meta": {"key": "7127-75947-0016_4507-16021-0059__T2__SCV2TTS__4507-4507-16021-0059__VOICE__7127", "mixture_id": "7127-75947-0016_4507-16021-0059", "target_source": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/4507/16021/4507-16021-0059.flac", "target_spk": "4507", "target_utt": "4507-16021-0059", "target_text": "TO BURN WITHOUT CEASING TO FLY THEREIN LIES THE MARVEL OF GENIUS", "original_interferer_source": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/7127/75947/7127-75947-0016.flac", "interferer_spk": "7127", "interferer_utt": "7127-75947-0016", "prompt_audio": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/7127/75946/7127-75946-0000.flac", "prompt_utt": "7127-75946-0000", "prompt_text": "AT THE CONCLUSION OF THE BANQUET WHICH WAS SERVED AT FIVE O'CLOCK THE KING ENTERED HIS CABINET WHERE HIS TAILORS WERE AWAITING HIM FOR THE PURPOSE OF TRYING ON THE CELEBRATED COSTUME REPRESENTING SPRING WHICH WAS THE RESULT OF SO MUCH IMAGINATION AND HAD COST SO MANY EFFORTS OF THOUGHT TO THE DESIGNERS AND ORNAMENT WORKERS OF THE COURT", "synthetic_interferer": "/data/tse_cue_project/manifests/librimix_similar_content_v2_tts/clean/test/synthetic_interferer/7127-75947-0016_4507-16021-0059__T2__SCV2TTS__4507-4507-16021-0059__VOICE__7127.wav"}, "sir_db": 0.0}

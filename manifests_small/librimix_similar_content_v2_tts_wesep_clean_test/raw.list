{"key": "61-70970-0020_4507-16021-0031__T2__SCV2TTS__4507-4507-16021-0031__VOICE__61", "condition": "similar_content_v2_tts", "spk": ["4507", "61"], "mix": {"default": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/mix_clean/61-70970-0020_4507-16021-0031__T2__SCV2TTS__4507-4507-16021-0031__VOICE__61.wav"]}, "src": {"4507": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/s1/61-70970-0020_4507-16021-0031__T2__SCV2TTS__4507-4507-16021-0031__VOICE__61.wav"], "61": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/s2/61-70970-0020_4507-16021-0031__T2__SCV2TTS__4507-4507-16021-0031__VOICE__61.wav"]}, "target_text": "AND THEN WE INSIST UPON IT THE STUDY OF SOCIAL DEFORMITIES AND INFIRMITIES AND THE TASK OF POINTING THEM OUT WITH A VIEW TO REMEDY IS NOT A BUSINESS IN WHICH CHOICE IS PERMITTED", "source_meta": {"key": "61-70970-0020_4507-16021-0031__T2__SCV2TTS__4507-4507-16021-0031__VOICE__61", "mixture_id": "61-70970-0020_4507-16021-0031", "target_source": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/4507/16021/4507-16021-0031.flac", "target_spk": "4507", "target_utt": "4507-16021-0031", "target_text": "AND THEN WE INSIST UPON IT THE STUDY OF SOCIAL DEFORMITIES AND INFIRMITIES AND THE TASK OF POINTING THEM OUT WITH A VIEW TO REMEDY IS NOT A BUSINESS IN WHICH CHOICE IS PERMITTED", "original_interferer_source": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/61/70970/61-70970-0020.flac", "interferer_spk": "61", "interferer_utt": "61-70970-0020", "prompt_audio": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/61/70968/61-70968-0000.flac", "prompt_utt": "61-70968-0000", "prompt_text": "HE BEGAN A CONFUSED COMPLAINT AGAINST THE WIZARD WHO HAD VANISHED BEHIND THE CURTAIN ON THE LEFT", "synthetic_interferer": "/data/tse_cue_project/manifests/librimix_similar_content_v2_tts/clean/test/synthetic_interferer/61-70970-0020_4507-16021-0031__T2__SCV2TTS__4507-4507-16021-0031__VOICE__61.wav"}, "sir_db": 0.0}
{"key": "4446-2273-0022_2094-142345-0057__T1__SCV2TTS__4446-4446-2273-0022__VOICE__2094", "condition": "similar_content_v2_tts", "spk": ["4446", "2094"], "mix": {"default": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/mix_clean/4446-2273-0022_2094-142345-0057__T1__SCV2TTS__4446-4446-2273-0022__VOICE__2094.wav"]}, "src": {"4446": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/s1/4446-2273-0022_2094-142345-0057__T1__SCV2TTS__4446-4446-2273-0022__VOICE__2094.wav"], "2094": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/s2/4446-2273-0022_2094-142345-0057__T1__SCV2TTS__4446-4446-2273-0022__VOICE__2094.wav"]}, "target_text": "THEY WERE BOTH REMEMBERING WHAT THE WOMAN HAD SAID WHEN SHE TOOK THE MONEY GOD GIVE YOU A HAPPY LOVE", "source_meta": {"key": "4446-2273-0022_2094-142345-0057__T1__SCV2TTS__4446-4446-2273-0022__VOICE__2094", "mixture_id": "4446-2273-0022_2094-142345-0057", "target_source": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/4446/2273/4446-2273-0022.flac", "target_spk": "4446", "target_utt": "4446-2273-0022", "target_text": "THEY WERE BOTH REMEMBERING WHAT THE WOMAN HAD SAID WHEN SHE TOOK THE MONEY GOD GIVE YOU A HAPPY LOVE", "original_interferer_source": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/2094/142345/2094-142345-0057.flac", "interferer_spk": "2094", "interferer_utt": "2094-142345-0057", "prompt_audio": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/2094/142345/2094-142345-0000.flac", "prompt_utt": "2094-142345-0000", "prompt_text": "IT IS A VERY FINE OLD PLACE OF RED BRICK SOFTENED BY A PALE POWDERY LICHEN WHICH HAS DISPERSED ITSELF WITH HAPPY IRREGULARITY SO AS TO BRING THE RED BRICK INTO TERMS OF FRIENDLY COMPANIONSHIP WITH THE LIMESTONE ORNAMENTS SURROUNDING THE THREE GABLES THE WINDOWS AND THE DOOR PLACE", "synthetic_interferer": "/data/tse_cue_project/manifests/librimix_similar_content_v2_tts/clean/test/synthetic_interferer/4446-2273-0022_2094-142345-0057__T1__SCV2TTS__4446-4446-2273-0022__VOICE__2094.wav"}, "sir_db": 0.0}

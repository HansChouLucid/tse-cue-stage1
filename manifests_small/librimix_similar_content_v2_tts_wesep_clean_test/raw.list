NG THE THREE GABLES THE WINDOWS AND THE DOOR PLACE", "synthetic_interferer": "/data/tse_cue_project/manifests/librimix_similar_content_v2_tts/clean/test/synthetic_interferer/2094-142345-0003_6930-81414-0004__T2__SCV2TTS__6930-6930-81414-0004__VOICE__2094.wav"}, "sir_db": 0.0}

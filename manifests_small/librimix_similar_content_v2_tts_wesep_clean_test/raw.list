a/tse_cue_project/manifests/librimix_similar_content_v2_tts/clean/test/synthetic_interferer/4077-13751-0000_237-134500-0039__T1__SCV2TTS__4077-4077-13751-0000__VOICE__237.wav"}, "sir_db": 0.0}

n/2830/3979/2830-3979-0000.flac", "prompt_utt": "2830-3979-0000", "prompt_text": "WE WANT YOU TO HELP US PUBLISH SOME LEADING WORK OF LUTHER'S FOR THE GENERAL AMERICAN MARKET WILL YOU DO IT", "synthetic_interferer": "/data/tse_cue_project/manifests/librimix_similar_content_v2_tts/clean/test/synthetic_interferer/8555-284449-0011_2830-3979-0010__T1__SCV2TTS__8555-8555-284449-0011__VOICE__2830.wav"}, "sir_db": 0.0}

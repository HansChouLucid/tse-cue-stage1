{"key": "3729-6852-0009_8455-210777-0059__T1__SCV2TTS__3729-3729-6852-0009__VOICE__8455", "condition": "similar_content_v2_tts", "spk": ["3729", "8455"], "mix": {"default": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/mix_clean/3729-6852-0009_8455-210777-0059__T1__SCV2TTS__3729-3729-6852-0009__VOICE__8455.wav"]}, "src": {"3729": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/s1/3729-6852-0009_8455-210777-0059__T1__SCV2TTS__3729-3729-6852-0009__VOICE__8455.wav"], "8455": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/s2/3729-6852-0009_8455-210777-0059__T1__SCV2TTS__3729-3729-6852-0009__VOICE__8455.wav"]}, "target_text": "YOU WILL FORGIVE ME DEAR READER IF I HAVE MADE YOU ATTEND THE FUNERAL OF SILVIA TEN YEARS BEFORE HER DEATH BELIEVE ME I HAVE NO INTENTION OF PERFORMING A MIRACLE YOU MAY CONSOLE YOURSELF WITH THE IDEA THAT I SHALL SPARE YOU THAT UNPLEASANT TASK WHEN POOR SILVIA DIES", "source_meta": {"key": "3729-6852-0009_8455-210777-0059__T1__SCV2TTS__3729-3729-6852-0009__VOICE__8455", "mixture_id": "3729-6852-0009_8455-210777-0059", "target_source": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/3729/6852/3729-6852-0009.flac", "target_spk": "3729", "target_utt": "3729-6852-0009", "target_text": "YOU WILL FORGIVE ME DEAR READER IF I HAVE MADE YOU ATTEND THE FUNERAL OF SILVIA TEN YEARS BEFORE HER DEATH BELIEVE ME I HAVE NO INTENTION OF PERFORMING A MIRACLE YOU MAY CONSOLE YOURSELF WITH THE IDEA THAT I SHALL SPARE YOU THAT UNPLEASANT TASK WHEN POOR SILVIA DIES", "original_interferer_source": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/8455/210777/8455-210777-0059.flac", "interferer_spk": "8455", "interferer_utt": "8455-210777-0059", "prompt_audio": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/8455/210777/8455-210777-0000.flac", "prompt_utt": "8455-210777-0000", "prompt_text": "I REMAINED THERE ALONE FOR MANY HOURS BUT I MUST ACKNOWLEDGE THAT BEFORE I LEFT THE CHAMBERS I HAD GRADUALLY BROUGHT MYSELF TO LOOK AT THE MATTER IN ANOTHER LIGHT", "synthetic_interferer": "/data/tse_cue_project/manifests/librimix_similar_content_v2_tts/clean/test/synthetic_interferer/3729-6852-0009_8455-210777-0059__T1__SCV2TTS__3729-3729-6852-0009__VOICE__8455.wav"}, "sir_db": 0.0}

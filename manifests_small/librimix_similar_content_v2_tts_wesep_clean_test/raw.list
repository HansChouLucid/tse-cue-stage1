": 0.0}
{"key": "237-134500-0015_2300-131720-0018__T1__SCV2TTS__237-237-134500-0015__VOICE__2300", "condition": "similar_content_v2_tts", "spk": ["237", "2300"], "mix": {"default": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/mix_clean/237-134500-0015_2300-131720-0018__T1__SCV2TTS__237-237-134500-0015__VOICE__2300.wav"]}, "src": {"237": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/s1/237-134500-0015_2300-131720-0018__T1__SCV2TTS__237-237-134500-0015__VOICE__2300.wav"], "2300": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/s2/237-134500-0015_2300-131720-0018__T1__SCV2TTS__237-237-134500-0015__VOICE__2300.wav"]}, "target_text": "THAT SUMMER THE RAINS HAD BEEN SO MANY AND OPPORTUNE THAT IT WAS ALMOST MORE THAN SHABATA AND HIS MAN COULD DO TO KEEP UP WITH THE CORN THE ORCHARD WAS A NEGLECTED WILDERNESS", "source_meta": {"key": "237-134500-0015_2300-131720-0018__T1__SCV2TTS__237-237-134500-0015__VOICE__2300", "mixture_id": "237-134500-0015_2300-131720-0018", "target_source": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/237/134500/237-134500-0015.flac", "target_spk": "237", "target_utt": "237-134500-0015", "target_text": "THAT SUMMER THE RAINS HAD BEEN SO MANY AND OPPORTUNE THAT IT WAS ALMOST MORE THAN SHABATA AND HIS MAN COULD DO TO KEEP UP WITH THE CORN THE ORCHARD WAS A NEGLECTED WILDERNESS", "original_interferer_source": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/2300/131720/2300-131720-0018.flac", "interferer_spk": "2300", "interferer_utt": "2300-131720-0018", "prompt_audio": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/2300/131720/2300-131720-0000.flac", "prompt_utt": "2300-131720-0000", "prompt_text": "THE PARIS PLANT LIKE THAT AT THE CRYSTAL PALACE WAS A TEMPORARY EXHIBIT", "synthetic_interferer": "/data/tse_cue_project/manifests/librimix_similar_content_v2_tts/clean/test/synt
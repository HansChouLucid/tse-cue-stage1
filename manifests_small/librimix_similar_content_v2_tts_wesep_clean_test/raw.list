{"key": "2961-960-0020_2094-142345-0006__T2__SCV2TTS__2094-2094-142345-0006__VOICE__2961", "condition": "similar_content_v2_tts", "spk": ["2094", "2961"], "mix": {"default": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/mix_clean/2961-960-0020_2094-142345-0006__T2__SCV2TTS__2094-2094-142345-0006__VOICE__2961.wav"]}, "src": {"2094": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/s1/2961-960-0020_2094-142345-0006__T2__SCV2TTS__2094-2094-142345-0006__VOICE__2961.wav"], "2961": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/s2/2961-960-0020_2094-142345-0006__T2__SCV2TTS__2094-2094-142345-0006__VOICE__2961.wav"]}, "target_text": "AT THE EDGE OF THIS BOX THERE LIES A GREAT WOODEN DOLL WHICH SO FAR AS MUTILATION IS CONCERNED BEARS A STRONG RESEMBLANCE TO THE FINEST GREEK SCULPTURE AND ESPECIALLY IN THE TOTAL LOSS OF ITS NOSE", "source_meta": {"key": "2961-960-0020_2094-142345-0006__T2__SCV2TTS__2094-2094-142345-0006__VOICE__2961", "mixture_id": "2961-960-0020_2094-142345-0006", "target_source": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/2094/142345/2094-142345-0006.flac", "target_spk": "2094", "target_utt": "2094-142345-0006", "target_text": "AT THE EDGE OF THIS BOX THERE LIES A GREAT WOODEN DOLL WHICH SO FAR AS MUTILATION IS CONCERNED BEARS A STRONG RESEMBLANCE TO THE FINEST GREEK SCULPTURE AND ESPECIALLY IN THE TOTAL LOSS OF ITS NOSE", "original_interferer_source": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/2961/960/2961-960-0020.flac", "interferer_spk": "2961", "interferer_utt": "2961-960-0020", "prompt_audio": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/2961/960/2961-960-0000.flac", "prompt_utt": "2961-960-0000", "prompt_text": "HE PASSES ABRUPTLY FROM PERSONS TO IDEAS AND NUMBERS AND FROM IDEAS AND NUMBERS TO PERSONS FROM THE HEAVENS TO MAN FROM ASTRONOMY TO PHYSIOLOGY HE CONFUSES OR RATHER DOES NOT DISTINGUISH SUBJECT AND OBJECT FIRST AND FINAL CAUSES AND IS DREAMING OF GEOMETRICAL FIGURES LOST IN A FLUX OF SENSE", "synthetic_interferer": "/data/tse_cue_project/manifests/librimix_similar_content_v2_tts/clean/test/synthetic_interferer/2961-960-0020_2094-142345-0006__T2__SCV2TTS__2094-2094-142345-0006__VOICE__2961.wav"}, "sir_db": 0.0}

{"key": "3729-6852-0043_8555-284447-0000__T2__SCV2TTS__8555-8555-284447-0000__VOICE__3729", "condition": "similar_content_v2_tts", "spk": ["8555", "3729"], "mix": {"default": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/mix_clean/3729-6852-0043_8555-284447-0000__T2__SCV2TTS__8555-8555-284447-0000__VOICE__3729.wav"]}, "src": {"8555": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/s1/3729-6852-0043_8555-284447-0000__T2__SCV2TTS__8555-8555-284447-0000__VOICE__3729.wav"], "3729": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/s2/3729-6852-0043_8555-284447-0000__T2__SCV2TTS__8555-8555-284447-0000__VOICE__3729.wav"]}, "target_text": "THEN HE RUSHED DOWN STAIRS INTO THE COURTYARD SHOUTING LOUDLY FOR HIS SOLDIERS AND THREATENING TO PATCH EVERYBODY IN HIS DOMINIONS IF THE SAILORMAN WAS NOT RECAPTURED", "source_meta": {"key": "3729-6852-0043_8555-284447-0000__T2__SCV2TTS__8555-8555-284447-0000__VOICE__3729", "mixture_id": "3729-6852-0043_8555-284447-0000", "target_source": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/8555/284447/8555-284447-0000.flac", "target_spk": "8555", "target_utt": "8555-284447-0000", "target_text": "THEN HE RUSHED DOWN STAIRS INTO THE COURTYARD SHOUTING LOUDLY FOR HIS SOLDIERS AND THREATENING TO PATCH EVERYBODY IN HIS DOMINIONS IF THE SAILORMAN WAS NOT RECAPTURED", "original_interferer_source": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/3729/6852/3729-6852-0043.flac", "interferer_spk": "3729", "interferer_utt": "3729-6852-0043", "prompt_audio": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/3729/6852/3729-6852-0000.flac", "prompt_utt": "3729-6852-0000", "prompt_text": "TO CELEBRATE THE ARRIVAL OF HER SON SILVIA GAVE A SPLENDID SUPPER TO WHICH SHE HAD INVITED ALL HER RELATIVES AND IT WAS A GOOD OPPORTUNITY FOR ME TO MAKE THEIR ACQUAINTANCE", "synthetic_interferer": "/data/tse_cue_project/manifests/librimix_similar_content_v2_tts/clean/test/synthetic_interferer/3729-6852-0043_8555-284447-0000__T2__SCV2TTS__8555-8555-284447-0000__VOICE__3729.wav"}, "sir_db": 0.0}

ELY ABOUT THE PENALTY FOR FORGING A CHECK", "synthetic_interferer": "/data/tse_cue_project/manifests/librimix_similar_content_v2_tts/clean/test/synthetic_interferer/3729-6852-0042_6829-68769-0007__T1__SCV2TTS__3729-3729-6852-0042__VOICE__6829.wav"}, "sir_db": 0.0}

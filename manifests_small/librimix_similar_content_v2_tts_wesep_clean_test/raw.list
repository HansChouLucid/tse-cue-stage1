{"key": "6829-68771-0006_5105-28241-0016__T2__SCV2TTS__5105-5105-28241-0016__VOICE__6829", "condition": "similar_content_v2_tts", "spk": ["5105", "6829"], "mix": {"default": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/mix_clean/6829-68771-0006_5105-28241-0016__T2__SCV2TTS__5105-5105-28241-0016__VOICE__6829.wav"]}, "src": {"5105": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/s1/6829-68771-0006_5105-28241-0016__T2__SCV2TTS__5105-5105-28241-0016__VOICE__6829.wav"], "6829": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/s2/6829-68771-0006_5105-28241-0016__T2__SCV2TTS__5105-5105-28241-0016__VOICE__6829.wav"]}, "target_text": "YOU MUST SEE LIEUTENANT I SHOULD THINK THAT WE ARE NOT SO NEAR THE COAST OF ALGERIA AS YOU IMAGINED", "source_meta": {"key": "6829-68771-0006_5105-28241-0016__T2__SCV2TTS__5105-5105-28241-0016__VOICE__6829", "mixture_id": "6829-68771-0006_5105-28241-0016", "target_source": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/5105/28241/5105-28241-0016.flac", "target_spk": "5105", "target_utt": "5105-28241-0016", "target_text": "YOU MUST SEE LIEUTENANT I SHOULD THINK THAT WE ARE NOT SO NEAR THE COAST OF ALGERIA AS YOU IMAGINED", "original_interferer_source": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/6829/68771/6829-68771-0006.flac", "interferer_spk": "6829", "interferer_utt": "6829-68771-0006", "prompt_audio": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/6829/68769/6829-68769-0000.flac", "prompt_utt": "6829-68769-0000", "prompt_text": "KENNETH AND BETH REFRAINED FROM TELLING THE OTHER GIRLS OR UNCLE JOHN OF OLD WILL ROGERS'S VISIT BUT THEY GOT MISTER WATSON IN THE LIBRARY AND QUESTIONED HIM CLOSELY ABOUT THE PENALTY FOR FORGING A CHECK", "synthetic_interferer": "/data/tse_cue_project/manifests/librimix_similar_content_v2_tts/clean/test/synthetic_interferer/6829-68771-0006_5105-28241-0016__T2__SCV2TTS__5105-5105-28241-0016__VOICE__6829.wav"}, "sir_db": 0.0}
{"key": "4446-2271-0001_1221-135767-0001__T1__SCV2TTS__4446-4446-2271-0001__VOICE__1221", "condition": "similar_content_v2_tts", "spk": ["4446", "1221"], "mix": {"default": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/mix_clean/4446-2271-0001_1221-135767-0001__T1__SCV2TTS__4446-4446-2271-0001__VOICE__1221.wav"]}, "src": {"4446": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/s1/4446-2271-0001_1221-135767-0001__T1__SCV2TTS__4446-4446-2271-0001__VOICE__1221.wav"], "1221": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/s2/4446-2271-0001_1221-135767-0001__T1__SCV2TTS__4446-4446-2271-0001__VOICE__1221.wav"]}, "target_text": "HE HAD PRECONCEIVED IDEAS ABOUT EVERYTHING AND HIS IDEA ABOUT AMERICANS WAS THAT THEY SHOULD BE ENGINEERS OR MECHANICS", "source_meta": {"key": "4446-2271-0001_1221-135767-0001__T1__SCV2TTS__4446-4446-2271-0001__VOICE__1221", "mixture_id": "4446-2271-0001_1221-135767-0001", "target_source": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/4446/2271/4446-2271-0001.flac", "target_spk": "4446", "target_utt": "4446-2271-0001", "target_text": "HE HAD PRECONCEIVED IDEAS ABOUT EVERYTHING AND HIS IDEA ABOUT AMERICANS WAS THAT THEY SHOULD BE ENGINEERS OR MECHANICS", "original_interferer_source": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/1221/135767/1221-135767-0001.flac", "interferer_spk": "1221", "interferer_utt": "1221-135767-0001", "prompt_audio": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/1221/135766/1221-135766-0000.flac", "prompt_utt": "1221-135766-0000", "prompt_text": "HOW STRANGE IT SEEMED TO THE SAD WOMAN AS SHE WATCHED THE GROWTH AND THE BEAUTY THAT BECAME EVERY DAY MORE BRILLIANT AND THE INTELLIGENCE THAT THREW ITS QUIVERING SUNSHINE OVER THE TINY FEATURES OF THIS CHILD", "synthetic_interferer": "/data/tse_cue_project/manifests/librimix_similar_content_v2_tts/clean/test/synthetic_interferer/4446-2271-0001_1221-135767-0001__T1__SCV2TTS__4446-4446-2271-0001__VOICE__1221.wav"}, "sir_db": 0.0}
{"key": "4446-2271-0001_1221-135767-0001__T2__SCV2TTS__1221-1221-135767-0001__VOICE__4446", "condition": "similar_content_v2_tts", "spk": ["1221", "4446"], "mix": {"default": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/mix_clean/4446-2271-0001_1221-135767-0001__T2__SCV2TTS__1221-1221-135767-0001__VOICE__4446.wav"]}, "src": {"1221": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/s1/4446-2271-0001_1221-135767-0001__T2__SCV2TTS__1221-1221-135767-0001__VOICE__4446.wav"], "4446": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/s2/4446-2271-0001_1221-135767-0001__T2__SCV2TTS__1221-1221-135767-0001__VOICE__4446.wav"]}, "target_text": "ANOTHER AND FAR MORE IMPORTANT REASON THAN THE DELIVERY OF A PAIR OF EMBROIDERED GLOVES IMPELLED HESTER AT THIS TIME TO SEEK AN INTERVIEW WITH A PERSONAGE OF SO MUCH POWER AND ACTIVITY IN THE AFFAIRS OF THE SETTLEMENT", "source_meta": {"key": "4446-2271-0001_1221-135767-0001__T2__SCV2TTS__1221-1221-135767-0001__VOICE__4446", "mixture_id": "4446-2271-0001_1221-135767-0001", "target_source": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/1221/135767/1221-135767-0001.flac", "target_spk": "1221", "target_utt": "1221-135767-0001", "target_text": "ANOTHER AND FAR MORE IMPORTANT REASON THAN THE DELIVERY OF A PAIR OF EMBROIDERED GLOVES IMPELLED HESTER AT THIS TIME TO SEEK AN INTERVIEW WITH A PERSONAGE OF SO MUCH POWER AND ACTIVITY IN THE AFFAIRS OF THE SETTLEMENT", "original_interferer_source": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/4446/2271/4446-2271-0001.flac", "interferer_spk": "4446", "interferer_utt": "4446-2271-0001", "prompt_audio": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/4446/2271/4446-2271-0000.flac", "prompt_utt": "4446-2271-0000", "prompt_text": "MAINHALL LIKED ALEXANDER BECAUSE HE WAS AN ENGINEER", "synthetic_interferer": "/data/tse_cue_project/manifests/librimix_similar_content_v2_tts/clean/test/synthetic_interferer/4446-2271-0001_1221-135767-0001__T2__SCV2TTS__1221-1221-135767-0001__VOICE__4446.wav"}, "sir_db": 0.0}

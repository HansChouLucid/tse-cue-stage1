{"key": "3729-6852-0036_908-31957-0019__T2__SCV2TTS__908-908-31957-0019__VOICE__3729", "condition": "similar_content_v2_tts", "spk": ["908", "3729"], "mix": {"default": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/mix_clean/3729-6852-0036_908-31957-0019__T2__SCV2TTS__908-908-31957-0019__VOICE__3729.wav"]}, "src": {"908": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/s1/3729-6852-0036_908-31957-0019__T2__SCV2TTS__908-908-31957-0019__VOICE__3729.wav"], "3729": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/s2/3729-6852-0036_908-31957-0019__T2__SCV2TTS__908-908-31957-0019__VOICE__3729.wav"]}, "target_text": "THOU CANST WAIT THROUGH SORROW AND SICKNESS TO BRING SOULS TO TOUCH AND THINK IT SOON WHEN OTHERS CRY TOO LATE", "source_meta": {"key": "3729-6852-0036_908-31957-0019__T2__SCV2TTS__908-908-31957-0019__VOICE__3729", "mixture_id": "3729-6852-0036_908-31957-0019", "target_source": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/908/31957/908-31957-0019.flac", "target_spk": "908", "target_utt": "908-31957-0019", "target_text": "THOU CANST WAIT THROUGH SORROW AND SICKNESS TO BRING SOULS TO TOUCH AND THINK IT SOON WHEN OTHERS CRY TOO LATE", "original_interferer_source": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/3729/6852/3729-6852-0036.flac", "interferer_spk": "3729", "interferer_utt": "3729-6852-0036", "prompt_audio": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/3729/6852/3729-6852-0000.flac", "prompt_utt": "3729-6852-0000", "prompt_text": "TO CELEBRATE THE ARRIVAL OF HER SON SILVIA GAVE A SPLENDID SUPPER TO WHICH SHE HAD INVITED ALL HER RELATIVES AND IT WAS A GOOD OPPORTUNITY FOR ME TO MAKE THEIR ACQUAINTANCE", "synthetic_interferer": "/data/tse_cue_project/manifests/librimix_similar_content_v2_tts/clean/test/synthetic_interferer/3729-6852-0036_908-31957-0019__T2__SCV2TTS__908-908-31957-0019__VOICE__3729.wav"}, "sir_db": 0.0}
{"key": "1995-1826-0026_6829-68771-0029__T1__SCV2TTS__1995-1995-1826-0026__VOICE__6829", "condition": "similar_content_v2_tts", "spk": ["1995", "6829"], "mix": {"default": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/mix_clean/1995-1826-0026_6829-68771-0029__T1__SCV2TTS__1995-1995-1826-0026__VOICE__6829.wav"]}, "src": {"1995": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/s1/1995-1826-0026_6829-68771-0029__T1__SCV2TTS__1995-1995-1826-0026__VOICE__6829.wav"], "6829": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/s2/1995-1826-0026_6829-68771-0029__T1__SCV2TTS__1995-1995-1826-0026__VOICE__6829.wav"]}, "target_text": "NOW FOR ONE LITTLE HALF HOUR SHE HAD BEEN A WOMAN TALKING TO A BOY NO NOT EVEN THAT SHE HAD BEEN TALKING JUST TALKING THERE WERE NO PERSONS IN THE CONVERSATION JUST THINGS ONE THING COTTON", "source_meta": {"key": "1995-1826-0026_6829-68771-0029__T1__SCV2TTS__1995-1995-1826-0026__VOICE__6829", "mixture_id": "1995-1826-0026_6829-68771-0029", "target_source": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/1995/1826/1995-1826-0026.flac", "target_spk": "1995", "target_utt": "1995-1826-0026", "target_text": "NOW FOR ONE LITTLE HALF HOUR SHE HAD BEEN A WOMAN TALKING TO A BOY NO NOT EVEN THAT SHE HAD BEEN TALKING JUST TALKING THERE WERE NO PERSONS IN THE CONVERSATION JUST THINGS ONE THING COTTON", "original_interferer_source": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/6829/68771/6829-68771-0029.flac", "interferer_spk": "6829", "interferer_utt": "6829-68771-0029", "prompt_audio": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/6829/68769/6829-68769-0000.flac", "prompt_utt": "6829-68769-0000", "prompt_text": "KENNETH AND BETH REFRAINED FROM TELLING THE OTHER GIRLS OR UNCLE JOHN OF OLD WILL ROGERS'S VISIT BUT THEY GOT MISTER WATSON IN THE LIBRARY AND QUESTIONED HIM CLOSELY ABOUT THE PENALTY FOR FORGING A CHECK", "synthetic_interferer": "/data/tse_cue_project/manifests/librimix_similar_content_v2_tts/clean/test/synthetic_interferer/1995-1826-0026_6829-68771-0029__T1__SCV2TTS__1995-1995-1826-0026__VOICE__6829.wav"}, "sir_db": 0.0}
{"key": "1995-1826-0026_6829-68771-0029__T2__SCV2TTS__6829-6829-68771-0029__VOICE__1995", "condition": "similar_content_v2_tts", "spk": ["6829", "1995"], "mix": {"default": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/mix_clean/1995-1826-0026_6829-68771-0029__T2__SCV2TTS__6829-6829-68771-0029__VOICE__1995.wav"]}, "src": {"6829": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/s1/1995-1826-0026_6829-68771-0029__T2__SCV2TTS__6829-6829-68771-0029__VOICE__1995.wav"], "1995": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/s2/1995-1826-0026_6829-68771-0029__T2__SCV2TTS__6829-6829-68771-0029__VOICE__1995.wav"]}, "target_text": "BETH WAS A BEAUTIFUL GIRL THE HANDSOMEST OF THE THREE COUSINS BY FAR YET ELIZA SURPASSED HER IN NATURAL CHARM AND SEEMED WELL AWARE OF THE FACT", "source_meta": {"key": "1995-1826-0026_6829-68771-0029__T2__SCV2TTS__6829-6829-68771-0029__VOICE__1995", "mixture_id": "1995-1826-0026_6829-68771-0029", "target_source": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/6829/68771/6829-68771-0029.flac", "target_spk": "6829", "target_utt": "6829-68771-0029", "target_text": "BETH WAS A BEAUTIFUL GIRL THE HANDSOMEST OF THE THREE COUSINS BY FAR YET ELIZA SURPASSED HER IN NATURAL CHARM AND SEEMED WELL AWARE OF THE FACT", "original_interferer_source": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/1995/1826/1995-1826-0026.flac", "interferer_spk": "1995", "interferer_utt": "1995-1826-0026", "prompt_audio": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/1995/1826/1995-1826-0000.flac", "prompt_utt": "1995-1826-0000", "prompt_text": "IN THE DEBATE BETWEEN THE SENIOR SOCIETIES HER DEFENCE OF THE FIFTEENTH AMENDMENT HAD BEEN NOT ONLY A NOTABLE BIT OF REASONING BUT DELIVERED WITH REAL ENTHUSIASM", "synthetic_interferer": "/data/tse_cue_project/manifests/librimix_similar_content_v2_tts/clean/test/synthetic_interferer/1995-1826-0026_6829-68771-0029__T2__SCV2TTS__6829-6829-68771-0029__VOICE__1995.wav"}, "sir_db": 0.0}

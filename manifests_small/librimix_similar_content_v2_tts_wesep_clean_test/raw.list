9-68771-0035__VOICE__237.wav"}, "sir_db": 0.0}
{"key": "5639-40744-0029_1221-135766-0010__T1__SCV2TTS__5639-5639-40744-0029__VOICE__1221", "condition": "similar_content_v2_tts", "spk": ["5639", "1221"], "mix": {"default": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/mix_clean/5639-40744-0029_1221-135766-0010__T1__SCV2TTS__5639-5639-40744-0029__VOICE__1221.wav"]}, "src": {"5639": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/s1/5639-40744-0029_1221-135766-0010__T1__SCV2TTS__5639-5639-40744-0029__VOICE__1221.wav"], "1221": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/s2/5639-40744-0029_1221-135766-0010__T1__SCV2TTS__5639-5639-40744-0029__VOICE__1221.wav"]}, "target_text": "THIS TRUTH WHICH I HAVE LEARNED FROM HER LIPS IS CONFIRMED BY HIS FACE IN WHICH WE HAVE BOTH BEHELD THAT OF OUR SON", "source_meta": {"key": "5639-40744-0029_1221-135766-0010__T1__SCV2TTS__5639-5639-40744-0029__VOICE__1221", "mixture_id": "5639-40744-0029_1221-135766-0010", "target_source": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/5639/40744/5639-40744-0029.flac", "target_spk": "5639", "target_utt": "5639-40744-0029", "target_text": "THIS TRUTH WHICH I HAVE LEARNED FROM HER LIPS IS CONFIRMED BY HIS FACE IN WHICH WE HAVE BOTH BEHELD THAT OF OUR SON", "original_interferer_source": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/1221/135766/1221-135766-0010.flac", "interferer_spk": "1221", "interferer_utt": "1221-135766-0010", "prompt_audio": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/1221/135766/1221-135766-0000.flac", "prompt_utt": "1221-135766-0000", "prompt_text": "HOW STRANGE IT SEEMED TO THE SAD WOMAN AS SHE WATCHED THE GROWTH AND THE BEAUTY THAT BECAME EVERY DAY MORE BRILLIANT AND THE INTELLIGENCE THAT THREW ITS QUIVERING SUNSHINE OVER THE TINY FEATURES OF THIS CHILD", "synthetic_interferer": "/data/tse_cue_project/manifests/librimix_similar_content_v2_tts/clean/test/synthetic_interferer/5639-40744-0029_1221-135766-0010__T1__SCV2TTS__5639-5639-40744-0029__VOICE__1221.wav"}, "sir_db": 0.0}
{"key": "5639-40744-0029_1221-135766-0010__T2__SCV2TTS__1221-1221-135766-0010__VOICE__5639", "condition": "similar_content_v2_tts", "spk": ["1221", "5639"], "mix": {"default": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/mix_clean/5639-40744-0029_1221-135766-0010__T2__SCV2TTS__1221-1221-135766-0010__VOICE__5639.wav"]}, "src": {"1221": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/s1/5639-40744-0029_1221-135766-0010__T2__SCV2TTS__1221-1221-135766-0010__VOICE__5639.wav"], "5639": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/s2/5639-40744-0029_1221-135766-0010__T2__SCV2TTS__1221-1221-135766-0010__VOICE__5639.wav"]}, "target_text": "IT WAS A LOOK SO INTELLIGENT YET INEXPLICABLE PERVERSE SOMETIMES SO MALICIOUS BUT GENERALLY ACCOMPANIED BY A WILD FLOW OF SPIRITS THAT HESTER COULD NOT HELP QUESTIONING AT SUCH MOMENTS WHETHER PEARL WAS A HUMAN CHILD", "source_meta": {"key": "5639-40744-0029_1221-135766-0010__T2__SCV2TTS__1221-1221-135766-0010__VOICE__5639", "mixture_id": "5639-40744-0029_1221-135766-0010", "target_source": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/1221/135766/1221-135766-0010.flac", "target_spk": "1221", "target_utt": "1221-135766-0010", "target_text": "IT WAS A LOOK SO INTELLIGENT YET INEXPLICABLE PERVERSE SOMETIMES SO MALICIOUS BUT GENERALLY ACCOMPANIED BY A WILD FLOW OF SPIRITS THAT HESTER COULD NOT HELP QUESTIONING AT SUCH MOMENTS WHETHER PEARL WAS A HUMAN CHILD", "original_interferer_source": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/5639/40744/5639-40744-0029.flac", "interferer_spk": "5639", "interferer_utt": "5639-40744-0029", "prompt_audio": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/5639/40744/5639-40744-0000.flac", "prompt_utt": "5639-40744-0000", "prompt_text": "ELEVEN O'CLOCK HAD STRUCK IT WAS A FINE CLEAR NIGHT THEY WERE THE ONLY PERSONS ON THE ROAD AND THEY SAUNTERED LEISURELY ALONG TO AVOID PAYING THE PRICE OF FATIGUE FOR THE RECREATION PROVIDED FOR THE TOLEDANS IN THEIR VALLEY OR ON THE BANKS OF THEIR RIVER", "synthetic_interferer": "/data/tse_cue_project/manifests/librimix_similar_content_v2_tts/clean/test/synthetic_interferer/5639-40744-0029_1221-135766-0010__T2__SCV2TTS__1221-1221-135766-0010__VOICE__5639.wav"}, "sir_db": 0.0}

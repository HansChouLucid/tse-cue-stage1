{"key": "8455-210777-0067_2830-3979-0009__T2__SCV2TTS__2830-2830-3979-0009__VOICE__8455", "condition": "similar_content_v2_tts", "spk": ["2830", "8455"], "mix": {"default": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/mix_clean/8455-210777-0067_2830-3979-0009__T2__SCV2TTS__2830-2830-3979-0009__VOICE__8455.wav"]}, "src": {"2830": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/s1/8455-210777-0067_2830-3979-0009__T2__SCV2TTS__2830-2830-3979-0009__VOICE__8455.wav"], "8455": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/s2/8455-210777-0067_2830-3979-0009__T2__SCV2TTS__2830-2830-3979-0009__VOICE__8455.wav"]}, "target_text": "IT PRESENTS LIKE NO OTHER OF LUTHER'S WRITINGS THE CENTRAL THOUGHT OF CHRISTIANITY THE JUSTIFICATION OF THE SINNER FOR THE SAKE OF CHRIST'S MERITS ALONE", "source_meta": {"key": "8455-210777-0067_2830-3979-0009__T2__SCV2TTS__2830-2830-3979-0009__VOICE__8455", "mixture_id": "8455-210777-0067_2830-3979-0009", "target_source": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/2830/3979/2830-3979-0009.flac", "target_spk": "2830", "target_utt": "2830-3979-0009", "target_text": "IT PRESENTS LIKE NO OTHER OF LUTHER'S WRITINGS THE CENTRAL THOUGHT OF CHRISTIANITY THE JUSTIFICATION OF THE SINNER FOR THE SAKE OF CHRIST'S MERITS ALONE", "original_interferer_source": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/8455/210777/8455-210777-0067.flac", "interferer_spk": "8455", "interferer_utt": "8455-210777-0067", "prompt_audio": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/8455/210777/8455-210777-0000.flac", "prompt_utt": "8455-210777-0000", "prompt_text": "I REMAINED THERE ALONE FOR MANY HOURS BUT I MUST ACKNOWLEDGE THAT BEFORE I LEFT THE CHAMBERS I HAD GRADUALLY BROUGHT MYSELF TO LOOK AT THE MATTER IN ANOTHER LIGHT", "synthetic_interferer": "/data/tse_cue_project/manifests/librim
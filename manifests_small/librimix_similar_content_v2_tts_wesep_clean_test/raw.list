{"key": "908-157963-0017_7729-102255-0041__T2__SCV2TTS__7729-7729-102255-0041__VOICE__908", "condition": "similar_content_v2_tts", "spk": ["7729", "908"], "mix": {"default": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/mix_clean/908-157963-0017_7729-102255-0041__T2__SCV2TTS__7729-7729-102255-0041__VOICE__908.wav"]}, "src": {"7729": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/s1/908-157963-0017_7729-102255-0041__T2__SCV2TTS__7729-7729-102255-0041__VOICE__908.wav"], "908": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/s2/908-157963-0017_7729-102255-0041__T2__SCV2TTS__7729-7729-102255-0041__VOICE__908.wav"]}, "target_text": "THE WHOLE PROCEEDING WAS SO CHILDISH THE MISERABLE PLOT SO TRANSPARENT THE OUTRAGE SO GROSS AS TO BRING DISGUST TO THE BETTER CLASS OF BORDER RUFFIANS WHO WERE WITNESSES AND ACCESSORIES", "source_meta": {"key": "908-157963-0017_7729-102255-0041__T2__SCV2TTS__7729-7729-102255-0041__VOICE__908", "mixture_id": "908-157963-0017_7729-102255-0041", "target_source": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/7729/102255/7729-102255-0041.flac", "target_spk": "7729", "target_utt": "7729-102255-0041", "target_text": "THE WHOLE PROCEEDING WAS SO CHILDISH THE MISERABLE PLOT SO TRANSPARENT THE OUTRAGE SO GROSS AS TO BRING DISGUST TO THE BETTER CLASS OF BORDER RUFFIANS WHO WERE WITNESSES AND ACCESSORIES", "original_interferer_source": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/908/157963/908-157963-0017.flac", "interferer_spk": "908", "interferer_utt": "908-157963-0017", "prompt_audio": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/908/157963/908-157963-0000.flac", "prompt_utt": "908-157963-0000", "prompt_text": "TO FADE AWAY LIKE MORNING BEAUTY FROM HER MORTAL DAY DOWN BY THE RIVER OF ADONA HER SOFT VOICE IS HEARD AND THUS HER GENTLE LAMENTATION FALLS LIKE MORNING DEW", "synthetic_interferer": "/data/tse_cue_project/manifests/librimix_similar_content_v2_tts/clean/test/synthetic_interferer/908-157963-0017_7729-102255-0041__T2__SCV2TTS__7729-7729-102255-0041__VOICE__908.wav"}, "sir_db": 0.0}

er": "/data/tse_cue_project/manifests/librimix_similar_content_v2_tts/clean/test/synthetic_interferer/5683-32866-0013_8555-284447-0024__T1__SCV2TTS__5683-5683-32866-0013__VOICE__8555.wav"}, "sir_db": 0.0}

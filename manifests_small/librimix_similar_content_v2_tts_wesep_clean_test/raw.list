{"key": "61-70968-0053_3729-6852-0020__T2__SCV2TTS__3729-3729-6852-0020__VOICE__61", "condition": "similar_content_v2_tts", "spk": ["3729", "61"], "mix": {"default": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/mix_clean/61-70968-0053_3729-6852-0020__T2__SCV2TTS__3729-3729-6852-0020__VOICE__61.wav"]}, "src": {"3729": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/s1/61-70968-0053_3729-6852-0020__T2__SCV2TTS__3729-3729-6852-0020__VOICE__61.wav"], "61": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/s2/61-70968-0053_3729-6852-0020__T2__SCV2TTS__3729-3729-6852-0020__VOICE__61.wav"]}, "target_text": "THEN TURNING TOWARDS ME HE SAYS THAT I LOOK LIKE A FOREIGNER AND WHEN I SAY THAT I AM AN ITALIAN HE BEGINS TO SPEAK TO ME OF THE COURT OF THE CITY OF THE THEATRES AND AT LAST HE OFFERS TO ACCOMPANY ME EVERYWHERE", "source_meta": {"key": "61-70968-0053_3729-6852-0020__T2__SCV2TTS__3729-3729-6852-0020__VOICE__61", "mixture_id": "61-70968-0053_3729-6852-0020", "target_source": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/3729/6852/3729-6852-0020.flac", "target_spk": "3729", "target_utt": "3729-6852-0020", "target_text": "THEN TURNING TOWARDS ME HE SAYS THAT I LOOK LIKE A FOREIGNER AND WHEN I SAY THAT I AM AN ITALIAN HE BEGINS TO SPEAK TO ME OF THE COURT OF THE CITY OF THE THEATRES AND AT LAST HE OFFERS TO ACCOMPANY ME EVERYWHERE", "original_interferer_source": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/61/70968/61-70968-0053.flac", "interferer_spk": "61", "interferer_utt": "61-70968-0053", "prompt_audio": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/61/70968/61-70968-0000.flac", "prompt_utt": "61-70968-0000", "prompt_text": "HE BEGAN A CONFUSED COMPLAINT AGAINST THE WIZARD WHO HAD VANISHED BEHIND THE CURTAIN ON THE LEFT", "synthetic_interferer": "/data/tse_cue_project/manifests/librimix_similar_content_v2_tts/clean/test/synthetic_interferer/61-70968-0053_3729-6852-0020__T2__SCV2TTS__3729-3729-6852-0020__VOICE__61.wav"}, "sir_db": 0.0}

NAMENT WORKERS OF THE COURT", "synthetic_interferer": "/data/tse_cue_project/manifests/librimix_similar_content_v2_tts/clean/test/synthetic_interferer/1580-141084-0002_7127-75947-0027__T1__SCV2TTS__1580-1580-141084-0002__VOICE__7127.wav"}, "sir_db": 0.0}

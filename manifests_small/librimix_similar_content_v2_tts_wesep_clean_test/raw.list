ect/manifests/librimix_similar_content_v2_tts/clean/test/synthetic_interferer/4077-13751-0020_8555-284449-0007__T1__SCV2TTS__4077-4077-13751-0020__VOICE__8555.wav"}, "sir_db": 0.0}
{"key": "4077-13751-0020_8555-284449-0007__T2__SCV2TTS__8555-8555-284449-0007__VOICE__4077", "condition": "similar_content_v2_tts", "spk": ["8555", "4077"], "mix": {"default": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/mix_clean/4077-13751-0020_8555-284449-0007__T2__SCV2TTS__8555-8555-284449-0007__VOICE__4077.wav"]}, "src": {"8555": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/s1/4077-13751-0020_8555-284449-0007__T2__SCV2TTS__8555-8555-284449-0007__VOICE__4077.wav"], "4077": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/s2/4077-13751-0020_8555-284449-0007__T2__SCV2TTS__8555-8555-284449-0007__VOICE__4077.wav"]}, "target_text": "NOW THEN LET'S ENTER THE CITY AN ENJOY THE GRAND FEAST THAT'S BEING COOKED I'M NEARLY STARVED MYSELF FOR THIS CONQUERIN KINGDOMS IS HARD WORK", "source_meta": {"key": "4077-13751-0020_8555-284449-0007__T2__SCV2TTS__8555-8555-284449-0007__VOICE__4077", "mixture_id": "4077-13751-0020_8555-284449-0007", "target_source": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/8555/284449/8555-284449-0007.flac", "target_spk": "8555", "target_utt": "8555-284449-0007", "target_text": "NOW THEN LET'S ENTER THE CITY AN ENJOY THE GRAND FEAST THAT'S BEING COOKED I'M NEARLY STARVED MYSELF FOR THIS CONQUERIN KINGDOMS IS HARD WORK", "original_interferer_source": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/4077/13751/4077-13751-0020.flac", "interferer_spk": "4077", "interferer_utt": "4077-13751-0020", "prompt_audio": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/4077/13751/4077-13751-0000.flac", "prompt_utt": "4077-13751-0000", "prompt_text": "ON THE SIXTH OF APRIL EIGHTEEN THIRTY THE CHURCH OF JESUS CHRIST OF LATTER DAY SAINTS WAS FORMALLY ORGANIZED AND THUS TOOK ON A LEGAL EXISTENCE", "synthetic_interferer": "/data/tse_cue_project/manifests/librimix_similar_content_v2_tts/clean/test/synthetic_interferer/4077-13751-0020_8555-284449-0007__T2__SCV2TTS__8555-8555-284449-0007__VOICE__4077.wav"}, "sir_db": 0.0}
{"key": "6829-68769-0051_61-70968-0024__T1__SCV2TTS__6829-6829-68769-0051__VOICE__61", "condition": "similar_content_v2_tts", "spk": ["6829", "61"], "mix": {"default": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/mix_clean/6829-68769-0051_61-70968-0024__T1__SCV2TTS__6829-6829-68769-0051__VOICE__61.wav"]}, "src": {"6829": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/s1/6829-68769-0051_61-70968-0024__T1__SCV2TTS__6829-6829-68769-0051__VOICE__61.wav"], "61": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/s2/6829-68769-0051_61-70968-0024__T1__SCV2TTS__6829-6829-68769-0051__VOICE__61.wav"]}, "target_text": "THERE WAS A GRIM SMILE OF AMUSEMENT ON HIS SHREWD FACE", "source_meta": {"key": "6829-68769-0051_61-70968-0024__T1__SCV2TTS__6829-6829-68769-0051__VOICE__61", "mixture_id": "6829-68769-0051_61-70968-0024", "target_source": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/6829/68769/6829-68769-0051.flac", "target_spk": "6829", "target_utt": "6829-68769-0051", "target_text": "THERE WAS A GRIM SMILE OF AMUSEMENT ON HIS SHREWD FACE", "original_interferer_source": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/61/70968/61-70968-0024.flac", "interferer_spk": "61", "interferer_utt": "61-70968-0024", "prompt_audio": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/61/70968/61-70968-0000.flac", "prompt_utt": "61-70968-0000", "prompt_text": "HE BEGAN A CONFUSED COMPLAINT AGAINST THE WIZARD WHO HAD VANISHED BEHIND THE CURTAIN ON THE LEFT", "synthetic_interferer": "/data/tse_cue_project/manifests/librimix_similar_content_v2_tts/clean/test/synthetic_interferer/6829-68769-0051_61-70968-0024__T1__SCV2TTS__6829-6829-68769-0051__VOICE__61.wav"}, "sir_db": 0.0}
{"key": "6829-68769-0051_61-70968-0024__T2__SCV2TTS__61-61-70968-0024__VOICE__6829", "condition": "similar_content_v2_tts", "spk": ["61", "6829"], "mix": {"default": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/mix_clean/6829-68769-0051_61-70968-0024__T2__SCV2TTS__61-61-70968-0024__VOICE__6829.wav"]}, "src": {"61": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/s1/6829-68769-0051_61-70968-0024__T2__SCV2TTS__61-61-70968-0024__VOICE__6829.wav"], "6829": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/s2/6829-68769-0051_61-70968-0024__T2__SCV2TTS__61-61-70968-0024__VOICE__6829.wav"]}, "target_text": "SPOKE THE SQUIRE LOSING ALL PATIENCE AND IT WAS TO YOU THAT I GAVE ANOTHER PURSE IN CONSOLATION", "source_meta": {"key": "6829-68769-0051_61-70968-0024__T2__SCV2TTS__61-61-70968-0024__VOICE__6829", "mixture_id": "6829-68769-0051_61-70968-0024", "target_source": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/61/70968/61-70968-0024.flac", "target_spk": "61", "target_utt": "61-70968-0024", "target_text": "SPOKE THE SQUIRE LOSING ALL PATIENCE AND IT WAS TO YOU THAT I GAVE ANOTHER PURSE IN CONSOLATION", "original_interferer_source": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/6829/68769/6829-68769-0051.flac", "interferer_spk": "6829", "interferer_utt": "6829-68769-0051", "prompt_audio": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/6829/68769/6829-68769-0000.flac", "prompt_utt": "6829-68769-0000", "prompt_text": "KENNETH AND BETH REFRAINED FROM TELLING THE OTHER GIRLS OR UNCLE JOHN OF OLD WILL ROGERS'S VISIT BUT THEY GOT MISTER WATSON IN THE LIBRARY AND QUESTIONED HIM CLOSELY ABOUT THE PENALTY FOR FORGING A CHECK", "synthetic_interferer": "/data/tse_cue_project/manifests/librimix_similar_content_v2_tts/clean/test/synthetic_interferer/6829-68769-0051_61-70968-0024__T2__SCV2TTS__61-61-70968-0024__VOICE__6829.wav"}, "sir_db": 0.0}
{"key": "1995-1826-0011_2094-142345-0037__T1__SCV2TTS__1995-1995-1826-0011__VOICE__2094", "condition": "similar_content_v2_tts", "spk": ["1995", "2094"], "mix": {"default": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/mix_clean/1995-1826-0011_2094-142345-0037__T1__SCV2TTS__1995-1995-1826-0011__VOICE__2094.wav"]}, "src": {"1995": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/s1/1995-1826-0011_2094-142345-0037__T1__SCV2TTS__1995-1995-1826-0011__VOICE__2094.wav"], "2094": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/s2/1995-1826-0011_2094-142345-0037__T1__SCV2TTS__1995-1995-1826-0011__VOICE__2094.wav"]}, "target_text": "HERE SHE WAS TEACHING DIRTY CHILDREN AND THE SMELL OF CONFUSED ODORS AND BODILY PERSPIRATION WAS TO HER AT TIMES UNBEARABLE", "source_meta": {"key": "1995-1826-0011_2094-142345-0037__T1__SCV2TTS__1995-1995-1826-0011__VOICE__2094", "mixture_id": "1995-1826-0011_2094-142345-0037", "target_source": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/1995/1826/1995-1826-0011.flac", "target_spk": "1995", "target_utt": "1995-1826-0011", "target_text": "HERE SHE WAS TEACHING DIRTY CHILDREN AND THE SMELL OF CONFUSED ODORS AND BODILY PERSPIRATION WAS TO HER AT TIMES UNBEARABLE", "original_interferer_source": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/2094/142345/2094-142345-0037.flac", "interferer_spk": "2094", "interferer_utt": "2094-142345-0037", "prompt_audio": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/2094/142345/2094-142345-0000.flac", "prompt_utt": "2094-142345-0000", "prompt_text": "IT IS A VERY FINE OLD PLACE OF RED BRICK SOFTENED BY A PALE POWDERY LICHEN WHICH HAS DISPERSED ITSELF WITH HAPPY IRREGULARITY SO AS TO BRING THE RED BRICK INTO TERMS OF FRIENDLY COMPANIONSHIP WITH THE LIMESTONE ORNAMENTS SURROUNDING THE THREE GABLES THE WINDOWS AND THE DOOR PLACE", "synthetic_interferer": "/data/tse_cue_project/manifests/librimix_similar_content_v2_tts/clean/test/synthetic_interferer/1995-1826-0011_2094-142345-0037__T1__SCV2TTS__1995-1995-1826-0011__VOICE__2094.wav"}, "sir_db": 0.0}
{"key": "1995-1826-0011_2094-142345-0037__T2__SCV2TTS__2094-2094-142345-0037__VOICE__1995", "condition": "similar_content_v2_tts", "spk": ["2094", "1995"], "mix": {"default": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/mix_clean/1995-1826-0011_2094-142345-0037__T2__SCV2TTS__2094-2094-142345-0037__VOICE__1995.wav"]}, "src": {"2094": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/s1/1995-1826-0011_2094-142345-0037__T2__SCV2TTS__2094-2094-142345-0037__VOICE__1995.wav"], "1995": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/s2/1995-1826-0011_2094-142345-0037__T2__SCV2TTS__2094-2094-142345-0037__VOICE__1995.wav"]}, "target_text": "WE CAN ALL BE SERVANTS OF GOD WHEREVER OUR LOT IS CAST BUT HE GIVES US DIFFERENT SORTS OF WORK ACCORDING AS HE FITS US FOR IT AND CALLS US TO IT", "source_meta": {"key": "1995-1826-0011_2094-142345-0037__T2__SCV2TTS__2094-2094-142345-0037__VOICE__1995", "mixture_id": "1995-1826-0011_2094-142345-0037", "target_source": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/2094/142345/2094-142345-0037.flac", "target_spk": "2094", "target_utt": "2094-142345-0037", "target_text": "WE CAN ALL BE SERVANTS OF GOD WHEREVER OUR LOT IS CAST BUT HE GIVES US DIFFERENT SORTS OF WORK ACCORDING AS HE FITS US FOR IT AND CALLS US TO IT", "original_interferer_source": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/1995/1826/1995-1826-0011.flac", "interferer_spk": "1995", "interferer_utt": "1995-1826-0011", "prompt_audio": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/1995/1826/1995-1826-0000.flac", "prompt_utt": "1995-1826-0000", "prompt_text": "IN THE DEBATE BETWEEN THE SENIOR SOCIETIES HER DEFENCE OF THE FIFTEENTH AMENDMENT HAD BEEN NOT ONLY A NOTABLE BIT OF REASONING BUT DELIVERED WITH REAL ENTHUSIASM", "synthetic_interferer": "/data/tse_cue_project/manifests/librimix_similar_content_v2_tts/clean/test/synthetic_interferer/1995-1826-0011_2094-142345-0037__T2__SCV2TTS__2094-2094-142345-0037__VOICE__1995.wav"}, "sir_db": 0.0}
{"key": "1089-134686-0022_8455-210777-0023__T1__SCV2TTS__1089-1089-134686-0022__VOICE__8455", "condition": "similar_content_v2_tts", "spk": ["1089", "8455"], "mix": {"default": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/mix_clean/1089-134686-0022_8455-210777-0023__T1__SCV2TTS__1089-1089-134686-0022__VOICE__8455.wav"]}, "src": {"1089": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/s1/1089-134686-0022_8455-210777-0023__T1__SCV2TTS__1089-1089-134686-0022__VOICE__8455.wav"], "8455": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/s2/1089-134686-0022_8455-210777-0023__T1__SCV2TTS__1089-1089-134686-0022__VOICE__8455.wav"]}, "target_text": "HOW COMES IT THAT WHILE THE FIRST BEATITUDE PROMISES THE KINGDOM OF HEAVEN TO THE POOR OF HEART THE SECOND BEATITUDE PROMISES ALSO TO THE MEEK THAT THEY SHALL POSSESS THE LAND", "source_meta": {"key": "1089-134686-0022_8455-210777-0023__T1__SCV2TTS__1089-1089-134686-0022__VOICE__8455", "mixture_id": "1089-134686-0022_8455-210777-0023", "target_source": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/1089/134686/1089-134686-0022.flac", "target_spk": "1089", "target_utt": "1089-134686-0022", "target_text": "HOW COMES IT THAT WHILE THE FIRST BEATITUDE PROMISES THE KINGDOM OF HEAVEN TO THE POOR OF HEART THE SECOND BEATITUDE PROMISES ALSO TO THE MEEK THAT THEY SHALL POSSESS THE LAND", "original_interferer_source": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/8455/210777/8455-210777-0023.flac", "interferer_spk": "8455", "interferer_utt": "8455-210777-0023", "prompt_audio": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/8455/210777/8455-210777-0000.flac", "prompt_utt": "8455-210777-0000", "prompt_text": "I REMAINED THERE ALONE FOR MANY HOURS BUT I MUST ACKNOWLEDGE THAT BEFORE I LEFT THE CHAMBERS I HAD GRADUALLY BROUGHT MYSELF TO LOOK AT THE MATTER IN ANOTHER LIGHT", "synthetic_interferer": "/data/tse_cue_project/manifests/librimix_similar_content_v2_tts/clean/test/synthetic_interferer/1089-134686-0022_8455-210777-0023__T1__SCV2TTS__1089-1089-134686-0022__VOICE__8455.wav"}, "sir_db": 0.0}
{"key": "1089-134686-0022_8455-210777-0023__T2__SCV2TTS__8455-8455-210777-0023__VOICE__1089", "condition": "similar_content_v2_tts", "spk": ["8455", "1089"], "mix": {"default": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/mix_clean/1089-134686-0022_8455-210777-0023__T2__SCV2TTS__8455-8455-210777-0023__VOICE__1089.wav"]}, "src": {"8455": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/s1/1089-134686-0022_8455-210777-0023__T2__SCV2TTS__8455-8455-210777-0023__VOICE__1089.wav"], "1089": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/s2/1089-134686-0022_8455-210777-0023__T2__SCV2TTS__8455-8455-210777-0023__VOICE__1089.wav"]}, "target_text": "WE SAT WITH THE OFFICERS SOME LITTLE TIME AFTER DINNER AND THEN WENT ASHORE", "source_meta": {"key": "1089-134686-0022_8455-210777-0023__T2__SCV2TTS__8455-8455-210777-0023__VOICE__1089", "mixture_id": "1089-134686-0022_8455-210777-0023", "target_source": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/8455/210777/8455-210777-0023.flac", "target_spk": "8455", "target_utt": "8455-210777-0023", "target_text": "WE SAT WITH THE OFFICERS SOME LITTLE TIME AFTER DINNER AND THEN WENT ASHORE", "original_interferer_source": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/1089/134686/1089-134686-0022.flac", "interferer_spk": "1089", "interferer_utt": "1089-134686-0022", "prompt_audio": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/1089/134686/1089-134686-0000.flac", "prompt_utt": "1089-134686-0000", "prompt_text": "HE HOPED THERE WOULD BE STEW FOR DINNER TURNIPS AND CARROTS AND BRUISED POTATOES AND FAT MUTTON PIECES TO BE LADLED OUT IN THICK PEPPERED FLOUR FATTENED SAUCE", "synthetic_interferer": "/data/tse_cue_project/manifests/librimix_similar_content_v2_tts/clean/test/synthetic_interferer/1089-134686-0022_8455-210777-0023__T2__SCV2TTS__8455-8455-210777-0023__VOICE__1089.wav"}, "sir_db": 0.0}

{"key": "2094-142345-0059_237-126133-0024__T1__SCV2TTS__2094-2094-142345-0059__VOICE__237", "condition": "similar_content_v2_tts", "spk": ["2094", "237"], "mix": {"default": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/mix_clean/2094-142345-0059_237-126133-0024__T1__SCV2TTS__2094-2094-142345-0059__VOICE__237.wav"]}, "src": {"2094": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/s1/2094-142345-0059_237-126133-0024__T1__SCV2TTS__2094-2094-142345-0059__VOICE__237.wav"], "237": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/s2/2094-142345-0059_237-126133-0024__T1__SCV2TTS__2094-2094-142345-0059__VOICE__237.wav"]}, "target_text": "THIS MISSUS POYSER SAID BLUSHING AND BELIEVING THAT THE CAPTAIN WAS REALLY INTERESTED IN HER MILK PANS AND WOULD ADJUST HIS OPINION OF HER TO THE APPEARANCE OF HER DAIRY", "source_meta": {"key": "2094-142345-0059_237-126133-0024__T1__SCV2TTS__2094-2094-142345-0059__VOICE__237", "mixture_id": "2094-142345-0059_237-126133-0024", "target_source": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/2094/142345/2094-142345-0059.flac", "target_spk": "2094", "target_utt": "2094-142345-0059", "target_text": "THIS MISSUS POYSER SAID BLUSHING AND BELIEVING THAT THE CAPTAIN WAS REALLY INTERESTED IN HER MILK PANS AND WOULD ADJUST HIS OPINION OF HER TO THE APPEARANCE OF HER DAIRY", "original_interferer_source": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/237/126133/237-126133-0024.flac", "interferer_spk": "237", "interferer_utt": "237-126133-0024", "prompt_audio": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/237/126133/237-126133-0000.flac", "prompt_utt": "237-126133-0000", "prompt_text": "HERE SHE WOULD STAY COMFORTED AND SOOTHED AMONG THE LOVELY PLANTS AND RICH EXOTICS REJOICING THE HEART OF OLD TURNER THE GARDENER WHO SINCE POLLY'S FIRST RAPTUROUS ENTRANCE HAD TAKEN HER INTO HIS GOOD GRACES FOR ALL TIME", "synthetic_interferer": "/data/tse_cue_project/manifests/librimix_similar_content_v2_tts/clean/test/synthetic_interferer/2094-142345-0059_237-126133-0024__T1__SCV2TTS__2094-2094-142345-0059__VOICE__237.wav"}, "sir_db": 0.0}
{"key": "2094-142345-0059_237-126133-0024__T2__SCV2TTS__237-237-126133-0024__VOICE__2094", "condition": "similar_content_v2_tts", "spk": ["237", "2094"], "mix": {"default": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/mix_clean/2094-142345-0059_237-126133-0024__T2__SCV2TTS__237-237-126133-0024__VOICE__2094.wav"]}, "src": {"237": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/s1/2094-142345-0059_237-126133-0024__T2__SCV2TTS__237-237-126133-0024__VOICE__2094.wav"], "2094": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/s2/2094-142345-0059_237-126133-0024__T2__SCV2TTS__237-237-126133-0024__VOICE__2094.wav"]}, "target_text": "AND THE OLD GENTLEMAN WAS SO DELIGHTED WITH HIS SUCCESS THAT HE HAD TO BURST OUT INTO A SERIES OF SHORT HAPPY BITS OF LAUGHTER THAT OCCUPIED QUITE A SPACE OF TIME", "source_meta": {"key": "2094-142345-0059_237-126133-0024__T2__SCV2TTS__237-237-126133-0024__VOICE__2094", "mixture_id": "2094-142345-0059_237-126133-0024", "target_source": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/237/126133/237-126133-0024.flac", "target_spk": "237", "target_utt": "237-126133-0024", "target_text": "AND THE OLD GENTLEMAN WAS SO DELIGHTED WITH HIS SUCCESS THAT HE HAD TO BURST OUT INTO A SERIES OF SHORT HAPPY BITS OF LAUGHTER THAT OCCUPIED QUITE A SPACE OF TIME", "original_interferer_source": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/2094/142345/2094-142345-0059.flac", "interferer_spk": "2094", "interferer_utt": "2094-142345-0059", "prompt_audio": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/2094/142345/2094-142345-0000.flac", "prompt_utt": "2094-142345-0000", "prompt_text": "IT IS A VERY FINE OLD PLACE OF RED BRICK SOFTENED BY A PALE POWDERY LICHEN WHICH HAS DISPERSED ITSELF WITH HAPPY IRREGULARITY SO AS TO BRING THE RED BRICK INTO TERMS OF FRIENDLY COMPANIONSHIP WITH THE LIMESTONE ORNAMENTS SURROUNDING THE THREE GABLES THE WINDOWS AND THE DOOR PLACE", "synthetic_interferer": "/data/tse_cue_project/manifests/librimix_similar_content_v2_tts/clean/test/synthetic_interferer/2094-142345-0059_237-126133-0024__T2__SCV2TTS__237-237-126133-0024__VOICE__2094.wav"}, "sir_db": 0.0}

{"key": "8455-210777-0034_8555-284449-0004__T1__SCV2TTS__8455-8455-210777-0034__VOICE__8555", "condition": "similar_content_v2_tts", "spk": ["8455", "8555"], "mix": {"default": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/mix_clean/8455-210777-0034_8555-284449-0004__T1__SCV2TTS__8455-8455-210777-0034__VOICE__8555.wav"]}, "src": {"8455": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/s1/8455-210777-0034_8555-284449-0004__T1__SCV2TTS__8455-8455-210777-0034__VOICE__8555.wav"], "8555": ["/data/tse_cue_project/datasets/Libri2Mix_similar_content_v2_tts/clean/test/wav16k/min/test/s2/8455-210777-0034_8555-284449-0004__T1__SCV2TTS__8455-8455-210777-0034__VOICE__8555.wav"]}, "target_text": "NOT A DOUBT BUT HAD YOUR FORCE BEEN ONLY DOUBLE OR TREBLE OUR OWN I SHOULD HAVE FOUND IT MY DUTY TO STRUGGLE WITH YOU", "source_meta": {"key": "8455-210777-0034_8555-284449-0004__T1__SCV2TTS__8455-8455-210777-0034__VOICE__8555", "mixture_id": "8455-210777-0034_8555-284449-0004", "target_source": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/8455/210777/8455-210777-0034.flac", "target_spk": "8455", "target_utt": "8455-210777-0034", "target_text": "NOT A DOUBT BUT HAD YOUR FORCE BEEN ONLY DOUBLE OR TREBLE OUR OWN I SHOULD HAVE FOUND IT MY DUTY TO STRUGGLE WITH YOU", "original_interferer_source": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/8555/284449/8555-284449-0004.flac", "interferer_spk": "8555", "interferer_utt": "8555-284449-0004", "prompt_audio": "/data/tse_cue_project/imported_data/LibriSpeech960/test-clean/8555/284447/8555-284447-0000.flac", "prompt_utt": "8555-284447-0000", "prompt_text": "THEN HE RUSHED DOWN STAIRS INTO THE COURTYARD SHOUTING LOUDLY FOR HIS SOLDIERS AND THREATENING TO PATCH EVERYBODY IN HIS DOMINIONS IF THE SAILORMAN WAS NOT RECAPTURED", "synthetic_interferer": "/data/tse_cue_project/manifests/librimix_similar_content_v2_tts/clean/test/s